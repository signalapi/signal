# Signal: Test Platform — environment template.
# Copy to `.env.local` (gitignored) and fill real values. Never commit real secrets.
#   cp .env.example .env.local

###> symfony/framework-bundle ###
APP_ENV=prod
# 32+ char random string. Generate: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=CHANGE_ME
###< symfony/framework-bundle ###

###> app/redis ###
REDIS_URL=redis://redis:6379
###< app/redis ###

###> app/crypto ###
# 32-byte key as 64 hex chars — encrypts stored DB-connection passwords.
# Generate: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET_KEY=CHANGE_ME
###< app/crypto ###

###> app/http ###
# Outgoing test-request TLS verification. 0 = verify (production). 1 = skip (local self-signed only).
HTTP_INSECURE_SSL=0
# Reverse proxies to trust for X-Forwarded-* headers. Behind an ingress: private_ranges.
TRUSTED_PROXIES=private_ranges
###< app/http ###

###> symfony/routing ###
DEFAULT_URI=https://your-domain.example
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:CHANGE_ME@database:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> app/ai (optional — AI diagnosis) ###
# Fill to enable the "AI ile teşhis et" button on failed runs. Empty = feature stays off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
###< app/ai ###
