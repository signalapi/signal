{# The dead-share-link page. Extends base.html.twig for signal.css + dark mode. #}
{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Report not found'|trans }} · Signal{% endblock %}

{% block stylesheets %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block body %}
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px">
    <div class="empty" style="max-width:430px;padding:34px 30px">
        <div class="eyebrow" style="display:flex;align-items:center;justify-content:center;gap:7px;margin-bottom:12px">
            {{ ic.i('terminal', 12, 2.4) }}Signal</div>
        <h1>{{ 'Report not found'|trans }}</h1>
        <p class="subtitle" style="margin-top:7px">{{ 'This share link may have expired or been revoked.'|trans }}</p>
    </div>
</div>
{% endblock %}
