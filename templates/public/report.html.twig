{# ==========================================================================
   templates/public/report.html.twig  —  the login-less shared run report.
   Now extends base.html.twig, so it inherits signal.css (tokens, dark mode,
   primitives) instead of carrying its own palette in an inline stylesheet.
   The robots meta rides in the stylesheets block — the only head hook base has.
   ========================================================================== #}
{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Run Report'|trans }} · {{ run.flow.name }} · Signal{% endblock %}

{% block stylesheets %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block body %}
{% set sc = run.status %}
{% set slabel = {
    'passed':    'Passed'|trans,
    'failed':    'Failed'|trans,
    'error':     'Error'|trans,
    'cancelled': 'Cancelled'|trans,
    'running':   'Running'|trans
} %}

<main class="content" style="max-width:860px;margin:0 auto">
    <div class="pagehead">
        <div>
            <div class="eyebrow" style="display:flex;align-items:center;gap:7px;margin-bottom:9px">
                {{ ic.i('terminal', 12, 2.4) }}Signal · {{ 'Run Report'|trans }}</div>
            <h1>{{ run.flow.name }}</h1>
            <p class="subtitle">{{ run.createdAt|date('d.m.Y H:i') }}</p>
        </div>
        <div class="actions" style="align-items:center">
            <span class="pill {{ sc }}" style="font-size:12px;padding:4.5px 12px">
                {%- if sc == 'passed' %}{{ ic.i('check', 13, 2.8) }}{% elseif sc in ['failed', 'error'] %}{{ ic.i('x', 13, 2.8) }}{% endif -%}
                {{ slabel[sc] ?? sc }}</span>
            <button class="icon-btn" data-theme-toggle title="{{ 'Theme'|trans }}" aria-label="{{ 'Theme'|trans }}">{{ ic.i('moon', 14) }}</button>
        </div>
    </div>

    <div class="ru-sum">
        <div class="ru-stat">
            <div class="n">{{ run.passedSteps }}/{{ run.totalSteps }}</div>
            <div class="l">{{ 'steps passed'|trans }}</div>
        </div>
        <div class="ru-stat">
            <div class="n">{{ run.durationMs ?? '—' }}{{ run.durationMs ? ' ms' }}</div>
            <div class="l">{{ 'duration'|trans }}</div>
        </div>
        <div class="ru-stat">
            <div class="n" style="font-size:15px">{{ run.environmentName ?: '—' }}</div>
            <div class="l">env</div>
        </div>
    </div>

    {% for r in run.stepResults %}
        {% set st = r.status == 'error' ? 'failed' : r.status %}
        {% set edge = r.status == 'passed' ? 'var(--pass)'
            : (r.status in ['failed', 'error'] ? 'var(--fail)'
            : (r.status == 'skipped' ? 'var(--warn)' : 'var(--line)')) %}
        <div class="card" style="margin-bottom:10px;border-left:3px solid {{ edge }}">
            <div class="card-head">
                <span class="status-ic {{ st }}">
                    {%- if r.status == 'passed' %}{{ ic.i('check', 12, 2.8) }}
                    {%- elseif r.status in ['failed', 'error'] %}{{ ic.i('x', 12, 2.8) }}
                    {%- elseif r.status == 'skipped' %}{{ ic.i('minus', 12, 2.8) }}
                    {%- else %}<span class="mono" style="font-size:10px;font-weight:700">{{ r.position + 1 }}</span>{% endif -%}
                </span>
                {% if r.requestMethod %}<span class="kind m-{{ r.requestMethod|lower }}">{{ r.requestMethod }}</span>{% endif %}
                <span class="t grow" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ r.label }}</span>
                {% if r.responseStatus %}
                    <span class="mono" style="font-size:11px;color:var(--muted);flex-shrink:0">{{ r.responseStatus }} · {{ r.durationMs }}ms</span>
                {% endif %}
            </div>
            {% set hasBody = r.status == 'skipped' or r.requestUrl or r.assertionResults is not empty
                or r.shapeDrift is not empty or r.error %}
            {% if hasBody %}
            <div class="card-body">
                {% if r.requestUrl and r.status != 'skipped' %}
                    <div class="mono" style="font-size:11.5px;color:var(--muted);word-break:break-all">{{ r.requestUrl }}</div>
                {% endif %}
                {% if r.status == 'skipped' %}
                    <div class="mono" style="font-size:11.5px;color:var(--muted)">{{ r.error ?: 'Skipped.'|trans }}</div>
                {% endif %}

                {% if r.assertionResults is not empty %}
                    <div style="margin-top:11px">
                        <div class="eyebrow" style="margin-bottom:5px">{{ 'Assertions'|trans }}</div>
                        {% for a in r.assertionResults %}
                            <div class="mono" style="display:flex;align-items:flex-start;gap:7px;font-size:11.5px;line-height:1.7">
                                <span style="color:{{ a.ok ? 'var(--pass)' : 'var(--fail)' }};padding-top:3px">{{ ic.i(a.ok ? 'check' : 'x', 12, 2.8) }}</span>
                                <span>{{ a.label }}{% if not a.ok %} <span style="color:var(--muted)">— {{ 'got:'|trans }} {{ a.actual }}</span>{% endif %}</span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if r.shapeDrift is not empty %}
                    <div style="margin-top:11px;padding:9px 11px;border-radius:var(--r);background:var(--warn-soft);border:1px solid var(--warn)">
                        <div class="eyebrow" style="color:var(--warn);margin-bottom:4px">{{ 'Contract changed'|trans }}</div>
                        {% for c in r.shapeDrift %}
                            <div class="mono" style="font-size:11.5px;line-height:1.7">{{ c }}</div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if r.error and r.status != 'skipped' %}
                    <div class="flash error" style="margin:11px 0 0;font-family:var(--mono);font-size:11.5px;font-weight:400">{{ r.error }}</div>
                {% endif %}
            </div>
            {% endif %}
        </div>
    {% endfor %}

    <p class="fhint" style="margin-top:24px;padding-top:14px;border-top:1px solid var(--line)">
        {{ 'Generated with Signal'|trans }} · {% if run.shareExpiresAt %}{{ 'This report link is valid until %date%.'|trans({'%date%': run.shareExpiresAt|date('d.m.Y H:i')}) }}{% else %}{{ 'This report link does not expire.'|trans }}{% endif %}
    </p>
</main>
{% endblock %}
