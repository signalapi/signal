{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ 'Overview'|trans }} · {{ 'Super Admin'|trans }}{% endblock %}

{% block panel %}
<div class="hero">
    <div class="dots"></div>
    <h1>{{ 'Overview'|trans }}</h1>
    <p class="lead">{{ 'Platform-wide status: merchants, workspaces and users.'|trans }}</p>
    <div class="actions">
        <a class="btn" href="{{ path('admin_merchant_new') }}">{{ '+ New Merchant'|trans }}</a>
        <a class="btn ghost" href="{{ path('admin_merchant_index') }}">{{ 'Manage merchants'|trans }}</a>
    </div>
</div>

<div class="metric-grid">
    <a class="metric" href="{{ path('admin_merchant_index') }}">
        <div class="ic">🏢</div><div class="num">{{ merchant_count }}</div>
        <div class="cap"><span>Merchant</span><span class="go">→</span></div>
    </a>
    <div class="metric">
        <div class="ic">🧩</div><div class="num">{{ workspace_count }}</div>
        <div class="cap"><span>Workspace</span></div>
    </div>
    <div class="metric">
        <div class="ic">👤</div><div class="num">{{ user_count }}</div>
        <div class="cap"><span>{{ 'Users'|trans }}</span></div>
    </div>
</div>

<div class="section-title">{{ 'Recently added merchants'|trans }}</div>
{% if recent_merchants is empty %}
    <div class="empty">{{ 'No merchants yet.'|trans }}</div>
{% else %}
    <table class="data">
        <thead><tr><th>{{ 'Name'|trans }}</th><th>Slug</th><th>{{ 'Status'|trans }}</th><th>Workspace</th><th>{{ 'Created'|trans }}</th></tr></thead>
        <tbody>
        {% for m in recent_merchants %}
            <tr>
                <td>{{ m.name }}</td>
                <td><code>{{ m.slug }}</code></td>
                <td>{% if m.active %}<span class="pill on">{{ 'active'|trans }}</span>{% else %}<span class="pill off">{{ 'inactive'|trans }}</span>{% endif %}</td>
                <td>{{ m.workspaces|length }}</td>
                <td>{{ m.createdAt|date('d.m.Y H:i') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
