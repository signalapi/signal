{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ 'Merchants'|trans }} · {{ 'Super Admin'|trans }}{% endblock %}

{% block panel %}
<div class="toolbar">
    <div><h1>{{ 'Merchants'|trans }}</h1><p class="subtitle" style="margin:0;">{{ 'All merchant accounts.'|trans }}</p></div>
    <a class="btn" href="{{ path('admin_merchant_new') }}">{{ '+ New Merchant'|trans }}</a>
</div>

{% if merchants is empty %}
    <div class="empty">{{ 'No merchants yet. Create the first one.'|trans }}</div>
{% else %}
    <table>
        <thead><tr><th>{{ 'Name'|trans }}</th><th>Slug</th><th>{{ 'Admins'|trans }}</th><th>Workspace</th><th>{{ 'Status'|trans }}</th><th>{{ 'Created'|trans }}</th><th></th></tr></thead>
        <tbody>
        {% for m in merchants %}
            <tr>
                <td>{{ m.name }}</td>
                <td><code>{{ m.slug }}</code></td>
                <td>{{ m.members|length }}</td>
                <td>{{ m.workspaces|length }}</td>
                <td>{% if m.active %}<span class="pill on">{{ 'active'|trans }}</span>{% else %}<span class="pill off">{{ 'inactive'|trans }}</span>{% endif %}</td>
                <td>{{ m.createdAt|date('d.m.Y H:i') }}</td>
                <td style="text-align:right;white-space:nowrap;">
                    <form class="inline" method="post" action="{{ path('admin_merchant_toggle', {id: m.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ m.id) }}">
                        <button class="btn ghost small" type="submit">{{ m.active ? 'Deactivate'|trans : 'Activate'|trans }}</button>
                    </form>
                    <form class="inline" method="post" action="{{ path('admin_merchant_delete', {id: m.id}) }}" onsubmit="return confirm('{{ 'The merchant and all of its data will be deleted. Are you sure?'|trans|e('js') }}');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ m.id) }}">
                        <button class="btn danger" type="submit">{{ 'Delete'|trans }}</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
