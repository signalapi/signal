{% extends 'admin/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Merchants'|trans }} · {{ 'Super Admin'|trans }}{% endblock %}

{% block panel %}
<div class="pagehead">
    <div>
        <h1>{{ 'Merchants'|trans }}</h1>
        <p class="subtitle">{{ 'All merchant accounts.'|trans }}</p>
    </div>
    <div class="actions">
        <a class="btn" href="{{ path('admin_merchant_new') }}">{{ ic.i('plus', 13, 2.2) }}{{ 'New Merchant'|trans }}</a>
    </div>
</div>

{% if merchants is empty %}
    <div class="empty">{{ 'No merchants yet. Create the first one.'|trans }}</div>
{% else %}
    <table class="data">
        <thead><tr><th>{{ 'Name'|trans }}</th><th>Slug</th><th>{{ 'Admins'|trans }}</th><th>Workspace</th><th>{{ 'Status'|trans }}</th><th>{{ 'Created'|trans }}</th><th></th></tr></thead>
        <tbody>
        {% for m in merchants %}
            <tr>
                <td style="font-weight:600;">{{ m.name }}</td>
                <td><code class="mono">{{ m.slug }}</code></td>
                <td class="mono">{{ m.members|length }}</td>
                <td class="mono">{{ m.workspaces|length }}</td>
                <td>
                    {%- if m.active -%}
                        <span class="pill passed"><span class="dot passed"></span>{{ 'active'|trans }}</span>
                    {%- else -%}
                        <span class="pill">{{ 'inactive'|trans }}</span>
                    {%- endif -%}
                </td>
                <td class="mono" style="color:var(--muted);">{{ m.createdAt|date('d.m.Y H:i') }}</td>
                <td style="text-align:right;white-space:nowrap;">
                    <div style="display:inline-flex;gap:7px;justify-content:flex-end;">
                        <form method="post" action="{{ path('admin_merchant_toggle', {id: m.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ m.id) }}">
                            <button class="btn ghost small" type="submit">
                                {{ ic.i(m.active ? 'pause' : 'check', 12, 2.4) }}{{ m.active ? 'Deactivate'|trans : 'Activate'|trans }}</button>
                        </form>
                        <form method="post" action="{{ path('admin_merchant_delete', {id: m.id}) }}" onsubmit="return confirm('{{ 'The merchant and all of its data will be deleted. Are you sure?'|trans|e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ m.id) }}">
                            <button class="btn danger small" type="submit">{{ ic.i('trash', 12) }}{{ 'Delete'|trans }}</button>
                        </form>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
