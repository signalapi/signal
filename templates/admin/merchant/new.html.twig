{% extends 'admin/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'New Merchant'|trans }} · {{ 'Super Admin'|trans }}{% endblock %}

{% block panel %}
<a class="backlink" href="{{ path('admin_merchant_index') }}"><span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>{{ 'Merchants'|trans }}</a>
<div class="pagehead">
    <div>
        <h1>{{ 'New Merchant'|trans }}</h1>
        <p class="subtitle">{{ 'Create the merchant and its first admin (merchant admin) user.'|trans }}</p>
    </div>
</div>

<div class="formcard" style="max-width:520px;">
    {{ form_start(form) }}
        <div class="fgroup">
            <div class="field">
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
            </div>
        </div>
        <div class="fgroup">
            <div class="fgroup-title">{{ 'Admins'|trans }}</div>
            <div class="field">
                {{ form_label(form.adminName) }}
                {{ form_widget(form.adminName) }}
            </div>
            <div class="field">
                {{ form_label(form.adminEmail) }}
                {{ form_widget(form.adminEmail) }}
            </div>
            <div class="field">
                {{ form_label(form.adminPassword) }}
                {{ form_widget(form.adminPassword) }}
            </div>
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">{{ 'Create'|trans }}</button>
            <a class="btn ghost" href="{{ path('admin_merchant_index') }}">{{ 'Cancel'|trans }}</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
