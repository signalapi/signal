{% extends 'base.html.twig' %}

{% block body %}
<div class="layout">
    <aside class="sidebar">
        <div class="brand">🧪 API Test<small>{{ 'Super Admin'|trans }}</small></div>
        <nav class="nav">
            <a href="{{ path('admin_dashboard') }}" class="{{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' }}">{{ 'Overview'|trans }}</a>
            <a href="{{ path('admin_merchant_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_merchant' ? 'active' }}">{{ 'Merchants'|trans }}</a>
            <a href="{{ path('admin_catalog_index') }}" class="{{ app.request.attributes.get('_route') starts with 'admin_catalog' ? 'active' }}">{{ 'API Catalog'|trans }}</a>
        </nav>
        <div class="userbox">
            <div class="name">{{ app.user.name }}</div>
            <div>{{ app.user.email }}</div>
            <div style="margin-top:8px;"><a href="{{ path('admin_logout') }}">{{ 'Sign out'|trans }}</a></div>
        </div>
    </aside>
    <main class="content">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash {{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block panel %}{% endblock %}
    </main>
</div>
{% endblock %}
