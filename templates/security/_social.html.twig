{# ==========================================================================
   "Continue with …" buttons — rendered only when the provider's client id is
   configured (OAUTH_GOOGLE_CLIENT_ID / OAUTH_GITHUB_CLIENT_ID), so a bare
   self-hosted install shows a plain e-mail form and nothing else.
   Param: providers (list like ['google', 'github']).
   ========================================================================== #}
{% if providers is defined and providers is not empty %}
<div style="display:flex;align-items:center;gap:10px;margin:16px 0 14px;">
    <span style="flex:1;height:1px;background:var(--line);"></span>
    <span style="font-size:11px;color:var(--faint);">{{ 'or'|trans }}</span>
    <span style="flex:1;height:1px;background:var(--line);"></span>
</div>
<div style="display:flex;flex-direction:column;gap:8px;">
    {% if 'google' in providers %}
        <a class="btn ghost block" href="{{ path('oauth_start', {provider: 'google'}) }}" style="justify-content:center;gap:9px;">
            <svg width="15" height="15" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.5 12.3c0-.9-.1-1.5-.3-2.2H12v4.1h6.5c-.1 1.1-.8 2.7-2.4 3.8l3.7 2.9c2.3-2.1 3.7-5.1 3.7-8.6z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 7.9-2.9l-3.7-2.9c-1 .7-2.4 1.2-4.2 1.2-3.2 0-6-2.2-7-5.1l-3.9 3C3.1 21.2 7.2 24 12 24z"/><path fill="#FBBC05" d="M5 14.3c-.2-.7-.4-1.5-.4-2.3s.1-1.6.4-2.3l-3.9-3C.4 8.3 0 10.1 0 12s.4 3.7 1.1 5.3l3.9-3z"/><path fill="#EA4335" d="M12 4.7c1.8 0 3 .8 3.7 1.4l3.3-3.2C17.9 1.1 15.2 0 12 0 7.2 0 3.1 2.8 1.1 6.7l3.9 3c1-2.9 3.8-5 7-5z"/></svg>
            {{ 'Continue with Google'|trans }}</a>
    {% endif %}
    {% if 'github' in providers %}
        <a class="btn ghost block" href="{{ path('oauth_start', {provider: 'github'}) }}" style="justify-content:center;gap:9px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12c0 5.3 3.4 9.8 8.2 11.4.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6C20.6 21.8 24 17.3 24 12c0-6.6-5.4-12-12-12z"/></svg>
            {{ 'Continue with GitHub'|trans }}</a>
    {% endif %}
</div>
{% endif %}
