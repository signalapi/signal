{% extends 'security/_auth_base.html.twig' %}

{% block title %}Süper Admin Girişi · Signal: Test Platform{% endblock %}
{% block brand_title %}Platform yönetimi.{% endblock %}

{% block auth_card %}
    <p class="eyebrow">🛡️ Süper Admin</p>
    <h1>Yönetici girişi</h1>
    <p class="sub">Platform yönetim paneline erişin.</p>

    {% if error %}
        <div class="flash error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('admin_login') }}">
        <div class="field">
            <label for="username">E-posta</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>
        </div>
        <div class="field">
            <label for="password">Şifre</label>
            <input type="password" id="password" name="_password" required placeholder="••••••••">
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn-primary" type="submit">Admin girişi</button>
    </form>

    <p class="alt"><a href="{{ path('app_login') }}">← Merchant girişi</a></p>
{% endblock %}
