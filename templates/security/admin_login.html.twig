{% extends 'security/_auth_base.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Super Admin Sign-in'|trans }} · Signal: Test Platform{% endblock %}
{% block brand_title %}{{ 'Platform administration.'|trans }}{% endblock %}

{% block auth_card %}
    <div class="eyebrow" style="display:flex;align-items:center;gap:6px;margin-bottom:7px">
        {{ ic.i('shield', 12) }}{{ 'Super Admin'|trans }}</div>
    <h1>{{ 'Administrator sign-in'|trans }}</h1>
    <p class="subtitle" style="margin-bottom:20px">{{ 'Access the platform administration panel.'|trans }}</p>

    {% if error %}
        <div class="flash error">{{ ic.i('x', 14, 2.6) }}{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('admin_login') }}">
        <div class="field">
            <label for="username">{{ 'Email'|trans }}</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>
        </div>
        <div class="field">
            <label for="password">{{ 'Password'|trans }}</label>
            <input type="password" id="password" name="_password" required placeholder="••••••••">
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn block" type="submit" style="margin-top:4px">{{ 'Admin sign-in'|trans }}</button>
    </form>

    <p style="text-align:center;margin:16px 0 0">
        <a class="backlink" href="{{ path('app_login') }}"><span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>{{ 'Back to sign in'|trans }}</a>
    </p>
{% endblock %}
