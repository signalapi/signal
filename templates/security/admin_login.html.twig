{% extends 'security/_auth_base.html.twig' %}

{% block title %}{{ 'Super Admin Sign-in'|trans }} · Signal: Test Platform{% endblock %}
{% block brand_title %}{{ 'Platform administration.'|trans }}{% endblock %}

{% block auth_card %}
    <p class="eyebrow">🛡️ {{ 'Super Admin'|trans }}</p>
    <h1>{{ 'Administrator sign-in'|trans }}</h1>
    <p class="sub">{{ 'Access the platform administration panel.'|trans }}</p>

    {% if error %}
        <div class="flash error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('admin_login') }}">
        <div class="field">
            <label for="username">{{ 'Email'|trans }}</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>
        </div>
        <div class="field">
            <label for="password">{{ 'Password'|trans }}</label>
            <input type="password" id="password" name="_password" required placeholder="••••••••">
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn-primary" type="submit">{{ 'Admin sign-in'|trans }}</button>
    </form>

    <p class="alt"><a href="{{ path('app_login') }}">← {{ 'Merchant sign-in'|trans }}</a></p>
{% endblock %}
