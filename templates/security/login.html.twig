{% extends 'security/_auth_base.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Sign in'|trans }} · Signal: Test Platform{% endblock %}

{% block auth_card %}
    <div style="display:flex;align-items:center;gap:9px;margin-bottom:14px">
        <span style="display:flex;width:30px;height:30px;align-items:center;justify-content:center;border-radius:9px;background:linear-gradient(140deg,var(--pri),var(--vio));color:#fff">{{ ic.i('terminal', 15, 2.4) }}</span>
        <span class="no-caps" style="font-weight:800;font-size:15px;color:var(--ink);letter-spacing:-.03em">Signal</span>
    </div>
    <h1>{{ 'Welcome back'|trans }}</h1>
    <p class="subtitle" style="margin-bottom:20px">{{ 'Sign in to your workspace.'|trans }}</p>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash {{ label }}">{{ ic.i(label == 'success' ? 'check' : 'x', 14, 2.6) }}{{ message }}</div>
        {% endfor %}
    {% endfor %}
    {% if error %}
        <div class="flash error">{{ ic.i('x', 14, 2.6) }}{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <div class="field">
            <label for="username">{{ 'Email'|trans }}</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus placeholder="ad@sirket.com">
        </div>
        <div class="field">
            <label for="password">{{ 'Password'|trans }}</label>
            <input type="password" id="password" name="_password" required placeholder="••••••••">
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn block" type="submit" style="margin-top:4px">{{ 'Sign in'|trans }}</button>
        <p class="fhint" style="text-align:right;margin:8px 0 0"><a href="{{ path('app_forgot_password') }}">{{ 'Forgot password?'|trans }}</a></p>
    </form>

    {% include 'security/_social.html.twig' with {providers: social_providers|default([])} only %}

    <p class="fhint" style="text-align:center;margin-top:16px">{{ 'No account yet?'|trans }} <a href="{{ path('app_register') }}">{{ 'Sign up'|trans }}</a></p>
{% endblock %}
