{% extends 'security/_auth_base.html.twig' %}

{% block title %}Giriş · Signal: Test Platform{% endblock %}

{% block auth_card %}
    <p class="eyebrow">Merchant</p>
    <h1>Tekrar hoş geldiniz</h1>
    <p class="sub">Hesabınıza giriş yapın.</p>

    {% if error %}
        <div class="flash error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <div class="field">
            <label for="username">E-posta</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus placeholder="ad@sirket.com">
        </div>
        <div class="field">
            <label for="password">Şifre</label>
            <input type="password" id="password" name="_password" required placeholder="••••••••">
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn-primary" type="submit">Giriş yap</button>
    </form>

    <p class="alt">Hesabınız yok mu? <a href="{{ path('app_register') }}">Kayıt olun</a></p>
{% endblock %}
