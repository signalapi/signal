{% extends 'security/_auth_base.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Sign Up'|trans }} · Signal: Test Platform{% endblock %}
{% block brand_title %}{{ 'Start testing in minutes.'|trans }}{% endblock %}

{% block auth_card %}
    <div class="eyebrow" style="margin-bottom:7px">{{ 'Sign up'|trans }}</div>
    <h1>{{ 'Create an account'|trans }}</h1>
    <p class="subtitle" style="margin-bottom:20px">{{ 'Start on your own — you can invite your team whenever you want.'|trans }}</p>

    {% for error in errors %}
        <div class="flash error">{{ ic.i('x', 14, 2.6) }}{{ error }}</div>
    {% endfor %}

    <form method="post" action="{{ path('app_register') }}">
        <div class="field">
            <label for="name">{{ 'Full name'|trans }}</label>
            <input type="text" id="name" name="name" value="{{ old.name }}" required autofocus placeholder="Ada Lovelace">
        </div>
        <div class="field">
            <label for="email">{{ 'Email'|trans }}</label>
            <input type="email" id="email" name="email" value="{{ old.email }}" required placeholder="ad@sirket.com">
        </div>
        <div class="grid2" style="gap:11px">
            <div class="field">
                <label for="password">{{ 'Password'|trans }}</label>
                <input type="password" id="password" name="password" required placeholder="{{ 'At least 8 characters'|trans }}">
            </div>
            <div class="field">
                <label for="password_confirm">{{ 'Password (again)'|trans }}</label>
                <input type="password" id="password_confirm" name="password_confirm" required placeholder="••••••••">
            </div>
        </div>
        <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
        <button class="btn block" type="submit" style="margin-top:4px">{{ 'Create account'|trans }}</button>
    </form>

    <p class="fhint" style="text-align:center;margin-top:16px">{{ 'Already have an account?'|trans }} <a href="{{ path('app_login') }}">{{ 'Sign In'|trans }}</a></p>
{% endblock %}
