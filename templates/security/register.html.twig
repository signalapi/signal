{% extends 'security/_auth_base.html.twig' %}

{% block title %}Kayıt Ol · Signal: Test Platform{% endblock %}
{% block brand_title %}Dakikalar içinde test etmeye başlayın.{% endblock %}

{% block auth_card %}
    <p class="eyebrow">Merchant kaydı</p>
    <h1>Hesap oluşturun</h1>
    <p class="sub">Şirketinizi ve ilk yöneticinizi oluşturun.</p>

    {% for error in errors %}
        <div class="flash error">{{ error }}</div>
    {% endfor %}

    <form method="post" action="{{ path('app_register') }}">
        <div class="field">
            <label for="merchant">Şirket / Merchant adı</label>
            <input type="text" id="merchant" name="merchant" value="{{ old.merchant }}" required autofocus placeholder="Acme Ltd.">
        </div>
        <div class="field">
            <label for="name">Ad Soyad</label>
            <input type="text" id="name" name="name" value="{{ old.name }}" required placeholder="Ada Lovelace">
        </div>
        <div class="field">
            <label for="email">E-posta</label>
            <input type="email" id="email" name="email" value="{{ old.email }}" required placeholder="ad@sirket.com">
        </div>
        <div class="row2">
            <div class="field">
                <label for="password">Şifre</label>
                <input type="password" id="password" name="password" required placeholder="En az 8 karakter">
            </div>
            <div class="field">
                <label for="password_confirm">Şifre (tekrar)</label>
                <input type="password" id="password_confirm" name="password_confirm" required placeholder="••••••••">
            </div>
        </div>
        <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
        <button class="btn-primary" type="submit">Hesap oluştur</button>
    </form>

    <p class="alt">Zaten hesabınız var mı? <a href="{{ path('app_login') }}">Giriş yapın</a></p>
{% endblock %}
