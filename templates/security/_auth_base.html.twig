{# ==========================================================================
   templates/security/_auth_base.html.twig  —  the shell every auth page uses.
   Uses the .auth / .auth-form / .auth-side primitives from signal.css, so the
   page carries no inline stylesheet of its own. The brand panel is the inverted
   surface (var(--ink) ground, var(--bg) type): it stays dark in the light theme
   and flips with the theme, which keeps contrast correct in both.
   ========================================================================== #}
{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block body %}
<div class="auth">
    <div class="auth-form">
        <div class="inner stagger">
            {% block auth_card %}{% endblock %}

            <p class="fhint" style="text-align:center;margin-top:22px">
                <a href="{{ path('app_locale_switch', {locale: 'en'}) }}" {% if app.request.locale == 'en' %}style="font-weight:700"{% endif %}>English</a>
                ·
                <a href="{{ path('app_locale_switch', {locale: 'tr'}) }}" {% if app.request.locale == 'tr' %}style="font-weight:700"{% endif %}>Türkçe</a>
            </p>
        </div>
    </div>

    <aside class="auth-side" style="background:var(--ink);color:var(--bg);gap:18px">
        <div style="display:flex;align-items:center;gap:9px">
            <span class="brand-mark">{{ ic.i('terminal', 15, 2.4) }}</span>
            <span style="font-size:14px;font-weight:700;letter-spacing:-.02em">Signal: Test Platform</span>
        </div>

        {# the runline signature, rendered with the .strip status vocabulary #}
        <span class="strip" style="gap:0">
            <i class="passed" style="width:10px;height:10px;border-radius:50%"></i>
            <i style="width:30px;height:2px;background:var(--pass)"></i>
            <i class="passed" style="width:10px;height:10px;border-radius:50%"></i>
            <i style="width:30px;height:2px;background:var(--pass)"></i>
            <i class="running" style="width:10px;height:10px;border-radius:50%"></i>
            <i style="width:30px;height:2px"></i>
            <i style="width:10px;height:10px;border-radius:50%"></i>
        </span>

        <h2 style="color:var(--bg);font-size:22px;line-height:1.32;max-width:24ch;margin:0">
            {% block brand_title %}{{ 'Test your APIs, verify the result from the database.'|trans }}{% endblock %}
        </h2>
        <p style="margin:0;max-width:46ch;font-size:13px;line-height:1.65;color:var(--bg);opacity:.7">
            {{ 'Import your Postman collections, build chained test flows, verify on PostgreSQL · MySQL · Redis · MongoDB — all in one place.'|trans }}
        </p>

        <ul style="list-style:none;margin:4px 0 0;padding:0;display:grid;gap:11px">
            <li style="display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--bg);opacity:.92">
                <span class="status-ic passed">{{ ic.i('check', 12, 2.8) }}</span>
                {{ 'Postman-compatible collection & environment import'|trans }}</li>
            <li style="display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--bg);opacity:.92">
                <span class="status-ic passed">{{ ic.i('check', 12, 2.8) }}</span>
                {{ 'Chained test flows + live DB verification'|trans }}</li>
            <li style="display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--bg);opacity:.92">
                <span class="status-ic passed">{{ ic.i('check', 12, 2.8) }}</span>
                {{ 'CI/cron triggering and Claude (MCP) integration'|trans }}</li>
        </ul>

        <div class="foot" style="text-transform:none;letter-spacing:0">© Signal: Test Platform</div>
    </aside>
</div>
{% endblock %}
