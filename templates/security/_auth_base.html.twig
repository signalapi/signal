{# ==========================================================================
   templates/security/_auth_base.html.twig  —  the shell every auth page uses.
   Uses the .auth / .auth-form / .auth-side primitives from signal.css, so the
   page carries no inline stylesheet of its own. The brand panel is the inverted
   surface (var(--ink) ground, var(--bg) type): it stays dark in the light theme
   and flips with the theme, which keeps contrast correct in both.
   ========================================================================== #}
{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block body %}
<div class="auth">
    <div class="auth-form">
        <div class="inner stagger">
            {% block auth_card %}{% endblock %}

            <p class="fhint" style="text-align:center;margin-top:22px">
                <a href="{{ path('app_locale_switch', {locale: 'en'}) }}" {% if app.request.locale == 'en' %}style="font-weight:700"{% endif %}>English</a>
                ·
                <a href="{{ path('app_locale_switch', {locale: 'tr'}) }}" {% if app.request.locale == 'tr' %}style="font-weight:700"{% endif %}>Türkçe</a>
            </p>
        </div>
    </div>

    {# the final design's brand panel: light ground, a "LIVE NOW" claim and a
       floating card of demo flow runs — the product, not a feature list #}
    <aside class="auth-side" style="background:var(--bg);gap:16px;justify-content:center">
        <div class="eyebrow">{{ 'Live now'|trans }}</div>
        <h2 style="color:var(--ink);font-size:24px;line-height:1.28;letter-spacing:-.03em;max-width:26ch;margin:0;font-weight:800">
            {% block brand_title %}{{ 'Every deploy verified end to end — request, chain, database. Not just a 200.'|trans }}{% endblock %}
        </h2>

        <div class="list-card" style="max-width:420px;box-shadow:var(--sh-lg);margin:6px 0 0">
            {% for d in [
                ['fail', 'Signup → subscription verify', ['p','p','p','p','f','p','f'], '3.1 s'],
                ['pass', 'Card payment → ledger row',    ['p','p','p','p','p','p','p'], '4.6 s'],
                ['pass', '3DS challenge → webhook',      ['p','p','p','p','p','p','p'], '2.2 s'],
                ['pri',  'Refund → balance + Redis',     ['p','p','p','p','p','r','r'], '—'],
            ] %}
                <div class="lrow" style="padding:10px 14px">
                    <span class="dot {{ d[0] == 'fail' ? 'failed' : (d[0] == 'pri' ? 'running' : 'passed') }}"></span>
                    <span style="flex:1;min-width:0;font-size:12.5px;font-weight:600;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ d[1] }}</span>
                    <span class="strip" style="gap:2.5px">
                        {% for s in d[2] %}<i class="{{ s == 'p' ? 'passed' : (s == 'f' ? 'failed' : 'running') }}" style="width:6px;height:6px;border-radius:50%"></i>{% endfor %}
                    </span>
                    <span class="l-meta" style="flex:0 0 34px;text-align:right">{{ d[3] }}</span>
                </div>
            {% endfor %}
        </div>

        <div class="foot" style="text-transform:none;letter-spacing:0;color:var(--faint)">© Signal: Test Platform</div>
    </aside>
</div>
{% endblock %}
