{# Workbench shell: an icon-only rail so the editor gets the full width. #}
{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block body %}
{% set ws = workspace %}
{% set route = app.request.attributes.get('_route') %}
<div class="wb">
    <nav class="wb-rail">
        <a href="{{ path('app_workspace_show', {id: ws.id}) }}" class="brand-mark" title="Signal">{{ ic.i('terminal', 15, 2.4) }}</a>
        <a href="{{ path('app_workspace_show', {id: ws.id}) }}" class="icon-btn" title="{{ 'Overview'|trans }}">{{ ic.i('overview') }}</a>
        <a href="{{ path('app_collection_index', {workspace: ws.id}) }}" class="icon-btn on" title="{{ 'Collections'|trans }}">{{ ic.i('collections') }}</a>
        <a href="{{ path('app_environment_index', {workspace: ws.id}) }}" class="icon-btn" title="{{ 'Environments'|trans }}">{{ ic.i('environments') }}</a>
        <a href="{{ path('app_flow_index', {workspace: ws.id}) }}" class="icon-btn" title="{{ 'Tests'|trans }}">{{ ic.i('flows') }}</a>
        <a href="{{ path('app_trends', {workspace: ws.id}) }}" class="icon-btn" title="{{ 'Trends'|trans }}">{{ ic.i('trends') }}</a>
        <a href="{{ path('app_dbconn_index', {workspace: ws.id}) }}" class="icon-btn" title="{{ 'DB connections'|trans }}">{{ ic.i('db') }}</a>
        <a href="{{ path('app_apitoken_index', {workspace: ws.id}) }}" class="icon-btn" title="API &amp; MCP">{{ ic.i('token') }}</a>
        <a href="{{ path('app_cookie_index', {workspace: ws.id}) }}" class="icon-btn" title="{{ 'Cookies'|trans }}">{{ ic.i('cookie') }}</a>
        <div class="grow"></div>
        <button class="icon-btn" data-theme-toggle title="{{ 'Theme'|trans }}" aria-label="{{ 'Theme'|trans }}">{{ ic.i('moon', 14) }}</button>
        <a href="{{ path('app_logout') }}" class="icon-btn" title="{{ 'Sign out'|trans }}">{{ ic.i('x') }}</a>
    </nav>
    {% block workbench %}{% endblock %}
</div>
{% endblock %}
