{% extends 'app/_layout.html.twig' %}

{% block title %}{{ 'Profile'|trans }} · {{ app.user.name }}{% endblock %}

{% block panel %}
<div class="pagehead">
    <div>
        <h1>{{ 'Profile'|trans }}</h1>
        <p class="subtitle">{{ app.user.email }}</p>
    </div>
</div>

<div class="grid2" style="align-items:start;">
    <form class="formcard" method="post" action="{{ path('app_profile_name') }}">
        <div class="fgroup">
            <div class="fgroup-title">{{ 'Account details'|trans }}</div>
            <div class="field">
                <label>{{ 'Full name'|trans }}</label>
                <input type="text" name="name" value="{{ app.user.name }}" required>
            </div>
            <div class="field">
                <label>{{ 'Email'|trans }}</label>
                <input type="email" value="{{ app.user.email }}" disabled style="opacity:.6;">
            </div>
        </div>
        <input type="hidden" name="_token" value="{{ csrf_token('profile-name') }}">
        <div class="form-actions">
            <button class="btn small" type="submit">{{ 'Save'|trans }}</button>
        </div>
    </form>

    <form class="formcard" method="post" action="{{ path('app_profile_password') }}">
        <div class="fgroup">
            <div class="fgroup-title">{{ 'Change password'|trans }}</div>
            <div class="field">
                <label>{{ 'Current password'|trans }}</label>
                <input type="password" name="current_password" required>
            </div>
            <div class="grid2">
                <div class="field">
                    <label>{{ 'New password'|trans }}</label>
                    <input type="password" name="new_password" required placeholder="{{ 'At least 8 characters'|trans }}">
                </div>
                <div class="field">
                    <label>{{ 'New password (again)'|trans }}</label>
                    <input type="password" name="new_password_confirm" required>
                </div>
            </div>
        </div>
        <input type="hidden" name="_token" value="{{ csrf_token('profile-password') }}">
        <div class="form-actions">
            <button class="btn small" type="submit">{{ 'Update password'|trans }}</button>
        </div>
    </form>
</div>

<div class="eyebrow" style="margin:24px 0 10px;">{{ 'Memberships'|trans }}</div>
<table class="data">
    <thead><tr><th>Merchant</th><th>{{ 'Role'|trans }}</th><th>{{ 'Joined'|trans }}</th></tr></thead>
    <tbody>
    {% for m in memberships %}
        <tr>
            <td style="font-weight:600;">{{ m.merchant.name }}</td>
            <td><span class="pill {{ m.canManage ? 'running' }}">{{ {'owner': 'Owner'|trans, 'admin': 'Company Admin'|trans, 'member': 'Member'|trans}[m.role] ?? m.role }}</span></td>
            <td class="mono" style="color:var(--muted);">{{ m.createdAt|date('d.m.Y') }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
