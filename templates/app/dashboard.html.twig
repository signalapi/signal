{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Welcome'|trans }} · {{ merchant.name }}{% endblock %}

{% block panel %}
<div class="hero">
    <div class="dots"></div>
    <h1>{{ 'Welcome, %name%'|trans({'%name%': app.user.name}) }}</h1>
    {% if is_granted('MERCHANT_MANAGE_WORKSPACES', merchant) %}
        <p class="lead">{{ merchant.name }} · {{ 'Create your first workspace to get started. Collections, environments and test flows live inside a workspace.'|trans }}</p>
        <div class="actions">
            <a class="btn" href="{{ path('app_workspace_new') }}">{{ '+ Create First Workspace'|trans }}</a>
        </div>
    {% else %}
        <p class="lead">{{ merchant.name }} · {{ "You don't have access to any workspace yet. A workspace admin or a company admin needs to add you."|trans }}</p>
    {% endif %}
</div>

<div class="quick-grid stagger">
    <div class="quick"><div class="ic">{{ ic.i('import', 15) }}</div><div><div class="t">Postman import</div><div class="s">Collection & environment</div></div></div>
    <div class="quick"><div class="ic">{{ ic.i('git', 15) }}</div><div><div class="t">{{ 'Chained tests'|trans }}</div><div class="s">{{ 'Chain steps together'|trans }}</div></div></div>
    <div class="quick"><div class="ic">{{ ic.i('db', 15) }}</div><div><div class="t">{{ 'DB validation'|trans }}</div><div class="s">Postgres · MySQL · Redis · Mongo</div></div></div>
</div>
{% endblock %}
