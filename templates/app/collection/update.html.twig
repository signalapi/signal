{% extends 'app/_layout.html.twig' %}

{% block title %}{{ 'Update'|trans }} · {{ collection.name }}{% endblock %}

{% macro reqline(r) %}
    <code style="font-size:12px;"><strong>{{ r.method }}</strong> {{ r.url }}</code>
{% endmacro %}

{% block panel %}
<a class="backlink" href="{{ path('app_collection_show', {workspace: workspace.id, collection: collection.id}) }}">← {{ collection.name }}</a>
<div class="pagehead">
    <div>
        <h1>{{ 'Catalog update'|trans }}</h1>
        <p class="subtitle">
            {%- if target -%}
                {{ current.catalogApi.name }} · <span class="pill">{{ current.label }}</span> → <span class="pill on">{{ target.label }}</span>
                {% if target.changelog %} · {{ target.changelog }}{% endif %}
            {%- else -%}
                {{ 'Source'|trans }}: <span class="pill">{{ sourceCollection.name }}</span> · {{ sourceCollection.workspace.name }}
            {%- endif -%}
            {% if plan.unchanged > 0 %} · {{ '%count% endpoints unchanged'|trans({'%count%': plan.unchanged}) }}{% endif %}
        </p>
    </div>
</div>

{% if plan.isEmpty %}
    <div class="empty" style="text-align:left;padding:24px;">{{ 'No content differences — the version label will be advanced.'|trans }}</div>
{% endif %}

<form method="post" action="{{ path('app_collection_update_apply', {workspace: workspace.id, collection: collection.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('collection-update' ~ collection.id) }}">

    {% if plan.added is not empty %}
        <div class="card" style="margin-bottom:14px;">
            <div class="subtitle" style="margin:0 0 10px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;">{{ 'New endpoints'|trans }} ({{ plan.added|length }})</div>
            {% for item in plan.added %}
                <label style="display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--border);">
                    <input type="checkbox" name="add[]" value="{{ item.request.originKey }}" checked>
                    <span style="flex:1;">{{ item.request.name }}{% if item.tag %} <span class="pill">{{ item.tag }}</span>{% endif %}<br>{{ _self.reqline(item.request) }}</span>
                </label>
            {% endfor %}
        </div>
    {% endif %}

    {% if plan.autoApply is not empty %}
        <div class="card" style="margin-bottom:14px;">
            <div class="subtitle" style="margin:0 0 10px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;">{{ 'Changed upstream — no local changes on your side'|trans }} ({{ plan.autoApply|length }})</div>
            {% for pair in plan.autoApply %}
                <div style="display:flex;gap:12px;align-items:center;padding:6px 0;border-bottom:1px solid var(--border);">
                    <span style="flex:1;">{{ pair.existing.name }}<br>{{ _self.reqline(pair.existing) }}<br><span class="subtitle" style="font-size:11px;">{{ 'new:'|trans }}</span> {{ _self.reqline(pair.incoming) }}</span>
                    <select name="change[{{ pair.existing.originKey }}]">
                        <option value="apply" selected>{{ 'Apply update'|trans }}</option>
                        <option value="keep">{{ 'Keep mine'|trans }}</option>
                    </select>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if plan.conflicts is not empty %}
        <div class="card" style="margin-bottom:14px;border-color:var(--accent);">
            <div class="subtitle" style="margin:0 0 10px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;">⚠ {{ 'Conflict — both you and upstream changed it'|trans }} ({{ plan.conflicts|length }})</div>
            {% for pair in plan.conflicts %}
                <div style="display:flex;gap:12px;align-items:center;padding:6px 0;border-bottom:1px solid var(--border);">
                    <span style="flex:1;">{{ pair.existing.name }}<br><span class="subtitle" style="font-size:11px;">{{ 'yours:'|trans }}</span> {{ _self.reqline(pair.existing) }}<br><span class="subtitle" style="font-size:11px;">{{ 'upstream:'|trans }}</span> {{ _self.reqline(pair.incoming) }}</span>
                    <select name="change[{{ pair.existing.originKey }}]">
                        <option value="keep" selected>{{ 'Keep mine'|trans }}</option>
                        <option value="apply">{{ 'Take upstream (local changes will be lost)'|trans }}</option>
                    </select>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if plan.removed is not empty %}
        <div class="card" style="margin-bottom:14px;">
            <div class="subtitle" style="margin:0 0 10px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;">{{ 'Removed from upstream'|trans }} ({{ plan.removed|length }})</div>
            <p class="subtitle" style="margin:0 0 8px;font-size:12px;">{{ 'Nothing is deleted — flow steps may depend on these requests. Checked items get a "deprecated" badge.'|trans }}</p>
            {% for r in plan.removed %}
                <label style="display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--border);">
                    <input type="checkbox" name="deprecate[]" value="{{ r.originKey }}" checked>
                    <span style="flex:1;">{{ r.name }}<br>{{ _self.reqline(r) }}</span>
                </label>
            {% endfor %}
        </div>
    {% endif %}

    <div class="form-actions">
        <button class="btn" type="submit">{{ target ? 'Apply update'|trans ~ ' → ' ~ target.label : 'Pull from source'|trans }}</button>
        <a class="btn ghost" href="{{ path('app_collection_show', {workspace: workspace.id, collection: collection.id}) }}">{{ 'Cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
