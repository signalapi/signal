{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Update'|trans }} · {{ collection.name }}{% endblock %}

{% macro reqline(r) %}
    <code class="mono" style="font-size:11px;color:var(--muted);"><strong style="color:var(--ink);">{{ r.method }}</strong> {{ r.url }}</code>
{% endmacro %}

{% block panel %}
<a class="backlink" href="{{ path('app_collection_show', {workspace: workspace.id, collection: collection.id}) }}"><span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>{{ collection.name }}</a>
<div class="pagehead">
    <div>
        <h1>{{ 'Catalog update'|trans }}</h1>
        <p class="subtitle">
            {%- if target -%}
                {{ current.catalogApi.name }} · <span class="pill">{{ current.label }}</span> → <span class="pill" style="background:var(--pri-soft);color:var(--pri);">{{ target.label }}</span>
                {% if target.changelog %} · {{ target.changelog }}{% endif %}
            {%- else -%}
                {{ 'Source'|trans }}: <span class="pill">{{ sourceCollection.name }}</span> · {{ sourceCollection.workspace.name }}
            {%- endif -%}
            {% if plan.unchanged > 0 %} · {{ '%count% endpoints unchanged'|trans({'%count%': plan.unchanged}) }}{% endif %}
        </p>
    </div>
</div>

{% if plan.isEmpty %}
    <div class="empty">{{ 'No content differences — the version label will be advanced.'|trans }}</div>
{% endif %}

<form method="post" action="{{ path('app_collection_update_apply', {workspace: workspace.id, collection: collection.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('collection-update' ~ collection.id) }}">

    {% if plan.added is not empty %}
        <div class="card" style="margin-bottom:14px;">
            <div class="card-head">
                <span style="color:var(--pass);">{{ ic.i('plus', 14, 2.2) }}</span>
                <span class="t">{{ 'New endpoints'|trans }}</span>
                <span class="pill">{{ plan.added|length }}</span>
            </div>
            <div class="card-body" style="padding-top:4px;padding-bottom:4px;">
                {% for item in plan.added %}
                    <label style="display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:1px solid var(--line2);">
                        <input type="checkbox" name="add[]" value="{{ item.request.originKey }}" checked style="margin:3px 0 0;">
                        <span class="grow">
                            <span style="font-size:12.5px;font-weight:600;color:var(--ink);">{{ item.request.name }}</span>
                            {% if item.tag %} <span class="pill">{{ item.tag }}</span>{% endif %}
                            <br>{{ _self.reqline(item.request) }}
                        </span>
                    </label>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if plan.autoApply is not empty %}
        <div class="card" style="margin-bottom:14px;">
            <div class="card-head">
                <span style="color:var(--pri);">{{ ic.i('rerun', 14) }}</span>
                <span class="t">{{ 'Changed upstream — no local changes on your side'|trans }}</span>
                <span class="pill">{{ plan.autoApply|length }}</span>
            </div>
            <div class="card-body" style="padding-top:4px;padding-bottom:4px;">
                {% for pair in plan.autoApply %}
                    <div style="display:flex;gap:12px;align-items:center;padding:9px 0;border-bottom:1px solid var(--line2);">
                        <span class="grow">
                            <span style="font-size:12.5px;font-weight:600;color:var(--ink);">{{ pair.existing.name }}</span>
                            <br>{{ _self.reqline(pair.existing) }}
                            <br><span class="eyebrow">{{ 'new:'|trans }}</span> {{ _self.reqline(pair.incoming) }}
                        </span>
                        <select name="change[{{ pair.existing.originKey }}]" style="width:auto;flex-shrink:0;">
                            <option value="apply" selected>{{ 'Apply update'|trans }}</option>
                            <option value="keep">{{ 'Keep mine'|trans }}</option>
                        </select>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if plan.conflicts is not empty %}
        <div class="card" style="margin-bottom:14px;border-color:var(--warn);">
            <div class="card-head">
                <span style="color:var(--warn);">{{ ic.i('git', 14) }}</span>
                <span class="t">{{ 'Conflict — both you and upstream changed it'|trans }}</span>
                <span class="pill" style="background:var(--warn-soft);color:var(--warn);">{{ plan.conflicts|length }}</span>
            </div>
            <div class="card-body" style="padding-top:4px;padding-bottom:4px;">
                {% for pair in plan.conflicts %}
                    <div style="display:flex;gap:12px;align-items:center;padding:9px 0;border-bottom:1px solid var(--line2);">
                        <span class="grow">
                            <span style="font-size:12.5px;font-weight:600;color:var(--ink);">{{ pair.existing.name }}</span>
                            <br><span class="eyebrow">{{ 'yours:'|trans }}</span> {{ _self.reqline(pair.existing) }}
                            <br><span class="eyebrow">{{ 'upstream:'|trans }}</span> {{ _self.reqline(pair.incoming) }}
                        </span>
                        <select name="change[{{ pair.existing.originKey }}]" style="width:auto;flex-shrink:0;">
                            <option value="keep" selected>{{ 'Keep mine'|trans }}</option>
                            <option value="apply">{{ 'Take upstream (local changes will be lost)'|trans }}</option>
                        </select>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if plan.removed is not empty %}
        <div class="card" style="margin-bottom:14px;">
            <div class="card-head">
                <span style="color:var(--fail);">{{ ic.i('trash', 14) }}</span>
                <span class="t">{{ 'Removed from upstream'|trans }}</span>
                <span class="pill">{{ plan.removed|length }}</span>
            </div>
            <div class="card-body" style="padding-top:4px;padding-bottom:4px;">
                <p class="fhint" style="margin:0 0 6px;">{{ 'Nothing is deleted — flow steps may depend on these requests. Checked items get a "deprecated" badge.'|trans }}</p>
                {% for r in plan.removed %}
                    <label style="display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:1px solid var(--line2);">
                        <input type="checkbox" name="deprecate[]" value="{{ r.originKey }}" checked style="margin:3px 0 0;">
                        <span class="grow">
                            <span style="font-size:12.5px;font-weight:600;color:var(--ink);">{{ r.name }}</span>
                            <br>{{ _self.reqline(r) }}
                        </span>
                    </label>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="form-actions">
        <button class="btn" type="submit">{{ target ? 'Apply update'|trans ~ ' → ' ~ target.label : 'Pull from source'|trans }}</button>
        <a class="btn ghost" href="{{ path('app_collection_show', {workspace: workspace.id, collection: collection.id}) }}">{{ 'Cancel'|trans }}</a>
    </div>
</form>
{% endblock %}
