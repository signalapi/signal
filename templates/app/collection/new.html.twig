{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'New collection'|trans }}{% endblock %}

{% block panel %}
<a class="backlink" href="{{ path('app_collection_index', {workspace: workspace.id}) }}"><span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>{{ 'Collections'|trans }}</a>
<div class="pagehead">
    <div>
        <h1>{{ 'New collection'|trans }}</h1>
        <p class="subtitle">{{ workspace.name }}</p>
    </div>
</div>

<div class="formcard" style="max-width:560px;">
    {{ form_start(form) }}
        <div class="field">{{ form_label(form.name) }}{{ form_widget(form.name) }}</div>
        <div class="field">{{ form_label(form.description) }}{{ form_widget(form.description, {'attr': {'rows': 3}}) }}</div>
        <div class="form-actions">
            <button class="btn" type="submit">{{ 'Create'|trans }} →</button>
            <a class="btn ghost" href="{{ path('app_collection_index', {workspace: workspace.id}) }}">{{ 'Cancel'|trans }}</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
