{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ collection.name }} · Workbench{% endblock %}

{% macro tree_request(r) %}
    <div class="tree-req" draggable="true" data-id="{{ r.id }}">
        <span class="meth m-{{ r.method|lower }}">{{ r.method }}</span>
        <span class="t-name">{{ r.name }}</span>
    </div>
    <div class="ex-list" data-ex-for="{{ r.id }}">
        {% for ex in r.examples %}
            <div class="ex-row" data-ex-id="{{ ex.id }}" title="{{ ex.name }}">
                <span class="ex-ic {{ ex.success ? 'ok' : (ex.statusCode ? 'bad' : 'na') }}">e.g.</span>
                <span class="ex-name">{{ ex.name }}</span>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{% macro tree_folder(f) %}
    {% import _self as t %}
    {% import '_icons.html.twig' as ic %}
    <div class="tree-folder" data-folder-id="{{ f.id }}">
        <div class="lbl"><span class="chev">▾</span>{{ ic.i('folder', 14) }}<span class="fname">{{ f.name }}</span></div>
        <div class="folder-body" data-folder-id="{{ f.id }}">
            {% for child in f.children %}{{ t.tree_folder(child) }}{% endfor %}
            {% for r in f.requests %}{{ t.tree_request(r) }}{% endfor %}
        </div>
    </div>
{% endmacro %}

{% block content_class %}flush{% endblock %}

{% block panel %}
{% import _self as t %}
<style>
    /* Workbench-only shell. Anything with a signal.css primitive uses the primitive;
       what is left here is the request bench itself: tree column, url bar, the
       highlighted body editor and the response pane. */
    .wb-tree { width: 246px; border-right: 1px solid var(--line); background: var(--panel); display: flex; flex-direction: column; overflow: hidden; }
    .wb-tree-head { padding: 11px 12px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .wb-tree-head .nm { font-weight: 700; font-size: 12.5px; flex: 1; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wb-search { padding: 9px 11px; border-bottom: 1px solid var(--line); }
    .wb-tree-body { flex: 1; overflow: auto; padding: 7px 7px 20px; }
    .wb-search input { width: 100%; background: var(--panel2); border: 1px solid var(--line);
        border-radius: 9px; padding: 7px 9px; color: var(--text); font-family: inherit; font-size: 12px; }
    .wb-tree-head .add { width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;
        border: 1px solid var(--line); background: var(--panel2); border-radius: 7px; cursor: pointer;
        color: var(--muted); flex-shrink: 0; }
    .wb-tree-head .add:hover { color: var(--pri); border-color: var(--pri); }

    .tree-req { display: flex; gap: 7px; align-items: center; padding: 6px 8px; border-radius: 8px; cursor: pointer;
        font-size: 12px; font-weight: 500; color: var(--text); position: relative; }
    .tree-req:hover { background: var(--panel2); }
    .tree-req.active { background: var(--pri-soft); color: var(--pri); font-weight: 700; }
    .tree-req.active .t-name { color: var(--pri); }
    .tree-req.active::before { content: ""; position: absolute; left: -8px; top: 6px; bottom: 6px; width: 3px; border-radius: 0 3px 3px 0; background: var(--pri); }
    .tree-req.dragging { opacity: .4; }
    .tree-req.hide, .tree-folder.hide, .ex-list.hide { display: none; }
    /* the design writes the method as bare coloured mono text, not a badge */
    .meth { font-family: var(--mono); font-size: 9px; font-weight: 800; min-width: 34px; flex-shrink: 0; }
    .m-get { color: var(--pass); } .m-post { color: var(--warn); } .m-put { color: var(--pri); }
    .m-patch { color: var(--vio); } .m-delete { color: var(--fail); }
    .m-head, .m-options { color: var(--muted); }
    .t-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* Saved example responses, nested under their request (Postman-style) */
    .ex-list { margin: 0 0 2px 18px; border-left: 1px solid var(--line); padding-left: 4px; }
    .ex-list:empty { display: none; }
    .ex-row { display: flex; align-items: center; gap: 7px; padding: 4px 8px; border-radius: 7px; cursor: pointer; font-size: 12px; color: var(--muted); }
    .ex-row:hover { background: var(--panel2); color: var(--text); }
    .ex-row.active { background: var(--pri-soft); color: var(--pri); }
    .ex-ic { font-family: var(--mono); font-size: 8px; font-weight: 700; letter-spacing: .02em; padding: 2px 4px; border-radius: 4px; flex-shrink: 0;
        background: var(--panel2); color: var(--muted); border: 1px solid var(--line); }
    .ex-ic.ok { color: var(--pass); border-color: color-mix(in srgb, var(--pass) 40%, transparent); }
    .ex-ic.bad { color: var(--fail); border-color: color-mix(in srgb, var(--fail) 40%, transparent); }
    .ex-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .tree-folder > .lbl { display: flex; align-items: center; gap: 7px; font-weight: 700; font-size: 12px; padding: 6px 8px; color: var(--ink); cursor: pointer; border-radius: 8px; user-select: none; }
    .tree-folder > .lbl:hover { background: var(--panel2); }
    .tree-folder > .lbl .chev { font-size: 10px; color: var(--muted); transition: transform .15s; width: 10px; text-align: center; }
    .tree-folder > .lbl .ic { color: var(--faint); }
    .tree-folder > .lbl .fname { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tree-folder.collapsed > .lbl .chev { transform: rotate(-90deg); }
    .tree-folder.collapsed > .folder-body { display: none; }
    .folder-body { margin-left: 13px; border-left: 1px solid var(--line); padding-left: 6px; min-height: 4px; }
    .tree-folder.drag-target > .lbl { background: var(--pri-soft); outline: 1px dashed var(--pri); }
    .wb-tree-body.drag-target { outline: 1px dashed var(--pri); outline-offset: -4px; border-radius: 8px; }

    .wb-topbar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; row-gap: 6px;
        padding: 9px 14px; border-bottom: 1px solid var(--line); background: var(--panel); }

    /* open-request tabs — several requests stay open, each keeping its own draft */
    .wb-tabs { display: flex; align-items: stretch; gap: 2px; flex: 1; min-width: 0;
        overflow-x: auto; scrollbar-width: none; }
    .wb-tabs::-webkit-scrollbar { display: none; }
    .wb-tab { display: inline-flex; align-items: center; flex-shrink: 0; max-width: 230px;
        padding: 6px 11px; border-radius: 9px; cursor: pointer; font-size: 11.5px; font-weight: 600;
        color: var(--muted); border: 1px solid transparent; background: transparent; }
    .wb-tab:hover { background: var(--panel2); }
    .wb-tab.active { background: var(--panel2); border-color: var(--line); color: var(--ink); }
    .wb-tab .meth { min-width: 0; margin-right: 6px; }
    .wb-tab .nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wb-tab .x { display: flex; align-items: center; justify-content: center; width: 15px; height: 15px;
        margin-left: 6px; border-radius: 5px; color: var(--faint); flex-shrink: 0; }
    .wb-tab .x:hover { background: var(--fail-soft); color: var(--fail); }
    /* an unsaved tab shows a dot instead of the close affordance until hovered */
    .wb-tab.dirty .x { color: var(--pri); }
    .wb-tab.dirty .x .ic { display: none; }
    .wb-tab.dirty .x::after { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .wb-tab.dirty:hover .x::after { display: none; }
    .wb-tab.dirty:hover .x .ic { display: inline-flex; }
    .wb-env { display: flex; align-items: center; gap: 6px; padding: 4px 9px; background: var(--panel2);
        border: 1px solid var(--line); border-radius: 9px; flex-shrink: 0; }
    .wb-env .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--teal); flex-shrink: 0; }
    .wb-env select { width: auto; background: none; border: none; padding: 1px 0; box-shadow: none;
        color: var(--ink); font-family: var(--mono); font-size: 11px; font-weight: 600; }
    .wb-env select:focus { outline: none; }
    .tab-n { font-family: var(--mono); font-size: 9.5px; color: var(--faint); margin-left: 5px; }
    .tab.active .tab-n { color: var(--pri); }
    .tab-dot { display: none; width: 5px; height: 5px; border-radius: 50%; background: var(--pri); margin-left: 6px; vertical-align: middle; }
    .tab-dot.on { display: inline-block; }
    .builder { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    .wb-resizer { height: 8px; flex-shrink: 0; background: var(--panel2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); cursor: row-resize; position: relative; }
    .wb-resizer::after { content: ""; position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 36px; height: 3px; border-radius: 3px; background: var(--line); }
    .wb-resizer:hover::after { background: var(--pri); }
    .urlbar { display: flex; gap: 7px; padding: 12px 14px 0; align-items: center; }
    /* width:auto — signal.css gives every <select> width:100%, which would
       squeeze the URL field down to nothing. */
    .urlbar select.method { width: auto; flex: 0 0 auto; background: var(--panel2); border: 1px solid var(--line);
        border-radius: 10px; padding: 9px 11px; font-family: var(--mono); font-size: 12px; font-weight: 700; }
    .urlbar input.url { flex: 1; background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
        padding: 9px 11px; color: var(--ink); font-family: var(--mono); font-size: 12px; box-shadow: var(--sh); }
    .urlbar .btn { border-radius: 10px; padding: 9px 15px; font-size: 12.5px; }
    .urlbar .btn:not(.ghost):not(.danger) { box-shadow: 0 4px 14px -6px var(--pri); }
    .tabs { display: flex; gap: 4px; padding: 12px 14px 0; }
    .tab { padding: 7px 11px; border-radius: 8px 8px 0 0; cursor: pointer; font-size: 12px; font-weight: 500;
        color: var(--muted); border-bottom: 2px solid transparent; }
    .tab.active { color: var(--pri); border-bottom-color: var(--pri); font-weight: 700; }
    .tabpanel { flex: 1; min-height: 0; overflow: auto; padding: 10px 14px 14px; }
    .tabpanel.body-area { overflow: hidden; display: flex; flex-direction: column; }

    /* Body editor. The design draws this as a dark block in BOTH themes — the
       one surface in the app that is always dark — so the palette below is
       literal hex from the handoff, not theme tokens. Structure: line-number
       gutter + a transparent textarea over a highlighted backdrop. */
    .hl-wrap { display: flex; flex: 1; min-height: 0; border: 1px solid var(--line); border-radius: 11px;
        background: #0A0D14; overflow: hidden; }
    .hl-wrap:focus-within { border-color: var(--pri); box-shadow: 0 0 0 3px var(--pri-soft); }
    .ln { flex-shrink: 0; width: 42px; padding: 11px 8px; text-align: right; font-family: var(--mono);
        font-size: 11.5px; line-height: 1.65; color: #3F4A63; overflow: hidden; white-space: pre;
        user-select: none; border-right: 1px solid rgba(255,255,255,.06); }
    .ed-stack { position: relative; flex: 1; min-height: 0; }
    .code-edit, .hl-backdrop { font-family: var(--mono); font-size: 11.5px; line-height: 1.65; white-space: pre;
        box-sizing: border-box; padding: 11px 12px; margin: 0; border: none; }
    .code-edit { position: absolute; inset: 0; width: 100%; height: 100%; background: transparent; color: transparent;
        caret-color: #C9D2E4; resize: none; overflow: auto; }
    .code-edit:focus { outline: none; box-shadow: none; }
    .code-edit::selection { color: #fff; background: rgba(108,134,255,.35); }
    .code-edit::-moz-selection { color: #fff; background: rgba(108,134,255,.35); }
    .hl-backdrop { position: absolute; inset: 0; color: #C9D2E4; background: transparent; overflow: hidden; pointer-events: none; }
    .hl-backdrop .j-key { color: #A48BFF; }
    .hl-backdrop .j-str { color: #3FCF8E; }
    .hl-backdrop .j-num { color: #F5B544; }
    .hl-backdrop .j-kw  { color: #6C86FF; }
    .hl-backdrop .j-pun { color: #5A6480; }
    .hl-backdrop .j-com { color: #4A5470; font-style: italic; }
    /* variables carry the design's chip: tinted background, 3px radius */
    .hl-backdrop .v-ok, .hl-backdrop .v-dyn, .hl-backdrop .v-bad { border-radius: 3px; padding: 0 2px; }
    .hl-backdrop .v-ok  { color: #6C86FF; background: rgba(108,134,255,.14); }   /* defined in the env */
    .hl-backdrop .v-dyn { color: #3AD1DC; background: rgba(58,209,220,.14); }    /* dynamic ($) */
    .hl-backdrop .v-bad { color: #FF6369; background: rgba(255,99,105,.16); }    /* undefined */

    /* autocomplete: the .ac primitive, minus the two classes this list emits */
    .ac-item .ac-name { font-family: var(--mono); font-size: 12.5px; color: var(--ink); }
    .ac-tag.dyn { background: var(--pri-soft); color: var(--pri); }

    .auth-in { width: 100%; max-width: 420px; display: block; background: var(--panel2); border: 1px solid var(--line); border-radius: var(--r-sm); padding: 9px 12px; color: var(--text); font-family: var(--mono); font-size: 13px; margin-bottom: 12px; }
    .auth-lbl { display: block; font-size: 12px; color: var(--muted); margin-bottom: 5px; }

    .response { height: 260px; flex-shrink: 0; display: flex; flex-direction: column; min-height: 0; background: var(--panel); }
    .resp-head { padding: 10px 14px; display: flex; gap: 14px; align-items: center; border-bottom: 1px solid var(--line2); }
    .resp-status { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 12px; font-weight: 700; }
    .resp-head .btn.small { padding: 6px 10px; border-radius: 8px; font-size: 11.5px; }
    .resp-body { flex: 1; overflow: auto; }
    .resp-body pre { margin: 0; padding: 12px 14px; font-family: var(--mono); font-size: 11.5px; line-height: 1.7; white-space: pre-wrap; word-break: break-word; }
    .muted-sm { color: var(--muted); font-family: var(--mono); font-size: 11px; }
    .hist-row { display: flex; gap: 10px; align-items: center; padding: 8px 16px; border-bottom: 1px solid var(--line); cursor: pointer; font-size: 13px; }
    .hist-row:hover { background: var(--panel2); }
</style>

<aside class="wb-tree">
    <div class="wb-tree-head">
        <span class="nm" title="{{ collection.name }}">{{ collection.name }}</span>
        <span style="display:flex;gap:5px;white-space:nowrap;">
            <button class="add" onclick="WB.newFolder()"
                    title="{{ 'Add folder'|trans }}" aria-label="{{ 'Add folder'|trans }}">{{ ic.i('folder', 12) }}</button>
            <button class="add" onclick="WB.newRequest()"
                    title="{{ 'New request'|trans }}" aria-label="{{ 'New request'|trans }}">{{ ic.i('plus', 12, 2.2) }}</button>
        </span>
    </div>
    <div class="wb-search">
        <input type="text" id="treeSearch" placeholder="{{ 'Search requests…'|trans }}" spellcheck="false" autocomplete="off">
    </div>
    <div class="wb-tree-body" id="tree">
        {% for f in collection.rootFolders %}{{ t.tree_folder(f) }}{% endfor %}
        {% for r in collection.rootRequests %}{{ t.tree_request(r) }}{% endfor %}
        {% if collection.rootFolders is empty and collection.rootRequests is empty %}
            <p class="muted-sm" style="padding:10px;">{{ 'Empty collection. Start with "+ Request".'|trans }}</p>
        {% endif %}
    </div>
</aside>

<div class="wb-main">
    <div class="wb-topbar">
        <div class="wb-tabs" id="wbTabs"></div>
        <div class="wb-env">
            <span class="dot"></span>
            <select id="wbEnv" title="{{ 'Environment · applied to all requests'|trans }}">
                <option value="">{{ '— none —'|trans }}</option>
                {% for e in environments %}<option value="{{ e.id }}">{{ e.name }}</option>{% endfor %}
            </select>
        </div>
    </div>

    <div id="emptyState" style="flex:1;display:flex;align-items:center;justify-content:center;padding:30px;">
        <div class="empty" style="max-width:340px;">
            <div style="width:56px;height:56px;margin:0 auto 14px;border-radius:16px;background:var(--pri-soft);color:var(--pri);display:flex;align-items:center;justify-content:center;">{{ ic.i('collections', 26) }}</div>
            <div style="font-weight:700;font-size:15px;color:var(--ink);">{{ 'Select or create a request'|trans }}</div>
            <p class="subtitle" style="margin:6px 0 16px;">{{ 'Click a request in the tree on the left, or add a new one.'|trans }}</p>
            <button class="btn" onclick="WB.newRequest()">{{ ic.i('plus', 13) }}{{ 'New request'|trans }}</button>
        </div>
    </div>

    <div class="builder" id="builder" hidden>
        <div style="display:flex;padding:12px 16px 0;"><input id="reqName" class="title-input" placeholder="{{ 'Request name'|trans }}"></div>
        <div class="urlbar">
            <select class="method" id="reqMethod">
                {% for m in constant('App\\Entity\\ApiRequest::METHODS') %}<option>{{ m }}</option>{% endfor %}
            </select>
            <input class="url" id="reqUrl" placeholder="https://api.example.com/{{ '{{path}}' }}">
            <button class="btn" onclick="WB.send()" id="sendBtn">{{ 'Send'|trans }}{{ ic.i('flows', 12) }}</button>
            <button class="btn ghost" onclick="WB.save()">{{ 'Save'|trans }}</button>
            <button class="btn ghost" onclick="WB.openCode()" title="{{ 'Generate code'|trans }}">{{ ic.i('terminal', 14) }}</button>
            <button class="btn danger" onclick="WB.del()" title="{{ 'Delete request'|trans }}">{{ ic.i('trash', 14) }}</button>
        </div>
        <div class="tabs">
            <div class="tab active" data-tab="params" onclick="WB.tab('params')">Params<span class="tab-n" id="tabnParams"></span></div>
            <div class="tab" data-tab="headers" onclick="WB.tab('headers')">Headers<span class="tab-n" id="tabnHeaders"></span></div>
            <div class="tab" data-tab="auth" onclick="WB.tab('auth')">Auth<span class="tab-dot" id="tabdAuth"></span></div>
            <div class="tab" data-tab="body" onclick="WB.tab('body')">Body<span class="tab-dot" id="tabdBody"></span></div>
        </div>
        <div class="tabpanel" data-panel="params">
            <div class="kvtable">
                <div class="kvhead"><span style="flex:0 0 38%">{{ 'Name'|trans }}</span><span style="flex:1">{{ 'Value'|trans }}</span><span style="width:34px"></span></div>
                <div id="paramsRows"></div>
            </div>
        </div>
        <div class="tabpanel" data-panel="headers" hidden>
            <div class="kvtable">
                <div class="kvhead"><span style="flex:0 0 38%">{{ 'Name'|trans }}</span><span style="flex:1">{{ 'Value'|trans }}</span><span style="width:34px"></span></div>
                <div id="headersRows"></div>
            </div>
        </div>
        <div class="tabpanel" data-panel="auth" hidden>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
                <label class="auth-lbl" style="margin:0;">{{ 'Type'|trans }}</label>
                <select id="authType" onchange="WB.renderAuth()" style="width:auto;">
                    <option value="none">No Auth</option>
                    <option value="bearer">Bearer Token</option>
                    <option value="basic">Basic Auth</option>
                    <option value="apikey">API Key</option>
                </select>
            </div>
            <div id="authFields"></div>
        </div>
        <div class="tabpanel body-area" data-panel="body" hidden>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                <select id="bodyMode" onchange="WB.validateBody()" style="width:auto;">
                    {% for m in ['none','raw','json','form'] %}<option>{{ m }}</option>{% endfor %}
                </select>
                <button type="button" class="btn ghost small" id="formatBtn" onclick="WB.formatBody()" hidden>Format</button>
                <span id="jsonValidity" class="muted-sm"></span>
                <div style="flex:1"></div>
                <span class="muted-sm">{{ '{{API_URL}}' }} · {{ '{{$randomEmail}}' }} · {{ '{{$guid}}' }} {{ 'supported'|trans }}</span>
            </div>
            <div class="hl-wrap">
                <div class="ln" id="lineNums">1</div>
                <div class="ed-stack">
                    <div id="bodyBackdrop" class="hl-backdrop"></div>
                    <textarea id="reqBody" class="code-edit" spellcheck="false" oninput="WB.validateBody()" placeholder="{{ 'Request body'|trans }}"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="wb-resizer" id="wbResizer" title="{{ 'Drag to resize · Click to collapse / restore'|trans }}" hidden></div>

    <div class="response" id="response" hidden>
        <div class="resp-head">
            <span class="resp-status" id="respStatus">—</span>
            <span class="muted-sm" id="respMeta"></span>
            <button class="btn ghost small" id="saveExampleBtn" onclick="WB.saveExample()" title="{{ 'Save this response as an example'|trans }}" hidden style="margin-left:6px;">{{ ic.i('import', 13) }}{{ 'Save example'|trans }}</button>
            <button class="btn ghost small" id="delExampleBtn" onclick="WB.deleteExample()" title="{{ 'Delete this example'|trans }}" hidden style="margin-left:6px;">{{ ic.i('trash', 13) }}{{ 'Delete example'|trans }}</button>
            <div style="flex:1"></div>
            <div class="tab active" data-rtab="body" onclick="WB.rtab('body')" style="padding:4px 8px;">Body</div>
            <div class="tab" data-rtab="headers" onclick="WB.rtab('headers')" style="padding:4px 8px;">Headers</div>
            <div class="tab" data-rtab="history" onclick="WB.rtab('history')" style="padding:4px 8px;">{{ 'History'|trans }}</div>
        </div>
        <div class="resp-body"><pre id="respBody"></pre><pre id="respHeaders" hidden></pre><div id="respHistory" hidden></div></div>
    </div>
</div>

<div class="ac" id="ac" hidden style="position:fixed;"></div>

<div id="codeModal" class="scrim" hidden onclick="if(event.target===this)WB.closeCode()">
    <div class="modal" style="width:700px;max-height:82vh;display:flex;flex-direction:column;">
        <div class="overlay-head">
            <strong>{{ 'Code'|trans }}</strong>
            <select id="codeLang" onchange="WB.renderCode()" style="width:auto;">
                <option value="curl">cURL</option>
                <option value="fetch">JavaScript (fetch)</option>
                <option value="php">PHP (cURL)</option>
            </select>
            <div style="flex:1"></div>
            <button class="btn small" onclick="WB.copyCode()">{{ 'Copy'|trans }}</button>
            <button class="btn ghost small" onclick="WB.closeCode()">{{ ic.i('x', 13) }}</button>
        </div>
        <pre id="codeOut" style="margin:0;padding:16px;overflow:auto;font-family:var(--mono);font-size:12.5px;white-space:pre;"></pre>
    </div>
</div>

<script type="application/json" id="wb-config">{{ {
    csrf: csrf_token('workbench'),
    urls: {
        get:    path('wb_request_get',    {workspace: workspace.id, request: 'REQID'}),
        save:   path('wb_request_save',   {workspace: workspace.id, request: 'REQID'}),
        send:   path('wb_request_send',   {workspace: workspace.id, request: 'REQID'}),
        del:    path('wb_request_delete', {workspace: workspace.id, request: 'REQID'}),
