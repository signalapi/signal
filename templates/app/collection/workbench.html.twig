        var search = document.getElementById('treeSearch');
        if (search) search.addEventListener('input', function () { filterTree(search.value); });
        tree.addEventListener('dragstart', e => { const r = e.target.closest('.tree-req'); if (r) { draggedEl = r; r.classList.add('dragging'); e.dataTransfer.effectAllowed = 'move'; } });
