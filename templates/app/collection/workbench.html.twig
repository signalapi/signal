        tree.addEventListener('click', function (e) {
            var ex = e.target.closest('.ex-row');
            if (ex) { e.stopPropagation(); showExample(ex.dataset.exId); return; }
            var lbl = e.target.closest('.lbl');
            if (lbl && lbl.parentElement.classList.contains('tree-folder')) lbl.parentElement.classList.toggle('collapsed');
