        tree.addEventListener('dragend', () => { if (draggedEl) draggedEl.classList.remove('dragging'); draggedEl = null; clearDragTargets(); });
        tree.addEventListener('dragover', e => {
            if (!draggedEl) return;
            e.preventDefault();
