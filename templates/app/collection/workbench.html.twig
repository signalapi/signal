{% extends 'app/workbench_layout.html.twig' %}

{% block title %}{{ collection.name }} · Workbench{% endblock %}

{% macro tree_request(r) %}
    {% set colors = {'GET':'#16a34a','POST':'#c77d11','PUT':'#2563eb','PATCH':'#8250df','DELETE':'#dc2626','HEAD':'#6b7079','OPTIONS':'#6b7079'} %}
    <div class="tree-req" draggable="true" data-id="{{ r.id }}">
        <span class="meth" style="color:{{ colors[r.method] ?? 'var(--muted)' }};">{{ r.method }}</span>
        <span class="t-name">{{ r.name }}</span>
    </div>
    <div class="ex-list" data-ex-for="{{ r.id }}">
        {% for ex in r.examples %}
            <div class="ex-row" data-ex-id="{{ ex.id }}" title="{{ ex.name }}">
                <span class="ex-ic {{ ex.success ? 'ok' : (ex.statusCode ? 'bad' : 'na') }}">e.g.</span>
                <span class="ex-name">{{ ex.name }}</span>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{% macro tree_folder(f) %}
    {% import _self as t %}
    <div class="tree-folder" data-folder-id="{{ f.id }}">
        <div class="lbl"><span class="chev">▾</span><span class="ficon">📂</span><span class="fname">{{ f.name }}</span></div>
        <div class="folder-body" data-folder-id="{{ f.id }}">
            {% for child in f.children %}{{ t.tree_folder(child) }}{% endfor %}
            {% for r in f.requests %}{{ t.tree_request(r) }}{% endfor %}
        </div>
    </div>
{% endmacro %}

{% block workbench %}
{% import _self as t %}
<style>
    .wb-tree { width: 290px; border-right: 1px solid var(--border); background: var(--panel); display: flex; flex-direction: column; overflow: hidden; }
    .wb-tree-head { padding: 12px 14px 11px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .wb-tree-head .nm { font-weight: 700; font-size: 13.5px; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wb-search { padding: 10px 12px; border-bottom: 1px solid var(--border); }
    .wb-search input { width: 100%; background: var(--panel-2); border: 1px solid var(--border); border-radius: 9px;
        padding: 7px 10px 7px 30px; color: var(--text); font-size: 13px; font-family: inherit;
        background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%239aa0a8' stroke-width='2.2' stroke-linecap='round'><circle cx='11' cy='11' r='7'/><line x1='21' y1='21' x2='16.65' y2='16.65'/></svg>");
        background-repeat: no-repeat; background-position: 9px center; }
    .wb-search input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
    .wb-tree-body { flex: 1; overflow: auto; padding: 8px 8px 18px; }
    .wb-tree-empty { color: var(--muted); font-size: 12.5px; padding: 14px 10px; }

    .tree-req { display: flex; gap: 9px; align-items: center; padding: 6px 8px; border-radius: 8px; cursor: pointer; font-size: 13px; color: var(--text); position: relative; }
    .tree-req:hover { background: var(--panel-2); }
    .tree-req.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
    .tree-req.active .t-name { color: var(--accent); }
    .tree-req.active::before { content: ""; position: absolute; left: -8px; top: 6px; bottom: 6px; width: 3px; border-radius: 0 3px 3px 0; background: var(--accent); }
    .tree-req.dragging { opacity: .4; }
    .tree-req.hide, .tree-folder.hide, .ex-list.hide { display: none; }
    .meth { font-family: var(--font-mono); font-weight: 700; font-size: 9.5px; letter-spacing: .04em; min-width: 40px; text-align: left; flex-shrink: 0; }
    .t-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* Saved example responses, nested under their request (Postman-style) */
    .ex-list { margin: 0 0 2px 18px; border-left: 1px solid var(--border); padding-left: 4px; }
    .ex-list:empty { display: none; }
    .ex-row { display: flex; align-items: center; gap: 7px; padding: 4px 8px; border-radius: 7px; cursor: pointer; font-size: 12px; color: var(--muted); }
    .ex-row:hover { background: var(--panel-2); color: var(--text); }
    .ex-row.active { background: var(--accent-soft); color: var(--accent); }
    .ex-ic { font-family: var(--font-mono); font-size: 8px; font-weight: 700; letter-spacing: .02em; padding: 2px 4px; border-radius: 4px; flex-shrink: 0;
        background: var(--panel-2); color: var(--muted); border: 1px solid var(--border); }
    .ex-ic.ok { color: var(--pass); border-color: rgba(31,157,85,.4); }
    .ex-ic.bad { color: var(--fail); border-color: rgba(229,72,77,.4); }
    .ex-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .tree-folder > .lbl { display: flex; align-items: center; gap: 6px; font-weight: 600; font-size: 13px; padding: 6px 8px; color: var(--ink); cursor: pointer; border-radius: 8px; user-select: none; }
    .tree-folder > .lbl:hover { background: var(--panel-2); }
    .tree-folder > .lbl .chev { font-size: 10px; color: var(--muted); transition: transform .15s; width: 10px; text-align: center; }
    .tree-folder > .lbl .ficon { font-size: 13px; filter: grayscale(.15); }
    .tree-folder > .lbl .fname { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tree-folder.collapsed > .lbl .chev { transform: rotate(-90deg); }
    .tree-folder.collapsed > .folder-body { display: none; }
    .folder-body { margin-left: 13px; border-left: 1px solid var(--border); padding-left: 6px; min-height: 4px; }
    .tree-folder.drag-target > .lbl { background: var(--accent-soft); outline: 1px dashed var(--accent); }
    .wb-tree-body.drag-target { outline: 1px dashed var(--accent); outline-offset: -4px; border-radius: 8px; }

    .wb-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    .wb-topbar { display: flex; align-items: center; justify-content: space-between; gap: 12px;
        padding: 10px 16px; border-bottom: 1px solid var(--border); background: var(--panel); }
    .wb-topbar .crumb { font-weight: 600; font-size: 13px; color: var(--ink); display: flex; align-items: center; gap: 7px; }
    .wb-topbar .crumb .ico { filter: grayscale(.2); }
    .wb-env { display: flex; align-items: center; gap: 8px; }
    .wb-env select { background: var(--panel-2); border: 1px solid var(--border); border-radius: 9px; padding: 7px 10px;
        color: var(--ink); font-weight: 600; font-size: 13px; font-family: inherit; min-width: 150px; }
    .tab-n { font-family: var(--font-mono); font-size: 10px; color: var(--muted); margin-left: 5px; }
    .tab.active .tab-n { color: var(--accent); }
    .tab-dot { display: none; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-left: 6px; vertical-align: middle; }
    .tab-dot.on { display: inline-block; }
    .empty-state { flex: 1; display: flex; align-items: center; justify-content: center; padding: 30px; }
    .es-card { text-align: center; max-width: 320px; }
    .es-ic { width: 56px; height: 56px; margin: 0 auto 16px; border-radius: 16px; background: var(--accent-soft);
        display: flex; align-items: center; justify-content: center; font-size: 26px; }
    .es-t { font-weight: 650; font-size: 16px; color: var(--ink); }
    .es-s { color: var(--muted); font-size: 13px; margin: 6px 0 18px; }
    .builder { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    .wb-resizer { height: 8px; flex-shrink: 0; background: var(--panel-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); cursor: row-resize; position: relative; }
    .wb-resizer::after { content: ""; position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 36px; height: 3px; border-radius: 3px; background: var(--border); }
    .wb-resizer:hover::after { background: var(--accent); }
    .nmbar { padding: 12px 16px 0; }
    .nmbar input { border: none; background: transparent; font-size: 16px; font-weight: 600; color: var(--text); width: 60%; }
    .nmbar input:focus { outline: none; }
    .urlbar { display: flex; gap: 8px; padding: 12px 16px; align-items: center; }
    .urlbar select.method { background: var(--panel-2); border: 1px solid var(--border); border-radius: 10px; padding: 9px 10px; font-weight: 700; color: var(--text); font-family: var(--font-mono); font-size: 13px; }
    .urlbar input.url { flex: 1; background: var(--panel-2); border: 1px solid var(--border); border-radius: 10px; padding: 9px 12px; color: var(--text); font-family: var(--font-mono); font-size: 13px; }
    .urlbar input.url:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
    .tabs { display: flex; gap: 2px; padding: 0 16px; border-bottom: 1px solid var(--border); }
    .tab { padding: 9px 12px; cursor: pointer; border-bottom: 2px solid transparent; color: var(--muted); font-size: 13px; }
    .tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
    .tabpanel { flex: 1; min-height: 0; overflow: auto; padding: 14px 16px; }
    .tabpanel[hidden] { display: none; }
    .tabpanel.body-area { overflow: hidden; display: flex; flex-direction: column; }
    .kv-row { display: flex; gap: 8px; margin-bottom: 6px; }
    .kv-row input { flex: 1; background: var(--panel-2); border: 1px solid var(--border); border-radius: 6px; padding: 7px 9px; color: var(--text); font-family: monospace; font-size: 13px; }
    .kv-row button { background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 16px; }
    .var-bar { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 7px 16px; border-bottom: 1px solid var(--border); background: var(--panel); }
    .var-chip { font-family: var(--font-mono); font-size: 11.5px; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--border); }
    .var-chip.ok { background: var(--accent-soft); color: var(--accent); border-color: color-mix(in srgb, var(--accent) 28%, transparent); }
    .var-chip.bad { background: var(--fail-soft); color: var(--fail); border-color: color-mix(in srgb, var(--fail) 35%, transparent); }

    /* Code editor: transparent textarea over a highlighted backdrop (real syntax colors) */
    /* Code editor: line-number gutter + (transparent textarea over highlighted backdrop). Fills available height, scrolls internally. */
    .hl-wrap { display: flex; flex: 1; min-height: 0; border: 1px solid var(--border); border-radius: 10px;
        background: var(--panel-2); overflow: hidden; }
    .hl-wrap:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
    .ln { flex-shrink: 0; width: 48px; padding: 12px 8px 12px 0; text-align: right; font-family: var(--font-mono);
        font-size: 13px; line-height: 1.55; color: #aeb4bf; background: var(--panel); overflow: hidden; white-space: pre;
        user-select: none; border-right: 1px solid var(--border); }
    .ed-stack { position: relative; flex: 1; min-height: 0; }
    .code-edit, .hl-backdrop { font-family: var(--font-mono); font-size: 13px; line-height: 1.55; white-space: pre;
        box-sizing: border-box; padding: 12px; margin: 0; border: none; }
    .code-edit { position: absolute; inset: 0; width: 100%; height: 100%; background: transparent; color: transparent;
        caret-color: var(--ink); resize: none; overflow: auto; }
    .code-edit:focus { outline: none; }
    .code-edit::selection { color: var(--ink); background: #cfd9ff; }
    .code-edit::-moz-selection { color: var(--ink); background: #cfd9ff; }
    .hl-backdrop { position: absolute; inset: 0; color: var(--ink); background: transparent; overflow: hidden; pointer-events: none; }
    .hl-backdrop .j-key { color: #8250df; }
    .hl-backdrop .j-str { color: #1f9d55; }
    .hl-backdrop .j-num { color: #b35900; }
    .hl-backdrop .j-kw  { color: #4534d6; font-weight: 600; }
    .hl-backdrop .j-pun { color: #9aa0a8; }
    .hl-backdrop .j-com { color: #9aa0a8; font-style: italic; }
    /* env-defined variable */
    .hl-backdrop .v-ok { background: var(--accent-soft); color: var(--accent); border-radius: 3px; padding: 0 1px; }
    /* dynamic ($) variable — distinct teal */
    .hl-backdrop .v-dyn { background: #d9f3ee; color: #0e7c6b; border-radius: 3px; padding: 0 1px; }
    /* undefined variable */
    .hl-backdrop .v-bad { background: var(--fail-soft); color: var(--fail); border-radius: 3px; padding: 0 1px; }

    /* variable autocomplete dropdown */
    .ac { position: fixed; z-index: 70; background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
        box-shadow: var(--shadow-lg); padding: 5px; min-width: 220px; max-height: 240px; overflow: auto; }
    .ac[hidden] { display: none; }
    .ac-item { display: flex; align-items: center; gap: 8px; padding: 6px 9px; border-radius: 7px; cursor: pointer; font-family: var(--font-mono); font-size: 12.5px; }
    .ac-item.sel { background: var(--accent-soft); }
    .ac-item .ac-tag { font-size: 9.5px; font-weight: 700; letter-spacing: .04em; padding: 1px 5px; border-radius: 4px; }
    .ac-item .ac-tag.env { background: var(--accent-soft); color: var(--accent); }
    .ac-item .ac-tag.dyn { background: #d9f3ee; color: #0e7c6b; }
    .ac-item .ac-name { color: var(--ink); }
    .auth-in { width: 100%; max-width: 420px; display: block; background: var(--panel-2); border: 1px solid var(--border); border-radius: 8px; padding: 9px 12px; color: var(--text); font-family: monospace; font-size: 13px; margin-bottom: 12px; }
    .auth-lbl { display: block; font-size: 12px; color: var(--muted); margin-bottom: 5px; }

    .response { height: 260px; flex-shrink: 0; display: flex; flex-direction: column; min-height: 0; background: var(--panel); }
    .resp-head { padding: 10px 16px; display: flex; gap: 18px; align-items: center; border-bottom: 1px solid var(--border); }
    .resp-status { font-weight: 700; }
    .resp-body { flex: 1; overflow: auto; }
    .resp-body pre { margin: 0; padding: 14px 16px; font-size: 12.5px; white-space: pre-wrap; word-break: break-word; }
    .muted-sm { color: var(--muted); font-size: 12px; }
    .hist-row { display: flex; gap: 10px; align-items: center; padding: 8px 16px; border-bottom: 1px solid var(--border); cursor: pointer; font-size: 13px; }
    .hist-row:hover { background: var(--panel-2); }
    .code-modal { position: fixed; inset: 0; background: rgba(15,23,42,.45); display: flex; align-items: center; justify-content: center; z-index: 60; }
    .code-modal[hidden] { display: none; }
    .code-card { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; width: 700px; max-width: 92vw; max-height: 82vh; display: flex; flex-direction: column; box-shadow: var(--shadow); }
    .code-head { display: flex; gap: 10px; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--border); }
    .code-head select { background: var(--panel-2); border: 1px solid var(--border); border-radius: 8px; padding: 6px 8px; color: var(--text); }
    #codeOut { margin: 0; padding: 16px; overflow: auto; font-size: 12.5px; white-space: pre; font-family: monospace; }
</style>

<aside class="wb-tree">
    <div class="wb-tree-head">
        <span class="nm" title="{{ collection.name }}">{{ collection.name }}</span>
        <span style="white-space:nowrap;">
            <button class="btn ghost small" onclick="WB.newFolder()" title="{{ 'Add folder'|trans }}">+ {{ 'Folder'|trans }}</button>
            <button class="btn small" onclick="WB.newRequest()">+ {{ 'Request'|trans }}</button>
        </span>
    </div>
    <div class="wb-search">
        <input id="treeSearch" placeholder="{{ 'Search requests…'|trans }}" spellcheck="false" autocomplete="off">
    </div>
    <div class="wb-tree-body" id="tree">
        {% for f in collection.rootFolders %}{{ t.tree_folder(f) }}{% endfor %}
        {% for r in collection.rootRequests %}{{ t.tree_request(r) }}{% endfor %}
        {% if collection.rootFolders is empty and collection.rootRequests is empty %}
            <p class="muted-sm" style="padding:10px;">{{ 'Empty collection. Start with "+ Request".'|trans }}</p>
        {% endif %}
    </div>
</aside>

<div class="wb-main">
    <div class="wb-topbar">
        <div class="crumb"><span class="ico">📁</span> {{ collection.name }}</div>
        <div class="wb-env">
            <span class="eyebrow">Environment</span>
            <select id="wbEnv" title="{{ 'Applied to all requests'|trans }}">
                <option value="">{{ '— none —'|trans }}</option>
                {% for e in environments %}<option value="{{ e.id }}">{{ e.name }}</option>{% endfor %}
            </select>
        </div>
    </div>

    <div class="empty-state" id="emptyState">
        <div class="es-card">
            <div class="es-ic">🧪</div>
            <div class="es-t">{{ 'Select or create a request'|trans }}</div>
            <div class="es-s">{{ 'Click a request in the tree on the left, or add a new one.'|trans }}</div>
            <button class="btn" onclick="WB.newRequest()">+ {{ 'New request'|trans }}</button>
        </div>
    </div>

    <div class="builder" id="builder" hidden>
        <div class="nmbar"><input id="reqName" placeholder="{{ 'Request name'|trans }}"></div>
        <div class="urlbar">
            <select class="method" id="reqMethod">
                {% for m in constant('App\\Entity\\ApiRequest::METHODS') %}<option>{{ m }}</option>{% endfor %}
            </select>
            <input class="url" id="reqUrl" placeholder="https://api.example.com/{{ '{{path}}' }}">
            <button class="btn" onclick="WB.send()" id="sendBtn">{{ 'Send'|trans }} ▸</button>
            <button class="btn ghost" onclick="WB.save()">{{ 'Save'|trans }}</button>
            <button class="btn ghost" onclick="WB.openCode()" title="{{ 'Generate code'|trans }}">&lt;/&gt;</button>
            <button class="btn danger" onclick="WB.del()" title="{{ 'Delete request'|trans }}">🗑</button>
        </div>
        <div class="tabs">
            <div class="tab active" data-tab="params" onclick="WB.tab('params')">Params<span class="tab-n" id="tabnParams"></span></div>
            <div class="tab" data-tab="headers" onclick="WB.tab('headers')">Headers<span class="tab-n" id="tabnHeaders"></span></div>
            <div class="tab" data-tab="auth" onclick="WB.tab('auth')">Auth<span class="tab-dot" id="tabdAuth"></span></div>
            <div class="tab" data-tab="body" onclick="WB.tab('body')">Body<span class="tab-dot" id="tabdBody"></span></div>
        </div>
        <div class="tabpanel" data-panel="params"><div id="paramsRows"></div></div>
        <div class="tabpanel" data-panel="headers" hidden><div id="headersRows"></div></div>
        <div class="tabpanel" data-panel="auth" hidden>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
                <label style="font-size:13px;color:var(--muted);">{{ 'Type'|trans }}</label>
                <select id="authType" onchange="WB.renderAuth()" style="background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:8px;color:var(--text);">
                    <option value="none">No Auth</option>
                    <option value="bearer">Bearer Token</option>
                    <option value="basic">Basic Auth</option>
                    <option value="apikey">API Key</option>
                </select>
            </div>
            <div id="authFields"></div>
        </div>
        <div class="tabpanel body-area" data-panel="body" hidden>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                <select id="bodyMode" onchange="WB.validateBody()" style="background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:7px;color:var(--text);">
                    {% for m in ['none','raw','json','form'] %}<option>{{ m }}</option>{% endfor %}
                </select>
                <button type="button" class="btn ghost small" id="formatBtn" onclick="WB.formatBody()" hidden>Format</button>
                <span id="jsonValidity" class="muted-sm"></span>
                <div style="flex:1"></div>
                <span class="muted-sm">{{ '{{API_URL}}' }} · {{ '{{$randomEmail}}' }} · {{ '{{$guid}}' }} {{ 'supported'|trans }}</span>
            </div>
            <div class="hl-wrap">
                <div class="ln" id="lineNums">1</div>
                <div class="ed-stack">
                    <div id="bodyBackdrop" class="hl-backdrop"></div>
                    <textarea id="reqBody" class="code-edit" spellcheck="false" oninput="WB.validateBody()" placeholder="{{ 'Request body'|trans }}"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="wb-resizer" id="wbResizer" title="{{ 'Drag to resize · Click to collapse / restore'|trans }}" hidden></div>

    <div class="response" id="response" hidden>
        <div class="resp-head">
            <span class="resp-status" id="respStatus">—</span>
            <span class="muted-sm" id="respMeta"></span>
            <button class="btn ghost small" id="saveExampleBtn" onclick="WB.saveExample()" title="{{ 'Save this response as an example'|trans }}" hidden style="margin-left:6px;">★ {{ 'Save example'|trans }}</button>
            <button class="btn ghost small" id="delExampleBtn" onclick="WB.deleteExample()" title="{{ 'Delete this example'|trans }}" hidden style="margin-left:6px;">🗑 {{ 'Delete example'|trans }}</button>
            <div style="flex:1"></div>
            <div class="tab active" data-rtab="body" onclick="WB.rtab('body')" style="padding:4px 8px;">Body</div>
            <div class="tab" data-rtab="headers" onclick="WB.rtab('headers')" style="padding:4px 8px;">Headers</div>
            <div class="tab" data-rtab="history" onclick="WB.rtab('history')" style="padding:4px 8px;">{{ 'History'|trans }}</div>
        </div>
        <div class="resp-body"><pre id="respBody"></pre><pre id="respHeaders" hidden></pre><div id="respHistory" hidden></div></div>
    </div>
</div>

<div class="ac" id="ac" hidden></div>

<div id="codeModal" class="code-modal" hidden onclick="if(event.target===this)WB.closeCode()">
    <div class="code-card">
        <div class="code-head">
            <strong>{{ 'Code'|trans }}</strong>
            <select id="codeLang" onchange="WB.renderCode()">
                <option value="curl">cURL</option>
                <option value="fetch">JavaScript (fetch)</option>
                <option value="php">PHP (cURL)</option>
            </select>
            <div style="flex:1"></div>
            <button class="btn small" onclick="WB.copyCode()">{{ 'Copy'|trans }}</button>
            <button class="btn ghost small" onclick="WB.closeCode()">✕</button>
        </div>
        <pre id="codeOut"></pre>
    </div>
</div>

<script type="application/json" id="wb-config">{{ {
    csrf: csrf_token('workbench'),
    urls: {
        get:    path('wb_request_get',    {workspace: workspace.id, request: 'REQID'}),
        save:   path('wb_request_save',   {workspace: workspace.id, request: 'REQID'}),
        send:   path('wb_request_send',   {workspace: workspace.id, request: 'REQID'}),
        del:    path('wb_request_delete', {workspace: workspace.id, request: 'REQID'}),
        create: path('wb_request_create', {workspace: workspace.id, collection: collection.id}),
        history: path('wb_history_list', {workspace: workspace.id, request: 'REQID'}),
        historyDetail: path('wb_history_detail', {workspace: workspace.id, history: 'HID'}),
        exampleCreate: path('wb_example_create', {workspace: workspace.id, request: 'REQID'}),
        exampleGet: path('wb_example_get', {workspace: workspace.id, example: 'EXID'}),
        exampleDelete: path('wb_example_delete', {workspace: workspace.id, example: 'EXID'}),
        folderCreate: path('wb_folder_create', {workspace: workspace.id, collection: collection.id}),
        reorder: path('wb_request_reorder', {workspace: workspace.id, collection: collection.id})
    },
    wsId: workspace.id,
    envs: environments|map(e => {'id': e.id, 'vars': e.variables|map(v => v.name)}),
    i18n: {
        name: 'name'|trans,
        value: 'value'|trans,
        del: 'delete'|trans,
        pressSend: 'Press Send or check the History tab'|trans,
        validVars: 'Valid (variables will be resolved)'|trans,
        validJson: 'Valid JSON'|trans,
        cantFormat: 'Body containing variables cannot be formatted'|trans,
        tokenPh: 'Token (can be a variable)'|trans,
        username: 'Username'|trans,
        usernamePh: 'username'|trans,
        password: 'Password'|trans,
        passwordPh: 'password'|trans,
        keyLbl: 'Key'|trans,
        valueLbl: 'Value'|trans,
        valuePh: 'value (can be a variable)'|trans,
        addTo: 'Add to'|trans,
        noAuth: 'No authentication for this request.'|trans,
        sending: 'Sending…'|trans,
        send: 'Send'|trans,
        error: 'Error'|trans,
        example: 'example'|trans,
        automatic: 'automatic'|trans,
        exampleNamePrompt: 'Example name:'|trans,
        exampleDefault: 'Example'|trans,
        exampleSaved: 'Example saved'|trans,
        exampleDeleteConfirm: 'This example will be deleted.'|trans,
        saved: 'Saved'|trans,
        requestDeleteConfirm: 'The request will be deleted.'|trans,
        requestNamePrompt: 'Request name:'|trans,
        newRequestDefault: 'New request'|trans,
        secAgo: '%count% sec ago'|trans,
        minAgo: '%count% min ago'|trans,
        hrAgo: '%count% hr ago'|trans,
        daysAgo: '%count% days ago'|trans,
        noHistory: 'No run history for this request yet.'|trans,
        history: 'history'|trans,
        copied: 'Copied'|trans,
        variables: 'Variables'|trans,
        undef: 'undefined'|trans,
        defined: 'defined'|trans,
