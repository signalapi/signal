    });
    return {select, send, save, del, newRequest, newFolder, tab, rtab, validateBody, formatBody, renderAuth, loadHistory, showHistory, showExample, saveExample, deleteExample, openCode, closeCode, renderCode, copyCode};
})();
</script>
