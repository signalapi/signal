{% verbatim %}
<script>
const WB = (() => {
    const CFG = JSON.parse(document.getElementById('wb-config').textContent);
    const CSRF = CFG.csrf;
    const U = CFG.urls;
    const T = CFG.i18n;
    const ENV_VARS = {};
    (CFG.envs || []).forEach(e => ENV_VARS[e.id] = new Set(Object.values(e.vars || {})));
    let currentId = null;
    let draggedEl = null;
    let lastResp = null;          // last live response (for "save as example")
    let currentExampleId = null;  // example currently shown in the panel (for delete)

    const $ = id => document.getElementById(id);
    const api = (url, method='GET', body=null) => fetch(url, {
        method, headers: {'Content-Type':'application/json','X-CSRF-Token':CSRF},
        body: body ? JSON.stringify(body) : null
    }).then(r => r.json());

    function kvRows(container, pairs) {
        container.innerHTML = '';
        const data = (pairs || []).concat([{name:'',value:''}]);
        data.forEach(p => addRow(container, p.name, p.value));
    }
    function addRow(container, name='', value='') {
        const row = document.createElement('div'); row.className = 'kvrow';
        row.innerHTML = '<input class="k" placeholder="' + T.name + '" value=""><input class="v" placeholder="' + T.value + '" value=""><button class="rm" title="' + T.del + '">' + CFG.icons.x + '</button>';
        const [n, v] = row.querySelectorAll('input');
        n.value = name; v.value = value;
        const ensureTrailing = () => {
            const rows = [...container.querySelectorAll('.kvrow')];
            const last = rows[rows.length-1];
            const li = last.querySelectorAll('input');
            if (li[0].value || li[1].value) addRow(container);
        };
        n.addEventListener('input', ensureTrailing);
        v.addEventListener('input', ensureTrailing);
        row.querySelector('button').onclick = () => { row.remove(); if(!container.querySelector('.kvrow')) addRow(container); };
        container.appendChild(row);
    }
    function collectPairs(container) {
        return [...container.querySelectorAll('.kvrow')].map(r => {
            const i = r.querySelectorAll('input');
            return {name: i[0].value.trim(), value: i[1].value};
        }).filter(p => p.name !== '');
    }
    // ---- Params <-> URL two-way sync (Postman-style; variables kept readable, not encoded) ----
    function urlToParams() {
        const url = $('reqUrl').value, qi = url.indexOf('?');
        const qs = qi >= 0 ? url.slice(qi + 1) : '';
        const pairs = qs ? qs.split('&').filter(Boolean).map(kv => {
            const i = kv.indexOf('='); return {name: i >= 0 ? kv.slice(0, i) : kv, value: i >= 0 ? kv.slice(i + 1) : ''};
        }).filter(p => p.name) : [];
        kvRows($('paramsRows'), pairs);
    }
    function paramsToUrl() {
        const url = $('reqUrl').value, qi = url.indexOf('?'), base = qi >= 0 ? url.slice(0, qi) : url;
        const pairs = collectPairs($('paramsRows'));
        $('reqUrl').value = pairs.length ? base + '?' + pairs.map(p => p.name + '=' + p.value).join('&') : base;
    }

    // ---- Open-request tabs -------------------------------------------------
    // Several requests stay open at once. Each tab carries its own unsaved
    // draft, so switching away and back does not lose edits, and the set of
    // open tabs survives a reload.
    let tabs = [];                       // [{id, name, method, dirty, draft}]
    const TABS_KEY = 'wb_tabs_' + CFG.collectionId;

    function tabOf(id) { return tabs.find(t => t.id === id); }

    function persistTabs() {
        try {
            localStorage.setItem(TABS_KEY, JSON.stringify({open: tabs.map(t => t.id), active: currentId}));
        } catch (e) { /* private mode: tabs simply do not survive the reload */ }
    }

    function renderTabs() {
        $('wbTabs').innerHTML = tabs.map(t =>
            '<div class="wb-tab' + (t.id === currentId ? ' active' : '') + (t.dirty ? ' dirty' : '') + '"'
            + ' data-id="' + escAttr(t.id) + '" title="' + escAttr(t.name) + '">'
            + '<span class="meth m-' + String(t.method || 'get').toLowerCase() + '">' + escHtml(t.method || '') + '</span>'
            + '<span class="nm">' + escHtml(t.name || '') + '</span>'
            + '<span class="x" data-close="' + escAttr(t.id) + '" title="' + escAttr(T.closeTab) + '">' + CFG.icons.x + '</span>'
            + '</div>').join('');
    }

    /** Park the on-screen state on the active tab before we navigate away. */
    function snapshot() {
        const t = tabOf(currentId);
        if (t) t.draft = payload();
    }

    /** Write a request (server shape or parked draft) into the builder. */
    function applyDraft(d) {
        $('reqName').value = d.name || '';
        $('reqMethod').value = d.method || 'GET';
        $('reqUrl').value = d.url || '';
        $('bodyMode').value = d.bodyMode || 'none';
        $('reqBody').value = d.body || '';
        kvRows($('paramsRows'), d.params || []);
        kvRows($('headersRows'), d.headers || []);
        if (($('reqUrl').value || '').includes('?')) urlToParams(); else paramsToUrl();
        const a = d.auth || {}; $('authType').value = a.type || 'none'; renderAuth(a);
        validateBody(); refreshVars();
    }

    function markDirty() {
        const t = tabOf(currentId);
        if (!t) return;
        const name = $('reqName').value, method = $('reqMethod').value;
        const changed = !t.dirty || t.name !== name || t.method !== method;
        t.dirty = true; t.name = name; t.method = method;
        if (changed) renderTabs();
    }

    function closeTab(id) {
        const i = tabs.findIndex(t => t.id === id);
        if (i === -1) return;
        if (tabs[i].dirty && !confirm(T.discardChanges)) return;
        const wasActive = id === currentId;
        tabs.splice(i, 1);
        if (!wasActive) { renderTabs(); persistTabs(); return; }
        currentId = null;
        const next = tabs[i] || tabs[i - 1];
        if (next) { select(next.id); return; }
        $('builder').hidden = true; $('response').hidden = true;
        $('wbResizer').hidden = true; $('emptyState').hidden = false;
        document.querySelectorAll('.tree-req.active').forEach(el => el.classList.remove('active'));
        renderTabs(); persistTabs();
    }

    function select(id, meta) {
        if (id === currentId) return;
        snapshot();
        if (!tabOf(id)) {
            const row = document.querySelector('.tree-req[data-id="' + id + '"]');
            tabs.push({
                id: id,
                name: (meta && meta.name) || row?.querySelector('.t-name')?.textContent || '…',
                method: (meta && meta.method) || row?.querySelector('.meth')?.textContent || 'GET',
                dirty: false, draft: null,
            });
        }
        currentId = id;
        lastResp = null; currentExampleId = null;
        $('saveExampleBtn').hidden = true; $('delExampleBtn').hidden = true;
        document.querySelectorAll('.ex-row.active').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.tree-req').forEach(el => el.classList.toggle('active', el.dataset.id === id));
        $('emptyState').hidden = true; $('builder').hidden = false; $('wbResizer').hidden = false;
        $('response').hidden = false;
        $('respStatus').textContent = '—'; $('respStatus').style.color = 'var(--muted)';
        $('respMeta').textContent = T.pressSend;
        $('respBody').textContent = ''; $('respHeaders').textContent = ''; rtab('body');
        renderTabs(); persistTabs();

        const t = tabOf(id);
        if (t.draft) { applyDraft(t.draft); return; }
        api(U.get.replace('REQID', id)).then(r => {
            if (currentId !== id) return;   // switched tabs while the fetch was in flight
            t.name = r.name; t.method = r.method;
            applyDraft(r);
            renderTabs();
        });
    }
    // Remove // line comments and /* block */ comments without touching anything inside strings.
    function stripJsonComments(src) {
        let out = '', i = 0, inStr = false, q = '';
        while (i < src.length) {
            const c = src[i], n = src[i + 1];
            if (inStr) {
                out += c;
                if (c === '\\') { out += (n || ''); i += 2; continue; }
                if (c === q) inStr = false;
                i++; continue;
            }
            if (c === '"' || c === "'") { inStr = true; q = c; out += c; i++; continue; }
            if (c === '/' && n === '/') { while (i < src.length && src[i] !== '\n') i++; continue; }
            if (c === '/' && n === '*') { i += 2; while (i < src.length && !(src[i] === '*' && src[i + 1] === '/')) i++; i += 2; continue; }
            out += c; i++;
        }
        return out;
    }
    // Validate ignoring {{variables}} (placeholders resolved at send time) and // or /* */ comments —
    // so a body like {"amount": {{amount}}} // note  is considered fine.
    function jsonForValidation(txt) { return stripJsonComments(txt).replace(/\{\{[^{}]*\}\}/g, '0'); }
    function validateBody() {
        const mode = $('bodyMode').value;
        const badge = $('jsonValidity'); const fmt = $('formatBtn');
        if (mode !== 'json') { badge.textContent = ''; fmt.hidden = true; return; }
        fmt.hidden = false;
        const txt = $('reqBody').value.trim();
        if (txt === '') { badge.textContent = ''; return; }
        const hasVars = /\{\{[^{}]*\}\}/.test(txt);
        try {
            JSON.parse(jsonForValidation(txt));
            badge.innerHTML = CFG.icons.check + ' ' + esc(hasVars ? T.validVars : T.validJson);
            badge.style.color = 'var(--pass)';
        } catch (e) {
            badge.innerHTML = CFG.icons.alert + ' ' + esc(e.message); badge.style.color = 'var(--fail)';
        }
    }
    function formatBody() {
        // Only reformat when there are no template variables (formatting would lose them).
        const txt = $('reqBody').value;
        if (/\{\{[^{}]*\}\}/.test(txt)) { flash(T.cantFormat); return; }
        try {
            $('reqBody').value = JSON.stringify(JSON.parse(txt), null, 2);
            refreshVars(); validateBody();
        } catch (e) { validateBody(); }
    }
    function payload() {
        return {
            name: $('reqName').value, method: $('reqMethod').value, url: $('reqUrl').value,
            headers: collectPairs($('headersRows')), params: collectPairs($('paramsRows')),
            bodyMode: $('bodyMode').value, body: $('reqBody').value, auth: collectAuth(),
        };
    }
    function renderAuth(prefill) {
        prefill = prefill || {};
        const type = $('authType').value, c = $('authFields'), v = k => (prefill[k]||'').replace(/"/g,'&quot;');
        const inp = (id,ph,val) => '<input id="'+id+'" placeholder="'+ph+'" value="'+val+'" class="auth-in">';
        const lbl = txt => '<label class="auth-lbl">'+txt+'</label>';
        let h = '';
        if (type === 'bearer') h = lbl('Token')+inp('authToken', T.tokenPh, v('token'));
        else if (type === 'basic') h = lbl(T.username)+inp('authUser', T.usernamePh, v('username'))+lbl(T.password)+inp('authPass', T.passwordPh, v('password'));
        else if (type === 'apikey') h = lbl(T.keyLbl)+inp('authKey','X-Api-Key', v('key'))+lbl(T.valueLbl)+inp('authVal', T.valuePh, v('value'))
            +lbl(T.addTo)+'<select id="authAddTo" class="auth-in"><option value="header"'+(prefill.addTo!=='query'?' selected':'')+'>Header</option><option value="query"'+(prefill.addTo==='query'?' selected':'')+'>Query param</option></select>';
        else h = '<p class="muted-sm">' + T.noAuth + '</p>';
        c.innerHTML = h;
    }
    function collectAuth() {
        const type = $('authType').value, g = id => (document.getElementById(id)?.value || '');
        if (type === 'bearer') return {type, token: g('authToken')};
        if (type === 'basic') return {type, username: g('authUser'), password: g('authPass')};
        if (type === 'apikey') return {type, key: g('authKey'), value: g('authVal'), addTo: g('authAddTo') || 'header'};
        return {type: 'none'};
    }
    function send() {
        if (!currentId) return;
        const b = payload(); b.environment = $('wbEnv').value;
        // Comments are an editor convenience; strip them so the wire body stays valid JSON.
        if (b.bodyMode === 'json' && b.body) b.body = stripJsonComments(b.body);
        $('sendBtn').textContent = T.sending; $('sendBtn').disabled = true;
        api(U.send.replace('REQID', currentId), 'POST', b).then(res => {
            $('sendBtn').textContent = T.send; $('sendBtn').disabled = false;
            $('response').hidden = false;
            if (!res.ok && res.error) {
                $('respStatus').textContent = T.error; $('respStatus').style.color = 'var(--fail)';
                $('respMeta').textContent = ''; $('respBody').textContent = res.error; rtab('body');
                $('respHeaders').textContent = '';
                lastResp = null; $('saveExampleBtn').hidden = true; $('delExampleBtn').hidden = true;
                return;
            }
            const sc = res.status;
            $('respStatus').textContent = sc;
            $('respStatus').style.color = sc < 300 ? 'var(--pass)' : (sc < 400 ? 'var(--warn)' : 'var(--fail)');
            $('respMeta').textContent = res.durationMs + ' ms · ' + res.size + ' B';
            let body = res.body || '';
            try { body = JSON.stringify(JSON.parse(body), null, 2); } catch(e) {}
            $('respBody').textContent = body;
            $('respHeaders').textContent = Object.entries(res.headers||{}).map(([k,v]) => k+': '+v).join('\n');
            rtab('body');
            loadHistory();
            // Live response → can be saved as an example; refresh the tree's example list.
            lastResp = { status: res.status, body: res.body, headers: res.headers };
            currentExampleId = null;
            document.querySelectorAll('.ex-row.active').forEach(el => el.classList.remove('active'));
            $('saveExampleBtn').hidden = false; $('delExampleBtn').hidden = true;
            if (res.examples) renderExamples(currentId, res.examples);
        });
    }

    // ---- Saved example responses ----
    function renderExamples(reqId, list) {
        const box = document.querySelector('.ex-list[data-ex-for="' + reqId + '"]');
        if (!box) return;
        box.innerHTML = (list || []).map(e => {
            const cls = e.success ? 'ok' : (e.status ? 'bad' : 'na');
            return '<div class="ex-row" data-ex-id="' + e.id + '" title="' + escAttr(e.name) + '">'
                + '<span class="ex-ic ' + cls + '">e.g.</span><span class="ex-name">' + escHtml(e.name) + '</span></div>';
        }).join('');
    }
    function escHtml(s) { return String(s).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c])); }
    function escAttr(s) { return escHtml(s).replace(/"/g, '&quot;'); }

    function showExample(id) {
        api(U.exampleGet.replace('EXID', id)).then(d => {
            currentExampleId = id; lastResp = null;
            document.querySelectorAll('.ex-row.active').forEach(el => el.classList.remove('active'));
            const row = document.querySelector('.ex-row[data-ex-id="' + id + '"]');
            if (row) row.classList.add('active');
            $('response').hidden = false;
            rtab('body');
            const sc = d.status;
            $('respStatus').textContent = sc == null ? '—' : sc;
            $('respStatus').style.color = sc == null ? 'var(--muted)' : (sc < 300 ? 'var(--pass)' : (sc < 400 ? 'var(--warn)' : 'var(--fail)'));
            $('respMeta').textContent = d.name + ' · ' + T.example + ({auto:' (' + T.automatic + ')',imported:' (Postman)',manual:''}[d.source] || '');
            let body = d.body || '';
            try { body = JSON.stringify(JSON.parse(body), null, 2); } catch(e) {}
            $('respBody').textContent = body;
            $('respHeaders').textContent = Object.entries(d.headers || {}).map(([k,v]) => k+': '+v).join('\n');
            $('saveExampleBtn').hidden = true; $('delExampleBtn').hidden = false;
        });
    }
    function saveExample() {
        if (!currentId || !lastResp) return;
        const name = prompt(T.exampleNamePrompt, lastResp.status ? (lastResp.status + ' Response') : T.exampleDefault);
        if (name === null) return;
        api(U.exampleCreate.replace('REQID', currentId), 'POST', {
            name: name, status: lastResp.status, body: lastResp.body, headers: lastResp.headers,
        }).then(r => { if (r.ok) { renderExamples(currentId, r.examples); flash(T.exampleSaved); } });
    }
    function deleteExample() {
        if (!currentExampleId) return;
        if (!confirm(T.exampleDeleteConfirm)) return;
        const rid = currentId;
        api(U.exampleDelete.replace('EXID', currentExampleId), 'POST').then(r => {
            if (r.ok) { renderExamples(rid, r.examples); currentExampleId = null; $('delExampleBtn').hidden = true; }
        });
    }

    function save() {
        if (!currentId) return;
        const id = currentId;
        api(U.save.replace('REQID', id), 'POST', payload()).then(r => {
            if (!r.ok) return;
            const el = document.querySelector('.tree-req[data-id="'+id+'"] .t-name'); if(el) el.textContent = r.request.name;
            const m = document.querySelector('.tree-req[data-id="'+id+'"] .meth');
            if(m) { m.textContent = r.request.method; m.className = 'meth m-' + String(r.request.method).toLowerCase(); }
            const t = tabOf(id);
            if (t) { t.dirty = false; t.draft = null; t.name = r.request.name; t.method = r.request.method; renderTabs(); }
            flash(T.saved);
        });
    }
    function del() {
        if (!currentId || !confirm(T.requestDeleteConfirm)) return;
        const id = currentId;
        api(U.del.replace('REQID', id), 'POST').then(r => {
            if (!r.ok) return;
            document.querySelector('.tree-req[data-id="'+id+'"]')?.remove();
            const t = tabOf(id);
            if (t) t.dirty = false;   // it is gone from the server; nothing to warn about
            closeTab(id);
        });
    }
    function newRequest() {
        const name = prompt(T.requestNamePrompt, T.newRequestDefault); if (name === null) return;
        api(U.create, 'POST', {name}).then(r => {
            if (!r.ok) return;
            const tree = $('tree');
            const div = document.createElement('div'); div.className='tree-req'; div.dataset.id=r.request.id;
            div.innerHTML = '<span class="meth m-'+String(r.request.method).toLowerCase()+'">'+r.request.method+'</span><span class="t-name">'+r.request.name+'</span>';
            div.onclick = () => select(r.request.id); tree.appendChild(div);
            select(r.request.id, {name: r.request.name, method: r.request.method});
        });
    }
    function tab(name) {
        document.querySelectorAll('.builder .tab').forEach(t => t.classList.toggle('active', t.dataset.tab===name));
        document.querySelectorAll('.builder .tabpanel').forEach(p => p.hidden = p.dataset.panel!==name);
    }
    function rtab(name) {
        document.querySelectorAll('.response .tab').forEach(t => t.classList.toggle('active', t.dataset.rtab===name));
        $('respBody').hidden = name!=='body'; $('respHeaders').hidden = name!=='headers'; $('respHistory').hidden = name!=='history';
        if (name === 'history') loadHistory();
    }
    function timeago(iso) {
        const s = Math.floor((Date.now() - new Date(iso).getTime())/1000);
        if (s < 60) return T.secAgo.replace('%count%', s);
        if (s < 3600) return T.minAgo.replace('%count%', Math.floor(s/60));
        if (s < 86400) return T.hrAgo.replace('%count%', Math.floor(s/3600));
        return T.daysAgo.replace('%count%', Math.floor(s/86400));
    }
    function loadHistory() {
        if (!currentId) return;
        api(U.history.replace('REQID', currentId)).then(d => {
            const items = d.items || [];
            if (!items.length) { $('respHistory').innerHTML = '<p class="muted-sm" style="padding:14px;">' + T.noHistory + '</p>'; return; }
            $('respHistory').innerHTML = items.map(it => {
                const ok = !it.error && it.status < 400;
                const color = it.error ? 'var(--fail)' : (it.status < 300 ? 'var(--pass)' : (it.status < 400 ? 'var(--warn)' : 'var(--fail)'));
                const st = it.error ? 'ERR' : (it.status || '—');
                return '<div class="hist-row" data-hid="'+it.id+'"><span style="font-weight:700;color:'+color+';min-width:40px;">'+st+'</span>'
                    + '<span style="font-weight:700;min-width:48px;color:var(--muted);">'+it.method+'</span>'
                    + '<span class="muted-sm" style="flex:1;">'+it.durationMs+' ms · '+it.size+' B'+(it.env ? ' · '+it.env : '')+(it.user ? ' · '+it.user : '')+'</span>'
                    + '<span class="muted-sm">'+timeago(it.createdAt)+'</span></div>';
            }).join('');
            $('respHistory').querySelectorAll('.hist-row').forEach(r => r.onclick = () => showHistory(r.dataset.hid));
        });
    }
    function showHistory(id) {
        api(U.historyDetail.replace('HID', id)).then(d => {
            rtab('body');
            if (d.error) {
                $('respStatus').textContent = T.error; $('respStatus').style.color = 'var(--fail)';
                $('respMeta').textContent = ''; $('respBody').textContent = d.error; $('respHeaders').textContent = ''; return;
            }
            const sc = d.status;
            $('respStatus').textContent = sc; $('respStatus').style.color = sc < 300 ? 'var(--pass)' : (sc < 400 ? 'var(--warn)' : 'var(--fail)');
            $('respMeta').textContent = d.durationMs + ' ms · ' + d.size + ' B' + (d.env ? ' · ' + d.env : '') + ' (' + T.history + ')';
            let body = d.body || ''; try { body = JSON.stringify(JSON.parse(body), null, 2); } catch(e) {}
            $('respBody').textContent = body;
            $('respHeaders').textContent = Object.entries(d.headers || {}).map(([k,v]) => k+': '+v).join('\n');
        });
    }
    function flash(msg) {
        const f = document.createElement('div'); f.textContent = msg;
        f.style.cssText = 'position:fixed;bottom:18px;right:18px;background:var(--pass);color:#fff;padding:8px 14px;border-radius:8px;font-size:13px;box-shadow:var(--sh);z-index:50;';
        document.body.appendChild(f); setTimeout(()=>f.remove(), 1500);
    }

    // ---- Code generation ----
    function openCode() { if (!currentId) return; $('codeModal').hidden = false; renderCode(); }
    function closeCode() { $('codeModal').hidden = true; }
    function effectiveReq() {
        const p = payload();
        let url = p.url;
        const headers = (p.headers || []).map(h => ({name: h.name, value: h.value}));
        const auth = p.auth || {type: 'none'};
        if (auth.type === 'bearer' && auth.token) headers.push({name: 'Authorization', value: 'Bearer ' + auth.token});
        else if (auth.type === 'basic') headers.push({name: 'Authorization', value: 'Basic ' + btoa((auth.username || '') + ':' + (auth.password || ''))});
        else if (auth.type === 'apikey' && auth.key) {
            if (auth.addTo === 'query') url += (url.includes('?') ? '&' : '?') + auth.key + '=' + (auth.value || '');
            else headers.push({name: auth.key, value: auth.value || ''});
        }
        const hasCT = headers.some(h => h.name.toLowerCase() === 'content-type');
        if (p.body && !hasCT && p.bodyMode === 'json') headers.push({name: 'Content-Type', value: 'application/json'});
        if (p.body && !hasCT && p.bodyMode === 'form') headers.push({name: 'Content-Type', value: 'application/x-www-form-urlencoded'});
        return {method: p.method, url, headers, body: p.bodyMode !== 'none' ? (p.body || '') : ''};
    }
    function renderCode() {
        const r = effectiveReq(), lang = $('codeLang').value;
        $('codeOut').textContent = lang === 'curl' ? genCurl(r) : (lang === 'fetch' ? genFetch(r) : genPhp(r));
    }
    function sq(s) { return "'" + String(s).replace(/'/g, "'\\''") + "'"; }
    function phpStr(s) { return "'" + String(s).replace(/\\/g, '\\\\').replace(/'/g, "\\'") + "'"; }
    function genCurl(r) {
        let out = 'curl -X ' + r.method + ' ' + sq(r.url);
        r.headers.forEach(h => out += " \\\n  -H " + sq(h.name + ': ' + h.value));
        if (r.body) out += " \\\n  --data " + sq(r.body);
        return out;
    }
    function genFetch(r) {
        const h = {}; r.headers.forEach(x => h[x.name] = x.value);
        const opts = {method: r.method};
        if (Object.keys(h).length) opts.headers = h;
        if (r.body) opts.body = r.body;
        return 'fetch(' + JSON.stringify(r.url) + ', ' + JSON.stringify(opts, null, 2) + ')\n  .then(r => r.json())\n  .then(console.log);';
    }
    function genPhp(r) {
        let s = '$ch = curl_init(' + phpStr(r.url) + ');\n';
        s += 'curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);\n';
        s += 'curl_setopt($ch, CURLOPT_CUSTOMREQUEST, ' + phpStr(r.method) + ');\n';
        if (r.headers.length) s += 'curl_setopt($ch, CURLOPT_HTTPHEADER, [\n' + r.headers.map(h => '    ' + phpStr(h.name + ': ' + h.value)).join(',\n') + ',\n]);\n';
        if (r.body) s += 'curl_setopt($ch, CURLOPT_POSTFIELDS, ' + phpStr(r.body) + ');\n';
        s += '$response = curl_exec($ch);\ncurl_close($ch);\necho $response;';
        return s;
    }
    function copyCode() { navigator.clipboard.writeText($('codeOut').textContent).then(() => flash(T.copied)); }

    // ---- Undefined-variable highlighting ----
    function currentEnvVars() { return ENV_VARS[$('wbEnv').value] || new Set(); }
    function isDefined(name) { return name.charAt(0) === '$' || currentEnvVars().has(name); }
    function varsIn(text) { return text ? [...String(text).matchAll(/\{\{\s*(\$?[\w.\-]+)\s*\}\}/g)].map(m => m[1]) : []; }
    function collectVarsUsed() {
        const p = payload(), texts = [p.url, p.body];
        (p.headers || []).forEach(h => { texts.push(h.name, h.value); });
        (p.params || []).forEach(h => { texts.push(h.name, h.value); });
        const a = p.auth || {}; ['token','username','password','key','value'].forEach(k => { if (a[k]) texts.push(a[k]); });
        const set = new Set(); texts.forEach(t => varsIn(t).forEach(n => set.add(n)));
        return [...set];
    }
    function renderVarBar() {
        const vars = collectVarsUsed(), bar = $('varBar');
        if (!vars.length) { bar.hidden = true; bar.innerHTML = ''; return; }
        bar.hidden = false;
        const undef = vars.filter(v => !isDefined(v)).length;
        bar.innerHTML = '<span class="muted-sm" style="margin-right:2px;">' + T.variables + (undef ? ' · ' + undef + ' ' + T.undef : '') + ':</span>'
            + vars.map(v => '<span class="var-chip ' + (isDefined(v) ? 'ok' : 'bad') + '" title="' + (isDefined(v) ? T.defined : T.undefinedInEnv) + '">{{' + esc(v) + '}}</span>').join('');
    }
    function varClass(name) { return name.charAt(0) === '$' ? 'v-dyn' : (currentEnvVars().has(name) ? 'v-ok' : 'v-bad'); }
    function varSpanInner(s) {
        return esc(s).replace(/\{\{\s*(\$?[\w.\-]+)\s*\}\}/g,
            (m, n) => '<span class="' + varClass(n) + '">' + esc(m) + '</span>');
    }
    function highlightJson(text) {
        const re = /(\/\/[^\n]*|\/\*[\s\S]*?\*\/)|("(?:\\.|[^"\\])*")|(\{\{\s*\$?[\w.\-]+\s*\}\})|(-?\d+\.?\d*(?:[eE][+-]?\d+)?)|\b(true|false|null)\b|([{}\[\],:])/g;
        let out = '', last = 0, m;
        while ((m = re.exec(text)) !== null) {
            out += esc(text.slice(last, m.index));
            if (m[1]) {
                out += '<span class="j-com">' + esc(m[1]) + '</span>';
            } else if (m[2]) {
                const isKey = /^\s*:/.test(text.slice(re.lastIndex));
                out += '<span class="j-' + (isKey ? 'key' : 'str') + '">' + varSpanInner(m[2]) + '</span>';
            } else if (m[3]) {
                const n = m[3].replace(/[{}\s]/g, '');
                out += '<span class="' + varClass(n) + '">' + esc(m[3]) + '</span>';
            } else if (m[4]) { out += '<span class="j-num">' + esc(m[4]) + '</span>'; }
            else if (m[5]) { out += '<span class="j-kw">' + esc(m[5]) + '</span>'; }
            else { out += '<span class="j-pun">' + esc(m[6]) + '</span>'; }
            last = re.lastIndex;
        }
        return out + esc(text.slice(last));
    }
    function renderBodyHighlight() {
        const txt = $('reqBody').value;
        const html = ($('bodyMode').value === 'json') ? highlightJson(txt) : varSpanInner(txt);
        $('bodyBackdrop').innerHTML = html + '\n';
        renderLineNumbers(txt);
    }
    function renderLineNumbers(txt) {
        const ln = $('lineNums'); if (!ln) return;
        const count = (txt.match(/\n/g) || []).length + 1;
        let s = '';
        for (let i = 1; i <= count; i++) s += i + '\n';
        ln.textContent = s;
        ln.scrollTop = $('reqBody').scrollTop;
    }
    const METHOD_COLOR = {GET:'var(--pass)',POST:'var(--warn)',PUT:'var(--pri)',PATCH:'var(--vio)',DELETE:'var(--fail)',HEAD:'var(--muted)',OPTIONS:'var(--muted)'};
    function colorMethod() { $('reqMethod').style.color = METHOD_COLOR[$('reqMethod').value] || 'var(--ink)'; }
    function refreshVars() { renderBodyHighlight(); updateTabCounts(); colorMethod(); }
    function updateTabCounts() {
        var p = collectPairs($('paramsRows')).length, h = collectPairs($('headersRows')).length;
        $('tabnParams').textContent = p ? '(' + p + ')' : '';
        $('tabnHeaders').textContent = h ? '(' + h + ')' : '';
        $('tabdAuth').className = 'tab-dot' + (($('authType').value && $('authType').value !== 'none') ? ' on' : '');
        $('tabdBody').className = 'tab-dot' + (($('bodyMode').value !== 'none' && $('reqBody').value.trim()) ? ' on' : '');
    }

    // ---- Variable autocomplete ({{ … }}) ----
    const DYN_VARS = ['$guid','$randomUUID','$timestamp','$isoTimestamp','$isoDate','$randomInt','$randomFirstName','$randomLastName','$randomFullName','$randomUserName','$randomEmail','$randomPhoneNumber','$randomCompanyName','$randomCity','$randomCountry','$randomColor','$randomBoolean','$randomWord','$randomWords','$randomIP','$randomPrice'];
    const AC = (function () {
        let el = null, ctx = null, items = [], sel = 0;
        const box = () => $('ac');
        function ctxAt(t) {
            const pos = t.selectionStart, before = t.value.slice(0, pos), open = before.lastIndexOf('{{');
            if (open === -1) return null;
            const between = before.slice(open + 2);
            if (between.indexOf('}}') !== -1 || between.indexOf('\n') !== -1) return null;
            if (!/^\s*\$?[\w.\-]*$/.test(between)) return null;
            return { start: open + 2, partial: between.trim() };
        }
        function suggestions(p) {
            p = p.toLowerCase();
            const env = [...currentEnvVars()].map(n => ({ name: n, kind: 'env' }));
            const all = env.concat(DYN_VARS.map(n => ({ name: n, kind: 'dyn' })));
            return all.filter(s => s.name.toLowerCase().indexOf(p) !== -1).slice(0, 12);
        }
        function caretXY(t, pos) {
            const d = document.createElement('div'), cs = getComputedStyle(t);
            ['fontFamily','fontSize','fontWeight','lineHeight','letterSpacing','paddingTop','paddingRight','paddingBottom','paddingLeft','borderTopWidth','borderLeftWidth'].forEach(p => d.style[p] = cs[p]);
            d.style.position = 'absolute'; d.style.visibility = 'hidden'; d.style.whiteSpace = 'pre-wrap'; d.style.wordWrap = 'break-word'; d.style.width = t.clientWidth + 'px';
            d.textContent = t.value.slice(0, pos);
            const s = document.createElement('span'); s.textContent = '|'; d.appendChild(s);
            document.body.appendChild(d);
            const r = t.getBoundingClientRect();
            const x = r.left + s.offsetLeft - t.scrollLeft, y = r.top + s.offsetTop - t.scrollTop, lh = parseFloat(cs.lineHeight) || 18;
            document.body.removeChild(d);
            return { x, y, lh };
        }
        function render() {
            box().innerHTML = items.map((s, i) => '<div class="ac-item' + (i === sel ? ' sel' : '') + '" data-i="' + i + '"><span class="ac-tag ' + s.kind + '">' + (s.kind === 'dyn' ? '$' : 'ENV') + '</span><span class="ac-name">' + esc(s.name) + '</span></div>').join('');
            box().querySelectorAll('.ac-item').forEach(it => it.onmousedown = e => { e.preventDefault(); choose(+it.dataset.i); });
        }
        function place() {
            const b = box();
            if (el.tagName === 'TEXTAREA') { const xy = caretXY(el, el.selectionStart); b.style.left = Math.min(xy.x, window.innerWidth - 250) + 'px'; b.style.top = (xy.y + xy.lh + 3) + 'px'; }
            else { const r = el.getBoundingClientRect(); b.style.left = r.left + 'px'; b.style.top = (r.bottom + 4) + 'px'; }
        }
        function open(t) {
            el = t; ctx = ctxAt(t);
            if (!ctx) return close();
            items = suggestions(ctx.partial);
            if (!items.length) return close();
            sel = 0; box().hidden = false; render(); place();
        }
        function close() { box().hidden = true; el = null; ctx = null; items = []; }
        function isOpen() { return !box().hidden; }
        function choose(i) {
            if (!el || !ctx || !items[i]) return;
            const t = el, name = items[i].name, before = t.value.slice(0, ctx.start);
            let rest = t.value.slice(t.selectionStart); const m = rest.match(/^\s*\}\}/); if (m) rest = rest.slice(m[0].length);
            const val = before + name + '}}'; t.value = val + rest;
            const c = val.length; t.setSelectionRange(c, c);
            close(); t.dispatchEvent(new Event('input', { bubbles: true })); t.focus();
        }
        function onKey(e) {
            if (!isOpen()) return;
            if (e.key === 'ArrowDown') { e.preventDefault(); sel = (sel + 1) % items.length; render(); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); sel = (sel - 1 + items.length) % items.length; render(); }
            else if (e.key === 'Enter' || e.key === 'Tab') { e.preventDefault(); choose(sel); }
            else if (e.key === 'Escape') { close(); }
        }
        function attach(t) {
            t.addEventListener('input', () => open(t));
            t.addEventListener('keydown', onKey);
            t.addEventListener('click', () => open(t));
            t.addEventListener('blur', () => setTimeout(close, 150));
        }
        return { attach, close, isOpen };
    })();

    // ---- Folders + drag & drop ----
    function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function newFolder() {
        const name = prompt(T.folderNamePrompt, T.newFolderDefault); if (name === null) return;
        api(U.folderCreate, 'POST', {name}).then(r => {
            if (!r.ok) return;
            const div = document.createElement('div'); div.className = 'tree-folder'; div.dataset.folderId = r.folder.id;
            div.innerHTML = '<div class="lbl"><span class="chev">▾</span>' + CFG.icons.folder + '<span class="fname">' + esc(r.folder.name) + '</span></div>'
                + '<div class="folder-body" data-folder-id="' + r.folder.id + '"></div>';
            $('tree').appendChild(div);
        });
    }
    function clearDragTargets() { document.querySelectorAll('.drag-target').forEach(el => el.classList.remove('drag-target')); }
    function filterTree(q) {
        q = q.trim().toLowerCase();
        document.querySelectorAll('.tree-req').forEach(function (r) {
            var n = (r.querySelector('.t-name') || {}).textContent || '';
            var hide = q !== '' && n.toLowerCase().indexOf(q) === -1;
            r.classList.toggle('hide', hide);
            var exl = document.querySelector('.ex-list[data-ex-for="' + r.dataset.id + '"]');
            if (exl) exl.classList.toggle('hide', hide);
        });
        document.querySelectorAll('.tree-folder').forEach(function (f) {
            var visible = f.querySelector('.tree-req:not(.hide)');
            f.classList.toggle('hide', q !== '' && !visible);
            if (q !== '') f.classList.remove('collapsed');
        });
    }
    function containerFor(target) {
        const body = target.closest('.folder-body');
        if (body) return body;
        const folder = target.closest('.tree-folder');
        if (folder) return folder.querySelector(':scope > .folder-body');
        return $('tree');
    }
    function reorderContainer(container) {
        const folderId = container.dataset.folderId || '';
        const order = [...container.querySelectorAll(':scope > .tree-req')].map(el => el.dataset.id);
        api(U.reorder, 'POST', {folderId, order}).then(() => flash(T.moved));
    }
    function onDrop(e) {
        e.preventDefault(); clearDragTargets();
        if (!draggedEl) return;
        const onReq = e.target.closest('.tree-req');
        let container, before = null;
        if (onReq && onReq !== draggedEl) { container = onReq.parentElement; before = onReq; }
        else { container = containerFor(e.target); }
        if (!container) return;
        if (before) container.insertBefore(draggedEl, before); else container.appendChild(draggedEl);
        // keep the dragged request's example list attached right beneath it
        const exl = document.querySelector('.ex-list[data-ex-for="' + draggedEl.dataset.id + '"]');
        if (exl) draggedEl.after(exl);
        reorderContainer(container);
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.tree-req').forEach(el => el.onclick = () => select(el.dataset.id));

        // Tab bar: click to switch, the ✕ (or a middle click) to close.
        $('wbTabs').addEventListener('click', function (e) {
            var x = e.target.closest('[data-close]');
            if (x) { e.stopPropagation(); closeTab(x.dataset.close); return; }
            var tab = e.target.closest('.wb-tab');
            if (tab) select(tab.dataset.id);
        });
        $('wbTabs').addEventListener('auxclick', function (e) {
            if (e.button !== 1) return;
            var tab = e.target.closest('.wb-tab');
            if (tab) { e.preventDefault(); closeTab(tab.dataset.id); }
        });

        // Restore the tabs that were open last time, then honour ?request=ID
        // (e.g. arriving from the flow canvas), else fall back to the first request.
        var restored = null;
        try { restored = JSON.parse(localStorage.getItem(TABS_KEY) || 'null'); } catch (e) { restored = null; }
        if (restored && Array.isArray(restored.open)) {
            restored.open.forEach(function (id) {
                var row = document.querySelector('.tree-req[data-id="' + id + '"]');
                if (!row) return;   // deleted since
                tabs.push({
                    id: id,
                    name: row.querySelector('.t-name')?.textContent || '…',
                    method: row.querySelector('.meth')?.textContent || 'GET',
                    dirty: false, draft: null,
                });
            });
            renderTabs();
        }
        var wanted = new URLSearchParams(location.search).get('request');
        var target = wanted && document.querySelector('.tree-req[data-id="' + wanted + '"]');
        if (target) { target.scrollIntoView({block: 'center'}); select(wanted); }
        else if (restored && tabOf(restored.active)) { select(restored.active); }
        else if (tabs.length) { select(tabs[0].id); }
        else { var firstReq = document.querySelector('.tree-req'); if (firstReq) select(firstReq.dataset.id); }
        $('reqUrl').addEventListener('keydown', e => { if(e.key==='Enter' && !AC.isOpen()){ e.preventDefault(); send(); }});
        $('reqUrl').addEventListener('input', urlToParams);
        $('paramsRows').addEventListener('input', paramsToUrl);
        $('builder').addEventListener('input', () => { refreshVars(); markDirty(); });
        // <select> fires change but not always input for keyboard picks
        $('builder').addEventListener('change', markDirty);
        // Leaving with unsaved work in any tab should ask first.
        window.addEventListener('beforeunload', (e) => {
            snapshot();
            if (tabs.some(t => t.dirty)) { e.preventDefault(); e.returnValue = ''; }
        });
        AC.attach($('reqBody'));
        AC.attach($('reqUrl'));

        // Global environment (top-right) — remembered per workspace, applied to all requests.
        var env = $('wbEnv'), key = 'wb_env_' + CFG.wsId, saved = localStorage.getItem(key);
        if (saved !== null) { for (var i = 0; i < env.options.length; i++) { if (env.options[i].value === saved) { env.value = saved; break; } } }
        env.addEventListener('change', function () { localStorage.setItem(key, env.value); refreshVars(); });
        $('reqBody').addEventListener('scroll', () => {
            const b = $('bodyBackdrop'); b.scrollTop = $('reqBody').scrollTop; b.scrollLeft = $('reqBody').scrollLeft;
            $('lineNums').scrollTop = $('reqBody').scrollTop;
        });

        // Pull the response area up/down (Postman-style) — drag to resize, single click to drop it
        // all the way down (maximize the editor); click again to snap back to the previous height.
        (function () {
            const resizer = $('wbResizer'), resp = $('response');
            const rkey = 'wb_resp_h_' + CFG.wsId, savedH = parseInt(localStorage.getItem(rkey) || '', 10);
            const DEFAULT_H = 260;
            if (savedH > 0) resp.style.height = savedH + 'px';
            // collapsed height = just the response header strip
            const collapsedH = () => { const h = resp.querySelector('.resp-head'); return h ? h.offsetHeight : 44; };
            let startY = 0, startH = 0, dragging = false, moved = 0, prevH = savedH > 0 ? savedH : DEFAULT_H;
            const animate = (on) => { resp.style.transition = on ? 'height .18s ease' : ''; };
