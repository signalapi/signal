                window.addEventListener('mousemove', onMove); window.addEventListener('mouseup', onUp);
            });
        })();

        const tree = $('tree');
        // Folder collapse/expand on label click; example rows open the saved example.
        tree.addEventListener('click', function (e) {
            var ex = e.target.closest('.ex-row');
            if (ex) { e.stopPropagation(); showExample(ex.dataset.exId); return; }
            var lbl = e.target.closest('.lbl');
