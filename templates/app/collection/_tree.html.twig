{# Collection tree: folders + request rows. Method badges use the .kind primitive. #}
{% macro method_badge(method) %}
    <span class="kind m-{{ method|lower }}">{{ method }}</span>
{% endmacro %}

{% macro request_row(request, workspace) %}
    {% import _self as tree %}
    <div style="display:flex;align-items:center;gap:9px;padding:6px 0;">
        {{ tree.method_badge(request.method) }}
        <a href="{{ path('app_request_show', {workspace: workspace.id, request: request.id}) }}" {% if request.deprecated %}style="text-decoration:line-through;opacity:.6;"{% endif %}>{{ request.name }}</a>
        {% if request.deprecated %}<span class="pill">deprecated</span>{% endif %}
    </div>
{% endmacro %}

{% macro folder_node(folder, workspace) %}
    {% import _self as tree %}
    {% import '_icons.html.twig' as ic %}
    <div style="margin:8px 0;">
        <div style="display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;color:var(--ink);">
            <span style="color:var(--faint);">{{ ic.i('folder', 14) }}</span>{{ folder.name }}
        </div>
        <div style="margin-left:16px;border-left:1px solid var(--line);padding-left:12px;">
            {% for child in folder.children %}
                {{ tree.folder_node(child, workspace) }}
            {% endfor %}
            {% for request in folder.requests %}
                {{ tree.request_row(request, workspace) }}
            {% endfor %}
        </div>
    </div>
{% endmacro %}
