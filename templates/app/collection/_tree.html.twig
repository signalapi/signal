{% macro method_badge(method) %}
    {% set colors = {'GET': '#22c55e', 'POST': '#f59e0b', 'PUT': '#3b82f6', 'PATCH': '#8b5cf6', 'DELETE': '#ef4444'} %}
    <span style="font-size:11px;font-weight:700;color:{{ colors[method] ?? '#9aa3b2' }};display:inline-block;width:54px;">{{ method }}</span>
{% endmacro %}

{% macro request_row(request, workspace) %}
    {% import _self as tree %}
    <div style="padding:6px 0 6px 8px;display:flex;align-items:center;gap:8px;">
        {{ tree.method_badge(request.method) }}
        <a href="{{ path('app_request_show', {workspace: workspace.id, request: request.id}) }}" {% if request.deprecated %}style="text-decoration:line-through;opacity:.6;"{% endif %}>{{ request.name }}</a>
        {% if request.deprecated %}<span class="pill off">deprecated</span>{% endif %}
    </div>
{% endmacro %}

{% macro folder_node(folder, workspace) %}
    {% import _self as tree %}
    <div style="margin:6px 0;">
        <div style="font-weight:600;color:var(--text);">📁 {{ folder.name }}</div>
        <div style="margin-left:18px;border-left:1px solid var(--border);padding-left:12px;">
            {% for child in folder.children %}
                {{ tree.folder_node(child, workspace) }}
            {% endfor %}
            {% for request in folder.requests %}
                {{ tree.request_row(request, workspace) }}
            {% endfor %}
        </div>
    </div>
{% endmacro %}
