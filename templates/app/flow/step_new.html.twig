{% extends 'app/_layout.html.twig' %}

{% block title %}Yeni adım · {{ flow.name }}{% endblock %}

{% block panel %}
<style>
    .sw { max-width: 940px; }
    .sw-grid { display: grid; grid-template-columns: 248px 1fr; gap: 26px; margin-top: 20px; align-items: start; }
    @media (max-width: 760px) { .sw-grid { grid-template-columns: 1fr; gap: 18px; } }

    /* ---- LEFT: type rail (echoes the flow runline) ---- */
    .rail { position: relative; padding: 4px 0; }
    .rail::before { content: ""; position: absolute; left: 21px; top: 24px; bottom: 24px; width: 2px;
        background: var(--border); z-index: 0; }
    .rail-item { position: relative; z-index: 1; display: flex; gap: 13px; align-items: flex-start; width: 100%;
        text-align: left; font: inherit; color: inherit; background: transparent; border: none; cursor: pointer;
        padding: 11px 12px 11px 0; border-radius: 12px; transition: background .12s; }
    .rail-item:hover { background: var(--panel-2); }
    .rail-node { width: 44px; height: 44px; flex-shrink: 0; border-radius: 50%; background: var(--panel); border: 2px solid var(--border);
        display: flex; align-items: center; justify-content: center; font-size: 21px; box-shadow: 0 0 0 4px var(--bg, var(--panel-2));
        transition: border-color .18s, background .18s, transform .1s; }
    .rail-item .rail-txt h3 { margin: 3px 0 3px; font-size: 14.5px; letter-spacing: -.01em; color: var(--muted); transition: color .15s; }
    .rail-item .rail-txt p { margin: 0; font-size: 11.5px; color: var(--muted); line-height: 1.4; opacity: .85; }
    .rail-item.on .rail-node { border-color: var(--accent); background: var(--accent-soft); transform: scale(1.04); }
    .rail-item.on .rail-txt h3 { color: var(--ink); font-weight: 700; }
    .rail-item.on { background: var(--panel-2); }

    /* ---- RIGHT: contextual detail ---- */
    .detail { background: var(--panel); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow);
        min-height: 340px; overflow: hidden; }
    .dt-head { padding: 18px 20px 14px; border-bottom: 1px solid var(--border); }
    .dt-head h2 { margin: 0 0 4px; font-size: 17px; }
    .dt-head p { margin: 0; font-size: 12.5px; color: var(--muted); }
    .dt-body { padding: 16px 20px 20px; }
    .pane { display: none; } .pane.on { display: block; }

    /* request picker */
    .search { width: 100%; box-sizing: border-box; background: var(--panel-2); border: 1px solid var(--border); border-radius: 10px;
        padding: 11px 13px; color: var(--text); font-size: 14px; margin-bottom: 12px; }
    .search:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
    .plist { border: 1px solid var(--border); border-radius: 12px; overflow: hidden auto; max-height: 380px; }
    .grp-head { position: sticky; top: 0; background: var(--panel-2); padding: 7px 14px; font-size: 11px; font-weight: 700;
        letter-spacing: .05em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--border); }
    .prow { display: flex; align-items: center; gap: 11px; width: 100%; text-align: left; font: inherit; color: inherit;
        cursor: pointer; background: transparent; border: none; border-bottom: 1px solid var(--border); padding: 11px 14px; transition: background .1s; }
    .prow:hover { background: var(--accent-soft); } .prow:last-child { border-bottom: none; }
    .mbadge { font-family: var(--font-mono); font-size: 9.5px; font-weight: 700; letter-spacing: .04em; padding: 3px 6px;
        border-radius: 5px; background: var(--accent-soft); color: var(--accent); flex-shrink: 0; min-width: 46px; text-align: center; }
    .mbadge.m-get { background: #e6f4ec; color: #16a34a; } .mbadge.m-post { background: #f8efe0; color: #b35900; }
    .mbadge.m-put { background: #e7eefc; color: #2563eb; } .mbadge.m-patch { background: #f0e9fb; color: #8250df; }
    .mbadge.m-delete { background: var(--fail-soft); color: #dc2626; }
    .prow .col { flex: 1; min-width: 0; }
    .prow .nm { font-weight: 600; font-size: 13.5px; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .prow .path { font-size: 11.5px; color: var(--muted); font-family: var(--font-mono); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .no-hit { padding: 24px; text-align: center; color: var(--muted); font-size: 13px; }
    .empty-note { background: var(--panel-2); border: 1px dashed var(--border); border-radius: 10px; padding: 16px; font-size: 13px; color: var(--muted); }
    .empty-note a { font-weight: 600; }
    .util-add { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
    .util-add .big-add { padding: 12px 22px; font-size: 14.5px; }
</style>

<div class="sw" id="sw"
     data-add="{{ path('app_flow_step_add', {workspace: workspace.id, flow: flow.id}) }}"
     data-adddb="{{ path('app_flow_step_add_db', {workspace: workspace.id, flow: flow.id}) }}"
     data-addutil="{{ path('app_flow_step_add_utility', {workspace: workspace.id, flow: flow.id}) }}"
     data-addcall="{{ path('app_flow_step_add_call', {workspace: workspace.id, flow: flow.id}) }}"
     data-token="{{ csrf_token('add-step' ~ flow.id) }}">

    <a class="backlink" href="{{ path('app_flow_show', {workspace: workspace.id, flow: flow.id}) }}">← {{ flow.name }}</a>
    <div class="pagehead"><div><h1>Yeni adım</h1><p class="subtitle">Akışa hangi düğümü ekleyelim?</p></div></div>

    <div class="sw-grid">
        {# ---- type rail ---- #}
        <div class="rail" role="tablist">
            <button type="button" class="rail-item on" data-type="http">
                <span class="rail-node">🌐</span>
                <span class="rail-txt"><h3>HTTP isteği</h3><p>API isteği gönder, yanıtı doğrula</p></span>
            </button>
            <button type="button" class="rail-item" data-type="db">
                <span class="rail-node">🗄️</span>
                <span class="rail-txt"><h3>DB doğrulama</h3><p>Sorgu çalıştır, satırı karşılaştır</p></span>
            </button>
            <button type="button" class="rail-item" data-type="setvar">
                <span class="rail-node">🔧</span>
                <span class="rail-txt"><h3>Değişken ata</h3><p>Elle bir değişken set et</p></span>
            </button>
            <button type="button" class="rail-item" data-type="delay">
                <span class="rail-node">⏱️</span>
                <span class="rail-txt"><h3>Bekle</h3><p>Adımlar arasına gecikme koy</p></span>
            </button>
            <button type="button" class="rail-item" data-type="call">
                <span class="rail-node">🧩</span>
                <span class="rail-txt"><h3>Alt-akış çağır</h3><p>Başka bir akışı burada çalıştır</p></span>
            </button>
        </div>

        {# ---- contextual detail ---- #}
        <div class="detail">
            {# HTTP #}
            <div class="pane on" data-pane="http">
                <div class="dt-head"><h2>HTTP isteği</h2><p>Bir collection isteği seç — kopyası bu adıma alınır.</p></div>
                <div class="dt-body">
                    {% if available_requests is empty %}
                        <div class="empty-note">Henüz istek yok. Önce <a href="{{ path('app_collection_index', {workspace: workspace.id}) }}">Collection'larda</a> bir istek oluştur.</div>
                    {% else %}
                        <input type="text" class="search" id="reqSearch" placeholder="İstek, collection veya URL ara…" autocomplete="off">
                        <div class="plist" id="reqList"></div>
                    {% endif %}
                </div>
            </div>
            {# DB #}
            <div class="pane" data-pane="db">
                <div class="dt-head"><h2>DB doğrulama</h2><p>Ödeme sonrası kayıt gerçekten oluştu mu — bir bağlantı seç.</p></div>
                <div class="dt-body">
                    {% if db_connections is empty %}
                        <div class="empty-note">Bağlantı yok. Önce <a href="{{ path('app_dbconn_index', {workspace: workspace.id}) }}">Veritabanı bağlantısı</a> ekle.</div>
                    {% else %}
                        <div class="plist">
                            {% for c in db_connections %}
                                <button type="button" class="prow" data-conn="{{ c.id }}">
                                    <span class="mbadge">{{ c.type|upper|slice(0,5) }}</span>
                                    <span class="col"><span class="nm">{{ c.name }}</span><span class="path">{{ c.host }}{{ c.databaseName ? ' / ' ~ c.databaseName }}</span></span>
                                </button>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
            {# setvar #}
            <div class="pane" data-pane="setvar">
                <div class="dt-head"><h2>Değişken ata</h2><p>Sabit bir değer veya <code>{{ '{{ifade}}' }}</code> ile bir değişken set et; sonraki adımlarda kullanılır.</p></div>
                <div class="dt-body util-add">
                    <p style="font-size:13px;color:var(--muted);margin:0;">Adım eklendikten sonra atamaları düzenleyeceksin.</p>
                    <button type="button" class="btn big-add" data-submit="setvar">🔧 Değişken adımı ekle</button>
                </div>
            </div>
            {# call sub-flow #}
            <div class="pane" data-pane="call">
                <div class="dt-head"><h2>Alt-akış çağır</h2><p>Seçilen akışın adımları burada, aynı değişken bağlamıyla çalışır — referanslı, hep güncel hâli.</p></div>
                <div class="dt-body">
                    {% if callable_flows is empty %}
                        <div class="empty-note">Çağrılabilir başka akış yok. Önce başka bir akış oluştur.</div>
                    {% else %}
                        <div class="plist">
                            {% for cf in callable_flows %}
                                <button type="button" class="prow" data-callflow="{{ cf.id }}">
                                    <span class="mbadge">AKIŞ</span>
                                    <span class="col"><span class="nm">{{ cf.name }}</span><span class="path">{{ cf.steps|length }} adım</span></span>
                                </button>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
            {# delay #}
            <div class="pane" data-pane="delay">
                <div class="dt-head"><h2>Bekle</h2><p>Asenkron işlemler (webhook, kuyruk) tamamlansın diye adımlar arasına gecikme koy.</p></div>
                <div class="dt-body util-add">
                    <p style="font-size:13px;color:var(--muted);margin:0;">Varsayılan 1000 ms — sonra düzenleyebilirsin.</p>
                    <button type="button" class="btn big-add" data-submit="delay">⏱️ Bekleme adımı ekle</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="reqData">[
{% for r in available_requests %}{"id":"{{ r.id }}","name":{{ r.name|json_encode|raw }},"method":"{{ r.method }}","coll":{{ r.collection.name|json_encode|raw }},"url":{{ (r.url ?: '')|json_encode|raw }}}{{ not loop.last ? ',' }}{% endfor %}
]</script>

{% verbatim %}
<script>
(function () {
    var sw = document.getElementById('sw');
    if (!sw) return;
    var token = sw.dataset.token;

    function post(action, field, value) {
        var f = document.createElement('form');
        f.method = 'post'; f.action = action;
        f.innerHTML = '<input type="hidden" name="_token">' + (field ? '<input type="hidden" name="' + field + '">' : '');
        f.querySelector('[name=_token]').value = token;
        if (field) f.querySelector('[name=' + field + ']').value = value;
        document.body.appendChild(f); f.submit();
    }

    // rail selection → swap detail pane
    function select(type) {
        document.querySelectorAll('.rail-item').forEach(function (i) { i.classList.toggle('on', i.dataset.type === type); });
        document.querySelectorAll('.pane').forEach(function (p) { p.classList.toggle('on', p.dataset.pane === type); });
        if (type === 'http') { var s = document.getElementById('reqSearch'); if (s) s.focus(); }
    }
    document.querySelectorAll('.rail-item').forEach(function (i) {
        i.addEventListener('click', function () { select(i.dataset.type); });
    });

    // utility add buttons
    document.querySelectorAll('[data-submit]').forEach(function (b) {
        b.addEventListener('click', function () { post(sw.dataset.addutil, 'type', b.dataset.submit); });
    });

    // db connections
    document.querySelectorAll('.prow[data-conn]').forEach(function (row) {
        row.addEventListener('click', function () { post(sw.dataset.adddb, 'connection', row.dataset.conn); });
    });

    // sub-flow calls
    document.querySelectorAll('.prow[data-callflow]').forEach(function (row) {
        row.addEventListener('click', function () { post(sw.dataset.addcall, 'calledFlow', row.dataset.callflow); });
    });

    // request picker: grouped + searchable
    var listEl = document.getElementById('reqList');
    if (listEl) {
        var reqs = JSON.parse(document.getElementById('reqData').textContent || '[]');
        function render(filter) {
            filter = (filter || '').toLowerCase().trim();
            var groups = {}, order = [];
            reqs.forEach(function (r) {
                if (filter && (r.name + ' ' + r.coll + ' ' + r.method + ' ' + r.url).toLowerCase().indexOf(filter) === -1) return;
                if (!groups[r.coll]) { groups[r.coll] = []; order.push(r.coll); }
                groups[r.coll].push(r);
            });
            listEl.innerHTML = '';
            if (!order.length) { listEl.innerHTML = '<div class="no-hit">Eşleşen istek yok.</div>'; return; }
            order.forEach(function (coll) {
                var h = document.createElement('div'); h.className = 'grp-head'; h.textContent = coll; listEl.appendChild(h);
                groups[coll].forEach(function (r) {
                    var b = document.createElement('button'); b.type = 'button'; b.className = 'prow';
                    var m = document.createElement('span'); m.className = 'mbadge m-' + r.method.toLowerCase(); m.textContent = r.method;
                    var col = document.createElement('span'); col.className = 'col';
                    var nm = document.createElement('span'); nm.className = 'nm'; nm.textContent = r.name; col.appendChild(nm);
                    if (r.url) { var p = document.createElement('span'); p.className = 'path'; p.textContent = r.url; col.appendChild(p); }
                    b.appendChild(m); b.appendChild(col);
                    b.addEventListener('click', function () { post(sw.dataset.add, 'request', r.id); });
                    listEl.appendChild(b);
                });
            });
        }
        render('');
        document.getElementById('reqSearch').addEventListener('input', function () { render(this.value); });
    }
})();
</script>
{% endverbatim %}
{% endblock %}
