{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'New step'|trans }} · {{ flow.name }}{% endblock %}

{% block panel %}
<div class="sw" id="sw" style="max-width:940px;"
     data-add="{{ path('app_flow_step_add', {workspace: workspace.id, flow: flow.id}) }}"
     data-adddb="{{ path('app_flow_step_add_db', {workspace: workspace.id, flow: flow.id}) }}"
     data-addutil="{{ path('app_flow_step_add_utility', {workspace: workspace.id, flow: flow.id}) }}"
     data-addcall="{{ path('app_flow_step_add_call', {workspace: workspace.id, flow: flow.id}) }}"
     data-token="{{ csrf_token('add-step' ~ flow.id) }}">

    <a class="backlink" href="{{ path('app_flow_show', {workspace: workspace.id, flow: flow.id}) }}">
        <span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>{{ flow.name }}</a>
    <div class="pagehead"><div><h1>{{ 'New step'|trans }}</h1><p class="subtitle">{{ 'Which node should we add to the flow?'|trans }}</p></div></div>

    <div class="card">
        {# ---- step-type palette ---- #}
        <div class="typebar" role="tablist">
            <button type="button" class="typebtn on" data-type="http">
                <span class="ic-box">{{ ic.i('environments', 15) }}</span>
                <span style="min-width:0"><span class="t">{{ 'HTTP request'|trans }}</span>
                    <span class="s" style="display:block">{{ 'Send an API request, verify the response'|trans }}</span></span>
            </button>
            <button type="button" class="typebtn" data-type="db">
                <span class="ic-box">{{ ic.i('db', 15) }}</span>
                <span style="min-width:0"><span class="t">{{ 'DB verification'|trans }}</span>
                    <span class="s" style="display:block">{{ 'Run a query, compare the row'|trans }}</span></span>
            </button>
            <button type="button" class="typebtn" data-type="setvar">
                <span class="ic-box">{{ ic.i('wrench', 15) }}</span>
                <span style="min-width:0"><span class="t">{{ 'Set variable'|trans }}</span>
                    <span class="s" style="display:block">{{ 'Set a variable manually'|trans }}</span></span>
            </button>
            <button type="button" class="typebtn" data-type="delay">
                <span class="ic-box">{{ ic.i('clock', 15) }}</span>
                <span style="min-width:0"><span class="t">{{ 'Wait'|trans }}</span>
                    <span class="s" style="display:block">{{ 'Add a delay between steps'|trans }}</span></span>
            </button>
            <button type="button" class="typebtn" data-type="call">
                <span class="ic-box">{{ ic.i('suites', 15) }}</span>
                <span style="min-width:0"><span class="t">{{ 'Call sub-flow'|trans }}</span>
                    <span class="s" style="display:block">{{ 'Run another flow here'|trans }}</span></span>
            </button>
        </div>

        {# ---- contextual detail ---- #}
        {# HTTP #}
        <div data-pane="http">
            <div class="card-body">
                <h2>{{ 'HTTP request'|trans }}</h2>
                <p class="subtitle" style="margin-bottom:14px;">{{ 'Pick a collection request — a copy is taken into this step.'|trans }}</p>
                {% if available_requests is empty %}
                    <div class="empty" style="text-align:left;">{{ 'No requests yet. First create a request in <a href="%url%">Collections</a>.'|trans({'%url%': path('app_collection_index', {workspace: workspace.id})})|raw }}</div>
                {% else %}
                    <label class="search" style="display:block;max-width:none;margin-bottom:12px;">
                        {{ ic.i('search', 14, 2) }}
                        <input type="text" id="reqSearch" placeholder="{{ 'Search request, collection or URL…'|trans }}" autocomplete="off">
                    </label>
                    <div class="picker" id="reqList" style="max-height:420px;overflow:auto;"></div>
                {% endif %}
            </div>
        </div>
        {# DB #}
        <div data-pane="db" hidden>
            <div class="card-body">
                <h2>{{ 'DB verification'|trans }}</h2>
                <p class="subtitle" style="margin-bottom:14px;">{{ 'Did the record really get created after payment — pick a connection.'|trans }}</p>
                {% if db_connections is empty %}
                    <div class="empty" style="text-align:left;">{{ 'No connections. First add a <a href="%url%">database connection</a>.'|trans({'%url%': path('app_dbconn_index', {workspace: workspace.id})})|raw }}</div>
                {% else %}
                    <div class="picker" style="max-height:420px;overflow:auto;">
                        {% for c in db_connections %}
                            <button type="button" class="picker-row" data-conn="{{ c.id }}">
                                <span class="kind m-db">{{ c.type|upper|slice(0,5) }}</span>
                                <span class="name">{{ c.name }}</span>
                                <span class="sub" style="min-width:0;">{{ c.host }}{{ c.databaseName ? ' / ' ~ c.databaseName }}</span>
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
        {# setvar #}
        <div data-pane="setvar" hidden>
            <div class="card-body">
                <h2>{{ 'Set variable'|trans }}</h2>
                <p class="subtitle">{{ 'Set a variable to a fixed value or with <code>{{expression}}</code>; it is used in later steps.'|trans|raw }}</p>
                <p class="fhint" style="margin-bottom:14px;">{{ 'You will edit the assignments after the step is added.'|trans }}</p>
                <button type="button" class="btn" data-submit="setvar">{{ ic.i('wrench', 13) }}{{ 'Add variable step'|trans }}</button>
            </div>
        </div>
        {# call sub-flow #}
        <div data-pane="call" hidden>
            <div class="card-body">
                <h2>{{ 'Call sub-flow'|trans }}</h2>
                <p class="subtitle" style="margin-bottom:14px;">{{ "The selected flow's steps run here with the same variable context — by reference, always the current version."|trans }}</p>
                {% if callable_flows is empty %}
                    <div class="empty" style="text-align:left;">{{ 'No other callable flow. First create another flow.'|trans }}</div>
                {% else %}
                    <div class="picker" style="max-height:420px;overflow:auto;">
                        {% for cf in callable_flows %}
                            <button type="button" class="picker-row" data-callflow="{{ cf.id }}">
                                <span class="kind m-call">{{ 'FLOW'|trans }}</span>
                                <span class="name">{{ cf.name }}</span>
                                <span class="sub" style="min-width:0;">{{ '%count% step|%count% steps'|trans({'%count%': cf.steps|length}) }}</span>
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
        {# delay #}
        <div data-pane="delay" hidden>
            <div class="card-body">
                <h2>{{ 'Wait'|trans }}</h2>
                <p class="subtitle">{{ 'Add a delay between steps so async operations (webhook, queue) can finish.'|trans }}</p>
                <p class="fhint" style="margin-bottom:14px;">{{ 'Default 1000 ms — you can edit it later.'|trans }}</p>
                <button type="button" class="btn" data-submit="delay">{{ ic.i('clock', 13) }}{{ 'Add wait step'|trans }}</button>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="reqData">[
{% for r in available_requests %}{"id":"{{ r.id }}","name":{{ r.name|json_encode|raw }},"method":"{{ r.method }}","coll":{{ r.collection.name|json_encode|raw }},"url":{{ (r.url ?: '')|json_encode|raw }}}{{ not loop.last ? ',' }}{% endfor %}
]</script>

<script type="application/json" id="sn-i18n">{{ {
    noHit: 'No matching request.'|trans
}|json_encode|raw }}</script>

{% verbatim %}
<script>
(function () {
    var sw = document.getElementById('sw');
    if (!sw) return;
    var T = JSON.parse(document.getElementById('sn-i18n').textContent);
    var token = sw.dataset.token;

    function post(action, field, value) {
        var f = document.createElement('form');
        f.method = 'post'; f.action = action;
        f.innerHTML = '<input type="hidden" name="_token">' + (field ? '<input type="hidden" name="' + field + '">' : '');
        f.querySelector('[name=_token]').value = token;
        if (field) f.querySelector('[name=' + field + ']').value = value;
        document.body.appendChild(f); f.submit();
    }

    // type selection → swap detail pane
    function select(type) {
        document.querySelectorAll('.typebtn').forEach(function (i) { i.classList.toggle('on', i.dataset.type === type); });
        document.querySelectorAll('[data-pane]').forEach(function (p) { p.hidden = p.dataset.pane !== type; });
        if (type === 'http') { var s = document.getElementById('reqSearch'); if (s) s.focus(); }
    }
    document.querySelectorAll('.typebtn').forEach(function (i) {
        i.addEventListener('click', function () { select(i.dataset.type); });
    });

    // utility add buttons
    document.querySelectorAll('[data-submit]').forEach(function (b) {
        b.addEventListener('click', function () { post(sw.dataset.addutil, 'type', b.dataset.submit); });
    });

    // db connections
    document.querySelectorAll('.picker-row[data-conn]').forEach(function (row) {
        row.addEventListener('click', function () { post(sw.dataset.adddb, 'connection', row.dataset.conn); });
    });

    // sub-flow calls
    document.querySelectorAll('.picker-row[data-callflow]').forEach(function (row) {
        row.addEventListener('click', function () { post(sw.dataset.addcall, 'calledFlow', row.dataset.callflow); });
    });

    // request picker: grouped + searchable
    var listEl = document.getElementById('reqList');
    if (listEl) {
        var reqs = JSON.parse(document.getElementById('reqData').textContent || '[]');
        function render(filter) {
            filter = (filter || '').toLowerCase().trim();
            var groups = {}, order = [];
            reqs.forEach(function (r) {
                if (filter && (r.name + ' ' + r.coll + ' ' + r.method + ' ' + r.url).toLowerCase().indexOf(filter) === -1) return;
                if (!groups[r.coll]) { groups[r.coll] = []; order.push(r.coll); }
                groups[r.coll].push(r);
            });
            listEl.innerHTML = '';
            if (!order.length) { var nh = document.createElement('div'); nh.className = 'empty'; nh.style.border = 'none'; nh.textContent = T.noHit; listEl.appendChild(nh); return; }
            order.forEach(function (coll) {
                var h = document.createElement('div'); h.className = 'picker-group'; h.textContent = coll; listEl.appendChild(h);
                groups[coll].forEach(function (r) {
                    var b = document.createElement('button'); b.type = 'button'; b.className = 'picker-row';
                    var m = document.createElement('span'); m.className = 'kind m-' + r.method.toLowerCase(); m.textContent = r.method;
                    var nm = document.createElement('span'); nm.className = 'name'; nm.textContent = r.name;
                    b.appendChild(m); b.appendChild(nm);
                    if (r.url) { var p = document.createElement('span'); p.className = 'sub'; p.style.minWidth = '0'; p.textContent = r.url; b.appendChild(p); }
                    b.addEventListener('click', function () { post(sw.dataset.add, 'request', r.id); });
                    listEl.appendChild(b);
                });
            });
        }
        render('');
        document.getElementById('reqSearch').addEventListener('input', function () { render(this.value); });
    }
})();
</script>
{% endverbatim %}
{% endblock %}
