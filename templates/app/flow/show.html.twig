{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}
{% import 'app/_runline.html.twig' as rl %}

{% block title %}{{ flow.name }} · Signal{% endblock %}

{% block panel %}
<div class="flowpage"
     data-async-url="{{ path('app_flow_run_async', {workspace: workspace.id, flow: flow.id}) }}"
     data-token="{{ csrf_token('run-flow' ~ flow.id) }}"
     id="flowPage">

    <div class="pagehead">
        <div>
            <h1>{{ flow.name }}</h1>
            <div style="display:flex;flex-wrap:wrap;gap:7px;margin-top:8px;">
                <span class="pill"><b style="color:var(--ink);">{{ flow.steps|length }}</b> {{ 'steps'|trans }}</span>
                <span class="pill">{{ ic.i('environments', 11) }}{{ flow.defaultEnvironment ? 'default:'|trans ~ ' ' : 'no env'|trans }}<b style="color:var(--ink);">{{ flow.defaultEnvironment ? flow.defaultEnvironment.name }}</b></span>
                <span class="pill">{{ flow.stopOnFailure ? 'stops at the first error'|trans : 'runs all steps'|trans }}</span>
                {% if flow.scheduleEnabled %}
                    <span class="pill passed">{{ ic.i('clock', 11) }}<b>{{ flow.cronExpression }}</b></span>
                {% endif %}
            </div>
        </div>
        <div class="actions">
            <a class="btn ghost" href="{{ path('app_flow_index', {workspace: workspace.id}) }}">
                <span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>{{ 'Flows'|trans }}</a>
            <form method="post" action="{{ path('app_flow_delete', {workspace: workspace.id, flow: flow.id}) }}" onsubmit="return confirm('{{ 'This flow will be permanently deleted.'|trans|e('js') }}');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ flow.id) }}">
                <button class="btn danger" type="submit">{{ ic.i('trash', 13) }}{{ 'Delete'|trans }}</button>
            </form>
        </div>
    </div>

    {% if flow.description %}<p class="subtitle" style="margin:0 0 4px;max-width:680px;">{{ flow.description }}</p>{% endif %}

    {# two columns; they wrap instead of collapsing behind a media query #}
    <div style="display:flex;gap:22px;align-items:flex-start;flex-wrap:wrap;margin-top:20px;">
        {# ============ LEFT: the vertical timeline ============ #}
        <div style="flex:2.2 1 440px;min-width:0;">
            <div style="display:flex;align-items:center;gap:9px;margin-bottom:14px;">
                <span class="eyebrow">{{ 'Flow steps'|trans }}</span>
                <span style="height:1px;flex:1;background:var(--line);"></span>
                <span class="mono" style="font-size:10.5px;color:var(--muted);">{{ flow.steps|length }}</span>
            </div>

            {% if flow.steps is empty %}
                <div class="empty" style="text-align:left;">{{ 'No steps yet. Add the first one with <b>+ Add step</b> below.'|trans|raw }}</div>
            {% else %}
            <div class="track" id="runtrack">
                {% for step in flow.steps %}
                    {% set badge = step.isCall ? 'CALL' : (step.isDb ? 'DB' : (step.isSetvar ? 'SET' : (step.isDelay ? 'WAIT' : step.reqMethod))) %}
                    {% set kindCls = step.isCall ? 'm-call' : (step.isDb ? 'm-db' : (step.isSetvar ? 'm-set' : (step.isDelay ? 'm-wait' : 'm-' ~ step.reqMethod|lower))) %}
                    <div class="track-row" data-pos="{{ loop.index0 }}">
                        <div class="track-rail"><div class="node" data-pos="{{ loop.index0 }}" data-idx="{{ loop.index }}">{{ loop.index }}</div></div>
                        <div class="step-card" data-pos="{{ loop.index0 }}" style="cursor:default;">
                            <div class="head">
                                <span class="kind {{ kindCls }}">{{ badge }}</span>
                                <span class="name">{{ step.name }}</span>
                                <span class="live" data-pos="{{ loop.index0 }}"></span>
                                <div style="display:flex;gap:4px;align-items:center;flex-shrink:0;">
                                    <form method="post" action="{{ path('app_flow_step_move', {workspace: workspace.id, flow: flow.id, step: step.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('move-step' ~ step.id) }}">
                                        <input type="hidden" name="direction" value="up">
                                        <button class="icon-btn" style="width:24px;height:24px;" type="submit" title="{{ 'Move up'|trans }}" {{ loop.first ? 'disabled' }}>{{ ic.i('arrow-up', 11, 2.4) }}</button>
                                    </form>
                                    <form method="post" action="{{ path('app_flow_step_move', {workspace: workspace.id, flow: flow.id, step: step.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('move-step' ~ step.id) }}">
                                        <input type="hidden" name="direction" value="down">
                                        <button class="icon-btn" style="width:24px;height:24px;" type="submit" title="{{ 'Move down'|trans }}" {{ loop.last ? 'disabled' }}>{{ ic.i('arrow-down', 11, 2.4) }}</button>
                                    </form>
                                    <a class="icon-btn" style="width:24px;height:24px;" href="{{ path('app_flow_step_edit', {workspace: workspace.id, flow: flow.id, step: step.id}) }}" title="{{ 'Edit'|trans }}">{{ ic.i('pencil', 12) }}</a>
                                    <form method="post" action="{{ path('app_flow_step_delete', {workspace: workspace.id, flow: flow.id, step: step.id}) }}" onsubmit="return confirm('{{ 'The step will be deleted.'|trans|e('js') }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ step.id) }}">
                                        <button class="icon-btn" style="width:24px;height:24px;" type="submit" title="{{ 'Delete'|trans }}">{{ ic.i('trash', 12) }}</button>
                                    </form>
                                </div>
                            </div>
                            <div class="detail">
                                {% if step.isCall %}{% if step.calledFlow %}{{ step.calledFlow.name }} ({{ '%count% steps'|trans({'%count%': step.calledFlow.steps|length}) }}){% else %}<span style="color:var(--fail);">{{ 'sub-flow deleted'|trans }}</span>{% endif %}
                                {% elseif step.isDelay %}{{ 'wait %ms% ms'|trans({'%ms%': step.query ?: 0}) }}
                                {% elseif step.isSetvar %}{{ (step.query ?: '(no assignment)'|trans)|slice(0, 90) }}
                                {% elseif step.isDb %}{% if step.dbConnection %}{{ step.dbConnection.type }} · {{ (step.query ?: '(no query)'|trans)|slice(0, 80) }}{% else %}<span style="color:var(--fail);">{{ 'connection deleted'|trans }}</span>{% endif %}
                                {% else %}{{ step.reqMethod }} {{ step.reqUrl ?: '(URL empty)'|trans }}{% endif %}
                            </div>
                            {% set verifiable = not step.isDelay and not step.isSetvar and not step.isCall %}
                            {% if step.hasCondition or step.hasLoop or verifiable %}
                            <div class="chips">
                                {% if step.hasCondition %}
                                    <span class="chip">{{ 'only if:'|trans }} {{ step.condition.left }} {{ step.condition.op }} {{ step.condition.right }}</span>
                                {% endif %}
                                {% if step.hasLoop %}
                                    <span class="chip var">{{ 'each'|trans }} {{ step.loop.as }} ∈ {{ step.loop.over }}</span>
                                {% endif %}
                                {% if verifiable %}
                                    <span class="chip">{{ '%count% extraction'|trans({'%count%': step.extractions|length}) }}</span>
                                    <span class="chip">{{ '%count% assertion'|trans({'%count%': step.assertions|length}) }}</span>
                                    {% if step.retryEnabled %}<span class="chip retry">{{ step.retryMax }}× / {{ step.retryDelayMs }}ms</span>{% endif %}
                                {% endif %}
                            </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% endif %}

            {# live execution trace — built from run status (handles sub-flows/loops) #}
            <div class="track" id="liveTrack" style="display:none;"></div>

            {# add control — opens the step-type chooser page #}
            <div class="track-add" id="addControl">
                <div class="slot"><span class="plus">{{ ic.i('plus', 12, 2.2) }}</span></div>
                <a class="btn-add" href="{{ path('app_flow_step_new', {workspace: workspace.id, flow: flow.id}) }}"
                   style="text-align:center;">+ {{ 'Add step'|trans }}</a>
            </div>
        </div>

        {# ============ RIGHT: run console + live status ============ #}
        <div style="flex:1 1 300px;min-width:0;">
            <div class="card">
                <div class="card-head"><span class="t">{{ 'Run'|trans }}</span></div>
                <div class="card-body">
                    <div class="field">
                        <label for="runEnv">{{ 'Environment'|trans }}</label>
                        <select id="runEnv">
                            <option value="">{{ flow.defaultEnvironment ? '(default: %name%)'|trans({'%name%': flow.defaultEnvironment.name}) : '— none —'|trans }}</option>
                            {% for env in environments %}<option value="{{ env.id }}">{{ env.name }}</option>{% endfor %}
                        </select>
                    </div>
                    <div class="field">
                        <label>{{ 'Variables'|trans }}</label>
                        {% if flow_variables is empty %}
                            <p class="fhint" style="margin-top:0;">{{ 'This flow needs no extra variables. You can add some manually below if you want.'|trans }}</p>
                        {% endif %}
                        <div id="varList">
                            {% for v in flow_variables %}
                                <div class="var-row var-card">
                                    <div class="top">
                                        <span class="vname" title="{{ v.name }}">{{ v.name }}</span>
                                        {% if v.fromEnv %}<span class="var-src env" title="{{ 'Provided by the environment — used if you leave this empty'|trans }}">env</span>{% endif %}
                                    </div>
                                    <input type="text" class="var-in input-mono" data-var="{{ v.name }}"
                                           placeholder="{{ v.fromEnv ? (v.envValue|length > 22 ? v.envValue|slice(0,22) ~ '…' : v.envValue) : 'enter value'|trans }}">
                                </div>
                            {% endfor %}
                        </div>
                        <a class="add-dashed" id="addVarBtn" style="display:block;text-align:center;">+ {{ 'add variable'|trans }}</a>
                    </div>

                    <button class="btn block" id="runLive" style="margin-top:4px;padding:11px;" {{ flow.steps is empty ? 'disabled' }}>{{ 'Run live'|trans }}</button>
                    <form method="post" action="{{ path('app_flow_run', {workspace: workspace.id, flow: flow.id}) }}" style="margin-top:8px;" id="syncForm">
                        <input type="hidden" name="_token" value="{{ csrf_token('run-flow' ~ flow.id) }}">
                        <input type="hidden" name="environment" id="syncEnv">
                        <input type="hidden" name="variables" id="syncVars">
                        <button class="btn ghost block" type="submit" {{ flow.steps is empty ? 'disabled' }} title="{{ 'Run synchronously, open the result when done'|trans }}">{{ 'Run and wait'|trans }}</button>
                    </form>
                </div>
            </div>

            {# live status — populated by JS #}
            <div class="card" id="livebox" style="margin-top:12px;padding:14px 15px;" hidden>
                <div style="display:flex;align-items:center;gap:9px;">
                    <span class="dot running" id="lbDot"></span>
                    <span id="lbTitle" style="font-size:12.5px;font-weight:700;color:var(--ink);">{{ 'Running…'|trans }}</span>
                    <div class="grow"></div>
                    <button class="btn danger small" id="lbCancel" hidden>{{ 'Cancel run'|trans }}</button>
                </div>
                <div class="progress"><i id="lbFill" style="width:0;"></i></div>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:8px;">
                    <span class="mono" id="lbCount" style="font-size:11px;color:var(--muted);">{{ '%done%/%total% steps'|trans({'%done%': 0, '%total%': flow.steps|length}) }}</span>
                    <a href="#" id="lbDetail" hidden style="font-size:11.5px;font-weight:600;">{{ 'View details'|trans }}</a>
                </div>
            </div>

            {# data-driven #}
            <details class="fold" style="margin-top:12px;">
                <summary>
                    <span class="ic-box">{{ ic.i('table', 15) }}</span>                    <span><span class="t">{{ 'Run data-driven'|trans }}</span></span>
                    <span class="chev">{{ ic.i('chevron-r', 12) }}</span>
                </summary>
                <div class="fold-body">
                    <form method="post" action="{{ path('app_flow_run_data', {workspace: workspace.id, flow: flow.id}) }}"
                          id="ddForm" data-cols="{{ flow_variables|map(v => v.name)|json_encode|e('html_attr') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('run-flow' ~ flow.id) }}">
                        <div class="field">
                            <label for="ddEnv">{{ 'Environment'|trans }}</label>
                            <select name="environment" id="ddEnv">
                                <option value="">{{ flow.defaultEnvironment ? '(default: %name%)'|trans({'%name%': flow.defaultEnvironment.name}) : '— none —'|trans }}</option>
                                {% for env in environments %}<option value="{{ env.id }}">{{ env.name }}</option>{% endfor %}
                            </select>
                        </div>
                        <div style="overflow-x:auto;"><table class="data" id="ddTable"></table></div>
                        <div style="display:flex;gap:8px;margin:10px 0;">
                            <button class="btn ghost small" type="button" id="ddAddRow">+ {{ 'Row'|trans }}</button>
                            <button class="btn ghost small" type="button" id="ddAddCol">+ {{ 'Column'|trans }}</button>
                        </div>
                        <input type="hidden" name="dataset" id="ddDataset">
                        <p class="fhint" style="margin:0 0 10px;">{{ 'Each row is one run. Columns map to the <code>{{variable}}</code>s in the flow.'|trans|raw }}</p>
                        <button class="btn small" type="submit" {{ flow.steps is empty ? 'disabled' }}>{{ ic.i('flows', 11) }}{{ 'Run with dataset'|trans }}</button>
                    </form>
                </div>
            </details>

            {# schedule #}
            <details class="fold" {{ flow.scheduleEnabled ? 'open' }}>
                <summary>
                    <span class="ic-box warn">{{ ic.i('clock', 15) }}</span>
                    <span><span class="t">{{ 'Schedule'|trans }}</span></span>
                    {% if flow.scheduleEnabled %}<span class="pill passed">{{ 'on'|trans }}</span>{% endif %}
                    <span class="chev">{{ ic.i('chevron-r', 12) }}</span>
                </summary>
                <div class="fold-body">
                    <form method="post" action="{{ path('app_flow_schedule', {workspace: workspace.id, flow: flow.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('schedule' ~ flow.id) }}">
                        <label style="display:inline-flex;align-items:center;gap:8px;font-size:12.5px;margin-bottom:10px;">
                            <input type="checkbox" name="scheduleEnabled" value="1" {{ flow.scheduleEnabled ? 'checked' }} style="width:auto;"> {{ 'Active'|trans }}</label>
                        <input type="text" name="cronExpression" value="{{ flow.cronExpression }}" placeholder="*/5 * * * *" class="input-mono" style="margin-bottom:10px;">
                        <p class="fhint" style="margin:0 0 10px;">{{ '5-field cron · <code>app:run-due-flows</code> runs every minute.'|trans|raw }}</p>
                        <button class="btn small" type="submit">{{ 'Save'|trans }}</button>
                    </form>
                </div>
            </details>
        </div>
    </div>

    {# ============ run history ============ #}
    <div style="margin-top:30px;">
        <div style="display:flex;align-items:center;gap:9px;margin-bottom:12px;">
            <span class="eyebrow">{{ 'Run history'|trans }}</span>
            <span style="height:1px;flex:1;background:var(--line);"></span>
        </div>
        {% if flow.runs is empty %}
            <div class="empty" style="text-align:left;">{{ 'No runs yet. Run the flow from above.'|trans }}</div>
        {% else %}
            {% for run in flow.runs %}
                <a class="hi-row" href="{{ path('app_flow_run_show', {workspace: workspace.id, flow: flow.id, run: run.id}) }}">
                    <span class="hi-dot {{ run.status }}"></span>
                    <span class="hi-flow">
                        <span class="nm">{{ '%done%/%total% steps'|trans({'%done%': run.passedSteps, '%total%': run.totalSteps}) }}</span>
                        <span class="tags">
                            <span class="hi-tag">{{ run.environmentName ?: 'no env'|trans }}</span>
                            {% if run.batchId %}<span class="hi-tag suite">data #{{ run.iteration + 1 }}</span>{% endif %}
                        </span>
                    </span>
                    {{ rl.line(run) }}
                    <span class="hi-num">{{ run.durationMs is not null ? run.durationMs ~ ' ms' : '—' }}</span>
                    <span class="hi-date">{{ run.createdAt|date('d.m.Y H:i:s') }}</span>
                    {{ include('app/flow/_status.html.twig', {status: run.status}) }}
                </a>
            {% endfor %}
        {% endif %}
    </div>
</div>

<script type="application/json" id="fp-i18n">{{ {
    error: 'error'|trans,
    runningLive: 'running'|trans,
    skipped: 'skipped'|trans,
    steps: '%done%/%total% steps'|trans,
    cancelRequested: ' · cancel requested…'|trans,
    donePassed: 'Completed — all steps passed'|trans,
    cancelled: 'Cancelled'|trans,
    failed: 'Failed'|trans,
    starting: 'Starting…'|trans,
    runningTitle: 'Running…'|trans,
    runLive: 'Run live'|trans,
    notStarted: 'Could not start'|trans,
    notStartedWorker: 'Could not start — is the worker running?'|trans,
    varName: 'variable'|trans,
    varValue: 'value'|trans
}|json_encode|raw }}</script>

{# node glyphs as icons — the same Lucide set the templates use #}
<script type="application/json" id="fp-glyphs">{{ {
    passed: ic.i('check', 13, 3) ~ '',
    failed: ic.i('x', 13, 3) ~ '',
    error: ic.i('x', 13, 3) ~ '',
    skipped: ic.i('minus', 13, 3) ~ ''
}|json_encode|raw }}</script>

{% verbatim %}
<script>
(function () {
    var page = document.getElementById('flowPage');
    if (!page) return;
    var T = JSON.parse(document.getElementById('fp-i18n').textContent);
    var GLYPH = JSON.parse(document.getElementById('fp-glyphs').textContent);
    var asyncUrl = page.dataset.asyncUrl, token = page.dataset.token;
    var runBtn = document.getElementById('runLive');
    var box = document.getElementById('livebox'), dot = document.getElementById('lbDot');
    var title = document.getElementById('lbTitle'), fill = document.getElementById('lbFill');
    var count = document.getElementById('lbCount'), detail = document.getElementById('lbDetail');
    var cancelBtn = document.getElementById('lbCancel');
    var staticTrack = document.getElementById('runtrack');
    var liveTrack = document.getElementById('liveTrack');
    var addControl = document.getElementById('addControl');
    var total = staticTrack ? staticTrack.querySelectorAll('.node').length : 0;

    function stepsLabel(done, all, cancelRequested) {
        return T.steps.replace('%done%', done).replace('%total%', all) + (cancelRequested ? T.cancelRequested : '');
    }

    // Switch the left column from the authored (static) list to a live trace,
    // which is rebuilt each poll from the run's step results — so sub-flow and
    // loop iterations (expanded positions) all show, with their real labels.
    function enterLiveMode() {
        if (staticTrack) staticTrack.style.display = 'none';
        if (addControl) addControl.style.display = 'none';
        liveTrack.style.display = '';
        liveTrack.innerHTML = '';
    }

    function badgeInfo(method) {
        var m = (method || '').toString();
        return { label: m || '·', cls: 'm-' + m.toLowerCase() };
    }

    function renderLive(steps) {
        liveTrack.innerHTML = '';
        steps.forEach(function (s, i) {
            var st = s.status;
            var row = document.createElement('div'); row.className = 'track-row';
            if (st === 'passed') row.classList.add('passed');
            if (st === 'failed' || st === 'error') row.classList.add('failed');

            var rail = document.createElement('div'); rail.className = 'track-rail';
            var node = document.createElement('div'); node.className = 'node ' + st;
            var g = GLYPH[st];
            if (g) node.innerHTML = g; else node.textContent = (i + 1);
            rail.appendChild(node);

            var card = document.createElement('div'); card.className = 'step-card ' + st;
            card.style.cursor = 'default';
            var head = document.createElement('div'); head.className = 'head';
            var b = badgeInfo(s.method);
            var badge = document.createElement('span'); badge.className = 'kind ' + b.cls; badge.textContent = b.label;
            var name = document.createElement('span'); name.className = 'name'; name.textContent = s.label || '';
            var live = document.createElement('span'); live.className = 'live ' + st;
            if (st === 'passed' && s.responseStatus) { live.textContent = s.responseStatus + ' · ' + (s.durationMs || 0) + 'ms'; }
            else if (st === 'failed' || st === 'error') { live.textContent = (s.responseStatus || T.error); }
            else if (st === 'running') { live.textContent = T.runningLive; }
            else if (st === 'skipped') { live.textContent = T.skipped; }
            head.appendChild(badge); head.appendChild(name); head.appendChild(live);
            card.appendChild(head);

            row.appendChild(rail); row.appendChild(card);
            liveTrack.appendChild(row);
        });
    }

    function setHead(state, label) {
        dot.className = 'dot ' + (state === 'running' ? 'running' : state);
        title.textContent = label;
    }

    function poll(url, detailUrl) {
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                renderLive(d.steps || []);
                var done = d.passedSteps || 0;
                total = d.totalSteps || total;
                fill.style.width = (total ? Math.min(100, Math.round((done / total) * 100)) : 0) + '%';
                count.textContent = stepsLabel(done, d.totalSteps || total, d.cancelRequested);
                if (d.finished) {
                    cancelBtn.hidden = true;
                    if (d.status === 'passed') { setHead('passed', T.donePassed); fill.className = 'passed'; fill.style.width = '100%'; }
                    else if (d.status === 'cancelled') { setHead('cancelled', T.cancelled); }
                    else { setHead('failed', T.failed); fill.className = 'failed'; }
                    detail.hidden = false; detail.href = detailUrl;
                    return;
                }
                setTimeout(function () { poll(url, detailUrl); }, 900);
            })
            .catch(function () { setTimeout(function () { poll(url, detailUrl); }, 2000); });
    }

    runBtn.addEventListener('click', function () {
        var env = document.getElementById('runEnv').value;
        var vars = collectVars();
        var body = new URLSearchParams();
        body.set('_token', token);
        body.set('environment', env);
        if (vars) body.set('variables', vars);

        runBtn.disabled = true; runBtn.textContent = T.starting;
        enterLiveMode();
        box.hidden = false; fill.className = ''; fill.style.width = '0';
        setHead('running', T.runningTitle); detail.hidden = true; cancelBtn.hidden = true;
        count.textContent = stepsLabel(0, total, false);

        fetch(asyncUrl, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
        })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                runBtn.disabled = false; runBtn.textContent = T.runLive;
                if (!d.statusUrl) { setHead('failed', T.notStarted); return; }
                total = d.totalSteps || total;
                poll(d.statusUrl, d.detailUrl);
            })
            .catch(function () {
                runBtn.disabled = false; runBtn.textContent = T.runLive;
                setHead('failed', T.notStartedWorker);
            });
    });

    // mirror console values into the synchronous fallback form
    var syncForm = document.getElementById('syncForm');
    if (syncForm) {
        syncForm.addEventListener('submit', function () {
            document.getElementById('syncEnv').value = document.getElementById('runEnv').value;
            document.getElementById('syncVars').value = collectVars();
        });
    }

    // ---- variable table → {name: value} JSON (empty values skipped) ----
    function collectVars() {
        var out = {};
        document.querySelectorAll('#varList .var-row').forEach(function (row) {
            var fixed = row.querySelector('.var-in');
            var name, val;
            if (fixed) { name = fixed.dataset.var; val = fixed.value.trim(); }
            else {
                var k = row.querySelector('.var-key'), v = row.querySelector('.var-val');
                if (!k) return; name = k.value.trim(); val = v ? v.value.trim() : '';
            }
            if (name && val !== '') out[name] = val;
        });
        return Object.keys(out).length ? JSON.stringify(out) : '';
    }
    var addVarBtn = document.getElementById('addVarBtn');
    if (addVarBtn) addVarBtn.addEventListener('click', function () {
        var row = document.createElement('div'); row.className = 'var-row var-card';
        row.innerHTML = '<div class="top"><input class="var-key input-mono" placeholder="' + T.varName + '">'
            + '<button type="button" class="var-rm icon-btn" style="width:22px;height:22px;flex-shrink:0">×</button></div>'
            + '<input class="var-val var-in-c input-mono" placeholder="' + T.varValue + '">';
        row.querySelector('.var-rm').addEventListener('click', function () { row.remove(); });
        document.getElementById('varList').appendChild(row);
        row.querySelector('.var-key').focus();
    });

    // ---- data-driven grid: model {cols, rows} → dataset JSON ----
    var ddForm = document.getElementById('ddForm');
    if (ddForm) {
        var ddTable = document.getElementById('ddTable');
        var cols = [];
        try { cols = JSON.parse(ddForm.dataset.cols || '[]'); } catch (e) { cols = []; }
        if (!cols.length) cols = ['value'];
        var rows = [ cols.map(function () { return ''; }), cols.map(function () { return ''; }) ];
        var CELL = ' style="padding:0" ';
        var INPUT = ' style="border:none;border-radius:0;background:transparent;padding:7px 9px" ';

        function renderDd() {
            var thead = '<tr>' + cols.map(function (c, ci) {
                return '<th' + CELL + '><input class="dd-col input-mono"' + INPUT + 'data-c="' + ci + '" value="' + String(c).replace(/"/g, '&quot;') + '"></th>';
            }).join('') + '<th style="width:34px;"></th></tr>';
            var body = rows.map(function (r, ri) {
                return '<tr>' + cols.map(function (c, ci) {
                    return '<td' + CELL + '><input class="input-mono"' + INPUT + 'data-r="' + ri + '" data-cc="' + ci + '" value="' + String(r[ci] || '').replace(/"/g, '&quot;') + '"></td>';
                }).join('') + '<td' + CELL + '><button type="button" class="icon-btn" style="width:26px;height:26px;border:none;background:none" data-del="' + ri + '">×</button></td></tr>';
            }).join('');
            ddTable.innerHTML = '<thead>' + thead + '</thead><tbody>' + body + '</tbody>';
        }
        // read edits back into the model on any input
        ddTable.addEventListener('input', function (e) {
            var t = e.target;
            if (t.classList.contains('dd-col')) { cols[+t.dataset.c] = t.value; }
            else if (t.dataset.r !== undefined) { rows[+t.dataset.r][+t.dataset.cc] = t.value; }
        });
        ddTable.addEventListener('click', function (e) {
            if (e.target.dataset.del !== undefined) { rows.splice(+e.target.dataset.del, 1); if (!rows.length) rows.push(cols.map(function(){return '';})); renderDd(); }
        });
        document.getElementById('ddAddRow').addEventListener('click', function () { rows.push(cols.map(function () { return ''; })); renderDd(); });
        document.getElementById('ddAddCol').addEventListener('click', function () {
            cols.push('column' + (cols.length + 1)); rows.forEach(function (r) { r.push(''); }); renderDd();
        });
        ddForm.addEventListener('submit', function () {
            var data = [];
            rows.forEach(function (r) {
                var obj = {}, any = false;
                cols.forEach(function (c, ci) { var name = String(c).trim(); var val = (r[ci] || '').trim(); if (name && val !== '') { obj[name] = val; any = true; } });
                if (any) data.push(obj);
            });
            document.getElementById('ddDataset').value = JSON.stringify(data);
        });
        renderDd();
    }
})();
</script>
{% endverbatim %}
