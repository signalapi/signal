{# ==========================================================================
   templates/app/flow/step_edit.html.twig  —  two-pane step editor.
   REPLACES the single-column stacked form.

   Controller: no signature change. renderEditor() already passes everything
   this template needs — step, extractions_text, assertions_text, connections,
   flows, vc_catalog, is_new, create_ctx.

   IMPORTANT — how the form still posts:
   the rule / transfer rows are a JS model, serialised on submit into the two
   hidden textareas 'assertions' and 'extractions' in exactly the DSL that
   FlowExpressionParser::parseAssertions()/parseExtractions() already reads.
   Nothing on the PHP side changes.
   ========================================================================== #}
{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ is_new|default(false) ? 'New step'|trans : 'Edit step'|trans }} · {{ flow.name }}{% endblock %}

{% block panel %}
{% set is_new = is_new|default(false) %}
{% set badge = step.isCall ? 'CALL' : (step.isDb ? 'DB' : (step.isSetvar ? 'SET' : (step.isDelay ? 'WAIT' : step.reqMethod))) %}
{% set kindCls = step.isCall ? 'm-call' : (step.isDb ? 'm-db' : (step.isSetvar ? 'm-set' : (step.isDelay ? 'm-wait' : 'm-' ~ step.reqMethod|lower))) %}
{% set cond = step.condition %}
{% set lp = step.loop %}
{% set verifiable = not step.isSetvar and not step.isDelay and not step.isCall %}

<form method="post" id="stepForm" class="editor"
      {% if is_new %}action="{{ path('app_flow_step_store', {workspace: workspace.id, flow: flow.id}) }}"{% endif %}
      data-probe="{{ is_new ? '' : path('app_flow_step_probe', {workspace: workspace.id, flow: flow.id, step: step.id}) }}"
      data-isdb="{{ step.isDb ? '1' : '0' }}">
    <input type="hidden" name="_token" value="{{ is_new ? csrf_token('new-step' ~ flow.id) : csrf_token('edit-step' ~ step.id) }}">
    {% if is_new %}
        <input type="hidden" name="stepType" value="{{ create_ctx.type }}">
        {% if create_ctx.reqId is defined %}<input type="hidden" name="reqId" value="{{ create_ctx.reqId }}">{% endif %}
    {% endif %}
    {# serialised by JS on submit — the DSL the parser already understands #}
    <textarea name="assertions" id="assertionsText" hidden>{{ assertions_text }}</textarea>
    <textarea name="extractions" id="extractionsText" hidden>{{ extractions_text }}</textarea>

    {# ------------------------------------------------ head #}
    <div class="editor-head">
        <div class="crumbs">
            <a href="{{ path('app_flow_index', {workspace: workspace.id}) }}">{{ 'Tests'|trans }}</a><span>/</span>
            <a href="{{ path('app_flow_show', {workspace: workspace.id, flow: flow.id}) }}">{{ flow.name }}</a><span>/</span>
            <span style="color:var(--ink);font-weight:600">{{ is_new ? 'New step'|trans : 'Step %n%'|trans({'%n%': step.position + 1}) }}</span>
        </div>
        <div class="editor-title">
            <span class="kind {{ kindCls }}">{{ badge }}</span>
            <input class="title-input" type="text" name="name" value="{{ step.name }}"
                   placeholder="{{ 'Step name'|trans }}" aria-label="{{ 'Step name'|trans }}">
            <div class="grow"></div>
            <span class="pill" id="dirtyPill" hidden style="background:var(--warn-soft);color:var(--warn)">
                <span class="dot" style="background:var(--warn)"></span>{{ 'unsaved changes'|trans }}</span>
            <a class="btn danger" href="{{ path('app_flow_show', {workspace: workspace.id, flow: flow.id}) }}">{{ 'Discard'|trans }}</a>
            <button class="btn" type="submit">{{ ic.i('check', 13, 2.6) }}{{ 'Save step'|trans }}</button>
        </div>

        {# behaviour chips — one row instead of three stacked cards #}
        <div class="behaviours">
            <button type="button" class="bchip {{ cond.left ?? '' ? 'set' }}" data-b="cond">
                {{ ic.i('git', 13) }}<strong>{{ 'Condition'|trans }}</strong>
                <span class="val">{{ cond.left ?? '' ? cond.left ~ ' ' ~ cond.op ~ ' ' ~ cond.right : 'always runs'|trans }}</span></button>
            <button type="button" class="bchip {{ lp.over ?? '' ? 'set' }}" data-b="loop">
                {{ ic.i('rerun', 13) }}<strong>{{ 'Loop'|trans }}</strong>
                <span class="val">{{ lp.over ?? '' ? 'each ' ~ lp.as ~ ' in ' ~ lp.over : 'off'|trans }}</span></button>
            {% if verifiable %}
            <button type="button" class="bchip {{ step.retryEnabled ? 'set' }}" data-b="retry">
                {{ ic.i('rerun', 13) }}<strong>{{ 'Retry'|trans }}</strong>
                <span class="val">{{ step.retryEnabled ? step.retryMax ~ '× / ' ~ step.retryDelayMs ~ 'ms' : 'off'|trans }}</span></button>
            {% endif %}
        </div>

        <div class="bpanel" data-panel="cond" hidden>
            <p class="subtitle" style="margin:0 0 9px">{{ 'The step is skipped when the condition does not hold — not counted as an error.'|trans }}</p>
            <div class="row">
                <input type="text" name="cond_left" value="{{ cond.left ?? '' }}" placeholder="{{ '{{' }}variable{{ '}}' }}" class="input-mono" style="flex:1.4 1 150px">
                <select name="cond_op">
                    {% for val, lbl in {'eq':'equals','ne':'not equal','contains':'contains','matches':'matches regex','gt':'greater than','lt':'less than','ge':'at least (≥)','le':'at most (≤)','exists':'exists (not empty)','empty':'is empty','notEmpty':'is not empty'} %}
                        <option value="{{ val }}" {{ (cond.op ?? 'eq') == val ? 'selected' }}>{{ lbl|trans }}</option>
                    {% endfor %}
                </select>
                <input type="text" name="cond_right" value="{{ cond.right ?? '' }}" placeholder="{{ 'value'|trans }}" class="input-mono" style="flex:1 1 110px">
            </div>
        </div>

        <div class="bpanel" data-panel="loop" hidden>
            <p class="subtitle" style="margin:0 0 9px">{{ 'Runs once per item of a list variable. The item is available as {{item}}, the index as {{item_index}}.'|trans }}</p>
            <div class="row">
                <span class="subtitle">{{ 'each'|trans }}</span>
                <input type="text" name="loop_as" value="{{ lp.as ?? '' }}" placeholder="item" class="input-mono" style="flex:0 0 130px">
                <span class="subtitle">{{ 'in'|trans }}</span>
                <input type="text" name="loop_over" value="{{ lp.over ?? '' }}" placeholder="{{ '{{' }}pkgs{{ '}}' }}" class="input-mono" style="flex:1 1 150px">
            </div>
        </div>

        {% if verifiable %}
        <div class="bpanel" data-panel="retry" hidden>
            <p class="subtitle" style="margin:0 0 9px">{{ 'Re-runs the step until the rules pass — for endpoints that settle asynchronously.'|trans }}</p>
            <div class="row">
                <label class="inline-lbl" style="display:inline-flex;align-items:center;gap:7px;font-size:12px">
                    <input type="checkbox" name="retryEnabled" value="1" {{ step.retryEnabled ? 'checked' }} style="width:auto">
                    {{ 'Enabled'|trans }}</label>
                <span class="subtitle">max</span>
                <input type="number" name="retryMax" value="{{ step.retryMax }}" min="1" max="20" class="input-mono" style="flex:0 0 80px">
                <span class="subtitle">{{ 'delay (ms)'|trans }}</span>
                <input type="number" name="retryDelayMs" value="{{ step.retryDelayMs }}" min="0" max="10000" step="100" class="input-mono" style="flex:0 0 100px">
            </div>
        </div>
        {% endif %}
    </div>

    {# ------------------------------------------------ panes #}
    <div class="editor-panes">

        {# ============ LEFT: configure ============ #}
        <div class="pane left">
            <div class="pane-head">
                <span class="cap">{{ 'Configure'|trans }}</span><span class="sep"></span>
                <span class="subtitle" style="font-size:11px">
                    {%- if step.isDb %}{{ 'read query — writes are blocked'|trans }}
                    {%- elseif step.isCall %}{{ 'called by reference'|trans }}
                    {%- elseif step.isSetvar %}{{ 'for the steps that follow'|trans }}
                    {%- else %}{{ 'this copy belongs to this step only'|trans }}{% endif -%}
                </span>
            </div>
            <div class="pane-body">
            {% if step.isDelay %}
                <label>{{ 'Duration'|trans }}</label>
                <div style="display:flex;gap:7px;align-items:center;margin-bottom:12px">
                    <input type="number" name="query" value="{{ step.query }}" min="0" max="60000" step="100"
                           class="input-mono" style="flex:0 0 130px;text-align:right;font-size:14px;font-weight:700">
                    <span class="mono subtitle">ms</span>
                    <div class="grow"></div>
                    {% for p in [500, 1500, 5000, 15000] %}
                        <button type="button" class="fchip" data-preset="{{ p }}">{{ p }} ms</button>
                    {% endfor %}
                </div>
                <p class="subtitle">{{ 'A fixed pause so async work — webhook, queue, projection — can finish before the next step reads it.'|trans }}</p>

            {% elseif step.isSetvar %}
                <label>{{ 'Assignments'|trans }}</label>
                <p class="subtitle" style="margin:0 0 8px">{{ 'One <code>name = value</code> per line. {{variable}} and {{$generator}} are resolved in the value.'|trans|raw }}</p>
                <div class="code-ed hl" data-hl="setvar">
                    <div class="cb-gutter" aria-hidden="true">1</div>
                    <div class="cb-area">
                        <pre class="cb-hl" aria-hidden="true"></pre>
                        <textarea name="query" rows="6" data-vc spellcheck="false" placeholder="planId = plan_pro_monthly">{{ step.query }}</textarea>
                    </div>
                </div>

            {% elseif step.isCall %}
                <label>{{ 'Called flow'|trans }}</label>
                <div class="picker" style="margin-bottom:12px">
                    {% for cf in flows %}
                        <label class="picker-row" style="cursor:pointer">
                            <input type="radio" name="calledFlow" value="{{ cf.id }}" style="width:auto"
                                   {{ step.calledFlow and step.calledFlow.id == cf.id ? 'checked' }}>
                            <span class="kind m-flow">FLOW</span>
                            <span class="name">{{ cf.name }}<br>
                                <span class="sub">{{ '%count% step|%count% steps'|trans({'%count%': cf.steps|length}) }}</span></span>
                        </label>
                    {% endfor %}
                </div>
                <div class="hintbox" style="background:var(--vio-soft);color:var(--vio)">
                    {{ ic.i('shield', 15) }}{{ 'By reference: the sub-flow always runs at its current version. Circular calls are blocked.'|trans }}
                </div>

            {% elseif step.isDb %}
                <label>{{ 'Connection'|trans }}</label>
                {% set dbtone = {postgres: ['PG', 'teal'], mysql: ['MY', 'vio'], redis: ['RD', 'fail'], mongo: ['MG', 'pass']} %}
                <div style="display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px">
                    {% for c in connections %}
                        {% set tb = dbtone[c.type] ?? [c.type|slice(0, 2)|upper, ''] %}
                        <label class="typebtn {{ step.dbConnection and step.dbConnection.id == c.id ? 'on' }}">
                            <input type="radio" name="connection" value="{{ c.id }}" hidden
                                   {{ step.dbConnection and step.dbConnection.id == c.id ? 'checked' }}>
                            <span class="tbadge {{ tb[1] }}">{{ tb[0] }}</span>
                            <span><span class="t">{{ c.name }}</span>
                                <span class="s mono">{{ c.host }}{{ c.databaseName ? ' / ' ~ c.databaseName }}</span></span>
                        </label>
                    {% endfor %}
                </div>
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                    <label style="margin:0">{{ 'Query'|trans }}</label><div class="grow"></div>
                    <span class="mono subtitle" style="font-size:10.5px">sql · redis · mongo</span>
                </div>
                <div class="code-ed hl" data-hl="query">
                    <div class="cb-gutter" aria-hidden="true">1</div>
                    <div class="cb-area">
                        <pre class="cb-hl" aria-hidden="true"></pre>
                        <textarea name="query" rows="5" data-vc spellcheck="false" placeholder="SELECT status FROM subscriptions WHERE id = {{ '{{' }}subId{{ '}}' }}">{{ step.query }}</textarea>
                    </div>
                </div>
                <div class="hintbox" style="background:var(--teal-soft);color:var(--teal)">
                    {{ ic.i('shield', 15) }}{{ 'Variables from earlier steps work here.'|trans }}
                </div>

            {% else %}
                <div style="display:flex;gap:7px;align-items:center;margin-bottom:12px">
                    <select name="method" class="method-sel m-{{ step.reqMethod|lower }}" id="methodSel">
                        {% for m in constant('App\\Entity\\ApiRequest::METHODS') %}<option {{ step.reqMethod == m ? 'selected' }}>{{ m }}</option>{% endfor %}
                    </select>
                    <span class="hl-wrap">
                        <span class="hl-bd" aria-hidden="true"></span>
                        <input type="text" name="url" value="{{ step.reqUrl }}" class="input-mono" data-vc data-hl-line
                               placeholder="{{ '{{' }}baseUrl{{ '}}' }}/v3/…">
                    </span>
                </div>

                <div class="tabs" style="display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:12px">
                    {% for id, lbl in {'params':'Params','headers':'Headers','body':'Body','auth':'Auth'} %}
                        <button type="button" class="etab {{ id == 'body' ? 'on' }}" data-tab="{{ id }}">{{ lbl|trans }}<span class="n" data-tabn="{{ id }}"></span></button>
                    {% endfor %}
                </div>

                <div data-panel-tab="params" hidden>
                    {{ include('app/flow/_kvtable.html.twig', {rows: step.reqParams, field: 'param'}) }}
                </div>
                <div data-panel-tab="headers" hidden>
                    {{ include('app/flow/_kvtable.html.twig', {rows: step.reqHeaders, field: 'header'}) }}
                </div>
                <div data-panel-tab="body">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:9px">
                        <select name="bodyMode" class="mono" style="width:auto;font-weight:700">
                            {% for m in ['none','raw','json','form'] %}<option {{ step.reqBodyMode == m ? 'selected' }}>{{ m }}</option>{% endfor %}
                        </select>
                        <button type="button" class="fchip" id="formatBtn">{{ 'Format'|trans }}</button>
                        <div class="grow"></div>
                        <span class="mono" id="jsonState" style="font-size:10.5px;color:var(--pass)"></span>
                    </div>
                    <div class="code-ed hl" data-hl="json">
                        <div class="cb-gutter" aria-hidden="true">1</div>
                        <div class="cb-area">
                            <pre class="cb-hl" aria-hidden="true"></pre>
                            <textarea name="body" rows="10" data-vc spellcheck="false">{{ step.reqBody }}</textarea>
                        </div>
                    </div>
                </div>
                <div data-panel-tab="auth" hidden>
                    {% set auth = step.reqAuth %}
                    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">
                        {% for tp in ['none','bearer','basic','apikey'] %}
                            <label class="fchip {{ (auth.type ?? 'none') == tp ? 'on' }}">
                                <input type="radio" name="authType" value="{{ tp }}" hidden {{ (auth.type ?? 'none') == tp ? 'checked' }}>{{ tp }}</label>
                        {% endfor %}
                    </div>
                    <div data-auth="bearer">
                        <label>{{ 'Bearer token'|trans }}</label>
                        <span class="hl-wrap" style="display:block;">
                            <span class="hl-bd" aria-hidden="true"></span>
                            <input type="text" name="authToken" value="{{ auth.token ?? '' }}" class="input-mono" data-vc data-hl-line placeholder="{{ '{{' }}token{{ '}}' }}">
                        </span>
                    </div>
                    <div data-auth="basic" style="display:flex;gap:8px">
                        <input type="text" name="authUser" value="{{ auth.username ?? '' }}" placeholder="{{ 'username'|trans }}">
                        <input type="text" name="authPass" value="{{ auth.password ?? '' }}" placeholder="{{ 'password'|trans }}">
                    </div>
                    <div data-auth="apikey" style="display:flex;gap:8px">
                        <input type="text" name="authKey" value="{{ auth.key ?? '' }}" placeholder="{{ 'key name'|trans }}">
                        <input type="text" name="authVal" value="{{ auth.value ?? '' }}" placeholder="{{ 'value'|trans }}" class="input-mono">
                        <select name="authAddTo" style="width:auto">
                            <option value="header" {{ (auth.addTo ?? 'header') == 'header' ? 'selected' }}>header</option>
                            <option value="query" {{ (auth.addTo ?? '') == 'query' ? 'selected' }}>query</option>
                        </select>
                    </div>
                </div>
            {% endif %}
            </div>
        </div>

        {# ============ RIGHT: verify ============ #}
        {% if verifiable %}
        <div class="pane right">
            <div class="pane-head">
                <span class="cap">{{ 'Verify'|trans }}</span><span class="sep"></span>
                {% if not is_new %}
                    <button type="button" class="btn ghost small" id="probeBtn" style="color:var(--pri);"
                            data-again="{{ 'Run again'|trans }}">{{ ic.i('import', 13) }}<span data-lbl>{{ 'Run this step'|trans }}</span></button>
                {% endif %}
            </div>
            <div class="pane-body">
                {# probe result — filled by JS #}
                <div id="probeWrap" style="margin-bottom:16px">
                    <div class="probe-empty" id="probeEmpty">
                        <div class="ic-box">{{ ic.i('import', 17) }}</div>
                        <div style="font-size:13px;font-weight:700;color:var(--ink)">{{ 'Run the step once'|trans }}</div>
                        <p class="subtitle" style="max-width:280px;margin:5px auto 0">{{ 'Signal sends it with the flow variables from the last run, then you pick fields from the real response instead of typing paths.'|trans }}</p>
                    </div>
                    <div id="probeResult" hidden>
                        <div class="probe-meta">
                            <span class="probe-pill" id="probeStatus"></span>
                            <span class="mono subtitle" id="probeMeta" data-fields="{{ 'fields'|trans }}" style="font-size:11px"></span>
                            <div class="grow"></div>
                            <span class="subtitle" style="font-size:11px">{{ 'click a field to build a rule'|trans }}</span>
                        </div>
                        <div class="tree" id="tree"></div>
                    </div>
                </div>

                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                    <span style="font-size:12.5px;font-weight:700;color:var(--ink)">{{ 'Rules'|trans }}</span>
                    <span class="chip" id="ruleCount">0</span>
                    <div class="grow"></div>
                    <span class="subtitle" style="font-size:11px">{{ 'all must pass'|trans }}</span>
                </div>
                <div id="ruleRows"></div>
                <button type="button" class="add-dashed" id="addRule" style="margin-bottom:18px">+ {{ 'rule'|trans }}</button>

                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                    <span style="font-size:12.5px;font-weight:700;color:var(--ink)">{{ 'Value transfer'|trans }}</span>
                    <span class="chip" id="extCount">0</span>
                    <div class="grow"></div>
                    <span class="subtitle" style="font-size:11px">{{ 'available later as {{name}}'|trans }}</span>
                </div>
                <div id="extRows"></div>
                <button type="button" class="add-dashed" id="addExt" style="margin-bottom:18px">+ {{ 'transfer'|trans }}</button>

                {% set schemaAssert = step.assertions|filter(a => (a.kind ?? '') == 'schema')|first %}
                <details class="fold" {{ schemaAssert ? 'open' }}>
                    <summary>
                        <span class="ic-box vio">{{ ic.i('shield', 15) }}</span>
                        <span><span class="t">{{ 'JSON schema'|trans }}</span>
                            <span class="s">{{ 'fail when the response shape changes'|trans }}</span></span>
                        <span class="chev">{{ ic.i('chevron-r', 12) }}</span>
                    </summary>
                    <div class="fold-body">
                        <textarea name="schema" id="schemaBox" rows="7" class="input-mono">{{ schemaAssert.schema ?? '' }}</textarea>
                        <div class="fold-actions">
                            <button type="button" class="btn small" id="genSchemaBtn">{{ 'Generate from response'|trans }}</button>
                            <button type="button" class="btn ghost small" id="clearSchemaBtn">{{ 'Clear'|trans }}</button>
                        </div>
                    </div>
                </details>

                {% if not is_new %}
                <details class="fold">
                    <summary>
                        <span class="ic-box warn">{{ ic.i('clock', 15) }}</span>
                        <span><span class="t">{{ 'Response baseline'|trans }}</span>
                            <span class="s">{{ 'compare every run against a captured response'|trans }}</span></span>
                        <span class="chev">{{ ic.i('chevron-r', 12) }}</span>
                    </summary>
                    <div class="fold-body">
                        <div class="code" id="baselineBox">{{ 'No baseline captured yet.'|trans }}</div>
                        <div class="fold-actions">
                            <button type="button" class="btn ghost small"
                                    formaction="{{ path('app_flow_step_reset_baseline', {workspace: workspace.id, flow: flow.id, step: step.id}) }}"
                                    formmethod="post">{{ 'Reset baseline'|trans }}</button>
                        </div>
                    </div>
                </details>
                {% endif %}

                <details class="fold">
                    <summary>
                        <span class="ic-box">{{ ic.i('terminal', 15) }}</span>
                        <span><span class="t">{{ 'Advanced — edit as text'|trans }}</span>
                            <span class="s">{{ 'the same DSL the API accepts'|trans }}</span></span>
                        <span class="chev">{{ ic.i('chevron-r', 12) }}</span>
                    </summary>
                    <div class="fold-body">
                        <textarea id="advAssert" rows="5" class="input-mono" placeholder="status == 200">{{ assertions_text }}</textarea>
                        <textarea id="advExt" rows="4" class="input-mono" placeholder="subId = id" style="margin-top:8px">{{ extractions_text }}</textarea>
                        <div class="fold-actions">
                            <button type="button" class="btn small" id="advApply">{{ 'Apply to rows'|trans }}</button>
                        </div>
                    </div>
                </details>
            </div>
        </div>
        {% endif %}
    </div>

    <script type="application/json" id="vcCatalog">{{ vc_catalog|json_encode|raw }}</script>
</form>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% verbatim %}
<script>
(function () {
    var form = document.getElementById('stepForm');
    if (!form) return;

    // ---- dirty tracking ------------------------------------------------
    var pill = document.getElementById('dirtyPill');
    form.addEventListener('input', function () { if (pill) pill.hidden = false; });
    form.addEventListener('change', function () { if (pill) pill.hidden = false; });

    // ---- behaviour chips ----------------------------------------------
    form.querySelectorAll('.bchip').forEach(function (b) {
        b.addEventListener('click', function () {
            var key = b.dataset.b, panel = form.querySelector('[data-panel="' + key + '"]');
            var opening = panel.hidden;
            form.querySelectorAll('.bpanel').forEach(function (p) { p.hidden = true; });
            form.querySelectorAll('.bchip').forEach(function (c) { c.classList.remove('open'); });
            if (opening) { panel.hidden = false; b.classList.add('open'); }
        });
    });

    // ---- request tabs -------------------------------------------------
    form.querySelectorAll('.etab').forEach(function (t) {
        t.addEventListener('click', function () {
            form.querySelectorAll('.etab').forEach(function (x) { x.classList.remove('on'); });
            t.classList.add('on');
            form.querySelectorAll('[data-panel-tab]').forEach(function (p) {
                p.hidden = p.dataset.panelTab !== t.dataset.tab;
            });
        });
    });

    // ---- delay presets ------------------------------------------------
    form.querySelectorAll('[data-preset]').forEach(function (b) {
        b.addEventListener('click', function () {
            var i = form.querySelector('input[name=query]');
            if (i) { i.value = b.dataset.preset; if (pill) pill.hidden = false; }
        });
    });

    // ---- rule / transfer model ---------------------------------------
    // Serialised back into the DSL the PHP parser reads. One rule per line:
    //   <path> <op> <expected>        e.g.  body.status == active
    //   status == 200
    // One transfer per line:  <name> = <path>
    var OPS = ['==','!=','contains','matches','>','<','>=','<=','exists','empty','notEmpty'];
    var rules = parseRules(document.getElementById('assertionsText').value);
    var exts  = parseExts(document.getElementById('extractionsText').value);

    function parseRules(text) {
        return (text || '').split('\n').map(function (l) { return l.trim(); }).filter(Boolean).map(function (l) {
            var m = l.match(/^(\S+)\s+(==|!=|contains|matches|>=|<=|>|<|exists|empty|notEmpty)\s*(.*)$/);
            return m ? { path: m[1], op: m[2], expected: m[3] } : { path: l, op: '==', expected: '' };
        });
    }
    function parseExts(text) {
        return (text || '').split('\n').map(function (l) { return l.trim(); }).filter(Boolean).map(function (l) {
            var i = l.indexOf('=');
            return i === -1 ? { name: l, path: '' } : { name: l.slice(0, i).trim(), path: l.slice(i + 1).trim() };
        });
    }
    function serialise() {
        document.getElementById('assertionsText').value = rules
            .filter(function (r) { return r.path; })
            .map(function (r) { return (r.path + ' ' + r.op + ' ' + (r.expected || '')).trim(); }).join('\n');
        document.getElementById('extractionsText').value = exts
            .filter(function (e) { return e.name && e.path; })
            .map(function (e) { return e.name + ' = ' + e.path; }).join('\n');
    }

    var IC_OK = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg>';
    var IC_NO = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>';

    function renderRules() {
        var host = document.getElementById('ruleRows');
        if (!host) return;
        host.innerHTML = '';
        rules.forEach(function (r, i) {
            var row = document.createElement('div');
            row.className = 'rule-row';
            row.innerHTML =
                '<span class="status-ic"></span>' +
                '<input type="text" class="path" value="">' +
                '<select class="op">' + OPS.map(function (o) {
                    return '<option' + (o === r.op ? ' selected' : '') + '>' + o + '</option>';
                }).join('') + '</select>' +
                '<input type="text" class="expected" placeholder="expected">' +
                '<span class="actual" hidden></span>' +
                '<button type="button" class="rm">×</button>';
            row.querySelector('.path').value = r.path;
            row.querySelector('.expected').value = r.expected;
            row.querySelector('.path').addEventListener('input', function (e) { r.path = e.target.value; serialise(); evaluateRules(); });
            row.querySelector('.expected').addEventListener('input', function (e) { r.expected = e.target.value; serialise(); evaluateRules(); });
            row.querySelector('.op').addEventListener('change', function (e) { r.op = e.target.value; serialise(); evaluateRules(); });
            row.querySelector('.rm').addEventListener('click', function () { rules.splice(i, 1); renderRules(); serialise(); });
            host.appendChild(row);
        });
        document.getElementById('ruleCount').textContent = rules.length;
        evaluateRules();
    }

    // ---- live rule verdicts against the probed response -----------------
    function resolvePath(path) {
        if (lastProbe && path === 'status' && lastProbe.status !== undefined) return lastProbe.status;
        if (lastProbe && path === 'responseTime' && lastProbe.durationMs !== undefined) return lastProbe.durationMs;
        if (path === 'rowCount' && Array.isArray(lastResponse)) return lastResponse.length;
        var cur = lastResponse;
        path.replace(/^body\./, '').split('.').forEach(function (part) {
            if (cur !== null && typeof cur === 'object') { cur = cur[part]; } else { cur = undefined; }
        });
        return cur;
    }
    function verdict(r) {
        if (!lastProbe || !r.path) return null;
        if ((r.expected || '').indexOf('{' + '{') !== -1) return null;
        var a = resolvePath(r.path), e = r.expected;
        if (a === undefined && r.op !== 'empty' && r.op !== 'exists') return { pass: false, actual: '—' };
        var an = parseFloat(a), en = parseFloat(e), pass;
        switch (r.op) {
            case '==': pass = String(a).replace(/^"|"$/g, '') === e; break;
            case '!=': pass = String(a).replace(/^"|"$/g, '') !== e; break;
            case 'contains': pass = String(a).indexOf(e) !== -1; break;
            case 'matches': try { pass = new RegExp(e).test(String(a)); } catch (err) { return null; } break;
            case '>': pass = an > en; break;
            case '<': pass = an < en; break;
            case '>=': pass = an >= en; break;
            case '<=': pass = an <= en; break;
            case 'exists': pass = a !== undefined && a !== null && a !== ''; break;
            case 'empty': pass = a === undefined || a === null || a === '' || (Array.isArray(a) && !a.length); break;
            case 'notEmpty': pass = !(a === undefined || a === null || a === '' || (Array.isArray(a) && !a.length)); break;
            default: return null;
        }
        return { pass: pass, actual: a === undefined ? '—' : JSON.stringify(a) };
    }
    function evaluateRules() {
        var host = document.getElementById('ruleRows');
        if (!host) return;
        host.querySelectorAll('.rule-row').forEach(function (row, i) {
            var r = rules[i], ic = row.querySelector('.status-ic'), ac = row.querySelector('.actual');
            var v = r ? verdict(r) : null;
            row.classList.toggle('failed', !!(v && !v.pass));
            if (!v) { ic.className = 'status-ic'; ic.innerHTML = ''; ac.hidden = true; return; }
            ic.className = 'status-ic ' + (v.pass ? 'passed' : 'failed');
            ic.innerHTML = v.pass ? IC_OK : IC_NO;
            ac.hidden = false;
            ac.textContent = v.actual;
        });
    }

    function renderExts() {
        var host = document.getElementById('extRows');
        if (!host) return;
        host.innerHTML = '';
        exts.forEach(function (x, i) {
            var row = document.createElement('div');
            row.className = 'rule-row';
            row.innerHTML =
                '<input type="text" class="name" value="">' +
                '<span class="mono" style="color:var(--faint)">=</span>' +
                '<input type="text" class="path" value="">' +
                '<span class="actual" hidden></span>' +
                '<button type="button" class="rm">×</button>';
            row.querySelector('.name').value = x.name;
            row.querySelector('.path').value = x.path;
            row.querySelector('.name').addEventListener('input', function (e) { x.name = e.target.value; serialise(); });
            row.querySelector('.path').addEventListener('input', function (e) { x.path = e.target.value; serialise(); evaluateExts(); });
            row.querySelector('.rm').addEventListener('click', function () { exts.splice(i, 1); renderExts(); serialise(); });
            host.appendChild(row);
        });
        document.getElementById('extCount').textContent = exts.length;
        evaluateExts();
    }

    // preview chip on each transfer: the value the path resolves to right now
    function evaluateExts() {
        var host = document.getElementById('extRows');
        if (!host) return;
        host.querySelectorAll('.rule-row').forEach(function (row, i) {
            var x = exts[i], ac = row.querySelector('.actual');
            if (!lastProbe || !x || !x.path) { ac.hidden = true; return; }
            var v = resolvePath(x.path);
            ac.hidden = v === undefined;
            if (v !== undefined) ac.textContent = typeof v === 'string' ? v : JSON.stringify(v);
        });
    }

    var addRule = document.getElementById('addRule');
    if (addRule) addRule.addEventListener('click', function () { rules.push({ path: '', op: '==', expected: '' }); renderRules(); });
    var addExt = document.getElementById('addExt');
    if (addExt) addExt.addEventListener('click', function () { exts.push({ name: '', path: '' }); renderExts(); });

    var advApply = document.getElementById('advApply');
    if (advApply) advApply.addEventListener('click', function () {
        rules = parseRules(document.getElementById('advAssert').value);
        exts = parseExts(document.getElementById('advExt').value);
        renderRules(); renderExts(); serialise();
    });

    form.addEventListener('submit', serialise);
    renderRules(); renderExts();

    // ---- probe: run the step, render the response as clickable fields --
    var probeBtn = document.getElementById('probeBtn');
    var lastResponse = null;
    var lastProbe = null;

    function flatten(obj, prefix, out) {
        out = out || [];
        Object.keys(obj || {}).forEach(function (k) {
            var path = prefix ? prefix + '.' + k : k, v = obj[k];
            if (v && typeof v === 'object' && !Array.isArray(v)) {
                out.push({ path: path, value: '{ ' + Object.keys(v).length + ' }', type: 'object' });
                flatten(v, path, out);
            } else if (Array.isArray(v)) {
                out.push({ path: path, value: '[ ' + v.length + ' ]', type: 'array' });
                if (v.length && typeof v[0] === 'object') flatten(v[0], path + '.0', out);
            } else {
                out.push({ path: path, value: JSON.stringify(v), type: typeof v });
            }
        });
        return out;
    }

    function renderTree(payload) {
        var tree = document.getElementById('tree');
        tree.innerHTML = '';
        flatten(payload, '', []).forEach(function (f) {
            var row = document.createElement('div');
            row.className = 'tree-row';
            row.innerHTML =
                '<span class="path"></span><span class="val"></span><span class="type">' + f.type + '</span>' +
                '<span class="acts"><button type="button" class="mini assert">assert</button>' +
                '<button type="button" class="mini extract">extract</button></span>';
            row.querySelector('.path').textContent = f.path;
            row.querySelector('.val').textContent = f.value;
            row.querySelector('.assert').addEventListener('click', function () {
                rules.push({ path: f.path, op: '==', expected: String(f.value).replace(/^"|"$/g, '') });
                renderRules(); serialise();
            });
            row.querySelector('.extract').addEventListener('click', function () {
                exts.push({ name: f.path.split('.').pop(), path: f.path });
                renderExts(); serialise();
            });
            tree.appendChild(row);
        });
    }

    if (probeBtn) probeBtn.addEventListener('click', function () {
        var url = form.dataset.probe;
        if (!url) return;
        probeBtn.disabled = true;
        var fd = new FormData();
        fd.append('_token', form.querySelector('input[name=_token]').value);
        fetch(url, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                probeBtn.disabled = false;
                lastProbe = d;
                // the DSL's paths are rooted at the response JSON, so flatten from there
                lastResponse = d.json !== undefined && d.json !== null ? d.json : (d.body !== undefined ? d.body : d);
                document.getElementById('probeEmpty').hidden = true;
                document.getElementById('probeResult').hidden = false;
                var st = document.getElementById('probeStatus');
                var dbRows = d.kind === 'db' && Array.isArray(d.json) ? d.json.length : null;
                st.textContent = d.status ? String(d.status)
                    : (dbRows !== null ? dbRows + ' row(s)' : (d.ok ? 'ok' : (d.error || 'error')));
                st.className = 'probe-pill' + (((d.status && d.status < 400) || dbRows !== null || (d.ok && !d.status)) ? '' : ' failed');
                var meta = document.getElementById('probeMeta');
                var fields = flatten(lastResponse, '', []).length;
                meta.textContent =
                    [d.durationMs ? d.durationMs + ' ms' : null, d.size ? d.size : null,
                     fields ? fields + ' ' + (meta.dataset.fields || 'fields') : null].filter(Boolean).join(' · ');
                var lbl = probeBtn.querySelector('span[data-lbl]');
                if (lbl) lbl.textContent = probeBtn.dataset.again || lbl.textContent;
                renderTree(lastResponse);
                evaluateRules();
                evaluateExts();
            })
            .catch(function () { probeBtn.disabled = false; });
    });

    // ---- schema generation from the probed response --------------------
    var gen = document.getElementById('genSchemaBtn');
    if (gen) gen.addEventListener('click', function () {
        if (!lastResponse) return;
        function schemaOf(v) {
            if (Array.isArray(v)) return { type: 'array', items: v.length ? schemaOf(v[0]) : {} };
            if (v && typeof v === 'object') {
                var props = {};
                Object.keys(v).forEach(function (k) { props[k] = schemaOf(v[k]); });
                return { type: 'object', required: Object.keys(v), properties: props };
            }
            return { type: v === null ? 'null' : typeof v };
        }
        document.getElementById('schemaBox').value = JSON.stringify(schemaOf(lastResponse), null, 2);
        if (pill) pill.hidden = false;
    });
    var clr = document.getElementById('clearSchemaBtn');
    if (clr) clr.addEventListener('click', function () { document.getElementById('schemaBox').value = ''; });

    // ---- json body validity + format ----------------------------------
    var body = form.querySelector('textarea[name=body]'), state = document.getElementById('jsonState');
    function checkJson() {
        if (!body || !state) return;
        var mode = form.querySelector('select[name=bodyMode]');
        if (!mode || mode.value !== 'json' || !body.value.trim()) { state.textContent = ''; return; }
        try { JSON.parse(body.value); state.textContent = 'valid json'; state.style.color = 'var(--pass)'; }
        catch (e) { state.textContent = 'invalid json'; state.style.color = 'var(--fail)'; }
    }
    if (body) body.addEventListener('input', checkJson);
    var fmt = document.getElementById('formatBtn');
    if (fmt) fmt.addEventListener('click', function () {
        try { body.value = JSON.stringify(JSON.parse(body.value), null, 2); checkJson(); } catch (e) {}
    });
    checkJson();

    /* ---- syntax highlighting — the prototype's K/S/N/P/V palette ---------
       A <pre class="cb-hl"> backdrop renders the colored copy; the textarea
       above it keeps editing with transparent text. */
    function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    function chipVars(h) {
        return h.replace(/\{\{[^{}<]*\}\}/g, function (m) { return '<span class="tok-v">' + m + '</span>'; });
    }
    function hlJson(src) {
        var h = esc(src).replace(
            /("(?:[^"\\]|\\.)*")(\s*:)|("(?:[^"\\]|\\.)*")|(-?\b\d+\.?\d*(?:[eE][+-]?\d+)?\b)|\b(true|false|null)\b|([{}\[\],:])/g,
            function (m, key, colon, str, num, kw, p) {
                if (key) return '<span class="tok-k">' + key + '</span><span class="tok-p">' + colon + '</span>';
                if (str) return '<span class="tok-s">' + str + '</span>';
                if (num) return '<span class="tok-n">' + num + '</span>';
                if (kw) return '<span class="tok-n">' + kw + '</span>';
                return '<span class="tok-p">' + p + '</span>';
            });
        return chipVars(h);
    }
    function hlQuery(src) {
        if (/^\s*[{[]/.test(src)) return hlJson(src);
        var h = esc(src).replace(
            /(--[^\n]*|#[^\n]*)|('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*")|(-?\b\d+\.?\d*\b)|\b(SELECT|FROM|WHERE|AND|OR|NOT|IN|ORDER|GROUP|BY|LIMIT|OFFSET|JOIN|LEFT|RIGHT|INNER|OUTER|ON|AS|COUNT|SUM|MIN|MAX|AVG|DISTINCT|LIKE|ILIKE|IS|NULL|BETWEEN|HAVING|UNION|CASE|WHEN|THEN|ELSE|END|GET|MGET|HGET|HGETALL|SMEMBERS|LRANGE|ZRANGE|KEYS|EXISTS|TTL|LLEN|SCARD|FIND|FINDONE|AGGREGATE|COUNTDOCUMENTS)\b|([=<>!+*\/(),;.])/gi,
            function (m, cm, str, num, kw, p) {
                if (cm) return '<span class="tok-p">' + cm + '</span>';
                if (str) return '<span class="tok-s">' + str + '</span>';
                if (num) return '<span class="tok-n">' + num + '</span>';
                if (kw) return '<span class="tok-k">' + kw + '</span>';
                return '<span class="tok-p">' + p + '</span>';
            });
        return chipVars(h);
    }
    function hlSetvar(src) {
        return esc(src).split('\n').map(function (l) {
            var m = l.match(/^(\s*)([\w.]+)(\s*=)(.*)$/);
            if (!m) return chipVars(l);
            return m[1] + '<span class="tok-k">' + m[2] + '</span><span class="tok-p">' + m[3] + '</span>' + chipVars(m[4]);
        }).join('\n');
    }
    var HL = { json: hlJson, query: hlQuery, setvar: hlSetvar };

    /* line-number gutters + highlight backdrop, in step with the textarea */
    document.querySelectorAll('.code-ed').forEach(function (box) {
        var ta = box.querySelector('textarea'), gut = box.querySelector('.cb-gutter');
        var hl = box.querySelector('.cb-hl'), fn = HL[box.dataset.hl];
        if (!ta || !gut) return;
        function paint() {
            var n = ta.value.split('\n').length;
            var out = '';
            for (var i = 1; i <= n; i++) out += i + (i < n ? '\n' : '');
            gut.textContent = out;
            if (hl && fn) { hl.innerHTML = fn(ta.value) + '\n'; }
            sync();
        }
        function sync() {
            gut.scrollTop = ta.scrollTop;
            if (hl) { hl.scrollTop = ta.scrollTop; hl.scrollLeft = ta.scrollLeft; }
        }
        ta.addEventListener('input', paint);
        ta.addEventListener('scroll', sync);
        paint();
    });

    /* single-line {{var}} chips: URL and bearer token inputs */
    document.querySelectorAll('.hl-wrap').forEach(function (w) {
        var inp = w.querySelector('input'), bd = w.querySelector('.hl-bd');
        if (!inp || !bd) return;
        function paint() {
            if (!inp.value) { inp.classList.remove('lit'); bd.innerHTML = ''; return; }
            inp.classList.add('lit');
            bd.innerHTML = chipVars(esc(inp.value));
            bd.scrollLeft = inp.scrollLeft;
        }
        inp.addEventListener('input', paint);
        inp.addEventListener('scroll', function () { bd.scrollLeft = inp.scrollLeft; });
        inp.addEventListener('blur', function () { bd.scrollLeft = inp.scrollLeft; });
        paint();
    });

    /* request tab counters: filled kv rows, body dot */
    function tabCounts() {
        ['params', 'headers'].forEach(function (kind) {
            var host = form.querySelector('[data-kv="' + kind.replace(/s$/, '') + '"]');
            var el = form.querySelector('[data-tabn="' + kind + '"]');
            if (!host || !el) return;
            var n = 0;
            host.querySelectorAll('.kvrow input.k').forEach(function (i) { if (i.value.trim()) n++; });
            el.textContent = n || '';
        });
        var bodyEl = form.querySelector('[data-tabn="body"]');
        if (bodyEl && body) bodyEl.textContent = body.value.trim() ? '●' : '';
    }
    form.addEventListener('input', tabCounts);
    tabCounts();

    /* method color follows the selection */
    var methodSel = document.getElementById('methodSel');
    if (methodSel) methodSel.addEventListener('change', function () {
        methodSel.className = 'method-sel m-' + methodSel.value.toLowerCase();
    });
})();
</script>
