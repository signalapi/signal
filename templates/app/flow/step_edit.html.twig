{% extends 'app/_layout.html.twig' %}

{% block title %}Adım düzenle · {{ flow.name }}{% endblock %}

{% block panel %}
{% set is_new = is_new|default(false) %}
{% set kind = step.isCall ? 'Alt-akış' : (step.isDelay ? 'Bekleme' : (step.isSetvar ? 'Değişken set' : (step.isDb ? 'DB sorgusu' : 'HTTP isteği'))) %}
{% set badge = step.isCall ? 'CALL' : (step.isDb ? 'DB' : (step.isSetvar ? 'SET' : (step.isDelay ? 'WAIT' : 'HTTP'))) %}

<a class="backlink" href="{{ is_new ? path('app_flow_step_new', {workspace: workspace.id, flow: flow.id}) : path('app_flow_show', {workspace: workspace.id, flow: flow.id}) }}">← {{ is_new ? 'Adım türü' : flow.name }}</a>
<div class="pagehead">
    <div>
        <h1>{{ is_new ? 'Yeni adım' : 'Adım düzenle' }}</h1>
        <p class="subtitle"><span class="pill" style="background:var(--accent-soft);color:var(--accent);">{{ badge }}</span> {{ kind }}{% if is_new %} · <span style="color:var(--muted);">Kaydedene kadar akışa eklenmez</span>{% endif %}</p>
    </div>
</div>

<form method="post"{% if is_new %} action="{{ path('app_flow_step_store', {workspace: workspace.id, flow: flow.id}) }}"{% endif %}>
    <input type="hidden" name="_token" value="{{ is_new ? csrf_token('new-step' ~ flow.id) : csrf_token('edit-step' ~ step.id) }}">
    {% if is_new %}
        <input type="hidden" name="stepType" value="{{ create_ctx.type }}">
        {% if create_ctx.reqId is defined %}<input type="hidden" name="reqId" value="{{ create_ctx.reqId }}">{% endif %}
    {% endif %}
    <div class="field" style="max-width:480px;">
        <label>Adım adı</label>
        <input type="text" name="name" value="{{ step.name }}">
    </div>

    {# ---- run-if condition (all step types) ---- #}
    {% set cond = step.condition %}
    {% set condOps = {'eq':'eşittir','ne':'eşit değil','contains':'içerir','matches':'regex eşleşir','gt':'büyüktür','lt':'küçüktür','ge':'en az (≥)','le':'en çok (≤)','exists':'var (dolu)','empty':'boş','notEmpty':'boş değil'} %}
    <div class="fgroup" style="max-width:640px;">
        <div class="fgroup-title">Koşul <span style="font-weight:400;color:var(--muted);">· opsiyonel</span></div>
        <p class="fhint" style="margin:0 0 10px;">Bu adım yalnızca koşul sağlanırsa çalışır; sağlanmazsa atlanır (hata sayılmaz). Örn: <code>{{ '{{provider}}' }}</code> içerir <code>Yuno</code>. Boş bırakırsan her zaman çalışır.</p>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <input type="text" name="cond_left" value="{{ cond.left ?? '' }}" placeholder="{{ '{{değişken}}' }}" style="flex:1.4;min-width:150px;font-family:var(--font-mono);">
            <select name="cond_op" style="background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:9px;color:var(--text);">
                {% for val, lbl in condOps %}<option value="{{ val }}" {{ (cond.op ?? 'eq') == val ? 'selected' }}>{{ lbl }}</option>{% endfor %}
            </select>
            <input type="text" name="cond_right" value="{{ cond.right ?? '' }}" placeholder="değer" style="flex:1;min-width:110px;font-family:var(--font-mono);">
        </div>
    </div>

    {# ---- forEach loop (all step types) ---- #}
    {% set loop_cfg = step.loop %}
    <div class="fgroup" style="max-width:640px;">
        <div class="fgroup-title">Döngü <span style="font-weight:400;color:var(--muted);">· opsiyonel</span></div>
        <p class="fhint" style="margin:0 0 10px;">Bir listenin her öğesi için bu adımı tekrar çalıştırır. <b>Liste</b> bir dizi döndüren değişken olmalı (örn. bir önceki adımda <code>pkgs = result.packages</code> ile çıkarılmış). Öğe <code>{{ '{{öğe}}' }}</code> olarak; nesneyse <code>{{ '{{öğe.id}}' }}</code>, sıra <code>{{ '{{öğe_index}}' }}</code>.</p>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <span style="font-size:12px;color:var(--muted);">her</span>
            <input type="text" name="loop_as" value="{{ loop_cfg.as ?? '' }}" placeholder="öğe" style="flex:0 0 130px;font-family:var(--font-mono);">
            <span style="font-size:12px;color:var(--muted);">için · liste</span>
            <input type="text" name="loop_over" value="{{ loop_cfg.over ?? '' }}" placeholder="{{ '{{pkgs}}' }}" style="flex:1;min-width:150px;font-family:var(--font-mono);">
        </div>
    </div>

    {% if step.isDelay %}
        <div class="fgroup" style="max-width:380px;">
            <div class="fgroup-title">Bekleme</div>
            <div class="field" style="margin:0;">
                <label>Süre (ms)</label>
                <input type="number" name="query" value="{{ step.query }}" min="0" max="60000" step="100">
                <p class="fhint">Adım, belirtilen süre kadar bekler (maks. 60000 ms). Asenkron işlemler arası gecikme için.</p>
            </div>
        </div>
    {% elseif step.isSetvar %}
        <div class="fgroup">
            <div class="fgroup-title">Değişken atamaları</div>
            <div class="field" style="margin:0;">
                <label>Her satır <code>ad = değer</code></label>
                <textarea name="query" rows="5" style="font-family:var(--font-mono);" placeholder="orderId = {{ '{{data.id}}' }}&#10;label = sabit-değer">{{ step.query }}</textarea>
                <p class="fhint">Değer kısmında <code>{{ '{{değişken}}' }}</code> ve <code>{{ '{{$randomEmail}}' }}</code> gibi ifadeler çözülür; sonuç sonraki adımlara aktarılır.</p>
            </div>
        </div>
    {% elseif step.isDb %}
        <div class="fgroup">
            <div class="fgroup-title">Veritabanı sorgusu</div>
            <div class="field">
                <label>Bağlantı</label>
                <select name="connection">
                    {% for c in connections %}<option value="{{ c.id }}" {{ step.dbConnection and step.dbConnection.id == c.id ? 'selected' }}>{{ c.name }} ({{ c.type }})</option>{% endfor %}
                </select>
            </div>
            <div class="field" style="margin:0;">
                <label>Sorgu (<code>{{ '{{değişken}}' }}</code> desteklenir)</label>
                <textarea name="query" rows="4" style="font-family:var(--font-mono);" placeholder="SELECT status FROM subscriptions WHERE user_id = {{ '{{userId}}' }}">{{ step.query }}</textarea>
                <p class="fhint">SQL: normal sorgu · Redis: <code>GET key</code> · Mongo: <code>{{ '{"collection":"x","filter":{...}}' }}</code></p>
            </div>
        </div>
    {% elseif step.isCall %}
        <div class="fgroup" style="max-width:520px;">
            <div class="fgroup-title">Çağrılan alt-akış</div>
            <div class="field" style="margin:0;">
                <label>Bu adım, seçilen akışın adımlarını burada sırayla çalıştırır (aynı değişken bağlamıyla).</label>
                <select name="calledFlow">
                    <option value="">— akış seç —</option>
                    {% for cf in flows %}<option value="{{ cf.id }}" {{ step.calledFlow and step.calledFlow.id == cf.id ? 'selected' }}>{{ cf.name }} ({{ cf.steps|length }} adım)</option>{% endfor %}
                </select>
                <p class="fhint">Referanslıdır: alt-akışı değiştirdiğinde onu çağıran her yerde güncel hâli çalışır. Döngüsel çağrılar otomatik engellenir.</p>
            </div>
        </div>
    {% else %}
        <div class="fgroup">
            <div class="fgroup-title">İstek · bu flow'a özel</div>
            <p class="fhint" style="margin:0 0 12px;">Bu istek yalnızca bu adıma aittir; collection'daki orijinali ve diğer flow'ları etkilemez.{% if step.apiRequest %} Kaynak: <code>{{ step.apiRequest.collection.name }} / {{ step.apiRequest.name }}</code>{% endif %}</p>
            <div style="display:flex;gap:8px;margin-bottom:12px;">
                <select name="method" style="background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:9px;color:var(--text);font-family:var(--font-mono);font-weight:700;">
                    {% for m in constant('App\\Entity\\ApiRequest::METHODS') %}<option {{ step.reqMethod == m ? 'selected' }}>{{ m }}</option>{% endfor %}
                </select>
                <input type="text" name="url" value="{{ step.reqUrl }}" placeholder="https://… ({{ '{{API_URL}}' }}, {{ '{{token}}' }} kullanılabilir)" style="flex:1;font-family:var(--font-mono);">
            </div>
            <div class="grid2">
                <div class="field">
                    <label>Query parametreleri</label>
                    <div id="paramRows">
                        {% for p in step.reqParams %}<div class="kvrow"><input name="param_name[]" value="{{ p.name }}" placeholder="ad"><input name="param_value[]" value="{{ p.value }}" placeholder="değer"></div>{% endfor %}
                        <div class="kvrow"><input name="param_name[]" placeholder="ad"><input name="param_value[]" placeholder="değer"></div>
                    </div>
                    <button type="button" class="btn ghost small" onclick="addKv('paramRows','param')">+ satır</button>
                </div>
                <div class="field">
                    <label>Header'lar</label>
                    <div id="headerRows">
                        {% for h in step.reqHeaders %}<div class="kvrow"><input name="header_name[]" value="{{ h.name }}" placeholder="ad"><input name="header_value[]" value="{{ h.value }}" placeholder="değer"></div>{% endfor %}
                        <div class="kvrow"><input name="header_name[]" placeholder="ad"><input name="header_value[]" placeholder="değer"></div>
                    </div>
                    <button type="button" class="btn ghost small" onclick="addKv('headerRows','header')">+ satır</button>
                </div>
            </div>
            <div class="field">
                <label>Gövde</label>
                <select name="bodyMode" style="background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:8px;color:var(--text);margin-bottom:8px;">
                    {% for m in ['none','raw','json','form'] %}<option {{ step.reqBodyMode == m ? 'selected' }}>{{ m }}</option>{% endfor %}
                </select>
                <textarea name="body" rows="6" style="font-family:var(--font-mono);" placeholder='{"amount": 100, "token": "{{ '{{token}}' }}"}'>{{ step.reqBody }}</textarea>
            </div>
            <div class="field" style="margin-bottom:0;">
                <label>Kimlik doğrulama</label>
                {% set auth = step.reqAuth %}
                <select name="authType" id="authType" onchange="authToggle()" style="background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:8px;color:var(--text);">
                    {% for t in ['none','bearer','basic','apikey'] %}<option value="{{ t }}" {{ (auth.type ?? 'none') == t ? 'selected' }}>{{ t }}</option>{% endfor %}
                </select>
                <div data-auth="bearer" style="margin-top:8px;"><input type="text" name="authToken" value="{{ auth.token ?? '' }}" placeholder="Bearer token ({{ '{{token}}' }})" style="font-family:var(--font-mono);"></div>
                <div data-auth="basic" style="margin-top:8px;display:flex;gap:8px;"><input type="text" name="authUser" value="{{ auth.username ?? '' }}" placeholder="kullanıcı"><input type="text" name="authPass" value="{{ auth.password ?? '' }}" placeholder="şifre"></div>
                <div data-auth="apikey" style="margin-top:8px;display:flex;gap:8px;"><input type="text" name="authKey" value="{{ auth.key ?? '' }}" placeholder="anahtar adı"><input type="text" name="authVal" value="{{ auth.value ?? '' }}" placeholder="değer"><select name="authAddTo" style="background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:8px;color:var(--text);"><option value="header" {{ (auth.addTo ?? 'header') == 'header' ? 'selected' }}>header</option><option value="query" {{ (auth.addTo ?? '') == 'query' ? 'selected' }}>query</option></select></div>
            </div>
        </div>
    {% endif %}

    {% if not step.isSetvar and not step.isDelay and not step.isCall %}
    <div class="fgroup" id="ruleBuilder"
         {% if not is_new %}data-probe="{{ path('app_flow_step_probe', {workspace: workspace.id, flow: flow.id, step: step.id}) }}"{% else %}data-probe=""{% endif %}
         data-isdb="{{ step.isDb ? '1' : '0' }}">
        <script type="application/json" id="seedAssert">{{ step.assertions|json_encode|raw }}</script>
        <script type="application/json" id="seedExt">{{ step.extractions|json_encode|raw }}</script>

        <div class="fgroup-title" style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
            <span>Doğrulama kuralları</span>
            {% if not is_new %}<button type="button" class="btn ghost small" id="probeBtn">↧ Yanıttan seç</button>{% endif %}
        </div>
        <p class="fhint" style="margin:0 0 12px;">Her kural, dönen yanıtın bir alanını beklediğin değerle karşılaştırır.{% if is_new %} Adımı kaydettikten sonra <b>Yanıttan seç</b> ile alanları tıklayarak ekleyebilirsin.{% else %} <b>Yanıttan seç</b>'e basıp alanı tıkla — path yazmana gerek yok.{% endif %}</p>

        <div id="treePanel" style="display:none;background:var(--panel-2);border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:14px;">
            <div id="treeStatus" style="font-size:12.5px;color:var(--muted);margin-bottom:8px;"></div>
            <div id="tree" style="font-family:var(--font-mono);font-size:12.5px;line-height:1.7;max-height:280px;overflow:auto;"></div>
        </div>

        <div id="ruleRows"></div>
        <button type="button" class="btn ghost small" id="addRule">+ kural</button>

        <div class="fgroup-title" style="margin-top:20px;">Değer aktarımı</div>
        <p class="fhint" style="margin:0 0 10px;">Bu yanıttan bir alanı bir değişkene al; sonraki adımlarda <code>{{ '{{değişken}}' }}</code> olarak kullan.</p>
        <div id="extRows"></div>
        <button type="button" class="btn ghost small" id="addExt">+ aktarım</button>

        <div style="margin-top:16px;">
            <a href="#" id="advToggle" class="fhint" style="text-decoration:underline;cursor:pointer;">⚙ Gelişmiş — metin olarak düzenle</a>
        </div>
        <div id="advBox" style="display:none;margin-top:10px;">
            <div class="grid2">
                <div class="field">
                    <label>Extraction'lar (<code>değişken = path</code>)</label>
                    <textarea name="extractions" rows="6" style="font-family:var(--font-mono);">{{ extractions_text }}</textarea>
                </div>
                <div class="field">
                    <label>Assertion'lar (her satır bir kural)</label>
                    <textarea name="assertions" rows="6" style="font-family:var(--font-mono);">{{ assertions_text }}</textarea>
                </div>
            </div>
            <p class="fhint">Operatörler: <code>== != &gt; &lt; &gt;= &lt;= contains matches exists empty notEmpty</code>. Buradaki değişiklikler yukarıdaki kurucuyla senkronize olur.</p>
        </div>
    </div>

    <div class="fgroup">
        <label class="inline-lbl" style="font-weight:600;font-size:14px;"><input type="checkbox" name="retryEnabled" value="1" {{ step.retryEnabled ? 'checked' }} style="width:auto;"> ↻ Assertion'lar geçene kadar tekrar dene (poll)</label>
        <p class="fhint" style="margin:6px 0 12px;">Asenkron işlemler için: adım, assertion'lar geçene kadar belirli aralıklarla tekrar çalışır. (Yalnızca assertion tanımlıysa etkindir.)</p>
        <div style="display:flex;gap:18px;align-items:center;flex-wrap:wrap;">
            <label style="font-size:13px;color:var(--muted);">Maks. deneme
                <input type="number" name="retryMax" value="{{ step.retryMax }}" min="1" max="20" style="width:70px;margin-left:6px;background:var(--panel-2);border:1px solid var(--border);border-radius:7px;padding:7px;color:var(--text);">
            </label>
            <label style="font-size:13px;color:var(--muted);">Aralık (ms)
                <input type="number" name="retryDelayMs" value="{{ step.retryDelayMs }}" min="0" max="10000" step="100" style="width:90px;margin-left:6px;background:var(--panel-2);border:1px solid var(--border);border-radius:7px;padding:7px;color:var(--text);">
            </label>
        </div>
    </div>
    {% endif %}

    <div class="form-actions">
        <button class="btn" type="submit">Kaydet</button>
        <a class="btn ghost" href="{{ path('app_flow_show', {workspace: workspace.id, flow: flow.id}) }}">Vazgeç</a>
    </div>
</form>

<style>
    .kvrow { display: flex; gap: 6px; margin-bottom: 5px; }
    .kvrow input { flex: 1; background: var(--panel-2); border: 1px solid var(--border); border-radius: 7px; padding: 7px 9px; color: var(--text); font-family: var(--font-mono); font-size: 12.5px; }
    [data-auth] { display: none; }
    .rrow { display: flex; gap: 6px; margin-bottom: 6px; align-items: center; }
    .rrow input, .rrow select { background: var(--panel-2); border: 1px solid var(--border); border-radius: 7px; padding: 8px 9px; color: var(--text); font-size: 12.5px; }
    .rrow .f-field { flex: 2; font-family: var(--font-mono); }
    .rrow .f-val { flex: 1.5; font-family: var(--font-mono); }
    .rrow select { flex: 1.2; }
    .rrow .rm { cursor: pointer; color: var(--muted); padding: 6px 9px; border: 1px solid var(--border); border-radius: 7px; background: transparent; line-height: 1; }
    .rrow .rm:hover { color: var(--danger, #e5484d); border-color: var(--danger, #e5484d); }
    .tnode { padding-left: 14px; }
    .tleaf { cursor: pointer; padding: 1px 6px; border-radius: 5px; display: inline-block; }
    .tleaf:hover { background: var(--accent-soft); }
    .tkey { color: var(--muted); } .tval { color: var(--accent); }
    .tvar { cursor: pointer; font-size: 11px; color: var(--muted); border: 1px solid var(--border); border-radius: 5px; padding: 0 6px; margin-left: 6px; background: transparent; }
    .tvar:hover { color: var(--accent); border-color: var(--accent); }
</style>
<script>
    function addKv(containerId, prefix) {
        var box = document.getElementById(containerId);
        var row = document.createElement('div'); row.className = 'kvrow';
        row.innerHTML = '<input name="' + prefix + '_name[]" placeholder="ad"><input name="' + prefix + '_value[]" placeholder="değer">';
        box.appendChild(row);
    }
    function authToggle() {
        var t = document.getElementById('authType').value;
        document.querySelectorAll('[data-auth]').forEach(function (el) { el.style.display = el.dataset.auth === t ? (el.dataset.auth === 'bearer' ? 'block' : 'flex') : 'none'; });
    }
    document.addEventListener('DOMContentLoaded', authToggle);

    // ---- Response-driven rule builder ----
    (function () {
        var root = document.getElementById('ruleBuilder');
        if (!root) return;

        var OPS = [
            {t: '==', tr: 'eşittir', val: true},
            {t: '!=', tr: 'eşit değil', val: true},
            {t: 'contains', tr: 'içerir', val: true},
            {t: 'matches', tr: 'regex eşleşir', val: true},
            {t: '>', tr: 'büyüktür', val: true},
            {t: '<', tr: 'küçüktür', val: true},
            {t: '>=', tr: 'en az (≥)', val: true},
            {t: '<=', tr: 'en çok (≤)', val: true},
            {t: 'exists', tr: 'var (dolu)', val: false},
            {t: 'empty', tr: 'boş', val: false},
            {t: 'notEmpty', tr: 'boş değil', val: false}
        ];
        var NAME2TOKEN = {eq:'==',ne:'!=',gt:'>',lt:'<',ge:'>=',le:'<=',contains:'contains',matches:'matches',exists:'exists',empty:'empty',notEmpty:'notEmpty'};
        var NOVAL = {exists:1, empty:1, notEmpty:1};

        var isDb = root.getAttribute('data-isdb') === '1';
        var probeUrl = root.getAttribute('data-probe');
        var ruleRows = document.getElementById('ruleRows');
        var extRows = document.getElementById('extRows');
        var taAssert = document.querySelector('#advBox textarea[name="assertions"]');
        var taExt = document.querySelector('#advBox textarea[name="extractions"]');
        var token = (document.querySelector('input[name="_token"]') || {}).value || '';

        function opNoVal(t) { for (var i=0;i<OPS.length;i++) if (OPS[i].t===t) return !OPS[i].val; return false; }

        function serialize() {
            var aLines = [];
            ruleRows.querySelectorAll('.rrow').forEach(function (row) {
                var f = row.querySelector('.f-field').value.trim();
                var op = row.querySelector('select').value;
                var v = row.querySelector('.f-val').value.trim();
                if (!f) return;
                aLines.push(opNoVal(op) ? (f + ' ' + op) : (f + ' ' + op + ' ' + v));
            });
            var eLines = [];
            extRows.querySelectorAll('.rrow').forEach(function (row) {
                var vr = row.querySelector('.e-var').value.trim();
                var f = row.querySelector('.e-field').value.trim();
                if (vr && f) eLines.push(vr + ' = ' + f);
            });
            taAssert.value = aLines.join('\n');
            taExt.value = eLines.join('\n');
        }

        function valToggle(row) {
            var op = row.querySelector('select').value;
            row.querySelector('.f-val').style.visibility = opNoVal(op) ? 'hidden' : 'visible';
        }

        function ruleRow(field, opToken, value) {
            var row = document.createElement('div'); row.className = 'rrow';
            var fi = document.createElement('input'); fi.className = 'f-field'; fi.placeholder = isDb ? 'alan (örn: rows.0.status)' : 'yanıt alanı'; fi.value = field || '';
            var sel = document.createElement('select');
            OPS.forEach(function (o) { var op = document.createElement('option'); op.value = o.t; op.textContent = o.tr; if (o.t === opToken) op.selected = true; sel.appendChild(op); });
            var vi = document.createElement('input'); vi.className = 'f-val'; vi.placeholder = 'beklenen değer'; vi.value = value || '';
            var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'rm'; rm.textContent = '×';
            rm.onclick = function () { row.remove(); serialize(); };
            [fi, vi].forEach(function (e) { e.addEventListener('input', serialize); });
            sel.addEventListener('change', function () { valToggle(row); serialize(); });
            row.appendChild(fi); row.appendChild(sel); row.appendChild(vi); row.appendChild(rm);
            ruleRows.appendChild(row); valToggle(row);
            return row;
        }

        function extRow(varName, field) {
            var row = document.createElement('div'); row.className = 'rrow';
            var vr = document.createElement('input'); vr.className = 'e-var'; vr.placeholder = 'değişken adı'; vr.value = varName || '';
            var arrow = document.createElement('span'); arrow.textContent = '='; arrow.style.color = 'var(--muted)';
            var fi = document.createElement('input'); fi.className = 'e-field f-field'; fi.placeholder = 'yanıt alanı'; fi.value = field || '';
            var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'rm'; rm.textContent = '×';
            rm.onclick = function () { row.remove(); serialize(); };
            [vr, fi].forEach(function (e) { e.addEventListener('input', serialize); });
            row.appendChild(vr); row.appendChild(arrow); row.appendChild(fi); row.appendChild(rm);
            extRows.appendChild(row);
            return row;
        }

        function structToRule(a) {
            var field;
            if (a.kind === 'status') field = 'status';
            else if (a.kind === 'responseTime') field = 'responseTime';
            else if (a.kind === 'body') field = 'body';
            else if (a.kind === 'header') field = 'header ' + (a.name || '');
            else field = a.path || '';
            return {field: field, op: NAME2TOKEN[a.op] || '==', value: a.expected || ''};
        }

        // Seed from stored structures.
        try {
            var seedA = JSON.parse(document.getElementById('seedAssert').textContent || '[]');
            seedA.forEach(function (a) { var r = structToRule(a); ruleRow(r.field, r.op, r.value); });
            var seedE = JSON.parse(document.getElementById('seedExt').textContent || '[]');
            seedE.forEach(function (e) { extRow(e.var, e.path); });
        } catch (e) {}

        document.getElementById('addRule').onclick = function () { ruleRow('', '==', ''); serialize(); };
        document.getElementById('addExt').onclick = function () { extRow('', ''); serialize(); };
        document.getElementById('advToggle').onclick = function (ev) {
            ev.preventDefault();
            var box = document.getElementById('advBox');
            box.style.display = box.style.display === 'none' ? 'block' : 'none';
        };

        // ---- probe + tree ----
        function preview(v) {
            if (v === null) return 'null';
            if (typeof v === 'string') return '"' + (v.length > 40 ? v.slice(0, 40) + '…' : v) + '"';
            return String(v);
        }
        function leaf(path, key, value) {
            var wrap = document.createElement('div');
            var span = document.createElement('span'); span.className = 'tleaf';
            var k = document.createElement('span'); k.className = 'tkey'; k.textContent = key + ': ';
            var val = document.createElement('span'); val.className = 'tval'; val.textContent = preview(value);
            span.appendChild(k); span.appendChild(val);
            span.title = 'Bu alan için kural ekle: ' + path;
            span.onclick = function () { addRuleFromPath(path, value); };
            var vb = document.createElement('button'); vb.type = 'button'; vb.className = 'tvar'; vb.textContent = '⇒ değişken';
            vb.title = 'Bu alanı bir değişkene al';
            vb.onclick = function () { addExtFromPath(path); };
            wrap.appendChild(span); wrap.appendChild(vb);
            return wrap;
        }
        function renderNode(container, obj, prefix) {
            if (obj === null || typeof obj !== 'object') { container.appendChild(leaf(prefix || '$', prefix || 'değer', obj)); return; }
            Object.keys(obj).forEach(function (key) {
                var path = prefix ? (prefix + '.' + key) : key;
                var v = obj[key];
                if (v !== null && typeof v === 'object') {
                    var head = document.createElement('div'); head.className = 'tkey'; head.textContent = key + (Array.isArray(v) ? ' [' + v.length + ']' : ' {}');
                    container.appendChild(head);
                    var child = document.createElement('div'); child.className = 'tnode';
                    renderNode(child, v, path); container.appendChild(child);
                } else {
                    container.appendChild(leaf(path, key, v));
                }
            });
        }
        function addRuleFromPath(path, value) {
            var v = (value !== null && typeof value !== 'object') ? String(value) : '';
            var r = ruleRow(path, '==', v); serialize();
            r.scrollIntoView({block: 'nearest'}); r.querySelector('.f-val').focus();
        }
        function addExtFromPath(path) {
            var suggested = path.split('.').pop().replace(/[^a-zA-Z0-9_]/g, '');
            var r = extRow(suggested, path); serialize();
            r.scrollIntoView({block: 'nearest'});
        }

        var panel = document.getElementById('treePanel');
        var treeEl = document.getElementById('tree');
        var statusEl = document.getElementById('treeStatus');
        var probeBtn = document.getElementById('probeBtn');
        if (probeBtn) probeBtn.onclick = function () {
            panel.style.display = 'block';
            statusEl.textContent = 'Yanıt çekiliyor…'; treeEl.innerHTML = '';
            var fd = new FormData(); fd.append('_token', token);
            fetch(probeUrl, {method: 'POST', body: fd, headers: {'X-Requested-With': 'fetch'}})
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (!d.ok && d.error) { statusEl.textContent = 'Hata: ' + d.error + (d.status ? ' (HTTP ' + d.status + ')' : ''); }
                    else { statusEl.textContent = (d.kind === 'db' ? 'DB sonucu' : 'HTTP ' + (d.status || '')) + ' — bir alana tıkla: kural · “⇒ değişken”: aktarım'; }
                    if (d.json !== null && d.json !== undefined) { renderNode(treeEl, d.json, ''); }
                    else if (d.rawBody) { var pre = document.createElement('div'); pre.style.whiteSpace = 'pre-wrap'; pre.textContent = d.rawBody; treeEl.appendChild(pre); statusEl.textContent += ' (JSON değil — path elle girilmeli)'; }
                })
                .catch(function () { statusEl.textContent = 'İstek başarısız.'; });
        };

        serialize();
    })();
</script>
{% endblock %}
