{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'New test flow'|trans }}{% endblock %}

{% block panel %}
<a class="backlink" href="{{ path('app_flow_index', {workspace: workspace.id}) }}">
    <span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>{{ 'Test flows'|trans }}</a>
<div class="pagehead">
    <div>
        <h1>{{ 'New test flow'|trans }}</h1>
        <p class="subtitle">{{ workspace.name }}</p>
    </div>
</div>

<div class="formcard" style="max-width:560px;">
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('new-flow') }}">
        <div class="field">
            <label>{{ 'Flow name'|trans }}</label>
            <input type="text" name="name" placeholder="{{ 'e.g. Signup → Subscription verification'|trans }}" required autofocus>
        </div>
        <div class="field">
            <label>{{ 'Description'|trans }}</label>
            <textarea name="description" rows="2" placeholder="{{ 'What does this flow verify?'|trans }}"></textarea>
        </div>
        <div class="field">
            <label>{{ 'Default environment'|trans }}</label>
            <select name="environment">
                <option value="">{{ '— none —'|trans }}</option>
                {% for env in environments %}<option value="{{ env.id }}">{{ env.name }}</option>{% endfor %}
            </select>
        </div>
        <div class="field">
            <label style="display:inline-flex;align-items:center;gap:8px;font-size:12.5px;color:var(--text);margin:0;">
                <input type="checkbox" name="stopOnFailure" value="1" checked style="width:auto;"> {{ 'Stop at the first failed step'|trans }}</label>
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">{{ 'Create'|trans }}{{ ic.i('chevron-r', 13, 2.4) }}</button>
            <a class="btn ghost" href="{{ path('app_flow_index', {workspace: workspace.id}) }}">{{ 'Cancel'|trans }}</a>
        </div>
    </form>
</div>
{% endblock %}
