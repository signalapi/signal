{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Run'|trans }} · {{ flow.name }}{% endblock %}

{% block panel %}
{% set sc = run.status %}

{% set inGroup = run.trigger == 'group' and run.batchId and suiteGroup %}
{% set backUrl = inGroup
    ? path('app_flow_group_run_show', {workspace: workspace.id, group: suiteGroup.id, batchId: run.batchId})
    : path('app_flow_show', {workspace: workspace.id, flow: flow.id}) %}

<a class="backlink" href="{{ backUrl }}">
    <span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>
    {%- if inGroup %}{{ ic.i('suites', 12) }}{{ '%name% run'|trans({'%name%': suiteGroup.name}) }}{% else %}{{ flow.name }}{% endif %}</a>

<div class="pagehead">
    <div>
        <h1>{{ 'Run detail'|trans }} · {{ flow.name }}</h1>
        <p class="subtitle">{{ run.createdAt|date('d.m.Y H:i:s') }}
            {%- if inGroup %} · <span class="pill" style="background:var(--vio-soft);color:var(--vio);">{{ ic.i('suites', 11) }}{{ suiteGroup.name }}</span>
            {%- elseif run.batchId %} · <span class="pill">data #{{ run.iteration + 1 }}</span>{% endif %}</p>
    </div>
    <div class="actions">
        <a class="btn ghost" href="{{ backUrl }}">{{ inGroup ? 'Back to suite run'|trans : 'Back to flow'|trans }}</a>
    </div>
</div>

<div class="ru-sum">
    <div class="ru-stat"><div class="n">{{ include('app/flow/_status.html.twig', {status: sc}) }}</div><div class="l">{{ 'Status'|trans }}</div></div>
    <div class="ru-stat"><div class="n">{{ run.passedSteps }}/{{ run.totalSteps }}</div><div class="l">{{ 'Passed steps'|trans }}</div></div>
    <div class="ru-stat"><div class="n">{{ run.durationMs ?? '—' }}{{ run.durationMs ? ' ms' }}</div><div class="l">{{ 'Total duration'|trans }}</div></div>
    <div class="ru-stat"><div class="n" style="font-size:14px;">{{ run.environmentName ?: '—' }}</div><div class="l">{{ 'Environment'|trans }}</div></div>
    <div class="ru-stat">
        <div class="n" style="font-size:14px;">{{ run.triggeredBy ? run.triggeredBy.name : 'Scheduled'|trans }}</div>
        <div class="l">{{ 'Run by'|trans }}</div>
    </div>
</div>

{% if sc != 'running' %}
<div class="card" id="share" style="padding:14px 15px;margin-bottom:18px;"
     data-share="{{ path('app_flow_run_share', {workspace: workspace.id, flow: flow.id, run: run.id}) }}"
     data-unshare="{{ path('app_flow_run_unshare', {workspace: workspace.id, flow: flow.id, run: run.id}) }}"
     data-token="{{ csrf_token('share-run' ~ run.id) }}">
    <button type="button" class="btn ghost small" id="shareBtn">{{ ic.i('share', 13) }}{{ 'Share'|trans }}</button>
    <div id="shareBox" style="display:flex;align-items:center;gap:8px;margin-top:10px;flex-wrap:wrap;" {{ run.isShareValid ? '' : 'hidden' }}>
        <input type="text" id="shareUrl" class="input-mono" readonly style="flex:1;min-width:220px;" value="{{ run.isShareValid ? url('public_report', {token: run.shareToken}) : '' }}">
        <button type="button" class="btn small" id="shareCopy">{{ 'Copy'|trans }}</button>
        <button type="button" class="btn ghost small" id="shareRevoke">{{ 'Revoke'|trans }}</button>
        <span class="share-exp" style="font-size:11.5px;color:var(--muted);">{{ run.isShareValid and run.shareExpiresAt ? 'until %date%'|trans({'%date%': run.shareExpiresAt|date('d.m.Y H:i')}) }}</span>
    </div>
    <p class="fhint">{{ 'A time-limited report link that requires no login. Shareable with stakeholders.'|trans }}</p>
</div>
<script>
(function () {
    var root = document.getElementById('share'); if (!root) return;
    var box = document.getElementById('shareBox'), urlIn = document.getElementById('shareUrl');
    var token = root.dataset.token;
    function post(url) {
        var b = new URLSearchParams(); b.set('_token', token);
        return fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'fetch', 'Content-Type': 'application/x-www-form-urlencoded' }, body: b.toString() }).then(function (r) { return r.json(); });
    }
    document.getElementById('shareBtn').addEventListener('click', function () {
        post(root.dataset.share).then(function (d) {
            if (d.url) { urlIn.value = d.url; box.hidden = false; root.querySelector('.share-exp').textContent = d.expiresAt ? '{{ 'until %date%'|trans|e('js') }}'.replace('%date%', d.expiresAt) : ''; }
        });
    });
    document.getElementById('shareCopy').addEventListener('click', function () {
        urlIn.select(); (navigator.clipboard ? navigator.clipboard.writeText(urlIn.value) : Promise.resolve()).catch(function(){});
        var b = this; var t = b.textContent; b.textContent = '{{ 'Copied'|trans|e('js') }}'; setTimeout(function(){ b.textContent = t; }, 900);
    });
    document.getElementById('shareRevoke').addEventListener('click', function () {
        post(root.dataset.unshare).then(function () { box.hidden = true; urlIn.value = ''; });
    });
})();
</script>
{% endif %}

{% if sc in ['failed', 'error'] %}
{% set failing = run.stepResults|filter(r => r.status in ['failed', 'error']) %}
<div style="background:var(--fail-soft);border:1px solid var(--fail);border-radius:var(--r-lg);padding:16px 18px;margin:4px 0 22px;">
    <h2 style="color:var(--fail);margin-bottom:12px;">{{ 'Why did it blow up?'|trans }}</h2>
    {% for r in failing %}
        <div class="card" style="padding:12px 14px;margin-bottom:10px;">
            <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;">
                <span style="font-size:13px;font-weight:700;color:var(--ink);">#{{ r.position + 1 }} · {{ r.label }}</span>
                <span class="mono" style="font-size:11px;color:var(--muted);">{{ r.requestMethod }}{% if r.responseStatus %} → HTTP {{ r.responseStatus }}{% endif %}</span>
            </div>
            {% if r.error %}<div class="mono" style="color:var(--fail);font-size:11.5px;margin-top:6px;">{{ r.error }}</div>{% endif %}
            {% set failedAsserts = r.assertionResults|filter(a => not a.ok) %}
            {% if failedAsserts is not empty %}
                <ul style="margin:8px 0 0;padding-left:18px;font-size:12px;">
                    {% for a in failedAsserts %}
                        <li style="margin:3px 0;"><code class="mono" style="color:var(--muted);">{{ a.label }}</code> — {{ 'actual:'|trans }}
                            <b style="color:var(--fail);">{{ a.actual|default('(none)'|trans) }}</b></li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if r.responseBody %}
                <details class="fold" style="margin-top:9px;">
                    <summary><span class="t">{{ 'Response body'|trans }}</span><span class="chev">{{ ic.i('chevron-r', 12) }}</span></summary>
                    <div class="fold-body"><pre class="code" style="max-height:260px;margin:0;">{{ r.responseBody|slice(0, 4000) }}</pre></div>
                </details>
            {% endif %}
        </div>
    {% endfor %}
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <button type="button" class="btn small" id="aiDiagBtn"
                data-url="{{ path('app_flow_run_diagnose', {workspace: workspace.id, flow: flow.id, run: run.id}) }}"
                data-token="{{ csrf_token('diagnose-run' ~ run.id) }}">{{ ic.i('bot', 13) }}{{ 'Diagnose with AI'|trans }}</button>
        <span style="font-size:11.5px;color:var(--muted);">{{ 'Claude interprets this evidence and suggests a root cause + fix.'|trans }}</span>
    </div>
    <div id="aiDiagOut" class="codebox" style="margin-top:12px;" hidden></div>
</div>

<script>
(function () {
    var btn = document.getElementById('aiDiagBtn'); if (!btn) return;
    var out = document.getElementById('aiDiagOut');
    btn.addEventListener('click', function () {
        btn.disabled = true; var label = btn.textContent; btn.textContent = '{{ 'Diagnosing…'|trans|e('js') }}';
        out.hidden = false; out.className = 'codebox'; out.style.color = ''; out.textContent = '{{ 'Claude is analyzing…'|trans|e('js') }}';
        var body = new URLSearchParams(); body.set('_token', btn.dataset.token);
        fetch(btn.dataset.url, { method: 'POST', headers: { 'X-Requested-With': 'fetch', 'Content-Type': 'application/x-www-form-urlencoded' }, body: body.toString() })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
            .then(function (res) {
                btn.disabled = false; btn.textContent = label;
                var d = res.d;
                if (d.configured === false) {
                    out.className = 'codebox'; out.style.color = ''; out.textContent = '{{ 'AI diagnosis is not connected yet. Set the ANTHROPIC_API_KEY environment variable to enable it (the code is ready).'|trans|e('js') }}';
                } else if (d.error) {
                    out.className = 'codebox'; out.style.color = 'var(--fail)'; out.textContent = '{{ 'Error'|trans|e('js') }}: ' + d.error;
                } else {
                    out.className = 'codebox'; out.style.color = '';
                    out.innerHTML = '<span class="eyebrow" style="display:block;margin-bottom:7px;">{{ 'CLAUDE DIAGNOSIS'|trans|e('js') }}</span>';
                    var p = document.createElement('div'); p.textContent = d.analysis || '{{ '(empty response)'|trans|e('js') }}'; out.appendChild(p);
                }
            })
            .catch(function () { btn.disabled = false; btn.textContent = label; out.className = 'codebox'; out.style.color = 'var(--fail)'; out.textContent = '{{ 'Request failed.'|trans|e('js') }}'; });
    });
})();
</script>
{% endif %}

{% if sc == 'running' %}
<div class="card" style="display:flex;align-items:center;gap:12px;padding:13px 16px;margin-bottom:18px;background:var(--pri-soft);border-color:var(--pri);">
    <span class="dot running"></span>
    <span style="font-weight:700;color:var(--pri);">{{ 'Running'|trans }}</span>
    <span class="subtitle" id="liveProgress">{{ '%done%/%total% steps'|trans({'%done%': run.passedSteps, '%total%': run.totalSteps}) }}</span>
    <div class="grow"></div>
    <form method="post" action="{{ path('app_flow_run_cancel', {workspace: workspace.id, flow: flow.id, run: run.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('cancel-run' ~ run.id) }}">
        <button class="btn danger" type="submit">{{ 'Cancel run'|trans }}</button>
    </form>
</div>
{% endif %}

{% set maxMs = 1 %}
{% for r in run.stepResults %}{% if r.durationMs and r.durationMs > maxMs %}{% set maxMs = r.durationMs %}{% endif %}{% endfor %}

<div class="track">
{% for r in run.stepResults %}
    {% set kind = r.requestMethod ?: '·' %}
    <div class="track-row {{ r.status }}">
        <div class="track-rail">
            <div class="node {{ r.status }}">
                {%- if r.status == 'passed' %}{{ ic.i('check', 13, 3) }}
                {%- elseif r.status in ['failed', 'error'] %}{{ ic.i('x', 13, 3) }}
                {%- elseif r.status == 'skipped' %}{{ ic.i('minus', 13, 3) }}
                {%- else %}{{ r.position + 1 }}{% endif -%}
            </div>
        </div>
        <div class="step-card {{ r.status }}" style="cursor:default;">
            <div class="head">
                <span class="kind m-{{ kind|lower }}">{{ kind }}</span>
                <span class="name">{{ r.label }}</span>
                {% if r.durationMs %}
                    <span class="wf-bar" style="flex:0 0 110px;">
                        <i class="{{ r.status == 'error' ? 'failed' : r.status }}" style="width:{{ (r.durationMs / maxMs * 100)|round }}%;"></i>
                    </span>
                    <span class="live {{ r.status }}">{{ r.durationMs }} ms</span>
                {% endif %}
                {{ include('app/flow/_status.html.twig', {status: r.status}) }}
            </div>

            {% if r.status == 'skipped' %}
                <div class="detail">{{ 'Skipped because the previous step failed.'|trans }}</div>
            {% else %}
                <div class="detail" style="white-space:normal;word-break:break-all;">
                    <b style="color:var(--ink);">{{ r.requestMethod }}</b> {{ r.requestUrl }}
                    {% if r.responseStatus %}→ <b style="color:var(--ink);">{{ r.responseStatus }}</b>{% endif %}
                    {% if r.attempts > 1 %}· <span class="chip retry">{{ '%count% attempts'|trans({'%count%': r.attempts}) }}</span>{% endif %}
                </div>

                {% if r.error %}<div class="flash error" style="margin:10px 0 0;">{{ r.error }}</div>{% endif %}

                {% if r.extractedVars is not empty %}
                    <div style="margin-top:11px;">
                        <div class="eyebrow" style="margin-bottom:5px;">{{ 'Extractions'|trans }}</div>
                        <div class="mono" style="font-size:11.5px;line-height:1.8;">
                            {% for k, v in r.extractedVars %}{{ k }} = <span style="color:var(--vio);">{{ v }}</span><br>{% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% if r.assertionResults is not empty %}
                    <div style="margin-top:11px;">
                        <div class="eyebrow" style="margin-bottom:5px;">{{ 'Assertions'|trans }}</div>
                        <div class="mono" style="font-size:11.5px;line-height:1.8;">
                        {% for a in r.assertionResults %}
                            <span style="display:flex;align-items:center;gap:7px;">
                                <span class="status-ic {{ a.ok ? 'passed' : 'failed' }}">{{ a.ok ? ic.i('check', 11, 3) : ic.i('x', 11, 3) }}</span>
                                <span>{{ a.label }}{% if not a.ok %} <span style="color:var(--muted);">— {{ 'received:'|trans }} {{ a.actual }}</span>{% endif %}</span>
                            </span>
                        {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% if r.shapeDrift is not empty %}
                    <div style="margin-top:11px;background:var(--warn-soft);border:1px solid var(--warn);border-radius:var(--r);padding:9px 11px;">
                        <div class="eyebrow" style="color:var(--warn);margin-bottom:5px;">{{ 'Contract changed'|trans }}
                            <span style="font-weight:400;letter-spacing:0;text-transform:none;">{{ '(response shape differs from the baseline)'|trans }}</span></div>
                        <div class="mono" style="font-size:11.5px;line-height:1.8;color:var(--ink);">
                            {% for c in r.shapeDrift %}{{ c }}<br>{% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% if r.responseBody %}
                    <details class="fold" style="margin:11px 0 0;">
                        <summary><span class="t">{{ 'Response body'|trans }}</span><span class="chev">{{ ic.i('chevron-r', 12) }}</span></summary>
                        <div class="fold-body"><pre class="code" style="max-height:320px;margin:0;">{{ r.responseBody }}</pre></div>
                    </details>
                {% endif %}
            {% endif %}
        </div>
    </div>
{% endfor %}
</div>

{% if sc == 'running' %}
<script>
(function () {
    var url = "{{ path('app_flow_run_status', {workspace: workspace.id, flow: flow.id, run: run.id}) }}";
    var STEPS = '{{ '%done%/%total% steps'|trans|e('js') }}';
    var CANCEL_REQ = '{{ ' · cancel requested…'|trans|e('js') }}';
    function poll() {
        fetch(url).then(function (r) { return r.json(); }).then(function (d) {
            var el = document.getElementById('liveProgress');
            if (el) el.textContent = STEPS.replace('%done%', d.passedSteps).replace('%total%', d.totalSteps) + (d.cancelRequested ? CANCEL_REQ : '');
            if (d.finished) { location.reload(); return; }
            setTimeout(poll, 1500);
        }).catch(function () { setTimeout(poll, 3000); });
    }
    setTimeout(poll, 1500);
})();
</script>
{% endif %}
{% endblock %}
