{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Data-driven run'|trans }} · {{ flow.name }}{% endblock %}

{% set eval = report.repeats > 1 %}
{% set verdictPill = {'stable-pass': 'passed', 'flaky': 'flaky', 'stable-fail': 'failed', 'input-dependent': 'failed'} %}
{% set verdictLabel = {'stable-pass': 'Reliable', 'flaky': 'Flaky', 'stable-fail': 'Failing', 'input-dependent': 'Input-dependent'} %}

{% block panel %}
<a class="backlink" href="{{ path('app_flow_show', {workspace: workspace.id, flow: flow.id}) }}">
    <span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>{{ flow.name }}</a>
<div class="pagehead">
    <div>
        <h1>{{ eval ? 'Eval run'|trans : 'Data-driven run'|trans }}</h1>
        <p class="subtitle">
            {% if eval %}
                {{ '%rows% rows × %repeats% runs each'|trans({'%rows%': report.rows, '%repeats%': report.repeats}) }}
            {% else %}
                {{ '%count% iterations · one run per data row'|trans({'%count%': total}) }}
            {% endif %}
        </p>
    </div>
</div>

{% if eval %}
    {# The two readings of the same batch: how often a single attempt passes,
       and how many inputs are decided either way. The gap is the flakiness. #}
    <div class="ru-sum">
        <div class="ru-stat"><div class="n">{{ (report.passRate * 100)|round }}%</div><div class="l">{{ 'Pass rate'|trans }}</div></div>
        <div class="ru-stat"><div class="n" style="color:var(--pass);">{{ report.stablePassRows }}</div><div class="l">{{ 'Reliable rows'|trans }}</div></div>
        <div class="ru-stat"><div class="n" style="color:{{ report.flakyRows > 0 ? 'var(--warn)' : 'var(--muted)' }};">{{ report.flakyRows }}</div><div class="l">{{ 'Flaky rows'|trans }}</div></div>
        <div class="ru-stat"><div class="n" style="color:{{ report.stableFailRows > 0 ? 'var(--fail)' : 'var(--muted)' }};">{{ report.stableFailRows }}</div><div class="l">{{ 'Failing rows'|trans }}</div></div>
    </div>

    <h2 class="section-title">{{ 'Rows'|trans }}</h2>
    <table class="data">
        <thead><tr><th style="width:50px;">#</th><th>{{ 'Data'|trans }}</th><th style="width:150px;">{{ 'Passed'|trans }}</th><th style="width:110px;">{{ 'Verdict'|trans }}</th></tr></thead>
        <tbody>
        {% for row in report.rowDetail %}
            <tr>
                <td class="mono" style="color:var(--muted);">{{ row.index + 1 }}</td>
                <td class="mono" style="font-size:11.5px;max-width:360px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted);" title="{{ row.data|json_encode }}">{{ row.data|json_encode }}</td>
                <td class="mono">
                    {{ row.passed }}/{{ row.runs }}
                    <span style="display:inline-block;width:56px;height:5px;border-radius:3px;background:var(--panel2);vertical-align:middle;margin-left:6px;">
                        <span style="display:block;height:5px;border-radius:3px;width:{{ (row.passRate * 100)|round }}%;background:{{ row.verdict == 'stable-pass' ? 'var(--pass)' : (row.verdict == 'flaky' ? 'var(--warn)' : 'var(--fail)') }};"></span>
                    </span>
                </td>
                <td><span class="pill {{ verdictPill[row.verdict] }}">{{ verdictLabel[row.verdict]|trans }}</span></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h2 class="section-title">{{ 'Checks that did not always pass'|trans }}</h2>
    {% if report.checks is empty %}
        <div class="empty" style="text-align:left;padding:18px;">{{ 'Every check passed in every run.'|trans }}</div>
    {% else %}
        <table class="data">
            <thead><tr><th>{{ 'Check'|trans }}</th><th style="width:100px;">{{ 'Passed'|trans }}</th><th style="width:110px;">{{ 'Verdict'|trans }}</th><th>{{ 'A failure it gave'|trans }}</th></tr></thead>
            <tbody>
            {% for check in report.checks %}
                <tr>
                    <td class="mono" style="font-size:11.5px;">{{ check.label }}</td>
                    <td class="mono">{{ check.passed }}/{{ check.total }}</td>
                    <td><span class="pill {{ verdictPill[check.verdict] }}" title="{{ '%flaky% rows flip, %failed% rows always fail'|trans({'%flaky%': check.flakyRows, '%failed%': check.failedRows}) }}">{{ verdictLabel[check.verdict]|trans }}</span></td>
                    <td style="font-size:11.5px;color:var(--muted);max-width:420px;">{{ check.sample }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% else %}
    {% set rate = total > 0 ? (passed / total * 100)|round : 0 %}
    <div class="ru-sum">
        <div class="ru-stat"><div class="n">{{ total }}</div><div class="l">{{ 'Iterations'|trans }}</div></div>
        <div class="ru-stat"><div class="n" style="color:var(--pass);">{{ passed }}</div><div class="l">{{ 'Passed'|trans }}</div></div>
        <div class="ru-stat"><div class="n" style="color:{{ passed == total ? 'var(--pass)' : 'var(--fail)' }};">{{ total - passed }}</div><div class="l">{{ 'Failed'|trans }}</div></div>
    </div>
{% endif %}

{% if runs is empty %}
    <div class="empty" style="text-align:left;padding:24px;">{{ 'No iterations found.'|trans }}</div>
{% else %}
    {% if eval %}<h2 class="section-title">{{ 'All runs'|trans }}</h2>{% endif %}
    <table class="data">
        <thead><tr><th style="width:50px;">#</th>{% if eval %}<th style="width:60px;">{{ 'Repeat'|trans }}</th>{% endif %}<th>{{ 'Status'|trans }}</th><th>{{ 'Steps'|trans }}</th><th>{{ 'Data'|trans }}</th><th>{{ 'Duration'|trans }}</th><th></th></tr></thead>
        <tbody>
        {% for run in runs %}
            <tr>
                <td class="mono" style="color:var(--muted);">{{ run.iteration + 1 }}</td>
                {% if eval %}<td class="mono" style="color:var(--faint);">{{ run.repeatIndex + 1 }}</td>{% endif %}
                <td>{{ include('app/flow/_status.html.twig', {status: run.status}) }}</td>
                <td class="mono">{{ run.passedSteps }}/{{ run.totalSteps }}</td>
                <td class="mono" style="font-size:11.5px;max-width:360px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted);" title="{{ run.iterationData|json_encode }}">{{ run.iterationData|json_encode }}</td>
                <td class="mono">{{ run.durationMs is not null ? run.durationMs ~ ' ms' : '—' }}</td>
                <td style="text-align:right;"><a class="btn ghost small" href="{{ path('app_flow_run_show', {workspace: workspace.id, flow: flow.id, run: run.id}) }}">{{ 'Details'|trans }}{{ ic.i('chevron-r', 12, 2.4) }}</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
