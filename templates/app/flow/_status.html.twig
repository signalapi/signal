{# One-word status vocabulary — .pill reads the entity status straight as a class.
   Labels go through |trans so the pill matches the rest of the page's language. #}
{% set map = {
    'passed':    'Passed',
    'failed':    'Failed',
    'error':     'Error',
    'running':   'Running',
    'skipped':   'Skipped',
    'cancelled': 'Cancelled',
} %}
<span class="pill {{ status }}">{{ (map[status] ?? status)|trans }}</span>
