{% extends 'app/_layout.html.twig' %}

{% block title %}{{ group.name }} · Grup koşumu{% endblock %}

{% block panel %}
<style>
    .gr-head { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
    .gr-head h1 { margin: 0; font-size: 22px; letter-spacing: -.02em; }
    .gr-bar { height: 8px; border-radius: 999px; background: var(--panel-2); overflow: hidden; margin-bottom: 18px; }
    .gr-bar > span { display: block; height: 100%; width: 0; background: var(--accent); transition: width .35s, background .3s; }
    .gr-bar.done > span { background: var(--pass); } .gr-bar.fail > span { background: var(--fail); }
    .gr-row { display: flex; align-items: center; gap: 14px; padding: 13px 16px; border: 1px solid var(--border); border-radius: 12px;
        background: var(--panel); box-shadow: var(--shadow); margin-bottom: 10px; text-decoration: none; color: inherit; transition: border-color .2s; }
    .gr-row .idx { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        font-family: var(--font-mono); font-size: 12px; font-weight: 700; border: 2px solid var(--border); color: var(--muted); background: var(--panel); }
    .gr-row.s-running .idx { color: #fff; background: var(--accent); border-color: var(--accent); animation: pulse 1s infinite; }
    .gr-row.s-passed .idx { color: #fff; background: var(--pass); border-color: var(--pass); }
    .gr-row.s-failed .idx, .gr-row.s-error .idx { color: #fff; background: var(--fail); border-color: var(--fail); }
    .gr-row.s-passed { border-color: rgba(31,157,85,.4); } .gr-row.s-failed, .gr-row.s-error { border-color: rgba(229,72,77,.45); }
    .gr-name { flex: 1; font-weight: 600; }
    .gr-meta { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
    .gr-state { font-size: 12px; font-weight: 600; }
    .gr-state.passed { color: var(--pass); } .gr-state.failed, .gr-state.error { color: var(--fail); } .gr-state.running { color: var(--accent); }
    .gr-state.pending { color: var(--muted); }
</style>

{% set labels = {'passed':'geçti','failed':'başarısız','error':'hata','running':'çalışıyor','skipped':'atlandı','cancelled':'iptal'} %}
{% set failedCount = 0 %}
{% for it in byIteration %}{% if it.status in ['failed','error'] %}{% set failedCount = failedCount + 1 %}{% endif %}{% endfor %}

<a class="backlink" href="{{ path('app_flow_suite_index', {workspace: workspace.id}) }}">← Suite'ler</a>
<div class="gr-head">
    <h1>▶ {{ group.name }}</h1>
    <span class="muted-sm" id="grSummary">
        {%- if finished -%}{{ failedCount ? failedCount ~ '/' ~ total ~ ' akış başarısız' : 'Tüm akışlar geçti (' ~ total ~ ')' }}
        {%- else -%}{{ done }}/{{ total }} akış bitti{% endif -%}
    </span>
</div>
<div class="gr-bar {{ finished ? (failedCount ? 'fail' : 'done') }}" id="grBar"><span id="grFill" style="width:{{ total ? (done / total * 100)|round : 0 }}%;"></span></div>

<div id="grList">
    {% for flow in group.flows %}
        {% set r = byIteration[loop.index0] ?? null %}
        {% set st = r ? r.status : 'pending' %}
        <{{ r ? 'a' : 'div' }} class="gr-row s-{{ st }}" data-idx="{{ loop.index0 }}"{% if r %} href="{{ r.detailUrl }}" style="text-decoration:none;color:inherit;"{% endif %}>
            <span class="idx">{{ loop.index }}</span>
            <span class="gr-name">{{ flow.name }}</span>
            <span class="gr-meta" data-meta>{% if r %}{{ r.passed }}/{{ r.total }}{{ r.durationMs is not null ? ' · ' ~ r.durationMs ~ 'ms' }}{% endif %}</span>
            <span class="gr-state {{ st }}" data-state>{{ labels[st] ?? 'bekliyor' }}</span>
        </{{ r ? 'a' : 'div' }}>
    {% endfor %}
</div>

{% if not finished %}
<span id="grCfg" data-status-url="{{ path('app_flow_group_run_status', {workspace: workspace.id, group: group.id, batchId: batchId}) }}" data-total="{{ total }}" hidden></span>

{% verbatim %}
<script>
(function () {
    var cfg = document.getElementById('grCfg');
    var statusUrl = cfg.dataset.statusUrl, total = parseInt(cfg.dataset.total, 10) || 0;
    var bar = document.getElementById('grBar'), fill = document.getElementById('grFill'), summary = document.getElementById('grSummary');
    var rows = [].slice.call(document.querySelectorAll('.gr-row'));

    function label(s) { return {passed:'geçti',failed:'başarısız',error:'hata',running:'çalışıyor',cancelled:'iptal'}[s] || s; }

    function poll() {
        fetch(statusUrl, {headers: {'X-Requested-With': 'XMLHttpRequest'}}).then(function (r) { return r.json(); }).then(function (d) {
            var byIdx = {};
            (d.runs || []).forEach(function (run) { byIdx[run.iteration] = run; });
            var done = 0, failed = 0;
            rows.forEach(function (row) {
                var idx = parseInt(row.dataset.idx, 10), run = byIdx[idx];
                row.className = 'gr-row s-' + (run ? run.status : 'pending');
                var st = row.querySelector('[data-state]'), meta = row.querySelector('[data-meta]');
                if (run) {
                    st.className = 'gr-state ' + run.status; st.textContent = label(run.status);
                    meta.textContent = run.passed + '/' + run.total + (run.durationMs != null ? ' · ' + run.durationMs + 'ms' : '');
                    row.setAttribute('href', run.detailUrl); row.tagName === 'A' || row.setAttribute('role', 'link');
                    row.onclick = function () { window.location.href = run.detailUrl; };
                    if (run.status !== 'running') done++;
                    if (run.status === 'failed' || run.status === 'error') failed++;
                } else {
                    st.className = 'gr-state pending'; st.textContent = 'bekliyor'; meta.textContent = '';
                }
            });
            fill.style.width = (total ? Math.round(done / total * 100) : 0) + '%';
            summary.textContent = done + '/' + total + ' akış bitti' + (failed ? ' · ' + failed + ' başarısız' : '');
            if (d.finished) {
                bar.className = 'gr-bar ' + (failed ? 'fail' : 'done');
                summary.textContent = failed ? (failed + '/' + total + ' akış başarısız') : ('Tüm akışlar geçti (' + total + ')');
                return;
            }
            setTimeout(poll, 1200);
        }).catch(function () { setTimeout(poll, 2500); });
    }
    setTimeout(poll, 600);
})();
</script>
{% endverbatim %}
{% endif %}
{% endblock %}
