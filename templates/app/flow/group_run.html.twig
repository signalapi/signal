{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ group.name }} · {{ 'Group run'|trans }}{% endblock %}

{% block panel %}
{# Status vocabulary matches app/flow/_status.html.twig so a pill reads the same everywhere. #}
{% set labels = {'passed':'Passed'|trans,'failed':'Failed'|trans,'error':'Error'|trans,'running':'Running'|trans,'skipped':'Skipped'|trans,'cancelled':'Cancelled'|trans} %}
{% set failedCount = 0 %}
{% for it in byIteration %}{% if it.status in ['failed','error'] %}{% set failedCount = failedCount + 1 %}{% endif %}{% endfor %}

<a class="backlink" href="{{ path('app_flow_suite_index', {workspace: workspace.id}) }}">
    <span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>{{ 'Suites'|trans }}</a>
<div class="pagehead">
    <div>
        <h1>{{ group.name }}</h1>
        <p class="subtitle" id="grSummary">
            {%- if finished -%}{{ failedCount ? '%count%/%total% flows failed'|trans({'%count%': failedCount, '%total%': total}) : 'All flows passed (%total%)'|trans({'%total%': total}) }}
            {%- else -%}{{ '%done%/%total% flows finished'|trans({'%done%': done, '%total%': total}) }}{% endif -%}
        </p>
    </div>
</div>
<div class="progress" id="grBar" style="margin-bottom:16px;">
    <i id="grFill" class="{{ finished ? (failedCount ? 'failed' : 'passed') }}" style="width:{{ total ? (done / total * 100)|round : 0 }}%;"></i>
</div>

<div class="card" id="grList" style="overflow:hidden;">
    {% for flow in group.flows %}
        {% set r = byIteration[loop.index0] ?? null %}
        {% set st = r ? r.status : 'pending' %}
        <{{ r ? 'a' : 'div' }} class="wf-row {{ st }}" data-idx="{{ loop.index0 }}"{% if r %} href="{{ r.detailUrl }}" style="color:inherit;"{% endif %}>
            <span class="node {{ st }}" style="width:22px;height:22px;font-size:10px;box-shadow:none;">{{ loop.index }}</span>
            <span class="name" style="width:auto;flex:1;">{{ flow.name }}</span>
            <span class="ms" style="width:auto;" data-meta>{% if r %}{{ r.passed }}/{{ r.total }}{{ r.durationMs is not null ? ' · ' ~ r.durationMs ~ 'ms' }}{% endif %}</span>
            <span class="pill {{ st }}" data-state>{{ labels[st] ?? 'Pending'|trans }}</span>
        </{{ r ? 'a' : 'div' }}>
    {% endfor %}
</div>

{% if not finished %}
<span id="grCfg" data-status-url="{{ path('app_flow_group_run_status', {workspace: workspace.id, group: group.id, batchId: batchId}) }}" data-total="{{ total }}" hidden></span>

<script type="application/json" id="gr-i18n">{{ {
    passed: 'Passed'|trans,
    failed: 'Failed'|trans,
    error: 'Error'|trans,
    running: 'Running'|trans,
    cancelled: 'Cancelled'|trans,
    pending: 'Pending'|trans,
    progress: '%done%/%total% flows finished'|trans,
    failedSuffix: ' · %count% failed'|trans,
    someFailed: '%count%/%total% flows failed'|trans,
    allPassed: 'All flows passed (%total%)'|trans
}|json_encode|raw }}</script>

{% verbatim %}
<script>
(function () {
    var cfg = document.getElementById('grCfg');
    var T = JSON.parse(document.getElementById('gr-i18n').textContent);
    var statusUrl = cfg.dataset.statusUrl, total = parseInt(cfg.dataset.total, 10) || 0;
    var bar = document.getElementById('grBar'), fill = document.getElementById('grFill'), summary = document.getElementById('grSummary');
    var rows = [].slice.call(document.querySelectorAll('.wf-row'));

    function label(s) { return T[s] || s; }

    function poll() {
        fetch(statusUrl, {headers: {'X-Requested-With': 'XMLHttpRequest'}}).then(function (r) { return r.json(); }).then(function (d) {
            var byIdx = {};
            (d.runs || []).forEach(function (run) { byIdx[run.iteration] = run; });
            var done = 0, failed = 0;
            rows.forEach(function (row) {
                var idx = parseInt(row.dataset.idx, 10), run = byIdx[idx];
                row.className = 'wf-row ' + (run ? run.status : 'pending');
                var nd = row.querySelector('.node');
                if (nd) nd.className = 'node ' + (run ? run.status : 'pending');
                var st = row.querySelector('[data-state]'), meta = row.querySelector('[data-meta]');
                if (run) {
                    st.className = 'pill ' + run.status; st.textContent = label(run.status);
                    meta.textContent = run.passed + '/' + run.total + (run.durationMs != null ? ' · ' + run.durationMs + 'ms' : '');
                    row.setAttribute('href', run.detailUrl); row.tagName === 'A' || row.setAttribute('role', 'link');
                    row.onclick = function () { window.location.href = run.detailUrl; };
                    if (run.status !== 'running') done++;
                    if (run.status === 'failed' || run.status === 'error') failed++;
                } else {
                    st.className = 'pill pending'; st.textContent = T.pending; meta.textContent = '';
                }
            });
            fill.style.width = (total ? Math.round(done / total * 100) : 0) + '%';
            summary.textContent = T.progress.replace('%done%', done).replace('%total%', total)
                + (failed ? T.failedSuffix.replace('%count%', failed) : '');
            if (d.finished) {
                fill.className = failed ? 'failed' : 'passed';
                summary.textContent = failed
                    ? T.someFailed.replace('%count%', failed).replace('%total%', total)
                    : T.allPassed.replace('%total%', total);
                return;
            }
            setTimeout(poll, 1200);
        }).catch(function () { setTimeout(poll, 2500); });
    }
    setTimeout(poll, 600);
})();
</script>
{% endverbatim %}
{% endif %}
{% endblock %}
