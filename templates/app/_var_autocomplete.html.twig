{# Reusable {{...}} autocomplete. Params:
   - catalog: array of {token,label,desc,group}
   - scope:   CSS selector of the container to attach to (delegated) #}
<script type="application/json" id="vcCatalog">{{ catalog|json_encode|raw }}</script>
<script type="application/json" id="vcConfig">{{ {scope: scope}|json_encode|raw }}</script>
{% verbatim %}
<script>
(function () {
    var catEl = document.getElementById('vcCatalog'), cfgEl = document.getElementById('vcConfig');
    if (!catEl || !cfgEl) return;
    var CAT = [], scope = '';
    try { CAT = JSON.parse(catEl.textContent || '[]'); scope = (JSON.parse(cfgEl.textContent || '{}').scope) || ''; } catch (e) { return; }
    var root = scope ? document.querySelector(scope) : document.body;
    if (!root) return;
    var OPEN = '{' + '{', CLOSE = '}' + '}';
    var pop = document.createElement('div'); pop.className = 'vc-pop'; document.body.appendChild(pop);
    var field = null, start = -1, items = [], sel = 0;

    function editable(el) { return el && (el.tagName === 'TEXTAREA' || (el.tagName === 'INPUT' && (el.type === 'text' || el.type === ''))); }

    function trigger(el) {
        if (typeof el.selectionStart !== 'number') return null;
        var pos = el.selectionStart, text = el.value.slice(0, pos);
        var open = text.lastIndexOf(OPEN);
        if (open === -1) return null;
        if (text.slice(open).indexOf(CLOSE) !== -1) return null;
        return { open: open, frag: text.slice(open + 2) };
    }

    function suggest(frag) {
        var f = frag.toLowerCase(), wantGen = f.charAt(0) === '$', q = wantGen ? f.slice(1) : f;
        return CAT.filter(function (it) {
            if (wantGen && it.group !== 'gen' && it.group !== 'fac') return false;
            return it.label.toLowerCase().indexOf(q) !== -1;
        }).slice(0, 12);
    }

    function hide() { pop.style.display = 'none'; field = null; }

    function render() {
        pop.innerHTML = '';
        items.forEach(function (it, i) {
            var row = document.createElement('div'); row.className = 'vc-item' + (i === sel ? ' sel' : '');
            var g = document.createElement('span'); g.className = 'vc-grp ' + (it.group || 'var'); g.textContent = it.group || 'var';
            var t = document.createElement('span'); t.className = 'vc-tok'; t.textContent = it.token;
            var d = document.createElement('span'); d.className = 'vc-desc'; d.textContent = it.desc || '';
            row.appendChild(g); row.appendChild(t); row.appendChild(d);
            row.addEventListener('mousedown', function (e) { e.preventDefault(); choose(i); });
            pop.appendChild(row);
        });
    }

    // Caret pixel position via a hidden mirror — the popup opens AT the caret,
    // inside the editor's flow, not under the whole field.
    function caretXY(el) {
        var cs = getComputedStyle(el);
        var div = document.createElement('div');
        ['fontFamily', 'fontSize', 'fontWeight', 'lineHeight', 'letterSpacing', 'tabSize',
         'paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft',
         'borderTopWidth', 'borderRightWidth', 'borderBottomWidth', 'borderLeftWidth',
         'boxSizing', 'whiteSpace', 'overflowWrap', 'wordBreak'].forEach(function (prop) { div.style[prop] = cs[prop]; });
        div.style.position = 'absolute'; div.style.visibility = 'hidden'; div.style.top = '-9999px';
        div.style.width = el.tagName === 'TEXTAREA' ? cs.width : 'auto';
        div.textContent = el.value.slice(0, el.selectionStart);
        var mark = document.createElement('span'); mark.textContent = '​';
        div.appendChild(mark);
        document.body.appendChild(div);
        var x = mark.offsetLeft, y = mark.offsetTop, h = mark.offsetHeight || 16;
        div.remove();
        var r = el.getBoundingClientRect();
        return { left: r.left + x - el.scrollLeft, top: r.top + y - el.scrollTop, h: h };
    }

    function position() {
        var r = field.getBoundingClientRect();
        var left = r.left, top = r.bottom + 2;
        try {
            var c = caretXY(field);
            left = Math.min(c.left, window.innerWidth - 260);
            top = c.top + c.h + 4;
            // keep the popup inside the field's vertical bounds where possible
            if (top < r.top) top = r.top + 4;
            if (top > window.innerHeight - 120) top = c.top - 8 - Math.min(280, pop.offsetHeight || 280);
        } catch (e) { /* mirror failed — fall back to the field edge */ }
        pop.style.left = (left + window.scrollX) + 'px';
        pop.style.top = (top + window.scrollY) + 'px';
        pop.style.minWidth = '240px';
    }

    function choose(i) {
        var it = items[i]; if (!it || !field) return;
        var pos = field.selectionStart, v = field.value;
        // Replace the WHOLE surrounding token, not just the typed fragment.
        // Typing a fresh {{ INSIDE an existing token widens the start to the
        // outer token's own {{ first.
        var head = v.slice(0, start).match(/\{\{[\w.$-]*$/);
        if (head) start -= head[0].length;
        // Measure the token FROM ITS START — independent of where the caret
        // sits — so no tail can ever be left behind. If the token is still
        // open ({{pl…), fall back to swallowing a name+}} tail after the caret.
        var whole = v.slice(start).match(/^\{\{[^{}\n]*\}\}/);
        var end;
        if (whole) {
            end = start + whole[0].length;
        } else {
            var tail = v.slice(Math.max(pos, start)).match(/^[\w.$-]*\}\}/);
            end = Math.max(pos, start) + (tail ? tail[0].length : 0);
        }
        field.value = v.slice(0, start) + it.token + v.slice(end);
        var caret = start + it.token.length;
        var f = field; // hide() clears `field` — keep the ref for the caret restore
        hide(); f.focus(); f.setSelectionRange(caret, caret);
        f.dispatchEvent(new Event('input', { bubbles: true }));
    }

    root.addEventListener('input', function (e) {
        if (!editable(e.target) || e.target.id === 'reqSearch') return;
        var t = trigger(e.target);
        if (!t) { hide(); return; }
        items = suggest(t.frag);
        if (!items.length) { hide(); return; }
        field = e.target; start = t.open; sel = 0; render(); position(); pop.style.display = 'block';
    });

    // Clicking INSIDE an existing {{token}} opens the full list to swap it —
    // no typing needed. choose() then replaces the whole token.
    function tokenAt(el) {
        if (typeof el.selectionStart !== 'number') return null;
        var pos = el.selectionStart, v = el.value;
        var open = v.lastIndexOf(OPEN, Math.max(0, pos - 1));
        if (open === -1) return null;
        if (v.slice(open + 2, pos).indexOf(CLOSE) !== -1) return null;
        if (!/^[^{}]*\}\}/.test(v.slice(pos))) return null;
        return open;
    }
    root.addEventListener('click', function (e) {
        if (!editable(e.target) || e.target.id === 'reqSearch') return;
        var open = tokenAt(e.target);
        if (open === null) { if (field === e.target) hide(); return; }
        items = suggest('');
        if (!items.length) return;
        field = e.target; start = open; sel = 0; render(); position(); pop.style.display = 'block';
    });

    root.addEventListener('keydown', function (e) {
        if (pop.style.display !== 'block' || field !== e.target) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); sel = (sel + 1) % items.length; render(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); sel = (sel - 1 + items.length) % items.length; render(); }
        else if (e.key === 'Enter' || e.key === 'Tab') { e.preventDefault(); choose(sel); }
        else if (e.key === 'Escape') { hide(); }
    }, true);

    document.addEventListener('mousedown', function (e) { if (field && e.target !== field && !pop.contains(e.target)) hide(); });
    window.addEventListener('scroll', function () { if (field) position(); }, true);
})();
</script>
{% endverbatim %}
