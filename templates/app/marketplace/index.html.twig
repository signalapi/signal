{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}API Marketplace{% endblock %}

{% macro visibility_pill(api) %}
{# the icon alias cannot be passed in, so the macro imports it itself #}
{% import '_icons.html.twig' as ic %}
    {% if api.visibility == 'public' %}
        <span class="pill">{{ 'Public'|trans }}</span>
        {% if api.verified %}<span class="pill passed">{{ ic.i('check', 11, 2.8) }}{{ 'Verified'|trans }}</span>{% endif %}
    {% elseif api.visibility == 'merchant' %}
        <span class="pill">{{ ic.i('company', 11) }}{{ 'Company only'|trans }}</span>
    {% else %}
        <span class="pill">{{ ic.i('shield', 11) }}{{ 'Workspace only'|trans }}</span>
    {% endif %}
{% endmacro %}

{% block panel %}
<div class="pagehead">
    <div>
        <h1>API Marketplace</h1>
        <p class="subtitle">{{ 'A platform-wide catalog: add ready-made API definitions to your workspace with one click, or publish your own.'|trans }}</p>
    </div>
    {% if can_publish %}
        <div class="actions">
            <a class="btn" href="{{ path('app_marketplace_publish') }}">{{ ic.i('plus', 13, 2.2) }}{{ 'Publish an API'|trans }}</a>
        </div>
    {% endif %}
</div>

{% if apis is empty %}
    <div class="empty">{{ 'No APIs available to you yet.'|trans }}</div>
{% elseif workspaces is empty %}
    <div class="flash error">{{ ic.i('x', 14, 2.6) }}{{ 'You have no workspace you can import into (editor+ permission).'|trans }}</div>
{% endif %}

<div class="res-grid stagger">
    {% for a in apis %}
        <div class="res-card">
            <div class="rc-top">
                <div class="ic">{% if a.logo %}{{ a.logo }}{% else %}{{ ic.i('marketplace', 16) }}{% endif %}</div>
                <div class="rc-name">
                    <span>{{ a.name }}</span>
                    <div class="s">{{ a.publisher ?? '' }}{{ a.category ? (a.publisher ? ' · ' : '') ~ a.category }}</div>
                </div>
            </div>
            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;">{{ _self.visibility_pill(a) }}</div>
            {% if a.description %}<p class="subtitle" style="margin-top:10px;">{{ a.description }}</p>{% endif %}
            <p class="subtitle" style="margin-top:8px;font-size:11.5px;">
                {{ 'Version'|trans }} <strong class="mono">{{ a.latestVersion.label }}</strong> · {{ '%count% endpoint|%count% endpoints'|trans({'%count%': a.latestVersion.spec.paths|length}) }} · {{ a.latestVersion.createdAt|date('d.m.Y') }}
            </p>
            {% if workspaces is not empty %}
            <div class="rc-foot">
                <form method="post" action="{{ path('app_marketplace_add', {slug: a.slug}) }}" style="display:flex;gap:8px;width:100%;">
                    <select name="workspace_id" class="grow">
                        {% for w in workspaces %}
                            <option value="{{ w.id }}">{{ w.name }}</option>
                        {% endfor %}
                    </select>
                    <input type="hidden" name="_token" value="{{ csrf_token('marketplace-add') }}">
                    <button class="btn" type="submit">{{ ic.i('plus', 13, 2.2) }}{{ 'Add'|trans }}</button>
                </form>
            </div>
            {% endif %}
        </div>
    {% endfor %}
</div>

{% if my_published is not empty %}
    <div class="pagehead" style="margin-top:30px;">
        <div>
            <div class="eyebrow" style="margin-bottom:5px;">{{ 'Published by your company'|trans }}</div>
            <p class="subtitle">{{ 'Entries your company offers in the marketplace.'|trans }}</p>
        </div>
    </div>
    <table class="data">
        <thead><tr><th>{{ 'Name'|trans }}</th><th>{{ 'Reach'|trans }}</th><th>{{ 'Scope'|trans }}</th><th>{{ 'Version'|trans }}</th><th></th></tr></thead>
        <tbody>
        {% for a in my_published %}
            <tr>
                <td style="font-weight:600;">{{ a.logo }} {{ a.name }}</td>
                <td style="white-space:nowrap;">{{ _self.visibility_pill(a) }}</td>
                <td>{{ a.ownerWorkspace ? a.ownerWorkspace.name : '—' }}</td>
                <td class="mono">{{ a.latestVersion ? a.latestVersion.label : 'not published'|trans }}</td>
                <td style="text-align:right;white-space:nowrap;">
                    <div style="display:inline-flex;gap:7px;justify-content:flex-end;">
                        {% if publishable is not empty %}
                            <form method="post" action="{{ path('app_marketplace_new_version', {slug: a.slug}) }}" style="display:flex;gap:7px;">
                                <input type="hidden" name="_token" value="{{ csrf_token('marketplace-version' ~ a.id) }}">
                                <input type="hidden" name="source" value="collection">
                                <select name="collection_id" title="{{ 'Publish a new version from…'|trans }}" style="width:auto;">
                                    {% for c in publishable %}
                                        <option value="{{ c.id }}">{{ c.workspace.name }} · {{ c.name }}</option>
                                    {% endfor %}
                                </select>
                                <button class="btn ghost small" type="submit">{{ ic.i('import', 12) }}{{ 'New version'|trans }}</button>
                            </form>
                        {% endif %}
                        <form method="post" action="{{ path('app_marketplace_unpublish', {slug: a.slug}) }}" onsubmit="return confirm('{{ 'The entry and all its versions will be removed from the marketplace.'|trans|e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('marketplace-unpublish' ~ a.id) }}">
                            <button class="btn danger small" type="submit">{{ ic.i('trash', 12) }}{{ 'Remove'|trans }}</button>
                        </form>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
