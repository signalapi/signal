{% extends 'app/_layout.html.twig' %}
{% import 'app/collection/_tree.html.twig' as tree %}

{% block title %}{{ request.name }}{% endblock %}

{% block panel %}
<div class="toolbar">
    <div>
        <h1>{{ request.name }}</h1>
        <p class="subtitle" style="margin:0;">
            <a href="{{ path('app_collection_show', {workspace: workspace.id, collection: request.collection.id}) }}">← {{ request.collection.name }}</a>
        </p>
    </div>
    <form class="inline" method="post" action="{{ path('app_request_delete', {workspace: workspace.id, request: request.id}) }}" onsubmit="return confirm('İstek silinecek. Emin misiniz?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ request.id) }}">
        <button class="btn danger" type="submit">Sil</button>
    </form>
</div>

<form method="post" action="{{ path('app_request_send', {workspace: workspace.id, request: request.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('save-request' ~ request.id) }}">

    <div class="field">
        <label>İstek adı</label>
        <input type="text" name="name" value="{{ request.name }}">
    </div>

    <div class="card" style="margin-bottom:16px;">
        <div style="display:flex;gap:8px;align-items:center;">
            <select name="method" style="background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:9px;color:var(--text);font-weight:600;">
                {% for m in constant('App\\Entity\\ApiRequest::METHODS') %}
                    <option value="{{ m }}" {{ request.method == m ? 'selected' }}>{{ m }}</option>
                {% endfor %}
            </select>
            <input type="text" name="url" value="{{ request.url }}" placeholder="https://api.example.com/{{ '{{basePath}}' }}" style="flex:1;background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--text);font-family:monospace;">
            <button class="btn" type="submit">Gönder ▸</button>
            <button class="btn ghost" type="submit" formaction="{{ path('app_request_save', {workspace: workspace.id, request: request.id}) }}">Kaydet</button>
        </div>
        <div style="margin-top:10px;display:flex;align-items:center;gap:8px;">
            <label style="color:var(--muted);font-size:13px;">Environment:</label>
            <select name="environment" style="background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:7px 10px;color:var(--text);">
                <option value="">— yok —</option>
                {% for env in environments %}
                    <option value="{{ env.id }}" {{ (selected_env is defined and selected_env == env.id) ? 'selected' }}>{{ env.name }}</option>
                {% endfor %}
            </select>
            <span class="subtitle" style="margin:0;font-size:12px;">{{ '{{değişken}}' }} sözdizimi desteklenir.</span>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div class="field">
            <label>Header'lar (her satır <code>Ad: değer</code>)</label>
            <textarea name="headers" rows="5" style="font-family:monospace;">{% for h in request.headers %}{{ h.name }}: {{ h.value }}
{% endfor %}</textarea>
        </div>
        <div class="field">
            <label>Query parametreleri (her satır <code>ad=değer</code>)</label>
            <textarea name="params" rows="5" style="font-family:monospace;">{% for p in request.queryParams %}{{ p.name }}={{ p.value }}
{% endfor %}</textarea>
        </div>
    </div>

    <div class="field">
        <label>Body modu</label>
        <select name="bodyMode" style="background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:8px;color:var(--text);">
            {% for mode in ['none', 'raw', 'json', 'form'] %}
                <option value="{{ mode }}" {{ request.bodyMode == mode ? 'selected' }}>{{ mode }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="field">
        <label>Body</label>
        <textarea name="body" rows="8" style="font-family:monospace;">{{ request.body }}</textarea>
    </div>
</form>

{% if result %}
    <h1 style="font-size:18px;margin-top:28px;">Yanıt</h1>
    {% if result.ok %}
        {% set sc = result.statusCode %}
        {% set color = sc < 300 ? 'var(--accent-2)' : (sc < 400 ? 'var(--warn)' : 'var(--danger)') %}
        <div class="card">
            <div style="display:flex;gap:20px;align-items:center;margin-bottom:14px;">
                <span style="font-size:20px;font-weight:700;color:{{ color }};">{{ sc }}</span>
                <span class="subtitle" style="margin:0;">{{ result.durationMs|number_format(0) }} ms</span>
            </div>
            <label style="color:var(--muted);font-size:12px;text-transform:uppercase;">Body</label>
            <pre style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:14px;overflow:auto;max-height:420px;font-size:13px;">{{ result.prettyBody() }}</pre>
        </div>
    {% else %}
        <div class="flash error">İstek başarısız: {{ result.error }}</div>
    {% endif %}
{% endif %}
{% endblock %}
