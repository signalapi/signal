{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Data Factories'|trans }} · {{ workspace.name }}{% endblock %}

{% block panel %}
<div class="pagehead">
    <div>
        <h1>{{ 'Data factories'|trans }}</h1>
        <p class="subtitle">{{ 'Generators for the values a flow needs — usable as %token% anywhere'|trans({'%token%': ('{{$token}}') }) }}</p>
    </div>
    <div class="actions">
        <form method="post" action="{{ path('app_factory_new', {workspace: workspace.id}) }}" id="facNewForm">
            <input type="hidden" name="name" id="facNewName">
            <input type="hidden" name="_token" value="{{ csrf_token('factory-new') }}">
            <button class="btn" type="button" id="facNewBtn">{{ ic.i('plus', 13, 2.2) }}{{ 'Factory'|trans }}</button>
        </form>
    </div>
</div>

<div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:14px;align-items:start;">
    {% include 'app/data_factory/_list.html.twig' with {selected: null} %}

    <div class="card">
        <div class="card-head">
            <span class="t">{{ 'Built-in generators'|trans }}</span>
            <span class="subtitle" style="font-size:11px;">{{ 'click a token → copied'|trans }}</span>
        </div>
        {% for b in builtins %}
            <button type="button" class="bi-card" data-copy="{{ b.token }}" title="{{ 'Copy'|trans }}"
                    style="display:flex;align-items:center;gap:11px;padding:11px 15px;width:100%;min-width:0;background:none;border:none;border-top:1px solid var(--line2);cursor:pointer;font-family:inherit;text-align:left;">
                <code class="mono" style="flex:0 0 150px;font-size:11.5px;font-weight:700;color:var(--pri);">{{ b.token }}</code>
                <span style="flex:1;min-width:0;font-size:11px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ b.description }}</span>
                <span style="flex:0 0 150px;font-family:var(--mono);font-size:10.5px;color:var(--faint);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ b.sample }}</span>
            </button>
        {% endfor %}
    </div>
</div>

<script>
document.getElementById('facNewBtn').addEventListener('click', function () {
    var n = prompt('{{ 'New factory name (e.g. testCard, provider)'|trans|e('js') }}');
    if (!n) return;
    document.getElementById('facNewName').value = n;
    document.getElementById('facNewForm').submit();
});
document.querySelectorAll('.bi-card').forEach(function (c) {
    c.addEventListener('click', function () {
        var t = c.dataset.copy;
        (navigator.clipboard ? navigator.clipboard.writeText(t) : Promise.reject()).then(function () {
            c.style.background = 'var(--pri-soft)'; setTimeout(function () { c.style.background = ''; }, 700);
        }).catch(function () {});
    });
});
</script>
{% endblock %}
