{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ '{{$' ~ factory.name ~ '}}' }} · {{ 'Data Factory'|trans }}{% endblock %}

{% block panel %}
{% set cfg = factory.config %}
<a class="backlink" href="{{ path('app_factory_index', {workspace: workspace.id}) }}">← {{ 'Data Factories'|trans }}</a>
<div class="pagehead">
    <div>
        <h1>{{ 'Edit factory'|trans }}</h1>
        <p class="subtitle">{{ 'Used in flows as %token% — a fresh value every time.'|trans({'%token%': '<code>' ~ ('{{$' ~ factory.name ~ '}}')|e ~ '</code>'})|raw }}</p>
    </div>
</div>

<form method="post" id="facForm" data-preview="{{ path('app_factory_preview', {workspace: workspace.id, factory: factory.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('factory-edit' ~ factory.id) }}">

    <div class="grid2" style="max-width:640px;">
        <div class="field">
            <label>{{ 'Name (token)'|trans }}</label>
            <input type="text" name="name" value="{{ factory.name }}" class="input-mono">
            <p class="fhint">{{ 'Letters, digits,'|trans }} <code>_</code>, <code>.</code></p>
        </div>
        <div class="field">
            <label>{{ 'Kind'|trans }}</label>
            <select name="kind" id="kind">
                <option value="oneOf"    {{ factory.kind == 'oneOf' ? 'selected' }}>{{ 'One of a list (oneOf)'|trans }}</option>
                <option value="template" {{ factory.kind == 'template' ? 'selected' }}>{{ 'Template (template)'|trans }}</option>
                <option value="intRange" {{ factory.kind == 'intRange' ? 'selected' }}>{{ 'Number range (intRange)'|trans }}</option>
                <option value="pattern"  {{ factory.kind == 'pattern' ? 'selected' }}>{{ 'Pattern (pattern)'|trans }}</option>
            </select>
        </div>
    </div>
    <div class="field" style="max-width:640px;">
        <label>{{ 'Description (optional)'|trans }}</label>
        <input type="text" name="description" value="{{ factory.description }}" placeholder="{{ 'what does it generate?'|trans }}">
    </div>

    {# ---- kind-specific config ---- #}
    <div class="fgroup kcfg" data-kind="oneOf" style="max-width:640px;">
        <div class="fgroup-title">{{ 'Values — one option per line'|trans }}</div>
        <textarea name="values" rows="6" class="input-mono" placeholder="Yuno&#10;Payrails">{{ (cfg.values ?? [])|join('\n') }}</textarea>
        <p class="fhint">{{ 'A random line is picked.'|trans }}</p>
    </div>
    <div class="fgroup kcfg" data-kind="template" style="max-width:640px;">
        <div class="fgroup-title">{{ 'Template'|trans }}</div>
        <input type="text" name="template" value="{{ cfg.template ?? '' }}" class="input-mono" placeholder="test+{{ '{{$guid}}' }}@zotlo.com">
        <p class="fhint">{{ 'The %token% generators inside it (built-in or another factory) are resolved.'|trans({'%token%': '<code>' ~ ('{{$...}}')|e ~ '</code>'})|raw }}</p>
    </div>
    <div class="fgroup kcfg" data-kind="intRange" style="max-width:640px;">
        <div class="fgroup-title">{{ 'Number range'|trans }}</div>
        <div style="display:flex;gap:12px;">
            <div class="field" style="margin:0;">
                <label>min</label>
                <input type="number" name="min" value="{{ cfg.min ?? 1 }}" style="width:110px;">
            </div>
            <div class="field" style="margin:0;">
                <label>max</label>
                <input type="number" name="max" value="{{ cfg.max ?? 100 }}" style="width:110px;">
            </div>
        </div>
    </div>
    <div class="fgroup kcfg" data-kind="pattern" style="max-width:640px;">
        <div class="fgroup-title">{{ 'Pattern'|trans }}</div>
        <input type="text" name="pattern" value="{{ cfg.pattern ?? '' }}" class="input-mono" placeholder="#### #### #### ####">
        <p class="fhint"><code>#</code> {{ 'digit'|trans }} · <code>A</code> A-Z · <code>a</code> a-z · <code>*</code> {{ 'letter+digit'|trans }} · {{ 'others as-is.'|trans }}</p>
    </div>

    <div class="fgroup" style="max-width:640px;">
        <div style="display:flex;align-items:center;gap:10px;">
            <button type="button" class="btn ghost small" id="previewBtn">{{ ic.i('factory', 12) }}{{ 'Preview'|trans }}</button>
            <span id="previewOut" class="mono" style="font-size:11.5px;color:var(--pri);"></span>
        </div>
    </div>

    <div class="form-actions">
        <button class="btn" type="submit">{{ 'Save'|trans }}</button>
        <a class="btn ghost" href="{{ path('app_factory_index', {workspace: workspace.id}) }}">{{ 'Cancel'|trans }}</a>
    </div>
</form>

<script>
(function () {
    var form = document.getElementById('facForm');
    var kind = document.getElementById('kind');
    function sync() {
        document.querySelectorAll('.kcfg').forEach(function (el) {
            el.style.display = el.dataset.kind === kind.value ? '' : 'none';
        });
    }
    kind.addEventListener('change', sync); sync();

    document.getElementById('previewBtn').addEventListener('click', function () {
        var out = document.getElementById('previewOut');
        out.textContent = '…';
        var fd = new FormData(form);
        fetch(form.dataset.preview, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'fetch' } })
            .then(function (r) { return r.json(); })
            .then(function (d) { out.textContent = (d.samples || []).join('   ·   '); })
            .catch(function () { out.textContent = '{{ 'preview failed'|trans|e('js') }}'; });
    });
})();
</script>

{% include 'app/_var_autocomplete.html.twig' with {catalog: vc_catalog, scope: '#facForm'} %}
{% endblock %}
