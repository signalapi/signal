{# master–detail left rail: factory list. Vars: workspace, factories, samples, selected (id string|null) #}
{% set kindtone = {oneOf: 'pri', template: 'vio', intRange: 'teal', pattern: 'warn'} %}
{% set kinddesc = {oneOf: 'one of a list'|trans, template: 'template'|trans, intRange: 'integer range'|trans, pattern: 'pattern'|trans} %}
<div class="list-card" style="margin:0;">
    <div class="lc-head" style="text-transform:none;letter-spacing:0;font-family:var(--font);font-size:12.5px;font-weight:700;color:var(--ink);">
        {{ 'Factories'|trans }}
        <span class="mpill">{{ factories|length }}</span>
    </div>
    {% for f in factories %}
        <a class="lrow" href="{{ path('app_factory_edit', {workspace: workspace.id, factory: f.id}) }}"
           {% if selected is defined and selected == (f.id ~ '') %}style="background:var(--pri-soft);"{% endif %}>
            <span class="tbadge wide {{ kindtone[f.kind] ?? '' }}" style="text-transform:none;">{{ f.kind }}</span>
            <span style="flex:1; min-width:0;">
                <span class="l-name mono" style="color:var(--pri);font-family:var(--mono);font-size:12px;">${{ f.name }}</span>
                <span class="l-sub" style="font-family:var(--font);font-size:11px;color:var(--faint);">{{ f.description ?: kinddesc[f.kind] ?? f.kind }}</span>
            </span>
            <span class="l-meta" style="max-width:130px;overflow:hidden;text-overflow:ellipsis;">{{ samples[f.id ~ ''] ?? '' }}</span>
        </a>
    {% else %}
        <div class="lrow"><span class="subtitle">{{ 'No factories yet.'|trans }}</span></div>
    {% endfor %}
</div>
