{% extends 'base.html.twig' %}

{% block body %}
{% set ws = workspace is defined and workspace ? workspace : current_workspace() %}
{% set route = app.request.attributes.get('_route') %}
{% set glyph %}<svg class="glyph" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="27" fill="none" stroke="var(--accent)" stroke-width="6"/><circle cx="32" cy="32" r="10" fill="var(--accent)"/></svg>{% endset %}
<div class="layout">
    <aside class="sidebar" id="sidebar">
        <div class="brand">
            {{ glyph }}<span>Signal</span>
            <button class="collapse-btn" id="collapseBtn" title="{{ 'Collapse/expand'|trans }}" aria-label="{{ 'Collapse menu'|trans }}">«</button>
        </div>

        {% set memberships = merchant_memberships() %}
        {% set multiMerchant = memberships|length > 1 %}
        {% if multiMerchant %}
            {% set cm = current_merchant() %}
            <div class="ws-switch">
                <div class="switch-cap">{{ 'Company'|trans }}</div>
                <form method="post" action="" id="merchantSwitchForm">
                    <input type="hidden" name="_token" value="{{ csrf_token('switch-merchant') }}">
                    <select aria-label="{{ 'Select merchant'|trans }}"
                            onchange="if(this.value){var f=document.getElementById('merchantSwitchForm');f.action=this.value;f.submit();}">
                        {% for m in memberships %}
                            <option value="{{ path('app_merchant_switch', {id: m.merchant.id}) }}" {{ cm and cm.id == m.merchant.id ? 'selected' }}>{{ m.merchant.name }}</option>
                        {% endfor %}
                    </select>
                </form>
            </div>
        {% endif %}

        <div class="ws-switch">
            {% if multiMerchant %}<div class="switch-cap">Workspace</div>{% endif %}
            <select onchange="if(this.value)location.href=this.value;" aria-label="{{ 'Select workspace'|trans }}" {% if not multiMerchant %}style="margin-top:12px;"{% endif %}>
                {% for w in merchant_workspaces() %}
                    <option value="{{ path('app_workspace_show', {id: w.id}) }}" {{ ws and ws.id == w.id ? 'selected' }}>{{ w.name }}</option>
                {% else %}
                    <option value="">{{ '— no workspaces —'|trans }}</option>
                {% endfor %}
                {% if current_merchant() and is_granted('MERCHANT_MANAGE_WORKSPACES', current_merchant()) %}
                    <option value="{{ path('app_workspace_new') }}">{{ '+ New workspace…'|trans }}</option>
                {% endif %}
            </select>
        </div>

        <nav class="nav">
            {% if ws %}
                <a href="{{ path('app_workspace_show', {id: ws.id}) }}" class="{{ route == 'app_workspace_show' ? 'active' }}"><span class="ico">◇</span><span class="label">{{ 'Overview'|trans }}</span></a>

                <div class="nav-group">{{ 'Work'|trans }}</div>
                <a href="{{ path('app_collection_index', {workspace: ws.id}) }}" class="{{ route starts with 'app_collection' or route starts with 'app_request' or route starts with 'wb_' ? 'active' }}"><span class="ico">🧪</span><span class="label">{{ 'Collections'|trans }}</span></a>
                <a href="{{ path('app_environment_index', {workspace: ws.id}) }}" class="{{ route starts with 'app_environment' ? 'active' }}"><span class="ico">🌐</span><span class="label">{{ 'Environments'|trans }}</span></a>

                <div class="nav-group">Test</div>
                <a href="{{ path('app_flow_index', {workspace: ws.id}) }}" class="{{ (route starts with 'app_flow' and not route starts with 'app_flow_group') ? 'active' }}"><span class="ico">▶</span><span class="label">{{ 'Flows'|trans }}</span></a>
                <a href="{{ path('app_flow_suite_index', {workspace: ws.id}) }}" class="{{ route starts with 'app_flow_group' ? 'active' }}"><span class="ico">🧩</span><span class="label">{{ 'Suites'|trans }}</span></a>
                <a href="{{ path('app_history_index', {workspace: ws.id}) }}" class="{{ route starts with 'app_history' ? 'active' }}"><span class="ico">🕘</span><span class="label">{{ 'History'|trans }}</span></a>
                <a href="{{ path('app_trends', {workspace: ws.id}) }}" class="{{ route starts with 'app_trends' ? 'active' }}"><span class="ico">📈</span><span class="label">{{ 'Trends'|trans }}</span></a>

                <div class="nav-group">{{ 'Infrastructure'|trans }}</div>
                <a href="{{ path('app_dbconn_index', {workspace: ws.id}) }}" class="{{ route starts with 'app_dbconn' ? 'active' }}"><span class="ico">🗄</span><span class="label">{{ 'DB Connections'|trans }}</span></a>
                <a href="{{ path('app_factory_index', {workspace: ws.id}) }}" class="{{ route starts with 'app_factory' ? 'active' }}"><span class="ico">🎲</span><span class="label">{{ 'Data Factories'|trans }}</span></a>
                <a href="{{ path('app_cookie_index', {workspace: ws.id}) }}" class="{{ route starts with 'app_cookie' ? 'active' }}"><span class="ico">🍪</span><span class="label">{{ 'Cookies'|trans }}</span></a>

                <div class="nav-group">{{ 'Management'|trans }}</div>
                <a href="{{ path('app_apitoken_index', {workspace: ws.id}) }}" class="{{ route starts with 'app_apitoken' ? 'active' }}"><span class="ico">🔑</span><span class="label">API & MCP</span></a>
                {% if is_granted('WORKSPACE_ADMIN', ws) %}
                    <a href="{{ path('app_ws_member_index', {workspace: ws.id}) }}" class="{{ route starts with 'app_ws_member' ? 'active' }}"><span class="ico">👥</span><span class="label">{{ 'Members'|trans }}</span></a>
                {% endif %}
            {% endif %}
            <div style="flex:1"></div>
            {# Platform-wide, above any single company or workspace. #}
            <div class="nav-group">{{ 'Discover'|trans }}</div>
            <a href="{{ path('app_marketplace') }}" class="{{ route starts with 'app_marketplace' ? 'active' }}"><span class="ico">🛒</span><span class="label nav-foot-label">API Marketplace</span></a>

            <div class="nav-group">{{ 'Company'|trans }}</div>
            {% if current_merchant() and is_granted('MERCHANT_MANAGE_MEMBERS', current_merchant()) %}
                <a href="{{ path('app_member_index') }}" class="{{ route starts with 'app_member' or route starts with 'app_invitation' ? 'active' }}"><span class="ico">🏢</span><span class="label nav-foot-label">{{ 'Users'|trans }}</span></a>
            {% endif %}
            <a href="{{ path('app_workspace_index') }}" class="{{ route == 'app_workspace_index' ? 'active' }}"><span class="ico">⚙</span><span class="label nav-foot-label">{{ 'Workspaces'|trans }}</span></a>
        </nav>

        <div class="userbox">
            <div class="name"><a href="{{ path('app_profile') }}" style="color:inherit;text-decoration:none;">{{ app.user.name }}</a></div>
            <div class="email">{{ app.user.email }}</div>
            <div style="margin-top:8px;"><a href="{{ path('app_profile') }}" class="label">{{ 'Profile'|trans }}</a> · <a href="{{ path('app_logout') }}" class="label">{{ 'Sign out'|trans }}</a></div>
            <div style="margin-top:6px;" class="label">
                <a href="{{ path('app_locale_switch', {locale: 'en'}) }}" {% if app.request.locale == 'en' %}style="font-weight:700;color:var(--accent);"{% endif %}>EN</a>
                ·
                <a href="{{ path('app_locale_switch', {locale: 'tr'}) }}" {% if app.request.locale == 'tr' %}style="font-weight:700;color:var(--accent);"{% endif %}>TR</a>
            </div>
        </div>
    </aside>

    <main class="content">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash {{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block panel %}{% endblock %}
    </main>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var sb = document.getElementById('sidebar');
    if (!sb) return;
    if (localStorage.getItem('sb_collapsed') === '1') sb.classList.add('collapsed');
    var b = document.getElementById('collapseBtn');
    if (b) b.addEventListener('click', function () {
        sb.classList.toggle('collapsed');
        localStorage.setItem('sb_collapsed', sb.classList.contains('collapsed') ? '1' : '0');
    });
})();
</script>
{% endblock %}
