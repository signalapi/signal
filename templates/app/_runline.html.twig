{# Renders a flow run as a strip of step ticks — the product's signature motif. #}
{% macro line(run) %}
    <span class="strip">
        {% for r in run.stepResults %}
            <i class="{{ r.status }}" title="{{ r.label }}: {{ r.status }}"></i>
        {% endfor %}
        {% if run.stepResults is empty %}<i></i>{% endif %}
    </span>
{% endmacro %}
