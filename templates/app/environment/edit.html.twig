{# ==========================================================================
   Final design: one combined table — VARIABLE | TEAM VALUE | MY VALUE — with
   the sibling environments as a segmented switcher in the page head.
   Two scopes still post to their own endpoints: the MY VALUE column belongs
   to the personal form; the shared definition opens as a separate editor pane
   (Edit team variables) because it rebuilds all rows and needs WORKSPACE_EDIT.
   ========================================================================== #}
{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ environment.name }} · Environment{% endblock %}

{% block panel %}
{% set can_edit = is_granted('WORKSPACE_EDIT', workspace) %}

<div class="pagehead">
    <div>
        <h1>{{ 'Environments'|trans }}</h1>
        <p class="subtitle">{{ 'Variables per environment, with your own values on top'|trans }}</p>
    </div>
    <div class="actions">
        <span class="seg">
            {% for e in environments %}
                <a href="{{ path('app_environment_edit', {workspace: workspace.id, environment: e.id}) }}"
                   class="{{ e.id == environment.id ? 'on' }}">{{ e.name }}</a>
            {% endfor %}
        </span>
        {% if can_edit %}
            <button class="btn ghost" type="button" id="teamEditBtn">{{ ic.i('pencil', 12) }}{{ 'Edit team variables'|trans }}</button>
        {% endif %}
    </div>
</div>

<div style="display:flex;align-items:center;gap:9px;padding:11px 13px;background:var(--pri-soft);border:1px solid var(--line);border-radius:11px;margin-bottom:14px;">
    {{ ic.i('members', 14) }}
    <span style="font-size:11.5px;color:var(--pri);">{{ 'A value you enter under “mine” only applies to your runs. The team value stays untouched.'|trans }}</span>
</div>

{# ---------------- combined table (design default): my values form ---------------- #}
<div data-pane="mine">
    {% if environment.variables is empty %}
        <div class="empty">{{ 'This environment has no variables yet.'|trans }}</div>
    {% else %}
        <form method="post" action="{{ path('app_environment_my_values', {workspace: workspace.id, environment: environment.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('my-values' ~ environment.id) }}">
            <div class="list-card">
                <div class="lc-head">
                    <span style="flex:0 0 220px;">{{ 'Variable'|trans }}</span>
                    <span style="flex:1;">{{ 'Team value'|trans }}</span>
                    <span style="flex:0 0 300px;">{{ 'My value'|trans }}</span>
                    <span style="flex:0 0 52px;"></span>
                </div>
                {% for v in environment.variables %}
                    {% set overridden = my_values[v.name]|default('') != '' %}
                    <div class="lrow" style="padding:9px 15px;">
                        <span class="mono" style="flex:0 0 220px;font-size:11.5px;font-weight:700;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="{{ v.name }}">{{ v.name }}</span>
                        <span class="mono" style="flex:1;min-width:0;font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;{{ v.secret ? 'color:var(--warn);' : 'color:var(--muted);' }}"
                              title="{{ v.secret ? '' : v.value }}">{{ v.secret ? (v.value ? v.value|slice(0, 5) ~ '_••••••••' : '••••••••') : (v.value ?: '—') }}</span>
                        <span style="flex:0 0 300px;">
                            <input type="{{ v.secret ? 'password' : 'text' }}" name="my[{{ v.name }}]"
                                   value="{{ my_values[v.name]|default('') }}" class="input-mono"
                                   placeholder="{{ v.secret ? '••••••••' : 'team value'|trans }}" autocomplete="off"
                                   style="width:100%;font-size:11.5px;{{ overridden ? 'border-color:var(--vio);background:var(--vio-soft);color:var(--vio);' }}">
                        </span>
                        <span style="flex:0 0 52px;display:flex;justify-content:flex-end;">
                            {% if overridden %}<span class="mpill vio">{{ 'mine'|trans }}</span>
                            {% elseif v.secret %}<span class="mpill warn">{{ 'secret'|trans }}</span>{% endif %}
                        </span>
                    </div>
                {% endfor %}
            </div>
            <div class="form-actions" style="margin-top:12px;">
                <button class="btn" type="submit">{{ 'Save my values'|trans }}</button>
                <a class="btn ghost" href="{{ path('app_environment_index', {workspace: workspace.id}) }}">{{ 'All environments'|trans }}</a>
            </div>
            <p class="fhint" style="margin-top:8px;">{{ 'Only you see these. When a field is empty you fall back to the team value.'|trans }}</p>
        </form>
    {% endif %}
</div>

{# ---------------- shared definition editor (WORKSPACE_EDIT) ---------------- #}
{% if can_edit %}
<div data-pane="shared" hidden>
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('edit-environment' ~ environment.id) }}">
        <div class="field" style="max-width:480px;">
            <label>{{ 'Environment name'|trans }}</label>
            <input type="text" name="name" value="{{ environment.name }}">
        </div>

        <div class="list-card" id="vars">
            <div class="lc-head">
                <span style="flex:0 0 260px;">{{ 'Name'|trans }}</span>
                <span style="flex:1;">{{ 'Value'|trans }}</span>
                <span style="flex:0 0 60px;text-align:center;">{{ 'Secret'|trans }}</span>
            </div>
            {% set idx = 0 %}
            {% for v in environment.variables %}
                <div class="lrow vrow" style="padding:8px 15px;">
                    <span style="flex:0 0 260px;"><input type="text" name="var_name[{{ idx }}]" value="{{ v.name }}" class="input-mono" style="width:100%;font-size:11.5px;"></span>
                    <span style="flex:1;"><input type="text" name="var_value[{{ idx }}]" value="{{ v.value }}" class="input-mono" style="width:100%;font-size:11.5px;"></span>
                    <span style="flex:0 0 60px;text-align:center;"><input type="checkbox" name="var_secret[{{ idx }}]" value="1" {{ v.secret ? 'checked' }} style="width:auto;"></span>
                </div>
                {% set idx = idx + 1 %}
            {% endfor %}
            {% for i in 1..3 %}
                <div class="lrow vrow" style="padding:8px 15px;">
                    <span style="flex:0 0 260px;"><input type="text" name="var_name[{{ idx }}]" value="" class="input-mono" style="width:100%;font-size:11.5px;"></span>
                    <span style="flex:1;"><input type="text" name="var_value[{{ idx }}]" value="" class="input-mono" style="width:100%;font-size:11.5px;"></span>
                    <span style="flex:0 0 60px;text-align:center;"><input type="checkbox" name="var_secret[{{ idx }}]" value="1" style="width:auto;"></span>
                </div>
                {% set idx = idx + 1 %}
            {% endfor %}
        </div>
        <p class="fhint">{{ 'Empty rows are ignored. Secret variables are masked in the UI.'|trans }}</p>
        <button type="button" class="btn ghost small" onclick="addRow()" style="margin-top:8px;">{{ ic.i('plus', 13, 2.2) }}{{ 'Add row'|trans }}</button>

        <div class="form-actions">
            <button class="btn" type="submit">{{ 'Save'|trans }}</button>
            <button class="btn ghost" type="button" id="teamCancelBtn">{{ 'Back to my values'|trans }}</button>
        </div>
    </form>
</div>
{% endif %}

<script>
function addRow() {
    var card = document.getElementById('vars');
    var i = card.querySelectorAll('.vrow').length;
    var row = document.createElement('div');
    row.className = 'lrow vrow';
    row.style.cssText = 'padding:8px 15px;';
    row.innerHTML =
        '<span style="flex:0 0 260px;"><input type="text" name="var_name[' + i + ']" class="input-mono" style="width:100%;font-size:11.5px;"></span>' +
        '<span style="flex:1;"><input type="text" name="var_value[' + i + ']" class="input-mono" style="width:100%;font-size:11.5px;"></span>' +
        '<span style="flex:0 0 60px;text-align:center;"><input type="checkbox" name="var_secret[' + i + ']" value="1" style="width:auto;"></span>';
    card.appendChild(row);
}
(function () {
    function show(name) {
        document.querySelectorAll('[data-pane]').forEach(function (p) { p.hidden = p.dataset.pane !== name; });
    }
    var btn = document.getElementById('teamEditBtn');
    if (btn) btn.addEventListener('click', function () { show('shared'); history.replaceState(null, '', '#shared'); });
    var back = document.getElementById('teamCancelBtn');
    if (back) back.addEventListener('click', function () { show('mine'); history.replaceState(null, '', '#mine'); });
    if (location.hash === '#shared' && btn) show('shared');
})();
</script>
{% endblock %}
