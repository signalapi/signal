{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ environment.name }} · Environment{% endblock %}

{% block panel %}
{% set can_edit = is_granted('WORKSPACE_EDIT', workspace) %}
<a class="backlink" href="{{ path('app_environment_index', {workspace: workspace.id}) }}"><span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>{{ 'Environments'|trans }}</a>
<div class="pagehead">
    <div>
        <h1>{{ can_edit ? 'Edit environment'|trans : environment.name }}</h1>
        <p class="subtitle">{{ workspace.name }} · {{ 'shared values are used by everyone; your own values override them only for you'|trans }}</p>
    </div>
</div>

<form method="post" action="{{ path('app_environment_my_values', {workspace: workspace.id, environment: environment.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('my-values' ~ environment.id) }}">
    <div class="fgroup">
        <div class="fgroup-title">{{ 'My values'|trans }}</div>
        {% if environment.variables is empty %}
            <p class="fhint">{{ 'This environment has no variables yet.'|trans }}</p>
        {% else %}
            <table class="data" id="myvars">
                <thead><tr>
                    <th style="width:30%;">{{ 'Name'|trans }}</th>
                    <th style="width:35%;">{{ 'Shared value'|trans }}</th>
                    <th>{{ 'My value'|trans }}</th>
                </tr></thead>
                <tbody>
                {% for v in environment.variables %}
                    <tr>
                        <td class="mono">
                            {{ v.name }}{% if v.secret %} <span class="pill">{{ ic.i('shield', 11) }}{{ 'secret'|trans }}</span>{% endif %}
                        </td>
                        <td class="mono" style="color:var(--muted);">
                            {%- if v.secret -%}
                                {{ v.value ? '••••••••' : '—' }}
                            {%- else -%}
                                {{ v.value|default('—') }}
                            {%- endif -%}
                        </td>
                        <td>
                            <input type="{{ v.secret ? 'password' : 'text' }}" name="my[{{ v.name }}]"
                                   value="{{ my_values[v.name]|default('') }}" class="input-mono"
                                   placeholder="{{ 'empty = use the shared value'|trans }}"
                                   autocomplete="off">
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <p class="fhint">{{ 'Only you see and use these. Clear a field to fall back to the shared value. Your values are also used when you run a flow.'|trans }}</p>
            <div class="form-actions">
                <button class="btn" type="submit">{{ 'Save my values'|trans }}</button>
            </div>
        {% endif %}
    </div>
</form>

{% if can_edit %}
<form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('edit-environment' ~ environment.id) }}">
    <div class="field" style="max-width:480px;">
        <label>{{ 'Environment name'|trans }}</label>
        <input type="text" name="name" value="{{ environment.name }}">
    </div>

    <div class="fgroup">
        <div class="fgroup-title">{{ 'Shared variables'|trans }}</div>
        <table class="data" id="vars">
            <thead><tr><th style="width:32%;">{{ 'Name'|trans }}</th><th>{{ 'Value'|trans }}</th><th style="width:70px;text-align:center;">{{ 'Secret'|trans }}</th></tr></thead>
            <tbody>
            {% set idx = 0 %}
            {% for v in environment.variables %}
                <tr>
                    <td><input type="text" name="var_name[{{ idx }}]" value="{{ v.name }}" class="input-mono"></td>
                    <td><input type="text" name="var_value[{{ idx }}]" value="{{ v.value }}" class="input-mono"></td>
                    <td style="text-align:center;"><input type="checkbox" name="var_secret[{{ idx }}]" value="1" {{ v.secret ? 'checked' }}></td>
                </tr>
                {% set idx = idx + 1 %}
            {% endfor %}
            {% for i in 1..3 %}
                <tr>
                    <td><input type="text" name="var_name[{{ idx }}]" value="" class="input-mono"></td>
                    <td><input type="text" name="var_value[{{ idx }}]" value="" class="input-mono"></td>
                    <td style="text-align:center;"><input type="checkbox" name="var_secret[{{ idx }}]" value="1"></td>
                </tr>
                {% set idx = idx + 1 %}
            {% endfor %}
            </tbody>
        </table>
        <p class="fhint">{{ 'Empty rows are ignored. Secret variables are masked in the UI.'|trans }}</p>
        <button type="button" class="btn ghost small" onclick="addRow()" style="margin-top:10px;">{{ ic.i('plus', 13, 2.2) }}{{ 'Add row'|trans }}</button>
    </div>

    <div class="form-actions">
        <button class="btn" type="submit">{{ 'Save'|trans }}</button>
        <a class="btn ghost" href="{{ path('app_environment_index', {workspace: workspace.id}) }}">{{ 'Cancel'|trans }}</a>
    </div>
</form>
{% endif %}

<script>
function addRow() {
    var tb = document.querySelector('#vars tbody');
    var i = tb.rows.length;
    var tr = document.createElement('tr');
    tr.innerHTML =
        '<td><input type="text" name="var_name[' + i + ']" class="input-mono"></td>' +
        '<td><input type="text" name="var_value[' + i + ']" class="input-mono"></td>' +
        '<td style="text-align:center;"><input type="checkbox" name="var_secret[' + i + ']" value="1"></td>';
    tb.appendChild(tr);
}
</script>
{% endblock %}
