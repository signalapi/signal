{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Cookies'|trans }} · {{ workspace.name }}{% endblock %}

{% macro rel_expiry(c) %}
    {%- if c.expiresAt is null -%}
        {{ 'session'|trans }}
    {%- else -%}
        {%- set secs = c.expiresAt.timestamp - 'now'|date('U') -%}
        {%- if secs <= 0 -%}{{ 'expired'|trans }}
        {%- elseif secs >= 86400 -%}in {{ (secs / 86400)|round }} d
        {%- elseif secs >= 3600 -%}in {{ (secs / 3600)|round }} h
        {%- else -%}in {{ (secs / 60)|round }} m
        {%- endif -%}
    {%- endif -%}
{% endmacro %}

{% macro jar(list, workspace) %}
    {% import '_icons.html.twig' as ic %}
    {% set domains = [] %}
    {% for c in list %}{% if c.domain not in domains %}{% set domains = domains|merge([c.domain]) %}{% endif %}{% endfor %}
    {% for d in domains|sort %}
        {% set group = list|filter(c => c.domain == d) %}
        <div class="list-card">
            <div class="lc-head" style="text-transform:none;letter-spacing:0;">
                <span class="mono" style="font-size:11.5px;font-weight:700;color:var(--ink);">{{ d }}</span>
                <span class="mpill">{{ group|length }} {{ 'cookies'|trans }}</span>
                <div style="flex:1 1 0;"></div>
            </div>
            {% for c in group %}
                <div class="lrow" style="padding:9px 15px;">
                    <span class="mono" style="flex:0 0 150px;font-size:11.5px;font-weight:600;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="{{ c.name }}">{{ c.name }}</span>
                    <span class="mono" style="flex:1;min-width:0;font-size:11px;color:var(--faint);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="{{ c.value }}">{{ c.value }}</span>
                    <span style="display:inline-flex;gap:4px;flex-shrink:0;">
                        {% if c.secure %}<span class="flagpill" style="background:var(--pass-soft);color:var(--pass);">Secure</span>{% endif %}
                        {% if c.hostOnly %}<span class="flagpill">HostOnly</span>{% endif %}
                        {% if c.path != '/' %}<span class="flagpill" style="background:var(--teal-soft);color:var(--teal);">{{ c.path }}</span>{% endif %}
                    </span>
                    <span class="l-meta" style="flex:0 0 64px;text-align:right;">{{ _self.rel_expiry(c) }}</span>
                    <form method="post" action="{{ path('app_cookie_delete', {workspace: workspace.id, cookie: c.id}) }}" style="flex-shrink:0;display:flex;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ c.id) }}">
                        <button type="submit" title="{{ 'Delete'|trans }}" aria-label="{{ 'Delete'|trans }}"
                                style="width:24px;height:24px;display:flex;align-items:center;justify-content:center;background:none;border:none;cursor:pointer;color:var(--faint);">{{ ic.i('x', 13, 2.4) }}</button>
                    </form>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% endmacro %}

{% block panel %}
<div class="pagehead">
    <div>
        <h1>{{ 'Cookie jar'|trans }}</h1>
        <p class="subtitle">{{ 'Cookies the flows collected, kept per domain'|trans }} · {{ 'your jar is personal'|trans }}</p>
    </div>
    <div class="actions">
        {% if cookies is not empty %}
            <form method="post" action="{{ path('app_cookie_clear', {workspace: workspace.id}) }}" onsubmit="return confirm('{{ 'Your cookies will be deleted.'|trans|e('js') }}');">
                <input type="hidden" name="_token" value="{{ csrf_token('cookie-clear') }}">
                <button class="btn ghost" type="submit">{{ 'Clear mine'|trans }}</button>
            </form>
        {% endif %}
    </div>
</div>

{% if cookies is empty %}
    <div class="empty" style="margin-bottom:18px;">{{ 'No cookies yet. When you send a request, the %header% headers in the response are saved here and attached to your subsequent requests automatically.'|trans({'%header%': '<code>Set-Cookie</code>'})|raw }}</div>
{% else %}
    {{ _self.jar(cookies, workspace) }}
{% endif %}

{% if shared_cookies is not empty %}
    <div class="pagehead" style="margin-top:22px;">
        <div>
            <div class="eyebrow" style="margin-bottom:5px;">{{ 'Shared jar (flow runs)'|trans }}</div>
            <p class="subtitle">{{ 'Shared cookies used by scheduled/automated flow runs.'|trans }}</p>
        </div>
        <div class="actions">
            {% if is_granted('WORKSPACE_EDIT', workspace) %}
                <form method="post" action="{{ path('app_cookie_clear', {workspace: workspace.id}) }}" onsubmit="return confirm('{{ 'Shared cookies will be deleted.'|trans|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('cookie-clear') }}">
                    <input type="hidden" name="scope" value="shared">
                    <button class="btn ghost" type="submit">{{ 'Clear shared'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </div>
    {{ _self.jar(shared_cookies, workspace) }}
{% endif %}
{% endblock %}
