{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'DB Connections'|trans }} · {{ workspace.name }}{% endblock %}

{% block panel %}
<a class="backlink" href="{{ path('app_workspace_show', {id: workspace.id}) }}"><span class="ic">{{ ic.i('arrow-left', 12, 2.2) }}</span>{{ 'Workspace'|trans }}</a>
<div class="pagehead">
    <div>
        <h1>{{ 'Database connections'|trans }}</h1>
        <p class="subtitle">{{ workspace.name }} · {{ 'for query assertions in test flows'|trans }}</p>
    </div>
    <div class="actions">
        <a class="btn" href="{{ path('app_dbconn_new', {workspace: workspace.id}) }}">{{ ic.i('plus', 13, 2.2) }}{{ 'New connection'|trans }}</a>
    </div>
</div>

<div class="res-grid stagger">
    {% for c in connections %}
        <div class="res-card">
            <div class="rc-top">
                <div class="ic">{{ ic.i('db', 17) }}</div>
                <div class="rc-name">
                    <span class="t">{{ c.name }}</span>
                    <div class="s"><span class="pill">{{ c.type }}</span></div>
                </div>
            </div>
            <div class="mono" style="font-size:11.5px;color:var(--muted);margin-top:12px;line-height:1.6;">
                {{ c.host }}:{{ c.port }}<br>
                <span style="color:var(--ink);">{{ c.databaseName ?: '— no database —'|trans }}</span>
            </div>
            <div class="rc-foot">
                <form method="post" action="{{ path('app_dbconn_test', {workspace: workspace.id, connection: c.id}) }}" class="grow">
                    <input type="hidden" name="_token" value="{{ csrf_token('dbconn-test' ~ c.id) }}">
                    <button class="btn ghost block" type="submit">{{ ic.i('check', 13, 2.2) }}{{ 'Test connection'|trans }}</button>
                </form>
                <a class="btn ghost small" href="{{ path('app_dbconn_edit', {workspace: workspace.id, connection: c.id}) }}">{{ ic.i('pencil', 12) }}{{ 'Edit'|trans }}</a>
                <form method="post" action="{{ path('app_dbconn_delete', {workspace: workspace.id, connection: c.id}) }}" onsubmit="return confirm('{{ 'The connection will be deleted.'|trans|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ c.id) }}">
                    <button class="btn danger" type="submit" title="{{ 'Delete'|trans }}" aria-label="{{ 'Delete'|trans }}">{{ ic.i('trash', 13) }}</button>
                </form>
            </div>
        </div>
    {% endfor %}
    <a class="res-new" href="{{ path('app_dbconn_new', {workspace: workspace.id}) }}">
        <span class="plus">+</span>
        <span style="font-weight:600;">{{ 'New connection'|trans }}</span>
        <span class="mono" style="font-size:10.5px;">Postgres · MySQL · Redis · Mongo</span>
    </a>
</div>
{% endblock %}
