{% extends 'app/_layout.html.twig' %}

{% block title %}{{ 'DB Connections'|trans }} · {{ workspace.name }}{% endblock %}

{% set dbicon = {'postgres':'🐘','postgresql':'🐘','mysql':'🐬','mariadb':'🐬','redis':'🟥','mongo':'🍃','mongodb':'🍃'} %}

{% block panel %}
<a class="backlink" href="{{ path('app_workspace_show', {id: workspace.id}) }}">← Workspace</a>
<div class="pagehead">
    <div>
        <h1>{{ 'Database connections'|trans }}</h1>
        <p class="subtitle">{{ workspace.name }} · {{ 'for query assertions in test flows'|trans }}</p>
    </div>
    <div class="actions">
        <a class="btn" href="{{ path('app_dbconn_new', {workspace: workspace.id}) }}">+ {{ 'New connection'|trans }}</a>
    </div>
</div>

<div class="res-grid stagger">
    {% for c in connections %}
        <div class="res-card">
            <div class="rc-top">
                <div class="ic">{{ dbicon[c.type|lower] ?? '🗄' }}</div>
                <div class="rc-name">
                    <span class="t">{{ c.name }}</span>
                    <div class="s"><span class="pill" style="background:var(--panel-2);color:var(--muted);">{{ c.type }}</span></div>
                </div>
            </div>
            <div style="font-family:var(--font-mono);font-size:12px;color:var(--muted);margin-top:12px;line-height:1.6;">
                {{ c.host }}:{{ c.port }}<br>
                <span style="color:var(--ink);">{{ c.databaseName ?: '— no database —'|trans }}</span>
            </div>
            <div class="rc-foot">
                <form method="post" action="{{ path('app_dbconn_test', {workspace: workspace.id, connection: c.id}) }}" class="grow">
                    <input type="hidden" name="_token" value="{{ csrf_token('dbconn-test' ~ c.id) }}">
                    <button class="btn ghost" type="submit" style="width:100%;justify-content:center;">⚡ {{ 'Test connection'|trans }}</button>
                </form>
                <a class="btn ghost small" href="{{ path('app_dbconn_edit', {workspace: workspace.id, connection: c.id}) }}">{{ 'Edit'|trans }}</a>
                <form method="post" action="{{ path('app_dbconn_delete', {workspace: workspace.id, connection: c.id}) }}" onsubmit="return confirm('{{ 'The connection will be deleted.'|trans|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ c.id) }}">
                    <button class="btn danger" type="submit">{{ 'Delete'|trans }}</button>
                </form>
            </div>
        </div>
    {% endfor %}
    <a class="res-new" href="{{ path('app_dbconn_new', {workspace: workspace.id}) }}">
        <span class="plus">+</span>
        <span style="font-weight:600;">{{ 'New connection'|trans }}</span>
        <span style="font-size:12px;">Postgres · MySQL · Redis · Mongo</span>
    </a>
</div>
{% endblock %}
