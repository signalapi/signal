{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'MCP servers'|trans }} · {{ workspace.name }}{% endblock %}

{% block panel %}
<div class="pagehead">
    <div>
        <h1>{{ 'MCP servers'|trans }}</h1>
        <p class="subtitle">{{ 'The endpoints your MCP and agent steps call, and the tools each one publishes'|trans }}</p>
    </div>
    <div class="actions">
        <a class="btn" href="{{ path('app_mcpserver_new', {workspace: workspace.id}) }}">{{ ic.i('plus', 13, 2.2) }}{{ 'Server'|trans }}</a>
    </div>
</div>

{% if servers is empty %}
    <div class="empty">{{ 'No servers yet. Add one, read its tools, and MCP steps can pick a tool instead of naming a URL.'|trans }}</div>
{% else %}
<div class="list-card">
    {% for s in servers %}
        <div class="lrow">
            <span class="tbadge teal">MCP</span>
            <span style="flex:1.6; min-width:0;">
                <span class="l-name">{{ s.name }}</span>
                <span class="l-sub">{{ s.url }}</span>
            </span>
            <span style="flex:0 0 150px; display:inline-flex; align-items:center; gap:6px; min-width:0;">
                {% if s.refreshError %}
                    <span class="sq fail" style="width:16px;height:16px;border-radius:5px;">{{ ic.i('alert', 10, 3) }}</span>
                    <span class="l-meta">{{ 'unreachable'|trans }}</span>
                {% elseif s.toolsRefreshedAt %}
                    <span class="sq pass" style="width:16px;height:16px;border-radius:5px;">{{ ic.i('check', 10, 3) }}</span>
                    <span class="l-meta">{{ '%count% tools'|trans({'%count%': s.tools|length}) }}</span>
                {% else %}
                    <span class="sq" style="width:16px;height:16px;border-radius:5px;">{{ ic.i('minus', 10, 3) }}</span>
                    <span class="l-meta">{{ 'not read yet'|trans }}</span>
                {% endif %}
            </span>
            <span class="l-meta" style="flex:0 0 80px;">{{ '%count% steps'|trans({'%count%': step_counts[s.id ~ ''] ?? 0}) }}</span>
            <div style="flex:1 1 0;min-width:0;"></div>
            <a class="gbtn" href="{{ path('app_mcpserver_edit', {workspace: workspace.id, server: s.id}) }}">{{ 'Open'|trans }}</a>
        </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
