{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ 'Members'|trans }} · {{ workspace.name }}{% endblock %}

{% block panel %}
<a class="backlink" href="{{ path('app_workspace_show', {id: workspace.id}) }}">← Workspace</a>
<div class="pagehead">
    <div>
        <h1>{{ 'Workspace members'|trans }}</h1>
        <p class="subtitle">{{ workspace.name }} · {{ 'access to this workspace only — admin manages, editor edits, viewer views'|trans }}</p>
    </div>
</div>

{% for link in app.flashes('invite_link') %}
    <div class="flash success" style="align-items:flex-start;flex-wrap:wrap;word-break:break-all;">
        {{ ic.i('check', 14, 2.6) }}
        <span class="grow">
            <strong>{{ 'Invite link — shown only now, pass it to the invitee:'|trans }}</strong><br>
            <code class="mono" id="inviteLink">{{ link }}</code>
        </span>
        <button class="btn ghost small" type="button" onclick="navigator.clipboard.writeText(document.getElementById('inviteLink').textContent)">{{ 'Copy'|trans }}</button>
    </div>
{% endfor %}

<form class="card" method="post" action="{{ path('app_ws_member_invite', {workspace: workspace.id}) }}" style="margin-bottom:14px;">
    <div class="card-head">
        {{ ic.i('members', 14) }}
        <span class="t">{{ 'Invite to this workspace'|trans }}</span>
    </div>
    <div class="card-body">
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
            <div class="field" style="flex:2;min-width:220px;margin-bottom:0;">
                <label>{{ 'Email'|trans }}</label>
                <input type="email" name="email" required placeholder="kisi@sirket.com">
            </div>
            <div class="field" style="min-width:130px;margin-bottom:0;">
                <label>{{ 'Role'|trans }}</label>
                <select name="role">
                    <option value="editor" selected>editor</option>
                    <option value="viewer">viewer</option>
                    <option value="admin">admin</option>
                </select>
            </div>
            <button class="btn small" type="submit">{{ ic.i('token', 12) }}{{ 'Create invite link'|trans }}</button>
        </div>
        <p class="fhint">{{ 'The invitee sees only this workspace. If already registered in the company, they are added instantly without an invitation.'|trans }}</p>
    </div>
    <input type="hidden" name="_token" value="{{ csrf_token('ws-invite') }}">
</form>

{% if addable is not empty %}
<form class="addbar" method="post" action="{{ path('app_ws_member_add', {workspace: workspace.id}) }}">
    <select name="user_id">
        {% for mm in addable %}
            <option value="{{ mm.user.id }}">{{ mm.user.name }} ({{ mm.user.email }})</option>
        {% endfor %}
    </select>
    <select name="role">
        <option value="editor" selected>editor</option>
        <option value="viewer">viewer</option>
        <option value="admin">admin</option>
    </select>
    <input type="hidden" name="_token" value="{{ csrf_token('ws-member-add') }}">
    <button class="btn small" type="submit">{{ ic.i('plus', 12, 2.2) }}{{ 'Add member from company'|trans }}</button>
</form>
{% endif %}

<table class="data" style="margin-bottom:22px;">
    <thead><tr><th>{{ 'Name'|trans }}</th><th>{{ 'Email'|trans }}</th><th>{{ 'Role'|trans }}</th><th></th></tr></thead>
    <tbody>
    {% for m in members %}
        <tr>
            <td style="font-weight:600;color:var(--ink);">{{ m.user.name }}</td>
            <td class="mono" style="font-size:11.5px;color:var(--muted);">{{ m.user.email }}</td>
            <td>
                <form method="post" action="{{ path('app_ws_member_role', {workspace: workspace.id, id: m.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('ws-member-role' ~ m.id) }}">
                    <select name="role" onchange="this.form.submit()" style="width:auto;">
                        <option value="admin" {{ m.role == 'admin' ? 'selected' }}>admin</option>
                        <option value="editor" {{ m.role == 'editor' ? 'selected' }}>editor</option>
                        <option value="viewer" {{ m.role == 'viewer' ? 'selected' }}>viewer</option>
                    </select>
                </form>
            </td>
            <td>
                <form method="post" style="display:flex;justify-content:flex-end;" action="{{ path('app_ws_member_remove', {workspace: workspace.id, id: m.id}) }}" onsubmit="return confirm('{{ '%name% will be removed from the workspace.'|trans({'%name%': m.user.name})|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('ws-member-remove' ~ m.id) }}">
                    <button class="btn danger small" type="submit">{{ ic.i('trash', 12) }}{{ 'Remove'|trans }}</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="4" style="color:var(--muted);">{{ 'No workspace-specific members yet.'|trans }}</td></tr>
    {% endfor %}
    </tbody>
</table>

{% if invitations is not empty %}
    <div class="section-title">{{ 'Pending invitations'|trans }}</div>
    <table class="data" style="margin-bottom:22px;">
        <thead><tr><th>{{ 'Email'|trans }}</th><th>{{ 'Role'|trans }}</th><th>{{ 'Expires'|trans }}</th><th></th></tr></thead>
        <tbody>
        {% for inv in invitations %}
            {% set wsOnly = inv.workspaceGrants|length == 1 %}
            <tr>
                <td class="mono" style="font-size:11.5px;">{{ inv.email }}</td>
                <td><span class="pill">{{ (inv.workspaceGrants|first).role ?? inv.merchantRole }}</span></td>
                <td class="mono" style="font-size:11.5px;color:var(--muted);">{{ inv.expiresAt|date('d.m.Y H:i') }}</td>
                <td>
                    {% if wsOnly %}
                        <div style="display:flex;gap:7px;justify-content:flex-end;">
                            <form method="post" action="{{ path('app_ws_invitation_rotate', {workspace: workspace.id, id: inv.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('ws-invite-rotate' ~ inv.id) }}">
                                <button class="btn ghost small" type="submit">{{ ic.i('rerun', 12) }}{{ 'Generate new link'|trans }}</button>
                            </form>
                            <form method="post" action="{{ path('app_ws_invitation_cancel', {workspace: workspace.id, id: inv.id}) }}" onsubmit="return confirm('{{ 'The invitation will be cancelled.'|trans|e('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('ws-invite-cancel' ~ inv.id) }}">
                                <button class="btn danger small" type="submit">{{ ic.i('x', 12, 2.4) }}{{ 'Revoke'|trans }}</button>
                            </form>
                        </div>
                    {% else %}
                        <span class="subtitle" style="font-size:11.5px;">{{ 'part of a company invitation'|trans }}</span>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

<div class="card">
    <div class="card-head">
        {{ ic.i('shield', 14) }}
        <span class="t">{{ 'Company management (automatic access)'|trans }}</span>
    </div>
    <div class="card-body">
        <p class="subtitle" style="margin-bottom:10px;">{{ 'The owner and company admins automatically access every workspace; they are not managed here.'|trans }}</p>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
            {% for mm in implicit_admins %}
                <span class="pill">{{ mm.user.name }} · {{ mm.role == 'owner' ? 'Owner' : ('Company Admin'|trans) }}</span>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
