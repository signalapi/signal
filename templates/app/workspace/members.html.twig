{% extends 'app/_layout.html.twig' %}

{% block title %}{{ 'Members'|trans }} · {{ workspace.name }}{% endblock %}

{% block panel %}
<a class="backlink" href="{{ path('app_workspace_show', {id: workspace.id}) }}">← Workspace</a>
<div class="pagehead">
    <div>
        <h1>{{ 'Workspace members'|trans }}</h1>
        <p class="subtitle">{{ workspace.name }} · {{ 'access to this workspace only — admin manages, editor edits, viewer views'|trans }}</p>
    </div>
</div>

{% for link in app.flashes('invite_link') %}
    <div class="flash success" style="word-break:break-all;">
        <strong>{{ 'Invite link — shown only now, pass it to the invitee:'|trans }}</strong><br>
        <code id="inviteLink" style="font-size:13px;">{{ link }}</code>
        <button class="btn small" type="button" style="margin-left:8px;" onclick="navigator.clipboard.writeText(document.getElementById('inviteLink').textContent)">{{ 'Copy'|trans }}</button>
    </div>
{% endfor %}

<form class="card" method="post" action="{{ path('app_ws_member_invite', {workspace: workspace.id}) }}" style="margin-bottom:14px;">
    <div class="subtitle" style="margin:0 0 10px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;">{{ 'Invite to this workspace'|trans }}</div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
        <div style="flex:2;min-width:220px;">
            <label style="display:block;font-size:12px;margin-bottom:4px;">{{ 'Email'|trans }}</label>
            <input type="email" name="email" required placeholder="kisi@sirket.com" style="width:100%;">
        </div>
        <div style="min-width:120px;">
            <label style="display:block;font-size:12px;margin-bottom:4px;">{{ 'Role'|trans }}</label>
            <select name="role" style="width:100%;">
                <option value="editor" selected>editor</option>
                <option value="viewer">viewer</option>
                <option value="admin">admin</option>
            </select>
        </div>
        <button class="btn small" type="submit">{{ 'Create invite link'|trans }}</button>
    </div>
    <p class="subtitle" style="margin:10px 0 0;font-size:12px;">{{ 'The invitee sees only this workspace. If already registered in the company, they are added instantly without an invitation.'|trans }}</p>
    <input type="hidden" name="_token" value="{{ csrf_token('ws-invite') }}">
</form>

{% if addable is not empty %}
<form class="addbar" method="post" action="{{ path('app_ws_member_add', {workspace: workspace.id}) }}">
    <select name="user_id">
        {% for mm in addable %}
            <option value="{{ mm.user.id }}">{{ mm.user.name }} ({{ mm.user.email }})</option>
        {% endfor %}
    </select>
    <select name="role">
        <option value="editor" selected>editor</option>
        <option value="viewer">viewer</option>
        <option value="admin">admin</option>
    </select>
    <input type="hidden" name="_token" value="{{ csrf_token('ws-member-add') }}">
    <button class="btn small" type="submit">+ {{ 'Add member from company'|trans }}</button>
</form>
{% endif %}

<table style="margin-bottom:22px;">
    <thead><tr><th>{{ 'Name'|trans }}</th><th>{{ 'Email'|trans }}</th><th>{{ 'Role'|trans }}</th><th></th></tr></thead>
    <tbody>
    {% for m in members %}
        <tr>
            <td style="font-weight:600;">{{ m.user.name }}</td>
            <td>{{ m.user.email }}</td>
            <td>
                <form class="inline" method="post" action="{{ path('app_ws_member_role', {workspace: workspace.id, id: m.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('ws-member-role' ~ m.id) }}">
                    <select name="role" onchange="this.form.submit()">
                        <option value="admin" {{ m.role == 'admin' ? 'selected' }}>admin</option>
                        <option value="editor" {{ m.role == 'editor' ? 'selected' }}>editor</option>
                        <option value="viewer" {{ m.role == 'viewer' ? 'selected' }}>viewer</option>
                    </select>
                </form>
            </td>
            <td style="text-align:right;">
                <form class="inline" method="post" action="{{ path('app_ws_member_remove', {workspace: workspace.id, id: m.id}) }}" onsubmit="return confirm('{{ '%name% will be removed from the workspace.'|trans({'%name%': m.user.name})|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('ws-member-remove' ~ m.id) }}">
                    <button class="btn danger" type="submit">{{ 'Remove'|trans }}</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="4" class="subtitle" style="font-size:13px;">{{ 'No workspace-specific members yet.'|trans }}</td></tr>
    {% endfor %}
    </tbody>
</table>

{% if invitations is not empty %}
    <div class="subtitle" style="margin:0 0 10px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;">{{ 'Pending invitations'|trans }}</div>
    <table style="margin-bottom:22px;">
        <thead><tr><th>{{ 'Email'|trans }}</th><th>{{ 'Role'|trans }}</th><th>{{ 'Expires'|trans }}</th><th></th></tr></thead>
        <tbody>
        {% for inv in invitations %}
            {% set wsOnly = inv.workspaceGrants|length == 1 %}
            <tr>
                <td>{{ inv.email }}</td>
                <td><span class="pill">{{ (inv.workspaceGrants|first).role ?? inv.merchantRole }}</span></td>
                <td>{{ inv.expiresAt|date('d.m.Y H:i') }}</td>
                <td style="text-align:right;white-space:nowrap;">
                    {% if wsOnly %}
                        <form class="inline" method="post" action="{{ path('app_ws_invitation_rotate', {workspace: workspace.id, id: inv.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('ws-invite-rotate' ~ inv.id) }}">
                            <button class="btn small" type="submit">{{ 'Generate new link'|trans }}</button>
                        </form>
                        <form class="inline" method="post" action="{{ path('app_ws_invitation_cancel', {workspace: workspace.id, id: inv.id}) }}" onsubmit="return confirm('{{ 'The invitation will be cancelled.'|trans|e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('ws-invite-cancel' ~ inv.id) }}">
                            <button class="btn danger" type="submit">{{ 'Revoke'|trans }}</button>
                        </form>
                    {% else %}
                        <span class="subtitle" style="font-size:12px;">{{ 'part of a company invitation'|trans }}</span>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}

<div class="card">
    <div class="subtitle" style="margin:0 0 8px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;">{{ 'Company management (automatic access)'|trans }}</div>
    <p class="subtitle" style="margin:0 0 10px;font-size:13px;">{{ 'The owner and company admins automatically access every workspace; they are not managed here.'|trans }}</p>
    {% for mm in implicit_admins %}
        <span class="pill on" style="margin-right:6px;">{{ mm.user.name }} · {{ mm.role == 'owner' ? 'Owner' : ('Company Admin'|trans) }}</span>
    {% endfor %}
</div>
{% endblock %}
