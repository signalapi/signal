{% extends 'app/_layout.html.twig' %}
{% import '_icons.html.twig' as ic %}

{% block title %}{{ workspace.name }} · Signal{% endblock %}

{% block panel %}
<div class="hero">
    <div class="dots"></div>
    <p class="eyebrow">Workspace</p>
    <h1>{{ workspace.name }}</h1>
    <p class="lead">{{ workspace.description ?: ('Send requests, chain flows, verify the result from the database — all in one place.'|trans) }}</p>
    <div class="actions">
        <a class="btn" href="{{ path('app_flow_index', {workspace: workspace.id}) }}">{{ ic.i('flows', 13) }}{{ 'Test flows'|trans }}</a>
        <a class="btn ghost" href="{{ path('app_collection_import', {workspace: workspace.id}) }}">{{ ic.i('import', 13) }}{{ 'Import Postman'|trans }}</a>
    </div>
</div>

<div class="metric-grid stagger" style="grid-template-columns:repeat(auto-fit,minmax(158px,1fr));">
    {% set cards = [
        {icon:'collections',  n: collection_count,  label:'Collection', route:'app_collection_index'},
        {icon:'environments', n: environment_count, label:'Environment', route:'app_environment_index'},
        {icon:'flows',        n: flow_count,        label:'Test Flow'|trans, route:'app_flow_index'},
        {icon:'db',           n: dbconn_count,      label:'DB Connection'|trans, route:'app_dbconn_index'},
        {icon:'token',        n: token_count,       label:'API Token', route:'app_apitoken_index'},
    ] %}
    {% for c in cards %}
        <a class="metric" href="{{ path(c.route, {workspace: workspace.id}) }}">
            <div class="cap">
                <span class="l">{{ c.label }}</span>
                {{ ic.i(c.icon, 14) }}
            </div>
            <div class="row">
                <span class="num">{{ c.n }}</span>
                <div class="grow"></div>
                <span style="color:var(--faint)">{{ ic.i('chevron-r', 13) }}</span>
            </div>
        </a>
    {% endfor %}
</div>

<div style="display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:18px;align-items:start;">
    {# ---- Recent runs ---- #}
    <div>
        <div class="toolbar" style="margin-bottom:12px;">
            <div class="section-title" style="margin:0;">{{ 'Recent runs'|trans }}</div>
            <a href="{{ path('app_trends', {workspace: workspace.id}) }}" class="eyebrow" style="color:var(--pri)">{{ 'All trends'|trans }} →</a>
        </div>
        {% if recent_runs is empty %}
            <div class="empty">{{ 'No runs yet. Create a test flow and run it.'|trans }}</div>
        {% else %}
            {% for run in recent_runs %}
                <a class="hi-row" href="{{ path('app_flow_run_show', {workspace: workspace.id, flow: run.flow.id, run: run.id}) }}">
                    <span class="hi-dot {{ run.status }}"></span>
                    <span class="hi-flow">
                        <span class="nm">{{ run.flow.name }}</span>
                        {% if run.batchId %}<span class="tags"><span class="hi-tag">data #{{ run.iteration + 1 }}</span></span>{% endif %}
                    </span>
                    <span class="strip">
                        {% for sr in run.stepResults %}<i class="{{ sr.status }}" title="{{ sr.label }}"></i>{% endfor %}
                    </span>
                    <span class="hi-num">{{ run.passedSteps }}/{{ run.totalSteps }} {{ 'steps'|trans }}</span>
                    <span class="hi-date">{{ run.createdAt|date('d.m H:i') }}</span>
                    <span class="pill {{ run.status }}">{{ run.durationMs ? (run.durationMs / 1000)|number_format(1) ~ ' s' : '—' }}</span>
                </a>
            {% endfor %}
        {% endif %}
    </div>

    {# ---- Quick actions ---- #}
    <div>
        <div class="section-title">{{ 'Quick actions'|trans }}</div>
        <div class="quick-grid" style="grid-template-columns:1fr;">
            <a class="quick" href="{{ path('app_collection_index', {workspace: workspace.id}) }}">
                <div class="ic">{{ ic.i('collections', 15) }}</div><div><div class="t">Collection workbench</div><div class="s">{{ 'Send and edit requests'|trans }}</div></div>
            </a>
            <a class="quick" href="{{ path('app_flow_new', {workspace: workspace.id}) }}">
                <div class="ic">{{ ic.i('git', 15) }}</div><div><div class="t">{{ 'New test flow'|trans }}</div><div class="s">{{ 'Chain steps, verify from the DB'|trans }}</div></div>
            </a>
            <a class="quick" href="{{ path('app_dbconn_index', {workspace: workspace.id}) }}">
                <div class="ic">{{ ic.i('db', 15) }}</div><div><div class="t">{{ 'DB connection'|trans }}</div><div class="s">Postgres · MySQL · Redis · Mongo</div></div>
            </a>
            <a class="quick" href="{{ path('app_apitoken_index', {workspace: workspace.id}) }}">
                <div class="ic">{{ ic.i('token', 15) }}</div><div><div class="t">API & MCP</div><div class="s">{{ 'CI / Claude integration'|trans }}</div></div>
            </a>
        </div>
    </div>
</div>
{% endblock %}
