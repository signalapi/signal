{% extends 'app/_layout.html.twig' %}

{% block title %}{{ 'New Workspace'|trans }}{% endblock %}

{% block panel %}
<a class="backlink" href="{{ path('app_workspace_index') }}">← {{ 'Workspaces'|trans }}</a>
<div class="pagehead">
    <div>
        <h1>{{ 'New Workspace'|trans }}</h1>
        <p class="subtitle">{{ 'Create a testing space. Collections, environments and test flows will be attached here.'|trans }}</p>
    </div>
</div>

<div class="formcard" style="max-width:560px;">
    {{ form_start(form) }}
        <div class="field">
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
        </div>
        <div class="field">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'rows': 3}}) }}
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">{{ 'Create'|trans }}</button>
            <a class="btn ghost" href="{{ path('app_workspace_index') }}">{{ 'Cancel'|trans }}</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
