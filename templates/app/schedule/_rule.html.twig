{# One timing rule, laid out as a sentence you read left to right:
     Run [every] [2] [hours]  on [M][T][W][T][F][S][S]
   Everything that does not apply to the chosen mode is hidden, and the two
   rarely-used fields (time window, days of the month) sit behind "⋯".
   `i` is the row index; the editor clones this with i="__I__". #}
{% import '_icons.html.twig' as ic %}
{% set mode = rule ? (rule.mode|default('at')) : 'at' %}
{% set has_more = rule and (rule.from is defined or (rule.monthDays is defined and rule.monthDays)) %}
<div class="rule">
    <div class="rule-line">
        <span class="rule-lead">{{ 'Run'|trans }}</span>

        <select name="rule_mode[{{ i }}]" data-mode aria-label="{{ 'Timing'|trans }}">
            <option value="at" {{ mode == 'at' ? 'selected' }}>{{ 'at'|trans }}</option>
            <option value="every" {{ mode == 'every' ? 'selected' }}>{{ 'every'|trans }}</option>
            <option value="cron" {{ mode == 'cron' ? 'selected' }}>{{ 'cron'|trans }}</option>
        </select>

        <input type="text" name="rule_at[{{ i }}]" class="input-mono" data-when="at" {{ mode != 'at' ? 'hidden' }}
               style="width:170px;" value="{{ rule and rule.at is defined ? rule.at|join(', ') : '' }}"
               placeholder="09:00, 14:00" aria-label="{{ 'Times'|trans }}">

        <input type="number" name="rule_n[{{ i }}]" data-when="every" {{ mode != 'every' ? 'hidden' }}
               min="1" max="59" value="{{ rule.n|default(1) }}" style="width:70px;" aria-label="{{ 'Interval'|trans }}">
        <select name="rule_unit[{{ i }}]" data-when="every" {{ mode != 'every' ? 'hidden' }} aria-label="{{ 'Unit'|trans }}">
            {# the label follows the number: "every 1 hour", "every 2 hours" #}
            <option value="minute" data-one="{{ 'minute'|trans }}" data-many="{{ 'minutes'|trans }}"
                    {{ rule and rule.unit|default('') == 'minute' ? 'selected' }}>{{ 'minutes'|trans }}</option>
            <option value="hour" data-one="{{ 'hour'|trans }}" data-many="{{ 'hours'|trans }}"
                    {{ not rule or rule.unit|default('hour') == 'hour' ? 'selected' }}>{{ 'hours'|trans }}</option>
        </select>

        <input type="text" name="rule_expr[{{ i }}]" class="input-mono" data-when="cron" {{ mode != 'cron' ? 'hidden' }}
               style="width:170px;" value="{{ rule.expr|default('') }}" placeholder="*/5 * * * *"
               aria-label="{{ 'Cron expression'|trans }}">

        <span class="rule-lead" data-hide-when="cron" {{ mode == 'cron' ? 'hidden' }}>{{ 'on'|trans }}</span>
        <div class="daypick" data-hide-when="cron" {{ mode == 'cron' ? 'hidden' }}>
            {% for n, label in days %}
                <label class="daybtn" title="{{ label }}">
                    <input type="checkbox" name="rule_days[{{ i }}][]" value="{{ n }}"
                           {{ rule and rule.days is defined and n in rule.days ? 'checked' }}>
                    <span>{{ label }}</span>
                </label>
            {% endfor %}
        </div>

        <div class="grow"></div>
        <button type="button" class="icon-btn" style="width:26px;height:26px;" data-more
                data-hide-when="cron" {{ mode == 'cron' ? 'hidden' }}
                title="{{ 'Time window and days of the month'|trans }}">{{ ic.i('dots', 13) }}</button>
        <button type="button" class="icon-btn" style="width:26px;height:26px;" data-remove-rule
                title="{{ 'Remove rule'|trans }}">{{ ic.i('trash', 12) }}</button>
    </div>

    <div class="rule-more" data-more-panel {{ has_more ? '' : 'hidden' }}>
        <span class="rule-lead" data-when="every" {{ mode != 'every' ? 'hidden' }}>{{ 'between'|trans }}</span>
        <input type="text" name="rule_from[{{ i }}]" class="input-mono" data-when="every" {{ mode != 'every' ? 'hidden' }}
               style="width:82px;" value="{{ rule.from|default('') }}" placeholder="09:00" aria-label="{{ 'From'|trans }}">
        <span class="rule-lead" data-when="every" {{ mode != 'every' ? 'hidden' }}>{{ 'and'|trans }}</span>
        <input type="text" name="rule_to[{{ i }}]" class="input-mono" data-when="every" {{ mode != 'every' ? 'hidden' }}
               style="width:82px;" value="{{ rule.to|default('') }}" placeholder="18:00" aria-label="{{ 'To'|trans }}">

        <span class="rule-lead">{{ 'on days'|trans }}</span>
        <input type="text" name="rule_month_days[{{ i }}]" class="input-mono" style="width:110px;"
               value="{{ rule and rule.monthDays is defined ? rule.monthDays|join(', ') : '' }}"
               placeholder="1, 15" aria-label="{{ 'Days of the month'|trans }}">
        <span class="rule-lead">{{ 'of the month'|trans }}</span>
    </div>
</div>
