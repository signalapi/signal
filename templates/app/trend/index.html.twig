{% extends 'app/_layout.html.twig' %}

{% block title %}{{ 'Trends'|trans }} · {{ workspace.name }}{% endblock %}

{% block panel %}
<div class="pagehead">
    <div>
        <h1>{{ 'Trends'|trans }}</h1>
        <p class="subtitle">{{ workspace.name }} · {{ 'based on the last 30 runs per flow'|trans }}</p>
    </div>
</div>

{% set rateColor = ws_pass_rate is null ? 'var(--muted)' : (ws_pass_rate >= 80 ? 'var(--pass)' : (ws_pass_rate >= 50 ? 'var(--warn)' : 'var(--fail)')) %}
<div class="metric-grid" style="grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) minmax(0,1fr);margin-bottom:22px;">
    <div class="metric">
        <div class="cap"><span class="l">{{ 'Overall pass rate'|trans }}</span></div>
        <div class="row"><span class="num" style="color:{{ rateColor }};">{{ ws_pass_rate is null ? '—' : ws_pass_rate ~ '%' }}</span></div>
        <div class="progress" style="height:7px;"><i style="width:{{ ws_pass_rate ?? 0 }}%;background:{{ rateColor }};"></i></div>
        <p class="subtitle" style="margin:9px 0 0;font-size:11.5px;">{{ 'across %count% completed runs'|trans({'%count%': ws_finished}) }}</p>
    </div>
    <div class="metric">
        <div class="cap"><span class="l">{{ 'Tracked flows'|trans }}</span></div>
        <div class="row"><span class="num">{{ rows|length }}</span></div>
    </div>
    <div class="metric">
        <div class="cap"><span class="l">{{ 'Completed runs'|trans }}</span></div>
        <div class="row"><span class="num">{{ ws_finished }}</span></div>
    </div>
</div>

{% if rows is empty %}
    <div class="empty">{{ 'No flows yet. Create and run a test flow; results will accumulate here.'|trans }}</div>
{% else %}
    <div style="display:flex;gap:16px;flex-wrap:wrap;margin:0 0 14px;color:var(--muted);font-size:11.5px;">
        <span style="display:inline-flex;align-items:center;gap:6px;"><span class="strip"><i class="passed"></i></span>{{ 'Passed'|trans }}</span>
        <span style="display:inline-flex;align-items:center;gap:6px;"><span class="strip"><i class="failed"></i></span>{{ 'Failed'|trans }}</span>
        <span style="display:inline-flex;align-items:center;gap:6px;"><span class="strip"><i class="cancelled"></i></span>{{ 'Cancelled'|trans }}</span>
        <span style="display:inline-flex;align-items:center;gap:6px;"><span class="strip"><i class="running"></i></span>{{ 'Running'|trans }}</span>
    </div>

    {% for row in rows %}
        {% set fin = row.counts.passed + row.counts.failed + row.counts.error + row.counts.cancelled %}
        <div class="card card-hover" style="margin-bottom:12px;">
            <div class="card-body">
                <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
                    <a href="{{ path('app_flow_show', {workspace: workspace.id, flow: row.flow.id}) }}"
                       style="min-width:170px;font-size:13.5px;font-weight:700;color:var(--ink);">{{ row.flow.name }}</a>

                    <div class="grow" style="min-width:180px;">
                        <div style="display:flex;justify-content:space-between;gap:8px;margin-bottom:5px;color:var(--muted);font-size:11.5px;">
                            <span>{{ 'Success'|trans }}</span>
                            <b class="mono" style="color:{{ row.passRate is null ? 'var(--muted)' : (row.passRate >= 80 ? 'var(--pass)' : (row.passRate >= 50 ? 'var(--warn)' : 'var(--fail)')) }};">{{ row.passRate is null ? '—' : row.passRate ~ '%' }}</b>
                        </div>
                        <div style="display:flex;height:9px;border-radius:999px;overflow:hidden;background:var(--panel2);">
                            {% if fin > 0 %}
                                {% if row.counts.passed %}<span style="width:{{ (row.counts.passed / fin * 100) }}%;background:var(--pass);"></span>{% endif %}
                                {% set bad = row.counts.failed + row.counts.error %}
                                {% if bad %}<span style="width:{{ (bad / fin * 100) }}%;background:var(--fail);"></span>{% endif %}
                                {% if row.counts.cancelled %}<span style="width:{{ (row.counts.cancelled / fin * 100) }}%;background:var(--warn);"></span>{% endif %}
                            {% endif %}
                        </div>
                    </div>

                    <div style="text-align:center;min-width:64px;">
                        <div class="mono" style="font-size:14px;font-weight:700;color:var(--ink);">{{ row.total }}</div>
                        <div class="subtitle" style="font-size:10.5px;">{{ 'runs'|trans }}</div>
                    </div>
                    <div style="text-align:center;min-width:64px;">
                        <div class="mono" style="font-size:14px;font-weight:700;color:var(--ink);">{{ row.avgMs is null ? '—' : row.avgMs ~ 'ms' }}</div>
                        <div class="subtitle" style="font-size:10.5px;">{{ 'avg. duration'|trans }}</div>
                    </div>
                </div>

                <div style="display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:13px;">
                    {% if row.timeline is empty %}
                        <span class="subtitle">{{ 'no runs yet'|trans }}</span>
                    {% else %}
                        <span class="eyebrow">{{ 'Old → New'|trans }}</span>
                        <span class="strip" style="gap:3px;flex-wrap:wrap;">
                            {% for r in row.timeline %}
                                <a href="{{ path('app_flow_run_show', {workspace: workspace.id, flow: row.flow.id, run: r.id}) }}"
                                   title="{{ r.status }} · {{ '%passed%/%total% steps'|trans({'%passed%': r.passedSteps, '%total%': r.totalSteps}) }} · {{ r.createdAt|date('d.m H:i:s') }}{{ r.batchId ? ' · data #' ~ (r.iteration + 1) }}">
                                    <i class="{{ r.status }}" style="width:13px;height:13px;border-radius:3px;"></i>
                                </a>
                            {% endfor %}
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
{% endif %}
{% endblock %}
