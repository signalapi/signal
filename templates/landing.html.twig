{# ==========================================================================
   Public landing page — Signal Landing.dc.html applied 1:1.
   Copy lives inline in both languages (picked by request locale) because it
   is landing prose, not UI chrome; the demo flow/waterfall/transcript data
   is the prototype's own storyline, rendered statically.
   ========================================================================== #}
{% extends 'base.html.twig' %}

{% block title %}Signal — API testing with database verification{% endblock %}

{% block body %}
{% set tr = app.request.locale == 'tr' %}
{% set L = tr ? {
    start: 'Ücretsiz başla', pill: 'Testleri Claude kurar ve çalıştırır',
    heroA: '200 dönmesi', heroB: 'testin geçtiği anlamına gelmez.',
    lead: "Signal API'ni tetikler, dönen değerleri zincirler ve gerçekten Postgres, MySQL, Redis ve Mongo'ya ne yazıldığını doğrular.",
    cta2: 'Bir koşumu izle', openApp: 'Uygulamayı aç', signin: 'Giriş yap',
    facts: ['Tek yapıştırmayla Postman içe aktarma', 'Şifreli veritabanı bilgileri', 'CI exit code + JUnit'],
    running: 'canlı çalışıyor', flow: 'Akış', stepsWord: 'adım', dbCheck: 'Veritabanı doğrulaması',
    caught: 'Yakaladı: API 201 dedi, satır trialing dedi.',
    diffEyebrow: 'Fark burada', diffTitle: 'Çoğu araç yanıt gövdesinde durur.',
    diffLead: 'İlginç hatalar tam orada başlar. Hiç tetiklenmeyen webhook, hiç yazılmayan ledger satırı, hiç temizlenmeyen cache — hepsi 200 döner.',
    diff: [
        ["HTTP'yi SQL'e zincirle", 'Yanıttan çıkarılan değer doğrudan WHERE id = {{subId}} içine girer.'],
        ['Dört bağlayıcı, tek adım tipi', 'PostgreSQL, MySQL, Redis ve MongoDB doğrulamaları HTTP adımlarının yanında durur.'],
        ['Şifreli kimlik bilgileri', 'Bağlantı parolaları libsodium ile mühürlenir, arayüze düz metin dönmez.'],
    ],
    waterfall: 'Şelale',
    featEyebrow: 'Neler var', featTitle: 'Tezgah, akış motoru ve zamanlayıcı — tek yerde.',
    features: [
        ['İstek tezgahı', 'Koleksiyonlar, klasörler, kayıtlı örnekler, değişken vurgulama ve kod üretimi. Postman koleksiyonunu içe aktar, kaldığın yerden devam et.', ['Collection v2.1', 'Ortamlar']],
        ['Zincirlenen akışlar', 'Değer çıkar, doğrula, sonraki adıma besle. Koşul, döngü, retry ve referansla çağrılan alt akışlar.', ['extract', 'assert', 'alt akış']],
        ['Veritabanı doğrulaması', 'rowCount, satır değerleri, Redis anahtarları, Mongo dokümanları — sebebi olan isteğin aynı koşumunda doğrulanır.', ['SQL', 'Redis', 'Mongo']],
        ['Suite ve zamanlama', "Akışları suite'lerde grupla, suite'i uçtan uca çalıştır ya da bırak cron on beş dakikada bir yapsın.", ['cron', 'stopOnFailure']],
        ['Yapıştırma kodu olmadan CI', "Tek yetkili POST akışı çalıştırır, hatada 422 döner. JUnit XML istersen pipeline'ın onu çizer.", ['Bearer token', 'JUnit XML']],
        ['Ekipler için', 'Şirket, workspace, üye ve API token — MCP oturumu dahil her kaynak kapsanmış.', ['workspace', 'roller']],
    ],
    mcpTitle: 'Testi anlat. Claude kurar.',
    mcpLead: "Uygulamanın içinde Streamable HTTP MCP endpoint'i, aynı Bearer token ile tek bir workspace'e kapsanmış. On dokuz araç, ayrı Node süreci yok.",
    mcpTools: [['KAPSAM', 'whoami'], ['OKUMA', 'list_flows · get_run · search_requests'], ['KURMA', 'create_flow · add_http_step · add_db_step'], ['KOŞUM', 'run_flow · run_flow_async']],
    chat: [
        ['sen', 'Signup isteğini at, sonra subscriptions tablosunda o kullanıcı için active satır var mı kontrol et.'],
        ['claude', 'Checkout v3\'te POST /v3/customers\'ı buldum. "signup → subscription" akışını kuruyorum.'],
        ['araç', 'add_http_step · add_db_step · run_flow'],
        ['claude', "Çalıştırdım: 7 adımın 6'sı geçti. rows.0.status active değil trialing döndü — kontrolden önce 2s bekleme ekleyeyim mi?"],
    ],
    hostEyebrow: 'Tetikleyiciler', hostTitle: 'Zaten çalıştığın yerden tetikle.',
    hostLead: "Tek yetkili çağrı akışı çalıştırır ve kararı döner — geçerse 200, geçmezse 422. Ya da cron, pipeline'ın veya Claude başlatsın.",
    stack: ['GitHub Actions', 'GitLab CI', 'cron zamanlama', 'API token', 'JUnit XML', 'Claude MCP'],
    ctaTitle: 'Durum koduna güvenmeyi bırak.',
    ctaLead: 'Bir workspace aç, Postman koleksiyonunu içe aktar ve ilk akışın kendini veritabanına karşı doğrulamasını izle.',
    footerNote: 'API entegrasyon ve E2E test — veritabanı doğrulamalı.',
    nav: [['Ürün', '#product'], ['Akışlar', '#diff'], ['MCP', '#mcp'], ['CI', '#triggers']],
    shellC1: 'pipeline içinde — adım düşerse sıfır olmayan exit',
    shellC2: 'aynı çağrı, CI\'ın çizebileceği JUnit XML',
} : {
    start: 'Start free', pill: 'Claude builds and runs your tests',
    heroA: 'A 200 response', heroB: 'is not a passing test.',
    lead: 'Signal fires your API, chains the values it returns, then verifies what actually landed in Postgres, MySQL, Redis and Mongo.',
    cta2: 'See a flow run', openApp: 'Open app', signin: 'Sign in',
    facts: ['Postman import in one paste', 'Encrypted database credentials', 'CI exit codes + JUnit'],
    running: 'running live', flow: 'Flow', stepsWord: 'steps', dbCheck: 'Database assertion',
    caught: 'Caught it: the API said 201, the row said trialing.',
    diffEyebrow: 'The difference', diffTitle: 'Most tools stop at the response body.',
    diffLead: 'That is where the interesting bugs start. A webhook that never fires, a ledger row that never lands, a cache that never invalidates — all of it returns 200.',
    diff: [
        ['Chain HTTP into SQL', 'A value extracted from a response goes straight into WHERE id = {{subId}}.'],
        ['Four connectors, one step type', 'PostgreSQL, MySQL, Redis and MongoDB assertions live next to your HTTP steps.'],
        ['Encrypted credentials', 'Connection passwords are sealed with libsodium and never returned to the browser.'],
    ],
    waterfall: 'Waterfall',
    featEyebrow: 'What you get', featTitle: 'A workbench, a flow engine and a scheduler — in one place.',
    features: [
        ['Request workbench', 'Collections, folders, saved examples, variable highlighting and code generation. Import a Postman collection and keep working.', ['Collection v2.1', 'Environments']],
        ['Flows that chain', 'Extract a value, assert on it, feed it into the next step. Conditions, loops, retries and sub-flows called by reference.', ['extract', 'assert', 'sub-flow']],
        ['Database assertions', 'rowCount, row values, Redis keys, Mongo documents — asserted in the same run as the request that caused them.', ['SQL', 'Redis', 'Mongo']],
        ['Suites and schedules', 'Group flows into suites, run a suite end to end, or let cron do it every fifteen minutes.', ['cron', 'stopOnFailure']],
        ['CI without glue code', 'One authenticated POST runs a flow and returns 422 on failure. Ask for JUnit XML and your pipeline renders it.', ['Bearer token', 'JUnit XML']],
        ['Built for teams', 'Companies, workspaces, members and API tokens — every resource scoped, including the MCP session.', ['workspaces', 'roles']],
    ],
    mcpTitle: 'Describe the test. Claude wires it up.',
    mcpLead: 'A Streamable HTTP MCP endpoint inside the app, scoped to a single workspace by the same Bearer token. Nineteen tools, no separate Node process.',
    mcpTools: [['SCOPE', 'whoami'], ['READ', 'list_flows · get_run · search_requests'], ['BUILD', 'create_flow · add_http_step · add_db_step'], ['RUN', 'run_flow · run_flow_async']],
    chat: [
        ['you', 'Hit the signup request, then check the subscriptions table has an active row for that user.'],
        ['claude', 'Found POST /v3/customers in Checkout v3. Creating flow "signup → subscription".'],
        ['tool', 'add_http_step · add_db_step · run_flow'],
        ['claude', 'Ran it: 6 of 7 passed. rows.0.status came back trialing, not active — want me to add a 2s wait before the check?'],
    ],
    hostEyebrow: 'Triggers', hostTitle: 'Run it from wherever you already work.',
    hostLead: 'One authenticated call runs a flow and answers with the verdict — 200 when it passes, 422 when it does not. Or let cron, your pipeline or Claude start it.',
    stack: ['GitHub Actions', 'GitLab CI', 'cron schedules', 'API tokens', 'JUnit XML', 'Claude MCP'],
    ctaTitle: 'Stop trusting the status code.',
    ctaLead: 'Create a workspace, import your Postman collection and watch the first flow verify itself against your database.',
    footerNote: 'API integration and E2E testing, with database verification.',
    nav: [['Product', '#product'], ['Flows', '#diff'], ['MCP', '#mcp'], ['CI', '#triggers']],
    shellC1: 'in your pipeline — non-zero exit when a step fails',
    shellC2: 'same call, JUnit XML your CI can render',
} %}

{% set demo_steps = [
    ['POST', 'Create customer',            'POST {{baseUrl}}/v3/customers',        '201 · 412ms',   'passed',  'warn'],
    ['CALL', 'auth: get bearer token',     '↳ sub-flow · shares variables',        'ok · 340ms',    'passed',  'vio'],
    ['POST', 'Start subscription',         'POST {{baseUrl}}/v3/subscriptions',    '201 · 518ms',   'passed',  'warn'],
    ['WAIT', 'Let the webhook land',       'wait 1 500 ms',                        'done',          'passed',  'muted'],
    ['DB',   'subscriptions row is active','postgres · SELECT … WHERE id = {{subId}}', 'assert failed', 'failed', 'teal'],
    ['DB',   'ledger cache warmed',        'redis · GET ledger:{{customerId}}',    'skipped',       'skipped', 'teal'],
    ['GET',  'Invoice reflects the plan',  'GET {{baseUrl}}/v3/invoices',          'skipped',       'skipped', 'pass'],
] %}
{% set demo_wf = [
    ['POST', 'Create customer',    0,    412,  'passed', 'warn'],
    ['CALL', 'auth: token',        412,  340,  'passed', 'vio'],
    ['POST', 'Start subscription', 752,  518,  'passed', 'warn'],
    ['WAIT', 'Webhook window',     1270, 1500, 'passed', 'muted'],
    ['DB',   'subscriptions row',  2770, 64,   'failed', 'teal'],
    ['DB',   'ledger cache',       2834, 0,    'skipped', 'teal'],
    ['GET',  'Invoice check',      2834, 0,    'skipped', 'pass'],
] %}
{% macro check(size) %}<svg width="{{ size|default(12) }}" height="{{ size|default(12) }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg>{% endmacro %}
{% macro cross(size) %}<svg width="{{ size|default(12) }}" height="{{ size|default(12) }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>{% endmacro %}
{% macro minus(size) %}<svg width="{{ size|default(12) }}" height="{{ size|default(12) }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M5 12h14"/></svg>{% endmacro %}
{% macro prompt() %}<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"><path d="M4 17 10 11 4 5"/><path d="M12 19h8"/></svg>{% endmacro %}

<div style="min-height:100vh;background:var(--bg);">

<!-- ===== nav ===== -->
<header style="position:sticky;top:0;z-index:50;background:var(--panel);border-bottom:1px solid var(--line);">
    <div style="max-width:1180px;margin:0 auto;padding:11px 24px;display:flex;align-items:center;gap:22px;">
        <div style="display:flex;align-items:center;gap:9px;">
            <div style="width:27px;height:27px;border-radius:8px;background:linear-gradient(140deg,var(--pri),var(--vio));display:flex;align-items:center;justify-content:center;">{{ _self.prompt() }}</div>
            <span class="no-caps" style="font-weight:800;font-size:16px;color:var(--ink);letter-spacing:-.035em;">Signal</span>
        </div>
        <nav style="display:flex;gap:3px;flex-wrap:wrap;">
            {% for n in L.nav %}
                <a href="{{ n[1] }}" style="padding:6px 10px;border-radius:8px;font-size:12.5px;font-weight:600;color:var(--muted);">{{ n[0] }}</a>
            {% endfor %}
        </nav>
        <div style="flex:1 1 0;min-width:0;"></div>
        <span class="seg" style="flex-shrink:0;">
            <a href="{{ path('app_locale_switch', {locale: 'en'}) }}" class="{{ not tr ? 'on' }}" style="font-family:var(--mono);font-size:10.5px;padding:4px 8px;">EN</a>
            <a href="{{ path('app_locale_switch', {locale: 'tr'}) }}" class="{{ tr ? 'on' }}" style="font-family:var(--mono);font-size:10.5px;padding:4px 8px;">TR</a>
        </span>
        <button class="icon-btn" data-theme-toggle title="Theme" aria-label="Theme" style="flex-shrink:0;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M12 3a6.4 6.4 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg>
        </button>
        {% if app.user %}
            <a class="btn" href="{{ path('app_dashboard') }}" style="flex-shrink:0;">{{ L.openApp }}</a>
        {% else %}
            <a href="{{ path('app_login') }}" style="padding:6px 10px;font-size:12.5px;font-weight:600;color:var(--muted);flex-shrink:0;">{{ L.signin }}</a>
            <a class="btn" href="{{ path('app_register') }}" style="flex-shrink:0;">{{ L.start }}</a>
        {% endif %}
    </div>
</header>

<!-- ===== hero ===== -->
<section id="product" style="max-width:1180px;margin:0 auto;padding:64px 24px 0;">
    <div style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px;">
        <span style="display:inline-flex;align-items:center;gap:8px;padding:5px 12px 5px 6px;border-radius:999px;border:1px solid var(--line);background:var(--panel);font-size:11.5px;font-weight:600;color:var(--muted);box-shadow:var(--sh);">
            <span style="display:inline-flex;align-items:center;gap:5px;padding:2px 7px;border-radius:999px;background:var(--vio-soft);color:var(--vio);font-family:var(--mono);font-size:9.5px;font-weight:800;letter-spacing:.06em;">MCP</span>
            {{ L.pill }}
        </span>
        <h1 style="margin:0;font-size:56px;line-height:1.02;font-weight:800;letter-spacing:-.045em;color:var(--ink);max-width:820px;">{{ L.heroA }}<br><span style="color:var(--pri);">{{ L.heroB }}</span></h1>
        <p style="margin:0;font-size:16.5px;line-height:1.55;color:var(--muted);max-width:600px;">{{ L.lead }}</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:4px;">
            <a href="{{ app.user ? path('app_dashboard') : path('app_register') }}" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:11px;background:var(--pri);color:#fff;font-size:13.5px;font-weight:700;box-shadow:0 8px 22px -10px var(--pri);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 17 10 11 4 5"/><path d="M12 19h8"/></svg>{{ app.user ? L.openApp : L.start }}
            </a>
            <a href="{{ path('app_login') }}" style="display:inline-flex;align-items:center;gap:8px;padding:12px 18px;border-radius:11px;border:1px solid var(--line);background:var(--panel);color:var(--text);font-size:13.5px;font-weight:700;box-shadow:var(--sh);">{{ L.cta2 }}</a>
        </div>
        <div style="display:flex;gap:18px;flex-wrap:wrap;justify-content:center;font-size:12px;color:var(--faint);margin-top:2px;">
            {% for f in L.facts %}
                <span style="display:inline-flex;align-items:center;gap:6px;"><span style="display:flex;color:var(--pass);">{{ _self.check(13) }}</span>{{ f }}</span>
            {% endfor %}
        </div>
    </div>

    <!-- product panel: a failing flow, told honestly -->
    <div style="margin-top:44px;background:var(--panel);border:1px solid var(--line);border-radius:18px;box-shadow:var(--sh-lg);overflow:hidden;">
        <div style="display:flex;align-items:center;gap:9px;padding:10px 14px;border-bottom:1px solid var(--line);background:var(--panel2);">
            <span style="display:flex;gap:5px;">
                <span style="width:9px;height:9px;border-radius:50%;background:var(--line);"></span>
                <span style="width:9px;height:9px;border-radius:50%;background:var(--line);"></span>
                <span style="width:9px;height:9px;border-radius:50%;background:var(--line);"></span>
            </span>
            <span style="font-family:var(--mono);font-size:10.5px;color:var(--faint);margin-left:6px;">signal · checkout api · staging</span>
            <div style="flex:1 1 0;min-width:0;"></div>
            <span class="livepill healthy" style="color:var(--pri);background:var(--pri-soft);"><i></i>{{ L.running }}</span>
        </div>
        <div style="display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);" class="land-2col">
            <div style="padding:18px 20px 22px;border-right:1px solid var(--line);">
                <div style="display:flex;align-items:center;gap:9px;margin-bottom:14px;">
                    <span style="font-family:var(--mono);font-size:9.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--faint);">{{ L.flow }}</span>
                    <span style="height:1px;flex:1;background:var(--line);"></span>
                    <span style="font-family:var(--mono);font-size:10px;color:var(--muted);">7 {{ L.stepsWord }} · 2 DB</span>
                </div>
                {% for s in demo_steps %}
                    {% set stat = s[4] %}
                    {% set c = stat == 'passed' ? 'var(--pass)' : (stat == 'failed' ? 'var(--fail)' : 'var(--warn)') %}
                    <div style="display:flex;gap:12px;align-items:stretch;">
                        <div style="position:relative;width:26px;flex-shrink:0;display:flex;justify-content:center;">
                            <span style="position:absolute;left:50%;transform:translateX(-50%);top:{{ loop.first ? '11px' : '0' }};bottom:{{ loop.last ? 'calc(100% - 11px)' : '0' }};width:2px;background:{{ stat == 'passed' ? 'var(--pass)' : (stat == 'failed' ? 'var(--fail)' : 'var(--line)') }};"></span>
                            <span style="position:relative;z-index:1;width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 0 0 4px var(--panel);background:{{ c }};border:2px solid {{ c }};color:#fff;{{ stat == 'skipped' ? 'opacity:.5;' }}">
                                {% if stat == 'passed' %}{{ _self.check() }}{% elseif stat == 'failed' %}{{ _self.cross() }}{% else %}{{ _self.minus() }}{% endif %}
                            </span>
                        </div>
                        <div style="flex:1;min-width:0;margin-bottom:8px;background:var(--panel);border-radius:11px;padding:9px 11px;border:1px solid {{ stat == 'failed' ? 'var(--fail)' : 'var(--line)' }};box-shadow:var(--sh);{{ stat == 'skipped' ? 'opacity:.62;' }}">
                            <div style="display:flex;align-items:center;gap:9px;">
                                <span style="font-family:var(--mono);font-size:8.5px;font-weight:800;letter-spacing:.07em;padding:3px 6px;border-radius:5px;flex-shrink:0;min-width:40px;text-align:center;{{ s[5] == 'muted' ? 'background:var(--panel2);color:var(--muted);' : 'background:var(--' ~ s[5] ~ '-soft);color:var(--' ~ s[5] ~ ');' }}">{{ s[0] }}</span>
                                <span style="flex:1;min-width:0;font-size:12.5px;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ s[1] }}</span>
                                <span style="font-family:var(--mono);font-size:10px;font-weight:600;flex-shrink:0;color:{{ c }};">{{ s[3] }}</span>
                            </div>
                            <div style="font-family:var(--mono);font-size:10px;color:var(--muted);margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ s[2] }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div style="padding:18px 20px 22px;display:flex;flex-direction:column;gap:12px;background:var(--panel2);">
                <div style="font-family:var(--mono);font-size:9.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--faint);">{{ L.dbCheck }}</div>
                <div style="background:#0A0D14;color:#C9D2E4;border:1px solid var(--line);border-radius:12px;padding:12px 13px;font-family:var(--mono);font-size:11px;line-height:1.75;">
                    <div style="white-space:pre;"><span class="tok-k">SELECT</span> status, plan_id, renews_at</div>
                    <div style="white-space:pre;"><span class="tok-k">FROM</span> subscriptions</div>
                    <div style="white-space:pre;"><span class="tok-k">WHERE</span> id <span class="tok-p">=</span> <span class="tok-v">{{ '{{subId}}' }}</span></div>
                    <div style="white-space:pre;">&nbsp;</div>
                    <div style="white-space:pre;"><span class="tok-p">-- 1 row · 64 ms</span></div>
                </div>
                <div style="background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden;">
                    {% for a in [['rowCount == 1', 'got 1', 'pass'], ['rows.0.status == "active"', 'got "trialing"', 'fail'], ['rows.0.plan_id == ' ~ '{{planId}}', 'skipped after failure', 'warn']] %}
                        <div style="display:flex;align-items:center;gap:9px;padding:9px 11px;{{ not loop.last ? 'border-bottom:1px solid var(--line2);' }}">
                            <span style="display:flex;width:20px;height:20px;align-items:center;justify-content:center;border-radius:6px;flex-shrink:0;background:var(--{{ a[2] }}-soft);color:var(--{{ a[2] }});">
                                {% if a[2] == 'pass' %}{{ _self.check() }}{% elseif a[2] == 'fail' %}{{ _self.cross() }}{% else %}{{ _self.minus() }}{% endif %}
                            </span>
                            <span style="flex:1;min-width:0;">
                                <span style="display:block;font-family:var(--mono);font-size:10.5px;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ a[0] }}</span>
                                <span style="display:block;font-family:var(--mono);font-size:9.5px;color:var(--muted);margin-top:2px;">{{ a[1] }}</span>
                            </span>
                        </div>
                    {% endfor %}
                </div>
                <div style="display:flex;align-items:center;gap:9px;padding:10px 12px;background:var(--fail-soft);border:1px solid var(--line);border-radius:12px;">
                    <span style="display:flex;width:20px;height:20px;align-items:center;justify-content:center;border-radius:6px;background:var(--fail);color:#fff;flex-shrink:0;">{{ _self.cross() }}</span>
                    <span style="font-size:11.5px;font-weight:600;color:var(--fail);line-height:1.45;">{{ L.caught }}</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== the difference ===== -->
<section id="diff" style="max-width:1180px;margin:0 auto;padding:82px 24px 0;">
    <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:44px;align-items:center;" class="land-2col">
        <div>
            <div style="font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--pri);margin-bottom:12px;">{{ L.diffEyebrow }}</div>
            <h2 style="margin:0 0 14px;font-size:34px;line-height:1.12;font-weight:800;letter-spacing:-.04em;color:var(--ink);">{{ L.diffTitle }}</h2>
            <p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:var(--muted);max-width:460px;">{{ L.diffLead }}</p>
            <div style="display:flex;flex-direction:column;gap:11px;">
                {% for d in L.diff %}
                    {% set tone = ['pri', 'teal', 'vio'][loop.index0] %}
                    <div style="display:flex;gap:11px;align-items:flex-start;">
                        <span class="sq {{ tone }}" style="width:30px;height:30px;border-radius:9px;">
                            {% if loop.index0 == 0 %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></svg>
                            {% elseif loop.index0 == 1 %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg>
                            {% else %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3l8 3v6c0 5-3.4 8.3-8 9.6C7.4 20.3 4 17 4 12V6z"/><path d="m9 12 2 2 4-4"/></svg>{% endif %}
                        </span>
                        <span style="min-width:0;">
                            <span style="display:block;font-size:13.5px;font-weight:700;color:var(--ink);">{{ d[0] }}</span>
                            <span style="display:block;font-size:12.5px;color:var(--muted);margin-top:2px;line-height:1.5;">{{ d[1] }}</span>
                        </span>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div style="display:flex;flex-direction:column;gap:11px;">
            <div style="background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:var(--sh);overflow:hidden;">
                <div style="display:flex;align-items:center;gap:9px;padding:11px 14px;border-bottom:1px solid var(--line2);">
                    <span style="font-size:12px;font-weight:700;color:var(--ink);">{{ L.waterfall }}</span>
                    <div style="flex:1 1 0;min-width:0;"></div>
                    <span style="font-family:var(--mono);font-size:10px;color:var(--faint);">3 140 ms</span>
                </div>
                {% for w in demo_wf %}
                    {% set col = w[4] == 'passed' ? 'var(--pass)' : (w[4] == 'failed' ? 'var(--fail)' : 'var(--warn)') %}
                    <div style="display:flex;align-items:center;gap:9px;padding:8px 13px;{{ not loop.last ? 'border-bottom:1px solid var(--line2);' }}{{ w[4] == 'failed' ? 'background:var(--fail-soft);' }}">
                        <span style="font-family:var(--mono);font-size:8.5px;font-weight:800;letter-spacing:.06em;padding:3px 5px;border-radius:5px;min-width:38px;text-align:center;flex-shrink:0;{{ w[5] == 'muted' ? 'background:var(--panel2);color:var(--muted);' : 'background:var(--' ~ w[5] ~ '-soft);color:var(--' ~ w[5] ~ ');' }}">{{ w[0] }}</span>
                        <span style="width:120px;font-size:11.5px;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex-shrink:0;">{{ w[1] }}</span>
                        <span style="flex:1;min-width:0;height:16px;position:relative;background:var(--panel2);border-radius:4px;overflow:hidden;">
                            <span style="position:absolute;top:0;bottom:0;left:{{ (w[2] / 3140 * 100)|round(1) }}%;width:{{ max(1.4, w[3] / 3140 * 100)|round(1) }}%;border-radius:4px;background:{{ col }};opacity:{{ w[4] == 'skipped' ? '.3' : '.9' }};"></span>
                        </span>
                        <span style="font-family:var(--mono);font-size:10px;color:var(--muted);width:52px;text-align:right;flex-shrink:0;">{{ w[3] ? w[3] ~ ' ms' : '—' }}</span>
                    </div>
                {% endfor %}
            </div>
            <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;">
                {% for c in [['PostgreSQL', 'SELECT', 'teal'], ['MySQL', 'SELECT', 'pri'], ['Redis', 'GET / EXISTS', 'fail'], ['MongoDB', 'find / count', 'pass']] %}
                    <div style="background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:12px 10px;text-align:center;box-shadow:var(--sh);min-width:0;">
                        <div class="sq {{ c[2] }}" style="width:32px;height:32px;margin:0 auto;border-radius:10px;">
                            {% if loop.index0 == 0 %}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><ellipse cx="12" cy="6" rx="7" ry="2.6"/><path d="M5 6v12c0 1.5 3.1 2.6 7 2.6s7-1.1 7-2.6V6"/></svg>
                            {% elseif loop.index0 == 1 %}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 18c4-1 6-4 6-8"/><path d="M9 10c3 1 5 4 5 8"/><path d="M14 6c4 2 7 6 7 12"/></svg>
                            {% elseif loop.index0 == 2 %}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m12 3 9 4-9 4-9-4z"/><path d="m3 12 9 4 9-4"/><path d="m3 17 9 4 9-4"/></svg>
                            {% else %}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2c3 4 5 7 5 10a5 5 0 0 1-10 0c0-3 2-6 5-10z"/><path d="M12 12v10"/></svg>{% endif %}
                        </div>
                        <div style="font-size:11.5px;font-weight:700;color:var(--ink);margin-top:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ c[0] }}</div>
                        <div style="font-family:var(--mono);font-size:9px;color:var(--faint);margin-top:2px;">{{ c[1] }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<!-- ===== features ===== -->
<section style="max-width:1180px;margin:0 auto;padding:82px 24px 0;">
    <div style="text-align:center;margin-bottom:32px;">
        <div style="font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--pri);margin-bottom:11px;">{{ L.featEyebrow }}</div>
        <h2 style="margin:0 auto;font-size:32px;line-height:1.14;font-weight:800;letter-spacing:-.04em;color:var(--ink);max-width:600px;">{{ L.featTitle }}</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;" class="land-3col">
        {% for f in L.features %}
            {% set tone = ['pri', 'vio', 'teal', 'warn', 'pass', 'pri'][loop.index0] %}
            <div class="card-hover" style="background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px 19px 20px;box-shadow:var(--sh);min-width:0;">
                <div class="sq {{ tone }}" style="width:34px;height:34px;border-radius:11px;">
                    {% if loop.index0 == 0 %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4.5 3h15"/><path d="M6 3v16a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V3"/><path d="M6 14h12"/></svg>
                    {% elseif loop.index0 == 1 %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></svg>
                    {% elseif loop.index0 == 2 %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg>
                    {% elseif loop.index0 == 3 %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
                    {% elseif loop.index0 == 4 %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="6" cy="6" r="2.6"/><circle cx="6" cy="18" r="2.6"/><circle cx="18" cy="12" r="2.6"/><path d="M6 8.6v6.8"/><path d="M8.6 6H13a2.4 2.4 0 0 1 2.4 2.4v1.2"/></svg>
                    {% else %}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9.5" cy="7" r="3.5"/><path d="M21 21v-2a4 4 0 0 0-3-3.8"/></svg>{% endif %}
                </div>
                <div style="font-size:14.5px;font-weight:700;color:var(--ink);margin-top:13px;letter-spacing:-.02em;">{{ f[0] }}</div>
                <p style="margin:6px 0 0;font-size:12.5px;line-height:1.6;color:var(--muted);">{{ f[1] }}</p>
                <div style="display:flex;gap:5px;margin-top:11px;flex-wrap:wrap;">
                    {% for c in f[2] %}<span class="chip">{{ c }}</span>{% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</section>

<!-- ===== MCP spotlight ===== -->
<section id="mcp" style="max-width:1180px;margin:82px auto 0;padding:0 24px;">
    <div style="background:#0A0D14;border:1px solid var(--line);border-radius:20px;overflow:hidden;box-shadow:var(--sh-lg);">
        <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:0;" class="land-2col">
            <div style="padding:38px 34px;">
                <div style="display:inline-flex;align-items:center;gap:8px;padding:5px 11px;border-radius:999px;background:rgba(164,139,255,.14);margin-bottom:16px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#A48BFF" stroke-width="1.9" stroke-linecap="round"><rect x="4" y="7" width="16" height="12" rx="3"/><path d="M12 3v4"/><circle cx="9" cy="13" r="1.1" fill="#A48BFF"/><circle cx="15" cy="13" r="1.1" fill="#A48BFF"/></svg>
                    <span style="font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.1em;color:#A48BFF;">MCP SERVER</span>
                </div>
                <h2 style="margin:0 0 13px;font-size:30px;line-height:1.14;font-weight:800;letter-spacing:-.04em;color:#F3F6FB;">{{ L.mcpTitle }}</h2>
                <p style="margin:0 0 20px;font-size:14.5px;line-height:1.6;color:#98A3BA;max-width:400px;">{{ L.mcpLead }}</p>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    {% for m in L.mcpTools %}
                        <div style="display:flex;align-items:center;gap:9px;">
                            <span style="font-family:var(--mono);font-size:9px;font-weight:800;letter-spacing:.06em;padding:2.5px 6px;border-radius:5px;background:rgba(108,134,255,.16);color:#A6B7FF;min-width:64px;text-align:center;">{{ m[0] }}</span>
                            <span style="font-family:var(--mono);font-size:11px;color:#B7C1D6;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ m[1] }}</span>
                        </div>
                    {% endfor %}
                </div>
                <div style="font-family:var(--mono);font-size:10.5px;color:#5A6480;margin-top:18px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:10px;padding:10px 11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">claude mcp add --transport http signal {{ app.request.schemeAndHttpHost }}/mcp</div>
            </div>
            <div style="padding:34px 34px 34px 0;display:flex;flex-direction:column;gap:10px;justify-content:center;" class="land-chat">
                {% for c in L.chat %}
                    {% set isYou = loop.first %}
                    {% set isTool = c[0] in ['tool', 'araç'] %}
                    <div style="display:flex;gap:10px;align-items:flex-start;padding:12px 13px;border-radius:12px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.06);{{ isTool ? 'font-family:var(--mono);' }}">
                        <span style="font-family:var(--mono);font-size:9px;font-weight:800;letter-spacing:.06em;padding:3px 6px;border-radius:5px;min-width:52px;text-align:center;flex-shrink:0;background:{{ isYou ? 'rgba(108,134,255,.16)' : (isTool ? 'rgba(255,255,255,.06)' : 'rgba(164,139,255,.16)') }};color:{{ isYou ? '#A6B7FF' : (isTool ? '#5A6480' : '#A48BFF') }};">{{ c[0] }}</span>
                        <span style="flex:1;min-width:0;font-size:12.5px;line-height:1.55;color:{{ isTool ? '#7C87A0' : (isYou ? '#D9E0EE' : '#B7C1D6') }};">{{ c[1] }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<!-- ===== triggers / CI ===== -->
<section id="triggers" style="max-width:1180px;margin:0 auto;padding:82px 24px 0;">
    <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;align-items:center;" class="land-2col">
        <div>
            <div style="font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--teal);margin-bottom:12px;">{{ L.hostEyebrow }}</div>
            <h2 style="margin:0 0 13px;font-size:32px;line-height:1.14;font-weight:800;letter-spacing:-.04em;color:var(--ink);">{{ L.hostTitle }}</h2>
            <p style="margin:0 0 18px;font-size:14.5px;line-height:1.6;color:var(--muted);max-width:440px;">{{ L.hostLead }}</p>
            <div style="display:flex;flex-wrap:wrap;gap:7px;">
                {% for s in L.stack %}
                    <span style="font-family:var(--mono);font-size:10.5px;font-weight:600;padding:4px 9px;border-radius:7px;background:var(--panel);border:1px solid var(--line);color:var(--muted);box-shadow:var(--sh);">{{ s }}</span>
                {% endfor %}
            </div>
        </div>
        <div style="background:#0A0D14;border:1px solid var(--line);border-radius:16px;box-shadow:var(--sh-lg);overflow:hidden;">
            <div style="display:flex;align-items:center;gap:8px;padding:10px 13px;border-bottom:1px solid rgba(255,255,255,.07);">
                <span style="display:flex;color:#5A6480;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 17 10 11 4 5"/><path d="M12 19h8"/></svg></span>
                <span style="font-family:var(--mono);font-size:10.5px;color:#5A6480;">bash</span>
            </div>
            <div style="padding:14px 15px;color:#C9D2E4;font-family:var(--mono);font-size:11.5px;line-height:1.85;">
                <div style="white-space:pre;"><span class="tok-p"># {{ L.shellC1 }}</span></div>
                <div style="white-space:pre;"><span class="tok-s">curl</span> -fsS -X POST \</div>
                <div style="white-space:pre;">  -H <span class="tok-n">"Authorization: Bearer $TOKEN"</span> \</div>
                <div style="white-space:pre;">  {{ app.request.httpHost }}/api/v1/flows/<span class="tok-v">$FLOW</span>/run</div>
                <div style="white-space:pre;">&nbsp;</div>
                <div style="white-space:pre;"><span class="tok-p"># {{ L.shellC2 }}</span></div>
                <div style="white-space:pre;"><span class="tok-s">curl</span> -fsS -X POST \</div>
                <div style="white-space:pre;">  -H <span class="tok-n">"Authorization: Bearer $TOKEN"</span> \</div>
                <div style="white-space:pre;">  {{ app.request.httpHost }}/api/v1/flows/<span class="tok-v">$FLOW</span>/run?format=junit</div>
            </div>
        </div>
    </div>
</section>

<!-- ===== CTA ===== -->
<section style="max-width:1180px;margin:0 auto;padding:82px 24px 0;">
    <div style="border:1px solid var(--line);border-radius:20px;background:var(--panel);box-shadow:var(--sh-lg);padding:46px 34px;text-align:center;position:relative;overflow:hidden;">
        <div style="position:absolute;inset:auto 0 -60% 0;height:180%;background:radial-gradient(60% 50% at 50% 100%, var(--pri-soft), transparent 70%);pointer-events:none;"></div>
        <div style="position:relative;">
            <h2 style="margin:0 auto 12px;font-size:34px;line-height:1.12;font-weight:800;letter-spacing:-.04em;color:var(--ink);max-width:560px;">{{ L.ctaTitle }}</h2>
            <p style="margin:0 auto 22px;font-size:15px;color:var(--muted);max-width:460px;line-height:1.55;">{{ L.ctaLead }}</p>
            <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
                <a href="{{ app.user ? path('app_dashboard') : path('app_register') }}" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:11px;background:var(--pri);color:#fff;font-size:13.5px;font-weight:700;box-shadow:0 8px 22px -10px var(--pri);">{{ app.user ? L.openApp : L.start }}</a>
                <a href="{{ path('app_login') }}" style="display:inline-flex;align-items:center;gap:8px;padding:12px 18px;border-radius:11px;border:1px solid var(--line);background:var(--panel);color:var(--text);font-size:13.5px;font-weight:700;">{{ L.cta2 }}</a>
            </div>
        </div>
    </div>
</section>

<!-- ===== footer ===== -->
<footer style="max-width:1180px;margin:56px auto 0;padding:44px 24px 40px;border-top:1px solid var(--line);">
    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:8px;">
            <div style="width:22px;height:22px;border-radius:7px;background:linear-gradient(140deg,var(--pri),var(--vio));display:flex;align-items:center;justify-content:center;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"><path d="M4 17 10 11 4 5"/><path d="M12 19h8"/></svg>
            </div>
            <span class="no-caps" style="font-weight:800;font-size:13.5px;color:var(--ink);letter-spacing:-.03em;">Signal</span>
        </div>
        <span style="font-size:12px;color:var(--faint);">{{ L.footerNote }}</span>
        <div style="flex:1 1 0;min-width:0;"></div>
        <div style="display:flex;gap:14px;flex-wrap:wrap;">
            {% for n in L.nav %}
                <a href="{{ n[1] }}" style="font-size:12px;font-weight:600;color:var(--muted);">{{ n[0] }}</a>
            {% endfor %}
        </div>
    </div>
</footer>

</div>
{% endblock %}
