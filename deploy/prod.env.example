# Copy to deploy/prod.env on the server and fill in. Gitignored — never commit.
#   cp deploy/prod.env.example deploy/prod.env

# Public URL. Used for URLs generated outside an HTTP request (CLI, mail, ...).
DEFAULT_URI=https://signal.yusufdgn.com

# Host:port the ingress reaches nginx on. 10.42.0.1 is the k3s cluster bridge,
# so nothing is published on the public interface.
HTTP_BIND=10.42.0.1:8090

# php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=CHANGE_ME
# 32 bytes / 64 hex chars — encrypts stored DB-connection passwords.
# Changing this makes every stored connection password undecryptable.
APP_SECRET_KEY=CHANGE_ME

POSTGRES_PASSWORD=CHANGE_ME
MONGO_PASSWORD=CHANGE_ME

# Optional — enables the "AI ile teşhis et" button on failed runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
